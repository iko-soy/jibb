GROUPS = ('eval', 'ship')


# ---------------------------------------------------------------- running


class Result:
    def __init__(self, check):
        self.check = check
        self.ok = False
        self.status = None
        self.why = ''
        self.output = ''
        self.seconds = 0.0


_lock = threading.Lock()
_running = set()     # process groups to kill if we're interrupted


def say(msg=''):
    with _lock:
        print(msg, flush=True)


def run(check, timeout, env):
    """Run one check; a Result."""
    res = Result(check)
    start = time.time()
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        try:
            proc = subprocess.Popen(
                check.command, cwd=ROOT, env=env, stdin=subprocess.DEVNULL,
                stdout=out,
                stderr=err if check.expect is not None else subprocess.STDOUT,
                start_new_session=True)
        except OSError as e:
            res.why = 'could not run %s: %s' % (check.command[0], e)
            return res
        with _lock:
            _running.add(proc.pid)
        try:
            res.status = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            kill(proc.pid)
            proc.wait()
            res.why = 'timed out after %d s' % timeout
        finally:
            with _lock:
                _running.discard(proc.pid)
            kill(proc.pid)  # anything it left running, such as urbit eval
        out.seek(0)
        err.seek(0)
        stdout = out.read().decode('utf-8', 'replace')
        stderr = err.read().decode('utf-8', 'replace')
    res.seconds = time.time() - start
    res.output = stdout + stderr
    if res.why:
        return res
    if res.status != 0:
        res.why = 'exit status %d' % res.status
    elif check.expect is not None and \
            not re.fullmatch(check.expect, stdout):
        res.why = "it didn't print the verdict that means a pass"
    else:
        res.ok = True
    return res


def kill(pgid):
    try:
        os.killpg(pgid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass


def kill_all(*_):
    with _lock:
        pids = list(_running)
    for pid in pids:
        kill(pid)


def report(res, verbose, logs, limit=300):
    mark = 'PASS' if res.ok else 'FAIL'
    line = '%s  %-34s %5d s' % (mark, res.check.name, round(res.seconds))
    if not res.ok:
        line += '  (%s)' % res.why
    lines = res.output.rstrip('\n').split('\n') if res.output.strip() else []
    if logs:
        with open(os.path.join(logs, res.check.name + '.log'), 'w') as f:
            f.write('$ %s\n%s' % (res.check.shown(), res.output))
    if res.ok and not verbose:
        say(line)
        return
    shown = lines
    if not verbose and len(lines) > limit:
        shown = ['(%d lines cut; --logs DIR keeps them all)'
                 % (len(lines) - limit)] + lines[-limit:]
    body = ['    $ ' + res.check.shown()] + ['    ' + l for l in shown]
    say('\n'.join([line] + body))


# ---------------------------------------------------------------- the ship


def ship(env, *args, **kw):
    return subprocess.run([SHIP] + list(args), cwd=ROOT, env=env, **kw)


def ship_running(env):
    """Whether tools/ship's ship runs: status exits 3 when it doesn't."""
    res = ship(env, 'status', stdout=subprocess.DEVNULL,
               stderr=subprocess.DEVNULL)
    return res.returncode != 3


# ---------------------------------------------------------------- main


def select(names, group):
    """The checks to run, in list order; exits 2 on a name nothing matches."""
    chosen = [c for c in CHECKS if group in (None, c.group)]
    if not names:
        return chosen
    picked = set()
    for name in names:
        hits = [c.name for c in chosen if fnmatch.fnmatchcase(c.name, name)]
        if not hits:
            where = ' in the %s group' % group if group else ''
            print('check: no check %s%s; tools/check --list lists them'
                  % (name, where), file=sys.stderr)
            sys.exit(2)
        picked.update(hits)
    return [c for c in chosen if c.name in picked]


def main(argv):
    ap = argparse.ArgumentParser(
        prog='tools/check', description=__doc__.split('\n\n')[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='\n\n'.join(__doc__.split('\n\n')[1:]))
    ap.add_argument('names', nargs='*', metavar='NAME',
                    help='checks to run, by name or glob (default: all)')
    ap.add_argument('--group', choices=GROUPS,
                    help='only the checks in this group')
    ap.add_argument('--list', action='store_true',
                    help='list the checks and exit')
    ap.add_argument('-j', '--jobs', type=int, default=os.cpu_count() or 1,
                    metavar='N', help='eval checks to run at once '
                    '(default: the number of CPUs, %(default)s)')
    ap.add_argument('--timeout', type=int, default=2400, metavar='SECONDS',
                    help='seconds each check may take (default %(default)s)')
    ap.add_argument('--logs', metavar='DIR',
                    help="keep every check's output in DIR/<name>.log")
    ap.add_argument('-v', '--verbose', action='store_true',
                    help="print every check's output, not only a failure's")
    args = ap.parse_args(argv)

    checks = select(args.names, args.group)
    if args.list:
        for c in checks:
            print('%-34s %-5s %s' % (c.name, c.group, c.shown()))
        return 0
    if args.jobs < 1:
        ap.error('-j must be at least 1')
    if args.logs:
        os.makedirs(args.logs, exist_ok=True)

    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1')
    signal.signal(signal.SIGTERM, lambda *_: (kill_all(), sys.exit(143)))
    started = time.time()
    results = []
    unable = False
    try:
        evals = [c for c in checks if c.group == 'eval']
        if evals:
            say('running %d eval check%s, %d at a time'
                % (len(evals), '' if len(evals) == 1 else 's', args.jobs))
            with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
                futures = [pool.submit(run, c, args.timeout, env)
                           for c in evals]
                for f in concurrent.futures.as_completed(futures):
                    res = f.result()
                    results.append(res)
                    report(res, args.verbose, args.logs)
        ships = [c for c in checks if c.group == 'ship']
        if ships:
            started_ship = False
            if not ship_running(env):
                say('starting the ship for %d ship check%s'
                    % (len(ships), '' if len(ships) == 1 else 's'))
                start = ship(env, 'start')
                if start.returncode != 0:
                    say('check: the ship would not start, so the ship '
                        'checks did not run')
                    unable = True
                    ships = []
                started_ship = not unable
            else:
                say('running %d ship check%s on the running ship'
                    % (len(ships), '' if len(ships) == 1 else 's'))
            try:
                for c in ships:
                    res = run(c, args.timeout, env)
                    results.append(res)
                    report(res, args.verbose, args.logs)
            finally:
                if started_ship:
                    say('stopping the ship tools/check started')
                    ship(env, 'stop', '--force')
    except KeyboardInterrupt:
        kill_all()
        print('check: interrupted', file=sys.stderr)
        return 130

    failed = [r for r in results if not r.ok]
    order = {c.name: i for i, c in enumerate(CHECKS)}
    say('')
    say('%d passed, %d failed%s in %d s' % (
        len(results) - len(failed), len(failed),
        ', ship checks not run' if unable else '',
        round(time.time() - started)))
    for r in sorted(failed, key=lambda r: order[r.check.name]):
        say('  failed: %s (%s)' % (r.check.name, r.why))
    if failed:
        return 1
    return 2 if unable else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
