#!/usr/bin/env python3
"""Run the repo's checks: all of them, a group, or some by name.

    tools/check                    every check: the eval group, then ship
    tools/check --group eval       the checks that need only urbit and Python
    tools/check --group ship       the checks that need the fake ~zod
    tools/check golden 'type-*'    only the checks these names or globs match
    tools/check --list             the checks, their groups and commands
    tools/check -j 3               at most 3 eval checks at once

CHECKS below is the one list of the repo's checks: docs/development.md
sends you here before pushing, and `nix flake check` runs this tool too
(see flake.nix), so a new check goes in the list and nowhere else.

The eval checks run under `urbit eval` without a ship, several at once
(-j, default: as many as there are CPUs), in the order of the list, so
the slowest come first.  The ship checks then run one at a time, in
order, on the ship tools/ship talks to: $JIBB_PIER, or /root/urbit/zod
(tools/ship also reads $JIBB_CLICK and $JIBB_SHIP_LOG).  When that ship
isn't running, tools/check starts it first and stops it again at the end.

Each check is one command, run from the repo root.  It passes when it
exits 0 and, for the few that print their verdict rather than exit with
it, when its output matches what the list expects.  Output is kept and
printed only for a check that fails (all of it with -v); --logs DIR
keeps every check's output in DIR/<name>.log.

Exit status: 0 when every check ran and passed, 1 when a check failed,
2 when the checks couldn't run (an unknown name, a ship that won't start).
"""

import argparse
import concurrent.futures
import fnmatch
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SHIP = os.path.join('tools', 'ship')


class Check:
    def __init__(self, name, group, command, expect=None):
        self.name = name
        self.group = group          # 'eval' or 'ship'
        self.command = command      # argv, run from ROOT
        self.expect = expect        # a regex stdout must match in full

    def shown(self):
        return ' '.join(c if re.match(r'^[\w./=-]+$', c) else "'%s'" % c
                        for c in self.command)


def tool(name, group='eval', *args):
    """A check that runs tools/<name> and passes when it exits 0."""
    base = os.path.basename(name)
    return Check(base, group, [os.path.join('tools', name)] + list(args))


def hoon(name, *args, expect):
    """A check that runs tools/hoon and compares what it prints."""
    return Check(name, 'eval', ['tools/hoon'] + list(args), expect=expect)


#  Every check, in the order they start: the eval group, slowest first,
