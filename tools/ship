class Fail(Exception):
    """Something failed: report it, exit 1."""


class Unable(Exception):
    """The command can't run: report it, exit 2."""


def say(msg=''):
    print(msg, flush=True)


_warned = set()


def warn(msg):
    """Print a warning once, however often the code finds it."""
    if msg not in _warned:
        _warned.add(msg)
        print('ship: ' + msg, file=sys.stderr, flush=True)


# ---------------------------------------------------------------- nouns
#
#  A noun is an int (an atom) or a 2-tuple (a cell).


def cue(data):
    """Decode a jammed noun, without recursion."""
    total = len(data) * 8

    def bit(i):
        if i >= total:
            raise ValueError('cue: ran off the end of the jam')
        return (data[i >> 3] >> (i & 7)) & 1

    def bits(i, k):
        if k == 0:
            return 0
        if i + k > total:
            raise ValueError('cue: ran off the end of the jam')
        v = int.from_bytes(data[i >> 3:(i + k + 7) >> 3], 'little')
        return (v >> (i & 7)) & ((1 << k) - 1)

    def rub(i):
        c = 0
        while bit(i + c) == 0:
            c += 1
        if c == 0:
            return 1, 0
        b = (1 << (c - 1)) | bits(i + c + 1, c - 1)
        return c + c + b, bits(i + c + c, b)

    refs = {}
    stack = []
    i = 0
    while True:
        start = i
        if bit(i) == 0:
            length, val = rub(i + 1)
            i += 1 + length
            refs[start] = val
        elif bit(i + 1) == 0:
            stack.append([start, False, None])
            i += 2
            continue
        else:
            length, ref = rub(i + 2)
            i += 2 + length
            val = refs[ref]
        while stack:
            top = stack[-1]
            if not top[1]:
                top[1] = True
                top[2] = val
                break
            stack.pop()
            val = (top[2], val)
            refs[top[0]] = val
        else:
            return val


def atom_bytes(a):
    """An atom's bytes, low byte first, as Hoon cords are."""
    return a.to_bytes((a.bit_length() + 7) // 8, 'little')


def text(a):
    return atom_bytes(a).decode('utf-8', 'replace')


def term(s):
    return int.from_bytes(s.encode(), 'little')


def items(n):
    """A Hoon list as a Python list."""
    out = []
    while isinstance(n, tuple):
        out.append(n[0])
        n = n[1]
    return out


def tape(n):
    return bytes(items(n)).decode('utf-8', 'replace')


def path_text(n):
    return '/' + '/'.join(text(s) for s in items(n))


def hoon_cord(data):
    """A Hoon cord literal holding exactly these bytes."""
    out = ["'"]
    for b in data:
        if b == 0x5c:
            out.append('\\\\')
        elif b == 0x27:
            out.append("\\'")
        elif 0x20 <= b < 0x7f:
            out.append(chr(b))
        else:
            out.append('\\%02x' % b)
    out.append("'")
    return ''.join(out)


def hoon_path(segments):
    """A Hoon path literal.  A segment that isn't a term, such as
    odd.name_1, goes in as a knot, [~.odd.name_1]: written plain, the
    parser would read the . as the end of a coin."""
    return '/' + '/'.join(s if TERM.match(s) else '[~.%s]' % s
                          for s in segments) if segments else '/'


# ---------------------------------------------------------------- tangs


def ram(tank):
    """A tank on one line, as Hoon's +ram:re prints it."""
    if isinstance(tank, int):
        return text(tank)
    tag = text(tank[0])
    if tag == 'leaf':
        return tape(tank[1])
    if tag in ('rose', 'palm'):
        spec, kids = tank[1]
        if tag == 'palm':
            p, (q, (r, s)) = spec
            sep, opn, cls = tape(p), tape(q) + tape(r), tape(s)
        else:
            p, (q, r) = spec
            sep, opn, cls = tape(p), tape(q), tape(r)
        return opn + sep.join(ram(k) for k in items(kids)) + cls
    return repr(tank)


def tang_lines(tang):
    out = []
    for tank in items(tang):
        try:
            out.append(ram(tank))
        except (TypeError, ValueError):
            out.append(repr(tank))
    return out


# ---------------------------------------------------------------- the ship


def find_urbit(pier):
    run = os.path.join(pier, '.run')
    if os.access(run, os.X_OK):
        return run
    found = shutil.which('urbit')
    if not found:
        raise Unable('no urbit binary: neither %s nor urbit on PATH' % run)
    return found


class Ship:
    def __init__(self, pier, log, click):
        self.pier = os.path.realpath(pier)
        self.log = log or self.pier + '.log'
        self.click = click
        self.sock = os.path.join(self.pier, '.urb', 'conn.sock')

    # -- processes

    def processes(self):
        """(king pid, serf pid) of the urbit running this pier, or None."""
        king = serf = None
        for pid in os.listdir('/proc'):
            if not pid.isdigit():
                continue
            try:
                with open('/proc/%s/cmdline' % pid, 'rb') as f:
                    args = [a.decode('utf-8', 'replace')
                            for a in f.read().split(b'\0') if a]
            except OSError:
                continue
            if len(args) < 2 or self.pier not in [
                    os.path.realpath(a) if a.startswith('/') else a
                    for a in args[1:]]:
                continue
            if args[1] == 'work':
                serf = int(pid)
            elif args[1] not in ('eval', 'dock', 'info', 'pack', 'meld'):
                king = int(pid)
        return king, serf

    def running(self):
        king, serf = self.processes()
        return king or serf

    def require(self):
        if not self.running():
            raise Unable('the ship at %s is not running; start it with '
                         'tools/ship start' % self.pier)
        if not os.path.exists(self.sock):
            raise Unable('the ship is running but has no %s yet; wait for '
                         'it to come up' % self.sock)

    # -- the log

    def log_size(self):
        try:
            return os.path.getsize(self.log)
        except OSError:
            return 0

    def log_since(self, offset):
        """The log's lines from a byte offset on, without colours."""
        try:
            with open(self.log, 'rb') as f:
                f.seek(offset)
                data = f.read()
        except OSError:
            return []
        data = re.sub(rb'\x1b\[[0-9;?]*[A-Za-z]', b'', data)
        return data.decode('utf-8', 'replace').replace('\r', '').split('\n')

    # -- start and stop

    def start(self, timeout):
        if self.running():
            say('the ship is already running (pid %d)' % self.running())
            self.wait_live(time.time() + timeout, None, 0)
            return
        if not os.path.isdir(os.path.join(self.pier, '.urb')):
            raise Unable('no pier at %s' % self.pier)
        binary = find_urbit(self.pier)
        if os.path.exists(self.log) and os.path.getsize(self.log):
            os.replace(self.log, self.log + '.1')
        logf = open(self.log, 'ab')
        logf.write(('tools/ship: starting %s -t %s at %s\n' % (
            binary, self.pier,
            datetime.datetime.now().isoformat(timespec='seconds'))).encode())
        logf.flush()
        proc = subprocess.Popen(
            [binary, '-t', self.pier], stdin=subprocess.DEVNULL,
            stdout=logf, stderr=subprocess.STDOUT,
            cwd=os.path.dirname(self.pier), start_new_session=True)
        logf.close()
        say('starting the ship at %s (pid %d), logging to %s'
            % (self.pier, proc.pid, self.log))
        self.wait_live(time.time() + timeout, proc, 0)

    def wait_live(self, deadline, proc, offset):
        """Wait for the pier to say it's live and for a thread to run."""
        live = re.compile(r'pier \(\d+\): live')
        while True:
            if proc is not None and proc.poll() is not None:
                tail = '\n'.join(self.log_since(offset)[-30:])
                raise Unable('the ship exited with status %d; the end of '
                             'its log:\n%s' % (proc.returncode, tail))
            if any(live.search(l) for l in self.log_since(offset)) or \
                    proc is None:
                if os.path.exists(self.sock):
                    try:
                        our = self.thread(OUR, timeout=60)
                        say('the ship is live: %s' % text(our))
                        return
                    except (Fail, OSError) as e:
                        if time.time() > deadline:
                            raise Unable('the ship is up but its threads '
                                         "don't run: %s" % e)
            if time.time() > deadline:
                raise Unable('the ship did not come up in time; see %s'
                             % self.log)
            time.sleep(0.5)

    def stop(self, timeout, force):
        king, serf = self.processes()
        if not king and not serf:
            say('the ship is not running')
            return
        target = king or serf
        say('stopping the ship (pid %d)' % target)
        os.kill(target, signal.SIGTERM)
        deadline = time.time() + timeout
        while time.time() < deadline:
            if not self.running():
                say('the ship has stopped')
                return
            time.sleep(0.3)
        if not force:
            raise Fail('the ship is still running after %ds; tools/ship '
                       'stop --force kills it' % timeout)
        for pid in self.processes():
            if pid:
                os.kill(pid, signal.SIGKILL)
        time.sleep(1)
        say('killed the ship')

    # -- threads

    def thread(self, hoon, timeout=600):
        """Run a strand on the ship with khan-eval; the noun of its vase.

        hoon is a whole strand, `=/  m  (strand ,vase)  ...`, in the
        subject khan-eval gives it: strandio, spider and zuse.
        """
        if not os.path.exists(self.sock):
            raise Unable('no %s: is the ship running?' % self.sock)
        frame = self.request(hoon)
        reply = self.call(frame, timeout)
        noun = cue(reply[5:])
        try:
            _rid, (kind, rest) = noun
        except (TypeError, ValueError):
            raise Fail('a strange reply from the ship: %.200r' % (noun,))
        if kind == term('avow'):
            ok, payload = rest
            if ok == 0:
                return payload[1]
            mote, tang = payload
            raise Fail('the thread failed: %%%s\n%s' % (
                text(mote), '\n'.join('  ' + l for l in tang_lines(tang))))
        raise Fail('the ship refused the request: %%%s %.200r'
                   % (text(kind), rest))

    def request(self, hoon):
        """The request for a khan-eval thread, as click formats and jams it."""
        prepared = prepare(hoon)
        with tempfile.TemporaryDirectory(prefix='jibb-ship-') as tmp:
            src = os.path.join(tmp, 'thread.hoon')
            out = os.path.join(tmp, 'request.jam')
            with open(src, 'w', encoding='ascii') as f:
                f.write(prepared)
            res = subprocess.run(
                [self.click, '-k', '-j', '-b', find_urbit(self.pier),
                 '-i', src, '-o', out, self.pier],
                capture_output=True)
            try:
                with open(out, 'rb') as f:
                    frame = f.read()
            except OSError:
                frame = b''
        size = int.from_bytes(frame[1:5], 'little') if len(frame) >= 5 else -1
        if len(frame) < 6 or frame[0] != 0 or size != len(frame) - 5:
            err = [l for l in res.stderr.decode('utf-8', 'replace')
                   .replace('\r', '').split('\n')
                   if l and not re.match(r'^(loom|lite|eval \()', l)]
            raise Fail('click could not jam the request:\n  ' +
                       '\n  '.join(err[-20:] or ['(no output)']))
        return frame

    def call(self, frame, timeout):
        """Send a newt frame to conn.sock and read one whole frame back."""
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        try:
            s.connect(self.sock)
            s.sendall(frame)
            buf = b''
            need = None
            while need is None or len(buf) < need:
                chunk = s.recv(1 << 20)
                if not chunk:
                    break
                buf += chunk
                if need is None and len(buf) >= 5:
                    need = 5 + int.from_bytes(buf[1:5], 'little')
        except socket.timeout:
            raise Fail('no reply from the ship in %ds' % timeout)
        finally:
            s.close()
        if need is None:
            raise Fail('the ship closed the connection without replying')
        if len(buf) < need:
            raise Fail('the reply was cut off after %d of its %d bytes: '
                       'vere closes conn.sock as soon as it has written a '
                       'reply, so only what fits in the socket buffer gets '
                       'through; ask for less' % (len(buf), need))
        return buf[:need]


def prepare(hoon):
    """Hoon as click -i needs it: no comments, backslashes doubled, and
    every byte that isn't printable ASCII written as a \\XX escape, all
    inside the cord click wraps the thread in."""
    lines = []
    for line in hoon.split('\n'):
        line = strip_comment(line).rstrip()
        if line:
            lines.append(line)
    out = []
    for ch in '\n'.join(lines).encode('utf-8'):
        if ch == 0x5c:
            out.append('\\\\')
        elif ch == 0x0a or 0x20 <= ch < 0x7f:
            out.append(chr(ch))
        else:
            out.append('\\%02x' % ch)
    return ''.join(out) + '\n'


def strip_comment(line):
    """A line of Hoon without its :: comment, minding quotes."""
    quote = None
    i = 0
    while i < len(line):
        c = line[i]
        if quote:
            if c == '\\':
                i += 1
            elif c == quote:
                quote = None
        elif c in '\'"':
            quote = c
        elif line.startswith('::', i):
            return line[:i]
        i += 1
    return line


