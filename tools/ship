def golden_cases(golden):
    """[(case name, folder)] for each case folder holding a source.jibb."""
    if not os.path.isdir(golden):
        return []
    cases = []
    for name in sorted(os.listdir(golden)):
        folder = os.path.join(golden, name)
        if not os.path.isdir(folder) or name.startswith('.'):
            continue
        if not os.path.isfile(os.path.join(folder, 'source.jibb')):
            warn('skipping %s: it has no source.jibb' % show(folder))
            continue
        if not KNOT.match(name):
            warn('skipping %s: %r is not a knot, so it has no Clay path '
                 '(lowercase letters, digits and - . ~ _)' % (show(folder), name))
            continue
        cases.append((name, folder))
    return cases


def arm_names(names):
    """A test- arm name for each case: its name with what a term can't
    hold made -, and a number added to tell clashes apart."""
    out, used = [], set()
    for name in names:
        base = 'test-' + re.sub(r'[^a-z0-9-]', '-', name)
        arm, n = base, 1
        while arm in used:
            n += 1
            arm = '%s-%d' % (base, n)
        used.add(arm)
        out.append(arm)
    return out


def generate_tests(golden):
    cases = golden_cases(golden)
    has_imports = False
    has_marks = False
    for _, folder in cases:
        try:
            sur = golden_case.sur_imports(folder)
            marks = golden_case.mark_imports(folder)
            has_imports |= bool(sur or marks)
            has_marks |= bool(marks)
        except ValueError as e:
            raise Unable(str(e))
    lines = [fill(TESTS_HEADER, SOURCE=show(golden)).rstrip('\n'),
             '/+  jibb, jibb-import' if has_imports else '/+  jibb']
    arms = []
    for i, ((name, folder), arm) in enumerate(
            zip(cases, arm_names([c[0] for c in cases])), 1):
        base = '/tests/golden/%s' % name
        lines.append('/*  src-%d  %%jibb  %s/source/jibb' % (i, base))
        #  a knot literal: a case's name may hold . and _, which a
        #  path literal in Hoon can't, though /* takes them
        try:
            logical = golden_case.source_path(folder)
            imports = golden_case.sur_imports(folder)
            marks = golden_case.mark_imports(folder)
        except ValueError as e:
            raise Unable(str(e))
        args = ['~.%s' % name]
        if logical:
            args.append(logical)
        args.append('src-%d' % i)
        for kind, face in (('tokens', 'tok'), ('tree', 'tre')):
            if os.path.isfile(os.path.join(folder, kind + '.txt')):
                lines.append('/*  %s-%d  %%txt   %s/%s/txt'
                             % (face, i, base, kind))
                args.append('`%s-%d' % (face, i))
            else:
                args.append('~')
        call = '(%s %s)' % ('check-at' if logical else 'check', ' '.join(args))
        if golden_case.wants_types(folder):
            if os.path.isfile(os.path.join(folder, 'types.txt')):
                lines.append('/*  typ-%d  %%txt   %s/types/txt' % (i, base))
                expected_types = '`typ-%d' % i
            else:
                expected_types = '~'
            path = logical or '~[%%tests %%golden ~.%s %%source %%jibb]' % name
            if marks:
                fixtures = []
                for j, (module, mold, _) in enumerate(imports, 1):
                    face = 'imp-%d-%d' % (i, j)
                    lines.append('/*  %s  %%txt  %s/sur/%s/txt' % (face, base, module))
                    fixtures.append('[%%%s %%%s %s]' % (module, mold, face))
                mark_fixtures = []
                for j, (mark, _) in enumerate(marks, 1):
                    face = 'mark-%d-%d' % (i, j)
                    lines.append('/*  %s  %%txt  %s/mar/%s/txt' % (face, base, mark))
                    mark_fixtures.append('[%%%s %s]' % (mark, face))
                call = '(weld %s (check-mark-types ~.%s %s src-%d %s ~[%s] ~[%s]))' % (
                    call, name, path, i, expected_types, ' '.join(fixtures),
                    ' '.join(mark_fixtures))
            elif imports:
                fixtures = []
                for j, (module, mold, _) in enumerate(imports, 1):
                    face = 'imp-%d-%d' % (i, j)
                    lines.append('/*  %s  %%txt  %s/sur/%s/txt' % (face, base, module))
                    fixtures.append('[%%%s %%%s %s]' % (module, mold, face))
                call = '(weld %s (check-import-types ~.%s %s src-%d %s ~[%s]))' % (
                    call, name, path, i, expected_types, ' '.join(fixtures))
            else:
                call = '(weld %s (check-types ~.%s %s src-%d %s))' % (
                    call, name, path, i, expected_types)
        arms.append('++  %s\n  %s' % (arm, call))
    lines.append('|%')
    if arms:
        lines.append('::  one arm per case')
        lines.append('::')
    lines.extend(arms)
    types_helper = ''
    if any(golden_case.wants_types(folder) for _, folder in cases):
        types_helper = '''::
++  check-types
  |=  [case=@ta at=path src=@t want=(unit wain)]
  ^-  tang
  (compare (file case "types.txt") want (golden-types:jibb at src))
'''
    if has_imports:
        types_helper += '''::
++  check-import-types
  |=  [case=@ta at=path src=@t want=(unit wain) fixtures=(list [module=term mold=term source=wain])]
  ^-  tang
  =/  result  (mule |.((import-types-result at src fixtures)))
  ?:  ?=(%| -.result)
    [leaf+"fixture compilation or type checking crashed" p.result]
  (compare (file case "types.txt") want p.result)
::
++  import-types-result
  |=  [at=path src=@t fixtures=(list [module=term mold=term source=wain])]
  ^-  @t
  =/  external=(list [module=term name=term result=*])
    %+  turn  fixtures
    |=  fixture=[module=term mold=term source=wain]
    ~_  leaf+"/sur/{(trip module.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [module.fixture mold.fixture (read-named:jibb-import module.fixture mold.fixture cor)]
  (golden-types-imports:jibb at src external)
'''
    if has_marks:
        types_helper += '''::
++  check-mark-types
  |=  [case=@ta at=path src=@t want=(unit wain) fixtures=(list [module=term mold=term source=wain]) marks=(list [name=term source=wain])]
  ^-  tang
  =/  result  (mule |.((mark-types-result at src fixtures marks)))
  ?:  ?=(%| -.result)
    [leaf+"fixture compilation or type checking crashed" p.result]
  (compare (file case "types.txt") want p.result)
::
++  mark-types-result
  |=  [at=path src=@t fixtures=(list [module=term mold=term source=wain]) marks=(list [name=term source=wain])]
  ^-  @t
  =/  external=(list [module=term name=term result=*])
    %+  turn  fixtures
    |=  fixture=[module=term mold=term source=wain]
    ~_  leaf+"/sur/{(trip module.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [module.fixture mold.fixture (read-named:jibb-import module.fixture mold.fixture cor)]
  =/  mark-external=(list [name=term result=*])
    %+  turn  marks
    |=  fixture=[name=term source=wain]
    ~_  leaf+"/mar/{(trip name.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [name.fixture (read-mark:jibb-import name.fixture cor)]
  (golden-types-with-marks:jibb at src external mark-external)
'''
    return '\n'.join(lines) + '\n' + TESTS_HELPERS.replace('\n--\n', '\n' + types_helper + '--\n')


# ---------------------------------------------------------------- sync


def desks_info(ship):
    """(mount points, {desk: revision})."""
    mon, dez = ship.thread(DESKS_INFO)
    return ({text(m) for m in items(mon)},
            {text(d): rev for d, rev in items(dez)})


def ensure_desk(ship, desk, quiet=False):
    """Create the desk if it's missing and mount it; the mount folder."""
    mounts, revs = desks_info(ship)
    mount = os.path.join(ship.pier, desk)
    if desk not in revs:
        ship.thread(fill(NEW_DESK, DESK=desk))
        if not quiet:
            say('%s: created the desk, as |new-desk does' % desk)
    if desk in mounts and not os.path.isdir(mount):
        ship.thread(fill(UNMOUNT, DESK=desk))
        mounts.discard(desk)
    if desk not in mounts:
        ship.thread(fill(MOUNT, DESK=desk))
        deadline = time.time() + 30
        while not os.path.isfile(os.path.join(mount, 'sys.kelvin')):
            if time.time() > deadline:
                raise Fail('%s: mounted, but %s/sys.kelvin never appeared'
                           % (desk, mount))
            time.sleep(0.2)
        if not quiet:
            say('%s: mounted at %s' % (desk, mount))
    return mount


def mirror(mount, files):
    """Make the mount folder hold exactly these files (dotfiles aside,
    which vere ignores); the paths added, changed and deleted."""
    added, changed, deleted = [], [], []
    for rel, (data, _src) in sorted(files.items()):
        path = os.path.join(mount, rel)
        try:
            with open(path, 'rb') as f:
                old = f.read()
        except FileNotFoundError:
            old = None
        if old == data:
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'wb') as f:
            f.write(data)
        (added if old is None else changed).append(rel)
    for dirpath, dirnames, filenames in os.walk(mount, topdown=False):
        rel_dir = os.path.relpath(dirpath, mount)
        rel_dir = '' if rel_dir == '.' else rel_dir
        if any(s.startswith('.') for s in rel_dir.split(os.sep) if s):
            continue
        for fn in filenames:
            rel = os.path.join(rel_dir, fn)
            if fn.startswith('.') or rel in files:
                continue
            os.remove(os.path.join(dirpath, fn))
            deleted.append(rel)
        if rel_dir and not os.listdir(dirpath):
            os.rmdir(dirpath)
    return added, changed, sorted(deleted)


def commit(ship, desk):
    """|commit the desk; the revision before."""
    return ship.thread(fill(COMMIT, DESK=desk))


MANIFEST_PAGE = 2000    # files per reply; see REPLY_BYTES
CONV_BYTES = 65536      # bigger files with other marks are only looked for


def short_hash(data):
    """The first 8 bytes of the sha-256, as the atom the ship gives."""
    return int.from_bytes(hashlib.sha256(data).digest()[:8], 'little')


def txt_lines(data, jet):
    """The wain the %txt mark stores for a file: lines, without the
    empty one after a final newline if jet, as vere's +to-wain does."""
    if not data:
        return []
    lines = data.split(b'\n')
    if jet and data.endswith(b'\n'):
        lines.pop()
    #  a line is an atom, which can't end in zero bytes
    return [l.rstrip(b'\0') for l in lines]


def verify(ship, desk, files):
    """Compare the desk with the files; (revision, problems, extra), extra
    being the paths of the desk's files that aren't among the files.

    The ship sends its manifest, a short hash of each file, and Python
    compares: files whose mark stores a cord by the hash of their
    bytes, %txt files by the hash of their lines, and the rest, which
    are few and small (desk.bill, sys.kelvin, desk.docket-0), by
    sending their content to be converted by the desk's own mark.
    """
    by_path = {'/' + '/'.join(clay_path(rel)): rel for rel in files}
    conv = []
    for pax, rel in sorted(by_path.items()):
        mark = clay_path(rel)[-1]
        data = files[rel][0]
        if mark not in BYTE_MARKS and mark != 'txt' and \
                len(data) <= CONV_BYTES:
            conv.append('[%s %s]' % (hoon_path(clay_path(rel)),
                                     hoon_cord(data)))
    now, start, total, desk_files = 'now.bowl', 0, None, {}
    while total is None or start < total:
        noun = ship.thread(fill(
            MANIFEST, DESK=desk, NOW=now, FROM=hoon_ud(start),
            COUNT=hoon_ud(MANIFEST_PAGE),
            CONV='~[%s]' % ' '.join(conv) if conv else '~'))
        rev, (da, (jet, (total, (conv_res, page)))) = noun
        now = '`@da``@`%s' % hoon_ud(da)
        for pax, (kind, val) in items(page):
            desk_files[path_text(pax)] = (text(kind), val)
        start += MANIFEST_PAGE
    jet = jet == 0
    problems = []
    extra = sorted(set(desk_files) - set(by_path))
    for pax in extra:
        problems.append('%s is on the desk but not in the repo' % pax)
    converted = {path_text(p): ok == 0 for p, ok in items(conv_res)}
    for pax, rel in sorted(by_path.items()):
        data, src = files[rel]
        mark = clay_path(rel)[-1]
        if pax not in desk_files:
            problems.append('%s is missing from the desk' % pax)
            continue
        kind, val = desk_files[pax]
        if mark in BYTE_MARKS:
            same = kind == 'cord' and val == short_hash(data.rstrip(b'\0'))
        elif mark == 'txt':
            same = kind == 'wain' and val == short_hash(
                b''.join(l + b'\n' for l in txt_lines(data, jet)))
        elif pax in converted:
            same = converted[pax]
        else:
            continue    # too big to send; it's there
        if not same:
            problems.append('%s differs from %s' % (pax, src))
    return rev, problems, extra


def sync(ship, desk, lib=None, golden=None, timeout=60, quiet=False):
    """Assemble a desk, copy it into its mount and |commit; the revision.

    The desk is checked against the repo first: when they already match
    there's nothing to commit.  Files on the desk that the repo doesn't
    have are deleted through Clay first, since a |commit deletes only
    the files vere has seen in the mount, and vere forgets them when
    the ship restarts.  Then the commit runs in a thread that waits for
    the new revision, or for Clay's error.
    """
    started = time.time()
    a = assemble(desk, lib=lib, golden=golden)
    ship.require()
    mount = ensure_desk(ship, desk, quiet=quiet)
    rev, problems, extra = verify(ship, desk, a.files)
    done = []
    if extra:
        rev = delete_and_wait(ship, desk, extra, timeout)
        done.append('deleted %d from the desk in revision %d'
                    % (len(extra), rev))
    added, changed, deleted = mirror(mount, a.files)
    if len(problems) > len(extra):
        rev = commit_and_wait(ship, desk, timeout)
        done.append('committed revision %d' % rev)
    if done:
        rev, problems, _ = verify(ship, desk, a.files)
        if problems:
            raise Fail('%s: after |commit, at revision %d, the desk still '
                       "doesn't match the repo:\n  %s"
                       % (desk, rev, '\n  '.join(problems[:20])))
        what = '; '.join(done)
    else:
        what = 'nothing to commit: already at revision %d' % rev
    if not quiet:
        say('%s: %d files; copied +%d ~%d -%d; %s; the desk matches the '
            'repo (%.1fs)' % (desk, len(a.files), len(added), len(changed),
                              len(deleted), what, time.time() - started))
    return rev


def commit_and_wait(ship, desk, timeout):
    """|commit, and wait for the new revision; raise Clay's error."""
    return change_and_wait(ship, desk, fill(COMMIT_ACT, DESK=desk), 'into',
                           'the commit', timeout)


def delete_and_wait(ship, desk, paths, timeout):
    """Delete files from the desk ('/a/b/hoon') through Clay, and wait
    for the new revision; raise Clay's error."""
    act = fill(DELETE_ACT, DESK=desk, PATHS='~[%s]' % ' '.join(
        hoon_path(p.split('/')[1:]) for p in paths))
    return change_and_wait(ship, desk, act, 'info',
                           'the deletion of %d files' % len(paths), timeout)


def change_and_wait(ship, desk, act, mote, what, timeout):
    """Change the desk with act, a CHANGE_WAIT action whose rejection
    Clay names %mote, and wait for the new revision; raise Clay's error.
    what names the change in errors."""
    noun = ship.thread(fill(CHANGE_WAIT, ACT=act, MOTE=mote, DESK=desk,
                            SECS=hoon_ud(timeout)),
                       timeout=timeout + 60)
    kind, val = noun
    kind = text(kind)
    if kind == 'done':
        return val
    if kind == 'crud':
        mote, tang = val
        raise Fail('%s: Clay rejected %s: %%%s\n  %s' % (
            desk, what, text(mote), '\n  '.join(tang_lines(tang))))
    raise Fail('%s: %s changed nothing in %ds' % (desk, what, timeout))


# ---------------------------------------------------------------- scry


def parse_scry(spec, care=None):
    """A scry path as dojo writes it, /cx/=my-app=/ui/about/jibb, into
    (care, Hoon for the path).  = stands for our, the desk %base and
    now, in the first three places after the care."""
    segs = spec.split('/')
    if not spec.startswith('/'):
        raise Unable('a scry path starts with /: %s' % spec)
    segs = segs[1:]
    if care is None:
        if not segs or not re.match(r'^[a-z]{2}$', segs[0]):
            raise Unable('a scry path starts with the vane and care, as '
                         '/cx/=my-app=/desk/bill: %s' % spec)
        care, segs = segs[0], segs[1:]
    #  =desk= is three segments: our, desk, now
    out = []
    if segs and segs[0].startswith('=') and segs[0].endswith('=') and \
            len(segs[0]) > 2:
        segs = ['=', segs[0][1:-1], '='] + segs[1:]
    defaults = ['(scot %p our.bowl)', '%base', '(scot %da now)']
    for i, s in enumerate(segs):
        if i < 3 and s in ('=', ''):
            out.append('[%s]' % defaults[i])
        elif s == '':
            continue    # a trailing or doubled /
        elif TERM.match(s):
            out.append(s)
        elif KNOT.match(s):
            out.append('[~.%s]' % s)
        else:
            out.append('[%s]' % hoon_cord(s.encode()))
    return care, '/' + '/'.join(out)


#  now is the time the path's = stands for: the ship's now, or for the
#  later parts of a big --raw read, the time of the first.
SCRY = r"""
=/  m  (strand ,vase)
;<  =bowl:spider  bind:m  get-bowl
=/  now=@da  @@NOW@@
=/  val  .^(@@TYPE@@ %@@CARE@@ @@PATH@@)
@@RESULT@@
"""

#  --raw: [%atom size now part], part being @@SIZE@@ bytes from
#  @@OFFSET@@ on, or [%cell ~].
SCRY_RAW = r"""
=/  raw=*  val
?^  raw  (pure:m !>([%cell ~]))
(pure:m !>([%atom (met 3 raw) now (cut 3 [@@OFFSET@@ @@SIZE@@] raw)]))
"""

SCRY_PRINT = FIT + r"""
(pure:m !>((fit (turn (wash [0 @@WIDTH@@] (sell !>(val))) crip))))
"""


def cmd_scry(ship, args):
    ship.require()
    care, pax = parse_scry(args.path)
    if not args.raw:
        noun = ship.thread(fill(SCRY, TYPE=args.type, CARE=care, PATH=pax,
                                NOW='now.bowl', RESULT=fill(
                                    SCRY_PRINT, WIDTH=hoon_ud(args.width))))
        for line in items(noun):
            say(text(line))
        return
    #  an atom comes in parts, all read at the time of the first
    now, offset, parts, size = 'now.bowl', 0, [], None
    while size is None or offset < size:
        noun = ship.thread(fill(SCRY, TYPE=args.type, CARE=care, PATH=pax,
                                NOW=now, RESULT=fill(
                                    SCRY_RAW, OFFSET=hoon_ud(offset),
                                    SIZE=hoon_ud(REPLY_BYTES))))
        if text(noun[0]) != 'atom':
            raise Fail('the result is a cell, not an atom; drop --raw')
        size, (da, part) = noun[1]
        now = '`@da``@`%s' % hoon_ud(da)
        want = min(REPLY_BYTES, size - offset)
        parts.append(atom_bytes(part).ljust(want, b'\0'))
        offset += want
    sys.stdout.buffer.write(b''.join(parts))
    sys.stdout.flush()


