# ---------------------------------------------------------------- test

TEST_LINE = re.compile(r'^(OK|FAILED|CRASHED|built) +(/\S*)')


def settle(ship, offset, quiet=0.5, limit=5.0):
    """Wait for the log to stop growing, so a thread's output is in."""
    deadline = time.time() + limit
    size = ship.log_size()
    while time.time() < deadline:
        time.sleep(quiet)
        now = ship.log_size()
        if now == size:
            break
        size = now
    return [l for l in ship.log_since(offset) if l.strip() and not NOISE.match(l)]


def cmd_test(ship, args):
    ship.require()
    lib = STUB if args.stub else args.lib
    golden = args.golden or GOLDEN
    started = time.time()
    if args.golden is None:
        content = generate_tests(golden)
        try:
            with open(TESTS_LIB, encoding='utf-8') as f:
                stale = f.read() != content
        except FileNotFoundError:
            stale = True
        if stale:
            os.makedirs(os.path.dirname(TESTS_LIB), exist_ok=True)
            with open(TESTS_LIB, 'w', encoding='utf-8') as f:
                f.write(content)
            say('updated %s from %s' % (show(TESTS_LIB), show(golden)))
    for _name, folder in golden_cases(golden):
        for fn in ('tokens.txt', 'tree.txt', 'types.txt'):
            data = _read(os.path.join(folder, fn))
            if data and not data.endswith(b'\n'):
                warn("%s has no final newline: the ship can't see that (the "
                     "%%txt mark keeps only lines, and vere's +to-wain jet "
                     "drops a final newline), but tools/golden fails it"
                     % show(os.path.join(folder, fn)))
    if not args.no_sync:
        sync(ship, 'jibb-dev', lib=lib, golden=golden, timeout=args.timeout)
    synced = time.time()
    offset = ship.log_size()
    flag, rest = ship.thread(fill(RUN_TEST, DESK='jibb-dev'),
                             timeout=args.timeout)
    lines = settle(ship, offset)
    for line in lines:
        say(line)
    counts = {'OK': 0, 'FAILED': 0, 'CRASHED': 0}
    for line in lines:
        m = TEST_LINE.match(line)
        if m and m.group(1) in counts and '/test-' in m.group(2):
            counts[m.group(1)] += 1
    built_failed = any(re.match(r'^FAILED +\S+ \(build\)', l) for l in lines)
    took = 'sync %.1fs, -test %.1fs' % (synced - started, time.time() - synced)
    if flag != 0:
        mote, tang = rest
        say('-test itself failed: %%%s' % text(mote))
        for line in tang_lines(tang):
            say('  ' + line)
        say('FAIL (%s)' % took)
        return 1
    ok = rest == 0
    summary = '%d OK, %d FAILED, %d CRASHED' % (
        counts['OK'], counts['FAILED'], counts['CRASHED'])
    if built_failed:
        summary += '; a test file failed to build'
    say('%s: %s (%s)' % ('PASS' if ok else 'FAIL', summary, took))
    return 0 if ok else 1


