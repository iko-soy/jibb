;<  =bowl:spider  bind:m  get-bowl
=/  arg  [%@@DESK@@ our.bowl %@@FROM@@ da+now.bowl %@@GERM@@]
;<  ~  bind:m  (poke-our %hood %kiln-merge !>(arg))
(pure:m !>(~))
"""

#  A page of the desk's manifest, for comparing it with the repo: the
#  revision; whether +to-wain ends the last line at a final newline, as
#  vere's jet does, or gives an empty line after it, as the Hoon does;
#  how many files the desk has; for each file sent with its content,
#  whether the desk's mark, converting that content from %mime, gives
#  the stored value; and for the files @@FROM@@ to @@FROM@@ + @@COUNT@@,
#  the path with [%cord hash] for a cord, [%wain hash] for a %txt file's
#  lines, each with a newline after it, or [%other 0].  A hash is the
#  first 8 bytes of the sha-256.  now is fixed across pages.
MANIFEST = r"""
=/  m  (strand ,vase)
;<  =bowl:spider  bind:m  get-bowl
=/  now=@da  @@NOW@@
=/  pre=path  /(scot %p our.bowl)/@@DESK@@/(scot %da now)
=/  all=(list path)  .^((list path) %ct pre)
=/  conv=(list [path ?])
  %+  turn  `(list [path @t])`@@CONV@@
  |=  [pax=path c=@t]
  ?.  .^(? %cu (weld pre pax))  [pax |]
  =/  have  .^(* %cx (weld pre pax))
  =/  tub  .^(tube:clay %cc (weld pre /mime/[(rear pax)]))
  =/  res  (mule |.((tub !>([/text/plain (as-octs:mimes:html c)]))))
  [pax &(?=(%& -.res) =(q.p.res have))]
=/  page=(list [path @tas @])
  %+  turn  (swag [@@FROM@@ @@COUNT@@] all)
  |=  pax=path
  =/  have  .^(* %cx (weld pre pax))
  :-  pax
  ?@  have  [%cord (end [3 8] (shax have))]
  ?.  =(%txt (rear pax))  [%other 0]
  :-  %wain
  (end [3 8] (shax (rap 3 (turn ;;(wain have) |=(l=@t (cat 3 l '\0a'))))))
=/  jet=?  =(1 (lent (to-wain:format 'a\0a')))
(pure:m !>([ud:.^(cass:clay %cw pre) now jet (lent all) conv page]))
"""

#  -test /=@@DESK@@=/tests, through the %test thread on %base.
RUN_TEST = r"""
=/  m  (strand ,vase)
;<  =bowl:spider  bind:m  get-bowl
=/  pax=path  /(scot %p our.bowl)/@@DESK@@/(scot %da now.bowl)/tests
;<  res=thread-result  bind:m  (await-thread %test !>([~ pax]))
?-  -.res
  %&  (pure:m !>([%& ;;(? q.p.res)]))
  %|  (pure:m !>([%| p.res]))
==
"""

def hoon_ud(n):
    """A number as a Hoon @ud literal: 150.000."""
    return '{:,}'.format(n).replace(',', '.')


#  +fit: printed lines, cut to what a reply can carry (see REPLY_BYTES).
FIT = r"""
=/  fit
  |=  lines=(list @t)
  =|  [n=@ud out=(list @t)]
  |-  ^-  (list @t)
  ?~  lines  (flop out)
  =.  n  (add n +((met 3 i.lines)))
  ?:  (gth n @@BYTES@@)
    %-  flop
    :_  out
    (crip "... and {(a-co:co (lent lines))} more lines, cut to fit the reply")
  $(lines t.lines, out [i.lines out])
""".replace('@@BYTES@@', hoon_ud(REPLY_BYTES))

#  A Hoon expression, evaluated as dojo would with our, now and eny,
#  printed as dojo prints it.
EXPR = r"""
=/  m  (strand ,vase)
;<  =bowl:spider  bind:m  get-bowl
=/  our  our.bowl
=/  now  now.bowl
=/  eny  eny.bowl
=/  vax=vase
  !>
  @@EXPR@@
""" + FIT + r"""
(pure:m !>((fit (turn (wash [0 @@WIDTH@@] (sell vax)) crip))))
"""

#  A strand's result vase, printed as dojo prints it.
RUN_FILE = r"""
=/  m  (strand ,vase)
;<  vax=vase  bind:m
  @@THREAD@@
""" + FIT + r"""
(pure:m !>((fit (turn (wash [0 @@WIDTH@@] (sell vax)) crip))))
"""

#  A poke, as dojo's :agent &mark value.
POKE = r"""
=/  m  (strand ,vase)
;<  =bowl:spider  bind:m  get-bowl
=/  our  our.bowl
=/  now  now.bowl
;<  ~  bind:m  (poke-our %@@AGENT@@ %@@MARK@@ !>(@@VALUE@@))
(pure:m !>(~))
"""


def fill(template, **kw):
    out = template
    for k, v in kw.items():
        out = out.replace('@@%s@@' % k, v)
    left = re.findall(r'@@[A-Z]+@@', out)
    if left:
        raise RuntimeError('unfilled template slots: %s' % left)
    return out


def desk_term(name):
    if not TERM.match(name):
        raise Unable('%s is not a desk name: desks are terms, lowercase '
                     'letters, digits and hyphens, starting with a letter'
                     % name)
    return name


# ---------------------------------------------------------------- desks


def clay_path(rel):
    """A desk file's Clay path from its Unix path: mar/txt.hoon is
    /mar/txt/hoon."""
    segs = rel.split('/')
    name, ext = segs[-1].rsplit('.', 1)
    return segs[:-1] + [name, ext]


def unix_problem(rel):
    """Why vere would leave this file out of the desk, or None."""
    segs = rel.split('/')
    name = segs[-1]
    if '.' not in name or name.endswith('.'):
        return 'it has no extension, so no mark'
    if name.endswith('~'):
        return 'it ends in ~'
    for s in segs:
        if not KNOT.match(s):
            return ('%r is not a knot: Clay paths are lowercase letters, '
                    'digits and - . ~ _' % s)
    return None


def mark_exists(files, mark):
    """Whether the desk has a mark: Clay looks for mark a-b-c at
    /mar/a-b-c.hoon, then /mar/a/b-c.hoon, and so on."""
    parts = mark.split('-')
    for i in range(len(parts)):
        rel = '/'.join(['mar'] + parts[:i] + ['-'.join(parts[i:])]) + '.hoon'
        if rel in files:
            return True
    return False


class Assembly:
    """A desk's files: desk-relative Unix path -> (bytes, where from)."""

    def __init__(self, desk):
        self.desk = desk
        self.files = {}

    def add(self, rel, data, src):
        old = self.files.get(rel)
        if old is not None and old[0] != data:
            raise Unable('%s/%s comes from both %s and %s, which differ'
                         % (self.desk, rel, old[1], src))
        self.files[rel] = (data, src)

    def replace(self, rel, data, src):
        self.files[rel] = (data, src)

    def add_tree(self, folder, into, skip=(), drop=None):
        if not os.path.isdir(folder):
            raise Unable('no folder %s' % show(folder))
        for dirpath, dirnames, filenames in os.walk(folder):
            rel_dir = os.path.relpath(dirpath, folder)
            rel_dir = '' if rel_dir == '.' else rel_dir
            dirnames[:] = sorted(
                d for d in dirnames if not d.startswith('.')
                and os.path.join(rel_dir, d) not in skip)
            for fn in sorted(filenames):
                if fn.startswith('.'):
                    continue
                rel = os.path.join(rel_dir, fn)
                if drop and drop(rel):
                    continue
                desk_rel = os.path.join(into, rel) if into else rel
                with open(os.path.join(dirpath, fn), 'rb') as f:
                    self.add(desk_rel, f.read(), show(os.path.join(dirpath, fn)))


def show(path):
    path = os.path.abspath(path)
    rel = os.path.relpath(path, ROOT)
    return path if rel.startswith('..') else rel


def assemble(desk, lib=None, golden=None):
    """The files of one of the repo's desks, checked as vere and Clay
    will see them.  lib replaces /lib/jibb.hoon; golden, for the
    jibb-dev test desk, is the folder of golden cases. When either is
    overridden, exclude other /tests/lib programs so they don't run
    against an unrelated library or pollute the custom case results."""
    if desk not in DESKS:
        raise Unable('no desk %s here; the repo builds %s'
                     % (desk, ', '.join(sorted(DESKS))))
    #  Override runs are harness tests, not tests of the repository's
    #  importer, checker, or other test files against the replacement lib.
    isolated = (lib is not None or
                (golden is not None and
                 os.path.abspath(golden) != os.path.abspath(GOLDEN)))
    a = Assembly(desk)
    vendor = os.path.join(ROOT, 'vendor')
    for pkg in sorted(os.listdir(vendor)):
        if os.path.isdir(os.path.join(vendor, pkg)) and not pkg.startswith('.'):
            a.add_tree(os.path.join(vendor, pkg), '')
    for folder, into, skip in DESKS[desk]:
        if folder == 'tests':
            golden = golden or GOLDEN
            if os.path.isdir(os.path.join(ROOT, 'tests')):
                a.add_tree(os.path.join(ROOT, 'tests'), 'tests',
                           skip=['golden'], drop=lambda rel:
                           rel == os.path.join('lib', 'jibb.hoon') or
                           (isolated and rel.startswith('lib' + os.sep) and
                            rel.endswith('.hoon')))
            if os.path.isdir(golden):
                a.add_tree(golden, os.path.join('tests', 'golden'))
            a.add(os.path.join('tests', 'lib', 'jibb.hoon'),
                  generate_tests(golden).encode(),
                  'tools/ship gen-tests --golden %s' % show(golden))
        else:
            a.add_tree(os.path.join(ROOT, folder), into, skip=skip)
    for rel, src in EXTRA.get(desk, {}).items():
        with open(os.path.join(ROOT, src), 'rb') as f:
            a.add(rel, f.read(), src)
    if lib is not None:
        if 'lib/jibb.hoon' not in a.files:
            raise Unable('desk %s has no lib/jibb.hoon to replace' % desk)
        with open(lib, 'rb') as f:
            a.replace('lib/jibb.hoon', f.read(), show(lib))
    check_assembly(a)
    return a


def check_assembly(a):
    problems = []
    for rel in sorted(a.files):
        why = unix_problem(rel)
        if why is None and not mark_exists(a.files, rel.rsplit('.', 1)[1]):
            why = 'the desk has no mark for .%s files' % rel.rsplit('.', 1)[1]
        if why is None:
            continue
        if rel.startswith('tests/golden/'):
            warn('leaving %s out of %s: %s' % (a.files[rel][1], a.desk, why))
            del a.files[rel]
        else:
            problems.append('%s (%s): %s' % (rel, a.files[rel][1], why))
    if 'sys.kelvin' not in a.files:
        problems.append('no sys.kelvin: Clay refuses a commit without one')
    if problems:
        raise Unable('desk %s would not commit as it is:\n  %s'
                     % (a.desk, '\n  '.join(problems)))


