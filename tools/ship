def wait_until(what, test, timeout):
    deadline = time.time() + timeout
    while True:
        result = test()
        if result:
            return result
        if time.time() > deadline:
            raise Fail('timed out waiting for %s' % what)
        time.sleep(0.4)


def reset_desk(ship, desk, files=None, marks_from=None):
    """Overwrite a desk with what |new-desk gives, the marks of another
    desk if asked, and these files ({rel: bytes}, all %jibb)."""
    pages = ' '.join('[%s %%jibb %s]' % (hoon_path(clay_path(rel)),
                                         hoon_cord(data))
                     for rel, data in sorted((files or {}).items()))
    ship.thread(fill(
        RESET_DESK, DESK=desk, FROM=marks_from or 'base',
        MARKS='.^((list path) %ct (weld src /mar))' if marks_from else '~',
        FILES='~[%s]' % pages if pages else '~'))


def merge_and_wait(ship, desk, source, germ, timeout):
    """|merge %desk our %source, =gem %germ, and wait for kiln to say
    how it went: (merged, the lines the ship printed)."""
    offset = ship.log_size()
    ship.thread(fill(MERGE, DESK=desk, FROM=source, GERM=germ))
    said = wait_until('kiln to finish |merge %%%s our %%%s' % (desk, source),
                      lambda: [l for l in ship.log_since(offset)
                               if KILN_SAID.match(l)], timeout)
    return said[0].startswith('merged with'), settle(ship, offset)


def change_line(data, n, new):
    lines = data.split(b'\n')
    lines[n - 1] = new
    return b'\n'.join(lines)


def commit_edit(ship, desk, rel, data, timeout):
    """Write a file into a desk's mount and |commit it; wait for it."""
    mount = os.path.join(ship.pier, desk)
    path = os.path.join(mount, rel)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'wb') as f:
        f.write(data)
    commit_and_wait(ship, desk, timeout)
    got = read_files(ship, desk, [rel])[rel]
    if got != data:
        raise Fail('%s: after |commit, /%s reads back as %r' % (desk, rel, got))


def without_final_newline(data):
    return data[:-1] if data.endswith(b'\n') else data


def cmd_check_commit(ship, args):
    ship.require()
    results = []
    started = time.time()

    def check(name, fn):
        t0 = time.time()
        try:
            notes = fn() or []
            ok = True
        except Fail as e:
            notes = str(e).split('\n')
            ok = False
        results.append((name, ok))
        say('%s  %s (%.1fs)' % ('PASS' if ok else 'FAIL', name, time.time() - t0))
        for note in notes:
            say('      ' + note)

    a = assemble('my-app')
    ui = sorted(rel for rel in a.files
                if rel.startswith('ui/') and rel.endswith('.jibb'))

    def synced():
        rev = sync(ship, 'my-app', timeout=args.timeout, quiet=True)
        return ['my-app is at revision %d with the repo\'s %d files, %d of '
                'them under /ui' % (rev, len(a.files), len(ui))]

    def byte_for_byte():
        got = read_files(ship, 'my-app', ui)
        notes, bad = [], []
        for rel in ui:
            want = a.files[rel][0]
            if got[rel] is None:
                bad.append('/%s is not on the desk' % rel)
            elif got[rel] != want:
                bad.append('/%s: %d bytes on the desk, %d in %s'
                           % (rel, len(got[rel]), len(want), a.files[rel][1]))
            else:
                notes.append('%s: %d bytes, identical' % (
                    '/' + '/'.join(clay_path(rel)), len(want)))
        if bad:
            raise Fail('\n'.join(bad))
        return notes

    def conversions():
        jet, res = ship.thread(fill(CONVERT, DESK='my-app',
                                    PATHS=paths_hoon(ui)))
        jet = jet == 0
        bad, lost = [], 0
        for rel, res in zip(ui, items(res)):
            want = a.files[rel][0]
            _p, (mite, (size, (octs, (joined, (count, (bam, bat)))))) = res
            lines = txt_lines(want, jet)
            back = b'\n'.join(lines)
            name = '/' + rel
            if path_text(mite) != '/text/x-jibb':
                bad.append('%s: to %%mime gives the type %s'
                           % (name, path_text(mite)))
            if size != len(want) or atom_bytes(octs) != want:
                bad.append('%s: to %%mime changes the bytes' % name)
            if atom_bytes(bam) != want:
                bad.append('%s: %%mime back to %%jibb changes it' % name)
            if count != len(lines) or atom_bytes(joined) != back:
                bad.append('%s: to %%txt gives %d lines, not the file\'s %d'
                           % (name, count, len(lines)))
            if atom_bytes(bat) != back:
                bad.append('%s: %%txt back to %%jibb gives something else '
                           'than the lines joined' % name)
            lost += back != want
        if bad:
            raise Fail('\n'.join(bad))
        notes = ['%d files: to %%mime (/text/x-jibb) and back unchanged; to '
                 '%%txt, one cord per line, and back' % len(ui)]
        if lost:
            notes.append(
                'but: %%txt keeps no final newline, so %d of the %d files '
                'come back from %%txt without theirs.  The mark is right; '
                "vere's +to-wain jet ends the last line at a final newline, "
                'where the Hoon in zuse gives an empty line after it.  %%hoon '
                'files do the same.' % (lost, len(ui)))
        return notes

    def half_written():
        mount = ensure_desk(ship, 'my-app', quiet=True)
        rels = sorted(HALF_WRITTEN)
        notes = []
        try:
            for rel in rels:
                path = os.path.join(mount, rel)
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, 'wb') as f:
                    f.write(HALF_WRITTEN[rel])
            rev = commit_and_wait(ship, 'my-app', args.timeout)
            got = read_files(ship, 'my-app', rels)
            notes.append('|commit made revision %d' % rev)
            for rel in rels:
                if got[rel] != HALF_WRITTEN[rel]:
                    raise Fail('/%s committed, but reads back as %r'
                               % (rel, got[rel]))
                notes.append('/%s committed and reads back the same: %r'
                             % (rel, HALF_WRITTEN[rel][-24:]))
        finally:
            shutil.rmtree(os.path.join(mount, 'ui', 'check-commit'),
                          ignore_errors=True)
            rev = commit_and_wait(ship, 'my-app', args.timeout)
        left = [r for r, v in read_files(ship, 'my-app', rels).items()
                if v is not None]
        if left:
            raise Fail('deleting them and |commit left %s' % ', '.join(left))
        notes.append('deleted them again: |commit made revision %d' % rev)
        return notes

    def merges_by_line():
        rel = 'ui/merge.jibb'
        base = MERGE_BASE
        ours = change_line(base, 5, b'+$ model [todos=(list item.todo) '
                           b'draft=@t error=(unit @t) note=@t]')
        theirs = change_line(base, 9, b'  [%toggled id=@ud on=?]')
        merged = change_line(ours, 9, b'  [%toggled id=@ud on=?]')
        notes = []
        prepare_pair(ship, rel, base, args.timeout)
        commit_edit(ship, CHECK_OURS, rel, ours, args.timeout)
        commit_edit(ship, CHECK_THEIRS, rel, theirs, args.timeout)
        notes.append('%%%s changed line 5 and %%%s line 9 of /%s, each with '
                     '|commit' % (CHECK_OURS, CHECK_THEIRS, rel))
        cmd = '|merge %%%s our %%%s' % (CHECK_OURS, CHECK_THEIRS)
        ok, said = merge_and_wait(ship, CHECK_OURS, CHECK_THEIRS, 'auto',
                                  args.timeout)
        if not ok:
            if not any('auto merge failed on strategy %fine' in l
                       for l in said):
                raise Fail('%s failed:\n  %s' % (cmd, '\n  '.join(said[:20])))
            notes.append(
                "but: %s, with kiln's default =gem %%auto, stops at "
                '"auto merge failed on strategy %%fine": kiln goes on to '
                '%%meet only on a %%bad-fine-merge error, and this Clay '
                'reports %%merge-failed' % cmd)
            cmd += ', =gem %mate'
            ok, said = merge_and_wait(ship, CHECK_OURS, CHECK_THEIRS, 'mate',
                                      args.timeout)
            if not ok:
                raise Fail('%s failed:\n  %s' % (cmd, '\n  '.join(said[:20])))
        got = read_files(ship, CHECK_OURS, [rel])[rel]
        if got == merged:
            notes.append('%s: both changes, byte for byte' % cmd)
        elif got == without_final_newline(merged):
            notes.append('%s: both changes, line for line' % cmd)
            notes.append(
                'but: the merged file has lost its final newline: Clay '
                'merges through %txt (grad %txt), which keeps none; see '
                'the %txt note above')
        else:
            raise Fail('%s did not give both changes; /%s is now:\n%s'
                       % (cmd, rel, got))
        return notes + ['the ship said: ' + l for l in said
                        if KILN_SAID.match(l)]

    def conflicts_by_line():
        rel = 'ui/merge.jibb'
        base = MERGE_BASE
        ours = change_line(base, 7, b'  [%typed text=@t at=@da]')
        theirs = change_line(base, 7, b'  [%typed words=@t]')
        prepare_pair(ship, rel, base, args.timeout)
        commit_edit(ship, CHECK_OURS, rel, ours, args.timeout)
        commit_edit(ship, CHECK_THEIRS, rel, theirs, args.timeout)
        ok, said = merge_and_wait(ship, CHECK_OURS, CHECK_THEIRS, 'mate',
                                  args.timeout)
        got = read_files(ship, CHECK_OURS, [rel])[rel]
        if ok or got != ours or not any('mate-conflict' in l for l in said):
            raise Fail('a %%mate merge of two changes to line 7 should fail '
                       'with a conflict and leave %%%s alone; the ship said:'
                       '\n  %s' % (CHECK_OURS, '\n  '.join(said[:20])))
        return ['both desks changed line 7: |merge %%%s our %%%s, =gem %%mate '
                'fails and leaves the file alone' % (CHECK_OURS, CHECK_THEIRS)] \
            + ['the ship said: ' + l for l in said
               if KILN_SAID.match(l) or l == 'mate-conflict']

    def clean_up():
        mounts, revs = desks_info(ship)
        for desk in (CHECK_OURS, CHECK_THEIRS):
            if desk in revs:
                reset_desk(ship, desk)
            if desk in mounts:
                ship.thread(fill(UNMOUNT, DESK=desk))
        rev = sync(ship, 'my-app', timeout=args.timeout, quiet=True)
        return ['%%%s and %%%s hold only what |new-desk gives and are '
                'unmounted (Clay keeps desks); my-app matches the repo at '
                'revision %d' % (CHECK_OURS, CHECK_THEIRS, rev)]

    check('sync my-app: |commit copies the repo onto the desk', synced)
    check('every /ui .jibb file reads back with %cx byte for byte',
          byte_for_byte)
    check('%jibb converts to %mime and back, and to %txt and back',
          conversions)
    check('half-written .jibb files still commit', half_written)
    check('a three-way merge of a .jibb file merges by line', merges_by_line)
    check('changes to the same line conflict', conflicts_by_line)
    check('clean up', clean_up)
    failed = [n for n, ok in results if not ok]
    say('%s: %d of %d checks passed (%.1fs)' % (
        'FAIL' if failed else 'PASS', len(results) - len(failed),
        len(results), time.time() - started))
    return 1 if failed else 0


def prepare_pair(ship, rel, base, timeout):
    """Reset the merge checks' desks: ours holds my-app's marks and the
    file, in a commit without parents; theirs takes it with a merge, so
    that ours's commit is the base of the next merge between them."""
    _mounts, revs = desks_info(ship)
    reset_desk(ship, CHECK_OURS, {rel: base}, marks_from='my-app')
    germ = 'only-that' if revs.get(CHECK_THEIRS) else 'init'
    ok, said = merge_and_wait(ship, CHECK_THEIRS, CHECK_OURS, germ, timeout)
    if not ok or read_files(ship, CHECK_THEIRS, [rel])[rel] != base:
        raise Fail('|merge %%%s our %%%s, =gem %%%s did not give it the file:'
                   '\n  %s' % (CHECK_THEIRS, CHECK_OURS, germ,
                               '\n  '.join(said[:20])))
    for desk in (CHECK_OURS, CHECK_THEIRS):
        mount = ensure_desk(ship, desk, quiet=True)
        wait_until('the mount of %s to hold the file' % desk,
                   lambda: _read(os.path.join(mount, rel)) == base, timeout)


def _read(path):
    try:
        with open(path, 'rb') as f:
            return f.read()
    except OSError:
        return None


# ---------------------------------------------------------------- main

EPILOG = """\
desks:
  my-app    vendor/* + jibb-dev (without any tests/) + my-app
  jibb      vendor/* + jibb
  jibb-dev  vendor/* + jibb-dev + tests, the test desk: tests/golden from
            --golden, tests/lib/jibb.hoon generated from it, and sys.kelvin
            from jibb/
A sync creates the desk if it's missing (as |new-desk does), mounts it at
<pier>/<desk>, makes the mount hold exactly the desk's files, runs
|commit, and waits until the desk matches the repo, checking every file.

Exit status: 0 on success, 1 when something failed, 2 when the command
couldn't run.  status exits 3 when the ship isn't running.
"""


def main(argv):
    ap = argparse.ArgumentParser(
        prog='tools/ship', description=__doc__.split('\n\n')[0],
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--pier', default=PIER,
                    help='the pier (default %(default)s, or $JIBB_PIER)')
    ap.add_argument('--log', default=os.environ.get('JIBB_SHIP_LOG'),
                    help="the ship's log (default <pier>.log, or $JIBB_SHIP_LOG)")
    ap.add_argument('--click', default=CLICK,
                    help='click (default %(default)s, or $JIBB_CLICK)')
    sub = ap.add_subparsers(dest='command', metavar='command')
    sub.required = True

    p = sub.add_parser('start', help='start the ship in the background')
    p.add_argument('--timeout', type=int, default=600)
    p = sub.add_parser('stop', help='stop the ship')
    p.add_argument('--timeout', type=int, default=120)
    p.add_argument('--force', action='store_true',
                   help='kill it if it does not stop in time')
    sub.add_parser('status', help='whether it runs; its desks and mounts')
    p = sub.add_parser('log', help="the end of the ship's log")
    p.add_argument('-n', '--lines', type=int, default=40)
    p.add_argument('--all', action='store_true',
                   help="keep docket's and kiln's network noise")

    p = sub.add_parser('sync', help='assemble desks from their folders and '
                       '|commit them')
    p.add_argument('desks', nargs='+', metavar='desk')
    g = p.add_mutually_exclusive_group()
    g.add_argument('--stub', action='store_true',
                   help='use tools/testdata/ship-stub.hoon as /lib/jibb.hoon')
    g.add_argument('--lib', help='use this file as /lib/jibb.hoon')
    p.add_argument('--golden', help='the golden cases for the jibb-dev desk '
                   '(default tests/golden)')
    p.add_argument('--timeout', type=int, default=120,
                   help='seconds to wait for the commit')

    p = sub.add_parser('test', help='sync the jibb-dev desk and run -test '
                       'on its /tests')
    g = p.add_mutually_exclusive_group()
    g.add_argument('--stub', action='store_true',
                   help='use tools/testdata/ship-stub.hoon as /lib/jibb.hoon')
    g.add_argument('--lib', help='use this file as /lib/jibb.hoon')
    p.add_argument('--golden', help='test these golden cases instead of '
                   'tests/golden (and leave tests/lib/jibb.hoon alone)')
    p.add_argument('--no-sync', action='store_true',
                   help='run -test on the desk as it is')
    p.add_argument('--timeout', type=int, default=3600)

    p = sub.add_parser('gen-tests', help='write tests/lib/jibb.hoon from '
                       'the golden cases')
    p.add_argument('--golden', help='the cases (default tests/golden)')
    p.add_argument('--out', help='the file (default tests/lib/jibb.hoon)')
    p.add_argument('--check', action='store_true',
                   help="don't write; exit 1 if the file is out of date")

    p = sub.add_parser('check-commit', help='prove that |commit stores '
                       '.jibb files, and leave the desks clean')
    p.add_argument('--timeout', type=int, default=120)

    p = sub.add_parser('scry', help='scry, as /cx/=my-app=/ui/about/jibb')
    p.add_argument('path')
    p.add_argument('--type', default='*', help='the mold (default *)')
    p.add_argument('--raw', action='store_true',
                   help="write an atom's bytes, as a file's")
    p.add_argument('--width', type=int, default=100)

    p = sub.add_parser('hoon', help='evaluate a Hoon expression, with our, '
                       'now and eny')
    p.add_argument('expr', nargs='?')
    p.add_argument('-f', '--file', help='read the expression from a file')
    p.add_argument('--width', type=int, default=100)

    p = sub.add_parser('run', help='run a thread: a file holding a strand')
    p.add_argument('file')
    p.add_argument('--timeout', type=int, default=600)
    p.add_argument('--width', type=int, default=100)

    p = sub.add_parser('poke', help="poke an agent, as dojo's :agent &mark "
                       'value')
    p.add_argument('agent')
    p.add_argument('mark')
    p.add_argument('value')

    p = sub.add_parser('commit', help='|commit a desk, and wait for the '
                       'new revision or the error')
    p.add_argument('desk')
    p.add_argument('--timeout', type=int, default=10)
    for name, what in (('mount', '|mount a desk, creating it if missing'),
                       ('unmount', '|unmount a desk')):
        p = sub.add_parser(name, help=what)
        p.add_argument('desk')

    args = ap.parse_args(argv)
    ship = Ship(args.pier, args.log, args.click)
    handlers = {
        'start': lambda: ship.start(args.timeout),
        'stop': lambda: ship.stop(args.timeout, args.force),
        'status': lambda: cmd_status(ship, args),
        'log': lambda: cmd_log(ship, args),
        'sync': lambda: cmd_sync(ship, args),
        'test': lambda: cmd_test(ship, args),
        'gen-tests': lambda: cmd_gen_tests(ship, args),
        'check-commit': lambda: cmd_check_commit(ship, args),
        'scry': lambda: cmd_scry(ship, args),
        'hoon': lambda: cmd_hoon(ship, args),
        'run': lambda: cmd_run(ship, args),
        'poke': lambda: cmd_poke(ship, args),
        'commit': lambda: cmd_commit(ship, args),
        'mount': lambda: cmd_mount(ship, args),
        'unmount': lambda: cmd_unmount(ship, args),
    }
    try:
        return handlers[args.command]() or 0
    except Fail as e:
        print('ship: %s' % e, file=sys.stderr)
        return 1
    except Unable as e:
        print('ship: %s' % e, file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
