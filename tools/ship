def paths_hoon(rels):
    return '~[%s]' % ' '.join(hoon_path(clay_path(r)) for r in rels) \
        if rels else '~'


def read_files(ship, desk, rels):
    """{rel: bytes or None} for files on a desk, read with %cx."""
    noun = ship.thread(fill(READ_FILES, DESK=desk, PATHS=paths_hoon(rels)))
    out = {}
    for rel, (_p, (flag, val)) in zip(rels, items(noun)):
        out[rel] = atom_bytes(val) if flag == 0 else None
