#!/usr/bin/env python3
"""Measure full-module checking of a generated chain, in both source orders."""
import argparse
from pathlib import Path
import shutil
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
EXPR = '=/  r  (infer-jibb-file-detailed /ui/perf/jibb src ~ ~ ~ ~[/ui/perf/jibb] ~ ~ ~ ~)  ?=(%& -.r)'


def run(label, args):
    start = time.monotonic()
    result = subprocess.run(args, cwd=ROOT, text=True, capture_output=True)
    elapsed = time.monotonic() - start
    if result.returncode or result.stdout.strip() != '%.y':
        print(f'{label}: failed after {elapsed:.3f} s ({result.returncode})\n{result.stdout}{result.stderr}', flush=True)
        return False
    print(f'{label}: {elapsed:.3f} s (including startup)', flush=True)
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--lines', type=int, default=2000)
    args = parser.parse_args()
    if args.lines < 1:
        parser.error('--lines must be positive')
    lines = ['++ value-0 0'] + [f'++ value-{n} value-{n-1}' for n in range(1, args.lines)]
    with tempfile.TemporaryDirectory(prefix='jibb-bench-') as directory:
        library = Path(directory) / 'jibb.hoon'
        shutil.copyfile(ROOT / 'jibb-dev/lib/jibb.hoon', library)
        base = [str(ROOT / 'tools/hoon'), '--lib', str(library), '--no-debug', '--timeout', '600']
        source = Path(directory) / 'module.jibb'
        ok = run('startup', base + ['%.y'])
        for label, ordered in [('bottom-up', lines), ('top-down', reversed(lines))]:
            source.write_text('\n'.join(ordered) + '\n', encoding='utf-8')
            ok = run(label, base + ['--cord', f'src={source}', EXPR]) and ok
        if not ok:
            raise SystemExit(1)


if __name__ == '__main__':
    main()
