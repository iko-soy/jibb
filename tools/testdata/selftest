def check_fast_failure_preserved(c, tmp):
    """A passing diagnostic replay must not erase a real first-run failure."""
    sys.path.insert(0, TOOLS)
    import urbit_eval as ue
    from noun import bytes_to_atom, from_list
    arms = SourceFileLoader('selftest_fast_arms', TEST_ARMS).load_module()
    goldens = SourceFileLoader('selftest_fast_goldens', GOLDEN).load_module()
    probes = SourceFileLoader('selftest_fast_probes', os.path.join(TOOLS, 'probe-regression')).load_module()
    suite = SimpleNamespace(name='sample')
    for first_lines in (['FAILED sample test-sample', '  original mismatch'], None):
        seen = []
        def eval_arm(prog, **kwargs):
            seen.append(prog.debug)
            result = ue.EvalResult()
            result.ok = prog.debug or first_lines is not None
            result.bail = 'exit'
            result.noun = from_list([bytes_to_atom(line.encode()) for line in
                                     (['OK sample test-sample'] if prog.debug else first_lines or [])])
            return result
        with patch.object(arms, 'program_for', lambda suites, lib, debug: SimpleNamespace(debug=debug)), \
                patch.object(arms.ue, 'run_eval', eval_arm):
            lines = arms.run_fast([suite], STUB, 10)
        c.expect(seen == [False, True] and any(line.startswith('FAILED sample') for line in lines),
                 'passing debug arm replay cleared failure: %r %r' % (seen, lines))

    # Feed canonical harness output through the real golden decoder/comparer.
    cases = copy_cases(tmp)
    for malformed in (False, True):
        seen = []
        case = goldens.Case('basic', os.path.join(cases, 'basic'))
        def eval_golden(prog, **kwargs):
            debug = prog.text().startswith('!:')
            seen.append(debug)
            result = ue.EvalResult()
            result.ok = True
            if malformed and not debug:
                result.noun = bytes_to_atom(b'not harness output')
                return result
            fields = [goldens.MAGIC, b'1', b'basic', b'ok',
                      read(os.path.join(case.folder, 'tokens.txt'))[:-1],
                      read(os.path.join(case.folder, 'tree.txt'))[:-1] if debug else b'fast-only mismatch',
                      b'', b'', b'']
            result.noun = bytes_to_atom(b''.join(str(len(field)).encode() + b':' + field + b','
                                                for field in fields))
            return result
        opts = SimpleNamespace(fast=True, jobs=1, timeout=10, save_program=None)
        error = None
        with patch.object(goldens.ue, 'run_eval', eval_golden):
            try:
                goldens.run_cases(STUB, [case], opts)
            except ue.ToolError as caught:
                error = str(caught)
        c.expect(seen == [False, True], 'golden replay did not switch debug mode: %r' % seen)
        if malformed:
            c.expect(error and 'fast failure retained' in error,
                     'passing debug replay cleared malformed initial output: %r' % error)
        else:
            ok, lines = goldens.compare(case)
            c.expect(not ok and 'fast-only mismatch' in '\n'.join(lines) and
                     'fast failure retained' in '\n'.join(lines),
                     'passing debug golden replay cleared mismatch: %r' % lines)

    sample = [('valid', '/ui/probe/jibb', '++ main 1\n')]
    for crashed in (False, True):
        seen = []
        def eval_probe(group, cases, debug=True):
            seen.append(debug)
            if debug:
                return [('valid', 0, '')]
            if crashed:
                raise ValueError('initial eval crash')
            return [('valid', 1, 'initial wrong rejection')]
        with patch.object(probes, 'eval_results', eval_probe):
            failures, error = probes.eval_group('p1', sample, fast=True)
        c.expect(seen == [False, True] and (failures or error) and
                 'fast failure retained' in str(error or failures),
                 'passing debug probe replay cleared failure: %r %r' % (failures, error))


def check_fast_resource_isolation(c, tmp):
    """Splitting a resource-limited batch retains the requested fast mode."""
    sys.path.insert(0, TOOLS)
    import urbit_eval as ue
    from noun import bytes_to_atom
    goldens = SourceFileLoader('selftest_split_goldens', GOLDEN).load_module()
    probes = SourceFileLoader('selftest_split_probes', os.path.join(TOOLS, 'probe-regression')).load_module()
    cases = goldens.find_cases(CASES, [])[:2]
    seen = []
    def eval_golden(prog, **kwargs):
        seen.append((len(prog.cases), prog.debug))
        result = ue.EvalResult()
        if len(prog.cases) > 1:
            result.bail = 'meme'
            return result
        result.ok = True
        case = prog.cases[0]
        fields = [goldens.MAGIC, b'1', case.name.encode(), b'ok',
                  read(os.path.join(case.folder, 'tokens.txt'))[:-1],
                  read(os.path.join(case.folder, 'tree.txt'))[:-1], b'', b'', b'']
        result.noun = bytes_to_atom(b''.join(str(len(field)).encode() + b':' + field + b','
                                            for field in fields))
        return result
    opts = SimpleNamespace(fast=True, jobs=1, timeout=10, save_program=None)
    with patch.object(goldens, 'golden_program',
                      lambda lib, cases, debug=True: SimpleNamespace(cases=cases, debug=debug)), \
            patch.object(goldens.ue, 'run_eval', eval_golden):
        goldens.run_cases(STUB, cases, opts)
    c.expect(seen == [(2, False), (1, False), (1, False)] and
             all(goldens.compare(case)[0] for case in cases),
             'golden resource isolation changed debug mode or outcomes: %r' % seen)

    seen = []
    def run_probe(command, **kwargs):
        seen.append('--no-debug' in command)
        labels = re.findall(r'^#### (.*)$', read(command[-1]).decode(), re.M)
        if len(labels) > 1:
            return SimpleNamespace(returncode=1, stderr='bail: %oops', stdout='')
        return SimpleNamespace(returncode=0, stderr='',
                               stdout='#### %s\nCHECKED\n' % labels[0])
    sample = [('first', '/ui/probe/jibb', '++ main 1\n'),
              ('second', '/ui/probe/jibb', '++ main 2\n')]
    with patch.object(probes.subprocess, 'run', run_probe):
        failures, error = probes.eval_group('p1', sample, fast=True)
    c.expect(seen == [True, True, True] and not failures and error is None,
             'probe resource isolation changed debug mode or outcomes: %r %r %r' %
             (seen, failures, error))


CHECKS =[(name[len('check_'):], fn) for name, fn in globals().items()
          if name.startswith('check_')]


def main(argv):
    ap = argparse.ArgumentParser(prog='tools/testdata/selftest')
    ap.add_argument('-k', metavar='WORD',
                    help='only the checks whose name has WORD')
    opts = ap.parse_args(argv)
    failed = 0
    ran = 0
    for name, fn in CHECKS:
        if opts.k and opts.k not in name:
            continue
        ran += 1
        c = Check()
        with tempfile.TemporaryDirectory(prefix='jibb-selftest-') as tmp:
            try:
                fn(c, tmp)
            except Exception as e:  # report and go on to the next check
                c.failures.append('%s: %s' % (type(e).__name__, e))
        if c.failures:
            failed += 1
            print('FAIL  %s' % name)
            for f in c.failures:
                print('\n'.join('  ' + l for l in str(f).split('\n')))
        else:
            print('ok    %s' % name)
        sys.stdout.flush()
    print('%d checks, %d failed' % (ran, failed))
    return 1 if failed or not ran else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
