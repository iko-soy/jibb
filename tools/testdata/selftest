             in out, 'no summary line:\n' + out)


def check_expected_files_by_hand(c, tmp):
    """The expected files hold what the stub should print, worked out here
    from each source, so they show that bytes survive the round trip:
    UTF-8, quotes, backslashes, tabs, CR, NUL and other control bytes."""
    for name in sorted(os.listdir(CASES)):
        src = read(os.path.join(CASES, name, 'source.jibb'))
        lines = src.split(b'\n')
        if lines[-1] == b'':
            lines.pop()
        # Each line is a cord in the stub, so it loses trailing NULs.
        tree = (lines[0].rstrip(b'\x00') if lines else b'') + b'\n'
        tokens = [b'file: /tests/golden/%s/source/jibb' % name.encode(),
                  b'bytes: %d' % len(src.rstrip(b'\x00')),
                  b'lines: %d' % len(lines)]
        tokens += [b'%d| %s' % (i + 1, l.rstrip(b'\x00'))
                   for i, l in enumerate(lines)]
        c.expect(read(os.path.join(CASES, name, 'tree.txt')) == tree,
                 '%s/tree.txt is not the first line of the source' % name)
        c.expect(read(os.path.join(CASES, name, 'tokens.txt')) ==
                 b'\n'.join(tokens) + b'\n',
                 "%s/tokens.txt is not what the stub's tokens should be"
                 % name)


