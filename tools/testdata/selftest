sys.dont_write_bytecode = True


class Check:
    def __init__(self):
        self.failures = []

    def expect(self, cond, what):
        if not cond:
            self.failures.append(what)


def run(*args, stdin=None):
    """Run a tool; returns (status, stdout and stderr as text)."""
    env = dict(os.environ, NO_COLOR='1', PYTHONDONTWRITEBYTECODE='1')
    p = subprocess.run([sys.executable] + list(args), input=stdin,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       cwd=ROOT, env=env)
    return p.returncode, p.stdout.decode('utf-8', 'replace')


def golden(*args):
    return run(GOLDEN, *args)


def hoon(*args, stdin=None):
    return run(HOON, *args, stdin=stdin)


def copy_cases(tmp):
    dest = os.path.join(tmp, 'golden')
    shutil.copytree(CASES, dest)
    return dest


def add_case(cases, name, source):
    os.makedirs(os.path.join(cases, name))
    with open(os.path.join(cases, name, 'source.jibb'), 'wb') as f:
        f.write(source)


def stub_with(tmp, name, old, new):
    """A copy of the stub with one line's text replaced; returns its path
    and the line number of the change."""
    with open(STUB) as f:
        lines = f.read().split('\n')
    hits = [i for i, l in enumerate(lines) if l == old]
    if not hits:
        hits = [i for i, l in enumerate(lines) if old in l]
    assert len(hits) == 1, (old, hits)
    lines[hits[0]] = lines[hits[0]].replace(old, new)
    path = os.path.join(tmp, name)
    with open(path, 'w') as f:
        f.write('\n'.join(lines))
    return path, hits[0] + 1


def stub_line(text):
    with open(STUB) as f:
        lines = f.read().split('\n')
    hits = [i + 1 for i, l in enumerate(lines) if text in l]
    assert len(hits) == 1, (text, hits)
    return hits[0]


def read(path):
    with open(path, 'rb') as f:
        return f.read()


