def check_fixture_crash_isolated(c, tmp):
    """A bad Hoon fixture must not hide the Jibb parse or other cases."""
    original = os.path.join(ROOT, 'tests', 'golden', 'types-import-mark')
    cases = os.path.join(tmp, 'fixture-cases')
    os.makedirs(cases)
    for name in ('good', 'bad', 'empty', 'mark-only'):
        shutil.copytree(original, os.path.join(cases, name))
    with open(os.path.join(cases, 'bad', 'mar', 'label.txt'), 'w') as f:
        f.write('not hoon\n')
    with open(os.path.join(cases, 'empty', 'mar', 'label.txt'), 'w'):
        pass
    # Clay's %txt mark treats the last unterminated line as a line too.
    good = os.path.join(cases, 'good', 'mar', 'label.txt')
    with open(good, 'rb') as f:
        without_newline = f.read().rstrip(b'\n')
    with open(good, 'wb') as f:
        f.write(without_newline)
    only = os.path.join(cases, 'mark-only')
    os.remove(os.path.join(only, 'imports.txt'))
    with open(os.path.join(only, 'source.jibb'), 'w') as f:
        f.write('/%  %label\n++ label-id |= x=label x\n')
    status, out = golden('--dir', cases, '--show')
    c.expect(status == 1, 'fixture failure must fail the run: %d\n%s' % (status, out))
    c.expect('==> bad: tokens <==\n1:1' in out and
             '==> bad: tree <==\n(module' in out and
             '==> bad: types <==\nCRASH\n/mar/label.txt fixture' in out,
             'malformed fixture should preserve parse and name the fixture:\n' + out)
    c.expect('==> empty: types <==\nCRASH\n/mar/label.txt fixture' in out,
             'empty fixture should name the fixture:\n' + out)
    for name in ('good', 'mark-only'):
        c.expect(('==> %s: types <==\nmodule kind: library\n'
                  '++ label-id: $-(@t @t)') % name in out,
                 'valid fixture should be isolated: ' + name + '\n' + out)
    expected = read(os.path.join(cases, 'bad', 'types.txt'))
    status, out = golden('--dir', cases, '--case', 'bad', '--update')
    c.expect(status == 1 and read(os.path.join(cases, 'bad', 'types.txt')) == expected and
             'CRASH' in out and '/mar/label.txt fixture' in out,
             'update must report the fixture crash and leave outputs alone:\n' + out)


def check_type_contract(c, tmp):
    cases = copy_cases(tmp)
    folder = os.path.join(cases, 'basic')
    types = os.path.join(folder, 'types.txt')
    contract = os.path.join(folder, 'type-contract.txt')
    with open(types, 'w') as f:
        f.write('do not overwrite incomplete diagnostic\n')
    location = '/tests/golden/basic/source.jibb:1:1'
    with open(contract, 'w') as f:
        f.write('typed-site ' + location + '\nmin-sites 2\n')
    old = '  (crip "type of {(spud file)}: {(a-co:co (met 3 src))} bytes")'
    new = r"  '/tests/golden/basic/source.jibb:1:1: expected has type @t\0asource\0a^'"
    lib, _ = stub_with(tmp, 'contract-stub.hoon', old, new)
    status, out = golden('--dir', cases, '--lib', lib, '--case', 'basic', '--update')
    c.expect(status == 1 and 'requires 2 diagnostic sites' in out and
             read(types) == b'do not overwrite incomplete diagnostic\n',
             '--update must not bless a failed contract: %d\n%s' % (status, out))
    with open(contract, 'w') as f:
        f.write('typed-site ' + location + '\nmin-sites 1\n')
    status, out = golden('--dir', cases, '--lib', lib, '--case', 'basic', '--update')
    c.expect(status == 0, 'a satisfied contract should permit an update: %d\n%s' % (status, out))
    status, out = golden('--dir', cases, '--lib', lib, '--case', 'basic')
    c.expect(status == 0 and 'PASS  basic' in out, 'a satisfied contract should pass: %d\n%s' % (status, out))
    with open(contract, 'w') as f:
        f.write('message expected has type @t\n')
    status, out = golden('--dir', cases, '--lib', lib, '--case', 'basic')
    c.expect(status == 0, 'a matching diagnostic message should pass: %d\n%s' % (status, out))
    saved = read(types)
    with open(contract, 'w') as f:
        f.write('message missing diagnostic\n')
    status, out = golden('--dir', cases, '--lib', lib, '--case', 'basic', '--update')
    c.expect(status == 1 and 'requires diagnostic message' in out and read(types) == saved,
             'an absent message must fail without updating: %d\n%s' % (status, out))
    with open(contract, 'w') as f:
        f.write('site /tests/golden/basic/source.jibb:2:1\n')
    status, out = golden('--dir', cases, '--lib', lib, '--case', 'basic')
    c.expect(status == 1 and 'requires site' in out, 'a missing site must fail: %d\n%s' % (status, out))


