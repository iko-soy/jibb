def check_trace_parsing(c, tmp):
    """How eval's failures are read, on traces as eval prints them."""
    sys.path.insert(0, TOOLS)
    import urbit_eval as ue

    def result(bail, *trace, timed_out=False):
        r = ue.EvalResult()
        r.bail, r.trace, r.timed_out = bail, list(trace), timed_out
        return r

    compile_time = [
        result('exit', '{1,234 5}', 'syntax error'),
        result('exit', '/::[2 1].[9 3]>', '-find.foo'),
        # a compile-time stack overflow, as recursive molds can cause
        result('over', '/eval::[2 1].[1,026 10]>', '/eval::[475 7].[475 75]>'),
        result('exit', '-find.foo'),    # no spots, as under !.
    ]
    run_time = [
        result('exit', '/:<[3.411 3].[3.414 10]>', '[%my-trace 3]'),
        result('meme', '/:<[2 1].[3 10]>'),
        result('fail'),
        result(None, timed_out=True),
    ]
    for r in compile_time:
        c.expect(r.is_compile_error(), 'should be compiling: %r' % r.trace)
    for r in run_time:
        c.expect(not r.is_compile_error(), 'should be running: %r' % r.trace)

    prog = ue.Program()
    prog.add('!:\n=>', '(prefix)', 'prefix')
    prog.add('\n'.join('lib line %d' % i for i in range(1, 4001)),
             'lib.hoon', 'lib')
    prog.add('harness', '(harness)', 'harness')
    lines, spots = ue.map_trace(prog, [
        '/::[2 1].[2,004 1]>', '/::[1,236 5].[1,236 9]>',
        '/:<[3.002 3].[3.003 10]>', '{1,236 7}', 'syntax error'])
    c.expect(lines == ['lib.hoon:1234:5-9', 'lib.hoon:3000:3-3001:10',
                       'lib.hoon:1234:7', 'syntax error'],
             'mapped lines: %r' % lines)
    c.expect([s.kind for s in spots] == ['lib'] * 3, 'spot kinds')
    folded = ue.fold_repeats(['out'] + ['a', 'b'] * 50 + ['in'])
    c.expect(folded == ['out', 'a', 'b',
                        '(the 2 lines above repeat 49 more times)', 'in'],
             'folding: %r' % folded)


