# ---------------------------------------------------------------- the ship

RESULT = re.compile(r'^(OK|FAILED|CRASHED) +/tests/lib/jibb/(test-\S+)$')
EXPECTED = re.compile(r'^Expected: (OK|FAILED|CRASHED)(?:, with "(.*)")?',
                      re.M)


def results(stdout):
    """{arm: (result, the lines printed after it)}."""
    out, arm = {}, None
    for line in stdout.split('\n'):
        m = RESULT.match(line)
        if m:
            arm = m.group(2)
            out[arm] = (m.group(1), [])
        elif re.match(r'^(>|built|PASS|FAIL)', line):
            arm = None
        elif arm:
            out[arm][1].append(line)
    return out


def deletion_checks():
    # Model a full golden desk being replaced by the much smaller stub desk.
    paths = ['/tests/golden/case-%04d/source/jibb' % i for i in range(3000)]
    paths += ['/tests/golden/%s-%04d/tree/txt' % ('a' * 200, i)
              for i in range(400)]
    batches = ship.delete_batches('jibb-dev', paths, 60)
    requests = [ship.fill(ship.CHANGE_WAIT, ACT=act, MOTE='info',
                          DESK='jibb-dev', SECS=ship.hoon_ud(60))
                for _batch, act in batches]
    check('large deletion requests are bounded and preserve every path in order',
          len(batches) > 1 and
          [path for batch, _act in batches for path in batch] == paths and
          all(ship.click_argument_bytes(req) <= ship.DELETE_REQUEST_BYTES
              for req in requests) and
          all(act == ship.delete_action('jibb-dev', batch)
              for batch, act in batches))

    # click -i adds an escape before every quote and two spaces per newline.
    check('click argument sizing includes quote and newline escaping',
          ship.click_argument_bytes("a'b\nc") == len(b"a\\'b  c") + 1)

    original = ship.change_and_wait
    calls = []
    try:
        def fake_change(_ship, desk, act, mote, what, timeout):
            calls.append((desk, act, mote, what, timeout))
            return len(calls)
        ship.change_and_wait = fake_change
        rev = ship.delete_and_wait(None, 'jibb-dev', paths, 60)
        check('deletion waits for each batch and returns the last revision',
              len(calls) == len(batches) and rev == len(batches) and
              [call[1] for call in calls] == [act for _batch, act in batches])

        calls.clear()
        rev = ship.delete_and_wait(None, 'jibb-dev', [], 60)
        check('empty deletion retains its original single-call behavior',
              rev == 1 and len(calls) == 1 and
              calls[0][1] == ship.delete_action('jibb-dev', []))

        calls.clear()
        def fail_second(*args):
            calls.append(args)
            if len(calls) == 2:
                raise ship.Fail('Clay rejected the batch')
            return 1
        ship.change_and_wait = fail_second
        try:
            ship.delete_and_wait(None, 'jibb-dev', paths, 60)
        except ship.Fail:
            stopped = len(calls) == 2
        else:
            stopped = False
        check('a failed deletion stops subsequent batches', stopped)

        calls.clear()
        ship.change_and_wait = fake_change
        try:
            ship.delete_and_wait(None, 'jibb-dev',
                                 paths[:1024] + ['/tests/' + 'x' * 70000 + '/txt'],
                                 60)
        except ship.Unable:
            rejected = not calls
        else:
            rejected = False
        check('an oversized path is rejected before any deletion', rejected)
    finally:
        ship.change_and_wait = original


def ship_checks(tmp, many):
    names = sorted(n for n in os.listdir(CASES)
                   if os.path.isfile(os.path.join(CASES, n, 'source.jibb')))
    res = run('test', '--stub', '--golden', CASES)
    print('        ' + (res.stdout.strip().split('\n') or [''])[-1])
    got = results(res.stdout)
    for name, arm in zip(names, ship.arm_names(names)):
        with open(os.path.join(CASES, name, 'about.txt')) as f:
            m = EXPECTED.search(f.read())
        want, words = m.group(1), m.group(2)
        have, said = got.get(arm, ('(no result)', []))
        ok = have == want and (words is None or
                               any(words in l for l in said))
        check('%s: %s%s' % (name, want, ', with "%s"' % words if words
                            else ''), ok,
              '%s\n%s' % (have, '\n'.join(said)) + '\n' + res.stderr)
    n = {k: sum(1 for v in got.values() if v[0] == k)
         for k in ('OK', 'FAILED', 'CRASHED')}
    check('the summary counts them, and test exits 1',
          res.returncode == 1 and
          'FAIL: %d OK, %d FAILED, %d CRASHED' % (
              n['OK'], n['FAILED'], n['CRASHED']) in res.stdout,
          res.stdout[-400:] + res.stderr)

    logical = os.path.join(tmp, 'logical-on-ship')
    src = b'++ api\n'
    write_case(logical, 'api', src)
    folder = os.path.join(logical, 'api')
    with open(os.path.join(folder, 'path.txt'), 'w') as f:
        f.write('/ui/api/todo.jibb\n')
    tokens, _tree = stub_output('api', src)
    with open(os.path.join(folder, 'tokens.txt'), 'wb') as f:
        f.write(tokens.replace(b'/tests/golden/api/source/jibb',
                               b'/ui/api/todo/jibb') + b'\n')
    with open(os.path.join(folder, 'types.txt'), 'wb') as f:
        f.write(b'type of /ui/api/todo/jibb: %d bytes\n' % len(src))
    res = run('test', '--stub', '--golden', logical)
    check('logical path and type output pass on the ship',
          res.returncode == 0 and
          'PASS: 1 OK, 0 FAILED, 0 CRASHED' in res.stdout,
          res.stdout[-1500:] + res.stderr)

    broken = os.path.join(tmp, 'broken.hoon')
    with open(STUB) as f:
        src = f.read()
    with open(broken, 'w') as f:
        f.write(src.replace("?:  =('crash' first)", '?:  =(%crash first first)'))
    res = run('test', '--lib', broken, '--golden', CASES)
    check('a library that does not build: the error, then FAILED (build)',
          res.returncode == 1 and re.search(
              r'syntax error at \[\d+ \d+\] in /lib/jibb/hoon', res.stdout)
          and 'FAILED  /tests/lib/jibb/hoon (build)' in
          res.stdout and 'a test file failed to build' in res.stdout,
          res.stdout[-1500:] + res.stderr)

    if many:
        golden = os.path.join(tmp, 'many-on-ship')
        for i in range(many):
            write_case(golden, 'case-%03d' % i,
                       b'++ case %d\n\n++ view\n  text "case %d"\n' % (i, i))
        res = run('test', '--stub', '--golden', golden)
        print('        ' + (res.stdout.strip().split('\n') or [''])[-1])
        check('%d made-up cases all pass' % many,
              res.returncode == 0 and
              'PASS: %d OK, 0 FAILED, 0 CRASHED' % many in res.stdout,
              res.stdout[-1500:] + res.stderr)


def main():
    ap = argparse.ArgumentParser(
        description=__doc__.split('\n\n')[0],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--no-ship', action='store_true',
                    help='only the checks that need no ship')
    ap.add_argument('--many', type=int, default=0, metavar='N',
                    help='also run N made-up cases on the ship')
    args = ap.parse_args()
    tmp = tempfile.mkdtemp(prefix='ship-selftest-')
    try:
        generator_checks(tmp)
        deletion_checks()
        if not args.no_ship:
            if not ship.Ship(ship.PIER, None, ship.CLICK).running():
                check('the fake ship is running (tools/ship start)', False)
            else:
                ship_checks(tmp, args.many)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print('%s: %d checks failed' % ('FAIL' if failures else 'PASS',
                                    len(failures)))
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())
