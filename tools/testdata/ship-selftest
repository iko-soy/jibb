SHIP = os.path.join(ROOT, 'tools', 'ship')
CASES = os.path.join(HERE, 'ship-golden')
STUB = os.path.join(HERE, 'ship-stub.hoon')


def load_ship():
    loader = importlib.machinery.SourceFileLoader('ship', SHIP)
    spec = importlib.util.spec_from_loader('ship', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ship = load_ship()
failures = []


def check(name, ok, detail=''):
    print('%s  %s' % ('ok  ' if ok else 'FAIL', name), flush=True)
    if not ok:
        failures.append(name)
        for line in str(detail).rstrip('\n').split('\n'):
            print('        ' + line)


def run(*args):
    return subprocess.run([SHIP] + list(args), capture_output=True,
                          text=True, cwd=ROOT)


def stub_output(case, src):
    """What ship-stub.hoon's golden arm gives, worked out here."""
    lines = src.split(b'\n')
    if src.endswith(b'\n'):
        lines.pop()
    if not src:
        lines = []

    def after(label, t):
        return label if not t else label + b' ' + t
    tokens = [b'file: /tests/golden/%s/source/jibb' % case.encode()]
    tokens += [after(b'%d|' % (i + 1), l) for i, l in enumerate(lines)]
    tree = [b'lines: %d' % len(lines),
            after(b'first:', lines[0] if lines else b'')]
    return b'\n'.join(tokens), b'\n'.join(tree)


def write_case(golden, case, src, expected=True):
    folder = os.path.join(golden, case)
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, 'source.jibb'), 'wb') as f:
        f.write(src)
    if expected:
        tokens, tree = stub_output(case, src)
        for fn, data in (('tokens.txt', tokens), ('tree.txt', tree)):
            with open(os.path.join(folder, fn), 'wb') as f:
                f.write(data + b'\n')


def arms(text):
    return re.findall(r'^\+\+  (test-\S*)\n  \(check (.*)\)$', text, re.M)


