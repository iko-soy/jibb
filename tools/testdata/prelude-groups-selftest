#!/usr/bin/env python3
"""Exercise the manifest-driven prelude source loader without a ship."""

import os
from pathlib import Path
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import prelude_groups


class GroupManifestTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix="jibb-group-manifest-")
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.library = self.root / "jibb-dev" / "lib" / "jibb"
        (self.library / "groups").mkdir(parents=True)
        (self.library / "groups" / "hoon.jibb").write_text("+$ step @u\n")
        (self.library / "groups" / "private.jibb").write_text("++ id |= x x\n")
        self.manifest = self.library / "prelude-groups.txt"

    def test_group_and_private_source(self):
        self.manifest.write_text(
            "# checked bundle\ngroup hoon /lib/jibb/groups/hoon\n"
            "source /lib/jibb/groups/private\n"
        )
        groups, private = prelude_groups.load(str(self.root))
        self.assertEqual((groups[0][0], groups[0][1]), ("hoon", "/lib/jibb/groups/hoon"))
        self.assertEqual(groups[0][3], b"+$ step @u\n")
        self.assertEqual(private[0][1], "/lib/jibb/groups/private")
        self.assertEqual(
            prelude_groups.hoon_path(groups[0][1]),
            "~[~.lib ~.jibb ~.groups ~.hoon ~.jibb]",
        )

    def test_rejects_duplicate_face_and_path_escape(self):
        self.manifest.write_text(
            "group hoon /lib/jibb/groups/hoon\n"
            "group hoon /lib/jibb/groups/private\n"
        )
        with self.assertRaises(ValueError):
            prelude_groups.load(str(self.root))
        self.manifest.write_text("group hoon /lib/jibb/../secret\n")
        with self.assertRaises(ValueError):
            prelude_groups.load(str(self.root))
        self.manifest.write_text("group hoon /lib/jibb/groups/missing\n")
        with self.assertRaises(ValueError):
            prelude_groups.load(str(self.root))

    def test_rejects_symlink_outside_desk(self):
        outside = self.root / "outside.jibb"
        outside.write_text("+$ leaked @t\n")
        link = self.library / "groups" / "leaked.jibb"
        os.symlink(outside, link)
        self.manifest.write_text("group leaked /lib/jibb/groups/leaked\n")
        with self.assertRaises(ValueError):
            prelude_groups.load(str(self.root))


if __name__ == "__main__":
    unittest.main()
