# Ctrl-C or SIGTERM cancels the queued checks and kills the running one at
# once, rather than waiting while every queued check runs.
CHECK_CHILD = r"""
import importlib.machinery, importlib.util, sys
path, log = sys.argv[1], sys.argv[2]
loader = importlib.machinery.SourceFileLoader('check_under_test', path)
spec = importlib.util.spec_from_file_location('check_under_test', path, loader=loader)
check = importlib.util.module_from_spec(spec)
loader.exec_module(check)
check.CHECKS = [check.Check('c%d' % i, 'eval',
                            ['sh', '-c', 'echo c%d >> %s; exec sleep 60' % (i, log)])
                for i in (1, 2, 3)]
sys.exit(check.main(['-j', '1']))
"""
for signum, status in ((signal.SIGINT, 130), (signal.SIGTERM, 143)):
    with tempfile.TemporaryDirectory(prefix='jibb-check-signal-test-') as folder:
        log = os.path.join(folder, 'started')
        Path(log).write_text('')
        child = subprocess.Popen([sys.executable, '-I', '-B', '-c', CHECK_CHILD,
                                  str(ROOT / 'tools/check'), log],
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        deadline = time.time() + 30
        while not Path(log).read_text() and time.time() < deadline:
            time.sleep(0.05)
        child.send_signal(signum)
        try:
            output, _ = child.communicate(timeout=20)
        except subprocess.TimeoutExpired:
            child.kill()
            child.communicate()
            raise AssertionError('tools/check kept running queued checks after %s'
                                 % signal.Signals(signum).name)
        expect(child.returncode == status and Path(log).read_text().split() == ['c1'],
               (signum, child.returncode, Path(log).read_text(), output))


