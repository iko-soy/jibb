def arm_rejects(operation, fragment):
    try:
        operation()
    except arms.Unusable as error:
        expect(fragment in str(error), str(error))
    else:
        raise AssertionError('accepted invalid library dependencies: ' + fragment)


with tempfile.TemporaryDirectory(prefix='jibb-arm-inputs-test-') as folder:
    root = Path(folder)
    suite_dir = root / 'suites'
    suite_dir.mkdir()
    files = {}

    def source(path, text):
        target = root / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        return target

    def library(name, text, path=None):
        target = source(path or 'sources/' + name + '.hoon', text)
        files['lib/' + name + '.hoon'] = (target.read_bytes(), str(target.relative_to(root)))
        return target

    def suite(name, header, directory=suite_dir):
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / (name + '.hoon')
        path.write_text(header + '\n|%\n++  test-smoke\n  %.y\n--\n')
        return arms.Suite(str(path), desk)

    plain = ':: synthetic library\n|%\n++  value  42\n--\n'
    compiler = library('jibb', plain)
    builder = library('jibb-build', plain)
    library('shared', '/+  jibb-build\n' + plain)
    library('left', '/+  shared\n' + plain)
    library('right', '/+  shared\n' + plain)
    library('raw-reader', '/*  builder  %hoon  /lib/jibb-build/hoon\n' + plain)
    library('lookalike', plain)
    files['lib/renamed.hoon'] = files['lib/jibb-build.hoon']
    files['lib/nested/builder.hoon'] = files['lib/jibb-build.hoon']
    link = root / 'sources/builder-link.hoon'
    link.symlink_to(builder)
    files['lib/symlinked.hoon'] = (link.read_bytes(), str(link.relative_to(root)))
    desk = arms.MappedDesk(files)

    with patch.object(arms, 'ROOT', str(root)):
        suites = [
            suite('direct', '/+  jibb-build'),
            suite('transitive', '/+  left'),
            suite('diamond', '/+  left, right'),
            suite('file-read', '/*  builder  %hoon  /lib/jibb-build/hoon'),
            suite('library-file-read', '/+  raw-reader'),
            suite('renamed', '/+  renamed'),
            suite('nested', '/+  nested-builder'),
            suite('symlinked', '/+  symlinked'),
            suite('unrelated', '/+  lookalike'),
            suite('jibb-build', ':: a suite name is not a dependency'),
            suite('ordinary', '/+  jibb'),
        ]
        expected = {'direct', 'transitive', 'diamond', 'file-read',
                    'library-file-read', 'renamed', 'nested', 'symlinked'}
        selected = arms.library_dependents(suites, desk, 'jibb-build', str(compiler))
        expect(selected == expected, (selected, expected))
        expect(arms.library_dependents(suites, desk, 'renamed', str(compiler)) == expected)
        # Every generated program starts with the selected root compiler.
        expect(arms.library_dependents(suites, desk, 'jibb', str(compiler)) == {
            item.name for item in suites})

        invalid_dir = root / 'invalid'
        library('cycle-a', '/+  cycle-b\n' + plain)
        library('cycle-b', '/+  cycle-a\n' + plain)
        cycle = suite('cycle', '/+  cycle-a', invalid_dir)
        arm_rejects(lambda: arms.library_dependents([cycle], desk, 'jibb-build', str(compiler)),
                    'cycle')
        missing = suite('missing', '/+  missing', invalid_dir)
        arm_rejects(lambda: arms.library_dependents([missing], desk, 'jibb-build', str(compiler)),
                    'missing')
        library('missing-file', '/*  data  %txt  /missing/txt\n' + plain)
        missing_file = suite('missing-file', '/+  missing-file', invalid_dir)
        arm_rejects(lambda: arms.library_dependents([missing_file], desk, 'jibb-build', str(compiler)),
                    'not on the jibb-dev desk')
        arm_rejects(lambda: arms.library_dependents(suites, desk, 'absent', str(compiler)),
                    'absent')

        def cli(*arguments):
            output = io.StringIO()
            with redirect_stdout(output), redirect_stderr(output):
                try:
                    status = arms.main(['--dir', str(suite_dir), '--lib', str(compiler),
                                        '--list', *arguments])
                except SystemExit as error:
                    status = error.code
            return status, output.getvalue()

        def listed(*arguments):
            status, output = cli(*arguments)
            expect(status == 0, output)
            return set(re.findall(r'^([a-z0-9-]+) \(', output, re.M))

        fake_ship = SimpleNamespace(assemble=lambda _: desk, Unable=arms.Unusable)
        with patch.object(arms, 'load_ship', return_value=fake_ship), \
                patch.object(arms, 'run', side_effect=AssertionError('unexpected eval')), \
                patch.object(arms, 'run_fast', side_effect=AssertionError('unexpected eval')):
            all_names = {item.name for item in suites}
            expect(listed() == all_names)
            expect(listed('--include-library', 'jibb-build') == expected)
            expect(listed('--exclude-library', 'jibb-build') == all_names - expected)
            ordinary = set()
            for index in range(1, 4):
                shard = ['--shard', '%d/3' % index]
                original = listed(*shard)
                retained = listed(*shard, '--exclude-library', 'jibb-build')
                moved = listed(*shard, '--include-library', 'jibb-build')
                expect(retained == original - expected, (index, original, retained))
                expect(moved == original & expected, (index, original, moved))
                expect(not ordinary & retained)
                ordinary.update(retained)
            expect(ordinary | expected == all_names and not ordinary & expected)
            status, output = cli('--include-library', 'jibb-build',
                                 '--exclude-library', 'jibb-build')
            expect(status == 2, output)
            mapping = root / 'desk.json'
            mapping.write_text(json.dumps({name: entry[1] for name, entry in files.items()}))
            for option in ('--include-library', '--exclude-library'):
                for conflict in (['--desk-map', str(mapping)], ['--report'], ['--update']):
                    status, output = cli(option, 'jibb-build', *conflict, 'direct')
                    expect(status == 2, (option, conflict, output))

with tempfile.TemporaryDirectory(prefix='jibb-arm-prefix-test-') as folder:
    root = Path(folder)

    def put(name, text):
        path = root / name
        path.write_text(text)
        return path

    compiler = put('jibb.hoon', '|%\n++  value  42\n--\n')
    helper = put('helper.hoon', '/+  jibb\n=/  answer  value:jibb\n'
                 '|%\n++  value  answer\n--\n')
    source = put('source.jibb', 'hello\n')
    desk = arms.MappedDesk({
        'lib/jibb.hoon': (compiler.read_bytes(), compiler.name),
        'lib/helper.hoon': (helper.read_bytes(), helper.name),
        'source.jibb': (source.read_bytes(), source.name),
    })
    header = ':: fixture\n/+  jibb, helper\n/*  src  %jibb  /source/jibb\n\n'
    body = ('|%\n++  test-one\n  ^-  tang\n  ~\n'
            '++  test-two\n  ^-  tang\n  ~\n++  report\n  src\n--\n')
    prefix = '=/  shared=@t  src\n=/  route=path\n/foo\n'
    with patch.object(arms, 'ROOT', str(root)), \
            patch.object(arms, 'DESK', desk, create=True):
        legacy = arms.Suite(str(put('legacy.hoon', header + body)), desk)
        prefixed = arms.Suite(str(put('prefixed.hoon', header + prefix + body)), desk)
        expected_header = ':: fixture\n::  jibb, helper\n::  src  %jibb  /source/jibb\n\n'
        expect(legacy.core == expected_header + body)
        expect(prefixed.core == expected_header + prefix + body)
        expect(prefixed.arms == legacy.arms == ['test-one', 'test-two'])
        expect(prefixed.reports and legacy.reports)
        expect(prefixed.files == legacy.files and prefixed.libs == legacy.libs)
        expect(arms.library_dependents([prefixed], desk, 'helper', str(compiler)) == {'prefixed'})
        _, _, imported = arms.library_input(desk, 'helper')
        expect(imported.libs == ['jibb'] and '=/  answer  value:jibb\n' in imported.core)
        for path in ('/[name]/jibb', '/(scot %p ship)/jibb', '/~zod/base'):
            setup = '=/  name=@tas  %source\n=/  ship=@p  ~zod\n=/  selected=path\n' + path + '\n'
            filename = put('path-prefix.hoon', header + setup + body)
            parsed = arms.Suite(str(filename), desk)
            expect(parsed.core == expected_header + setup + body, path)
            for late in ('/+  helper\n', '  /*  src %jibb /source/jibb\n'):
                filename = put('late-header.hoon', header + setup + late + body)
                arm_rejects(lambda: arms.Suite(str(filename), desk),
                            'Ford headers must come before')

        # A legacy suite must retain the old parser's exact generated bytes
        # and source segments in both debug modes, including report mode.
        at = (header + body).find('\n|%\n')
        old_head = (header + body)[:at + 1].split('\n')[:-1]
        old_core = '\n'.join('::' + line[2:] if line.startswith(('/+', '/*'))
                             else line for line in old_head) + (header + body)[at:]
        old_suite = SimpleNamespace(**(vars(legacy) | {'core': old_core}))
        for debug in (False, True):
            for mode in ('arms', 'report'):
                actual = arms.program_for([legacy], str(compiler), debug, mode)
                previous = arms.program_for([old_suite], str(compiler), debug, mode)
                expect(actual.encode() == previous.encode())
                expect([vars(s) for s in actual.segments] == [vars(s) for s in previous.segments])

        program = arms.program_for([prefixed], str(compiler), True)
        expect(program.text().count(prefix) == 1)
        expect(program.text().count('=/  answer  value:jibb\n') == 1)
        expect(program.text().count('(mule |.(`tang`') == len(prefixed.arms))
        segment = next(s for s in program.segments if s.name == prefixed.rel)
        for line, text in enumerate((header + prefix + body).splitlines(), 1):
            found, local = program.locate(segment.start + line - 1)
            expect(found is segment and local == line)
            if not text.startswith(('/+', '/*')):
                expect(found.lines[local - 1] == text)

        for bad, message in [
                ('/-  extra\n', 'only /+ and /* lines'),
                ('  /+  jibb\n', 'only /+ and /* lines'),
                ('/+\n', 'only /+ and /* lines'),
                ('/*\n', 'only /+ and /* lines'),
                ('/*  src %txt\n', 'a /* line is'),
                ('/*  src %json /source/jibb\n', 'only %txt, %jibb and %hoon'),
                ('/*  src %txt /missing/txt\n', 'not on the jibb-dev desk'),
                (prefix + '/+  jibb\n', 'Ford headers must come before'),
                (prefix + ':: comment\n/*  src %jibb /source/jibb\n',
                 'Ford headers must come before'),
                (prefix + '/-  extra\n', 'Ford headers must come before')]:
            path = put('invalid.hoon', ':: original line\n' + bad + body)
            arm_rejects(lambda: arms.Suite(str(path), desk), message)
        path = put('invalid.hoon', '/+  jibb\n=/  shared  42\nshared\n')
        arm_rejects(lambda: arms.Suite(str(path), desk), 'no |% core')


