#!/usr/bin/env python3
"""Check recorded assemblies and suite partitions without ships or Hoon eval."""

import importlib.machinery
from contextlib import redirect_stderr, redirect_stdout
import io
import json
import os
from pathlib import Path
import re
import sys
import tempfile
from types import SimpleNamespace
from unittest.mock import patch

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[2]
ship = importlib.machinery.SourceFileLoader(
    'check_inputs_ship', str(ROOT / 'tools/ship')).load_module()
arms = importlib.machinery.SourceFileLoader(
    'check_inputs_arms', str(ROOT / 'tools/test-arms')).load_module()


def rejects(operation, fragment):
    try:
        operation()
    except ship.Unable as error:
        assert fragment in str(error), str(error)
    else:
        raise AssertionError('accepted invalid recorded assembly: ' + fragment)


with tempfile.TemporaryDirectory(prefix='jibb-check-inputs-test-') as folder:
    root = Path(folder)
    ship.ROOT = folder
    (root / 'mark.hoon').write_text('|_  a=*\n++  grab  |%  ++  noun  *  --\n--\n')
    (root / 'value.hoon').write_text('42\n')
    (root / 'sys.kelvin').write_text('[%zuse 310]\n')
    mapping = {'mar/hoon.hoon': 'mark.hoon', 'mar/kelvin.hoon': 'mark.hoon',
               'sys.kelvin': 'sys.kelvin', 'lib/value.hoon': 'value.hoon'}
    assembly = ship.mapped_assembly('fixture', mapping)
    assert assembly.files['lib/value.hoon'] == (b'42\n', 'value.hoon')
    rejects(lambda: ship.mapped_assembly('fixture', {}), 'nonempty object')
    for path in ('../escape', '/absolute', 'a//b', 'a/./b', '', 3):
        rejects(lambda: ship.mapped_assembly('fixture', {path: 'value.hoon'}), 'invalid path')
        rejects(lambda: ship.mapped_assembly('fixture', {'lib/value.hoon': path}), 'invalid path')
    (root / 'outside.hoon').symlink_to(ROOT / 'jibb-dev/lib/jibb.hoon')
    rejects(lambda: ship.mapped_assembly('fixture', {'lib/outside.hoon': 'outside.hoon'}),
            'escapes the repository')
    rejects(lambda: ship.mapped_assembly('fixture', {'lib/value.hoon': 'value.hoon'}),
            'no mark')
    maps = root / 'desks.json'
    maps.write_text(json.dumps({'fixture': mapping}))
    previous = os.environ.get('JIBB_DESK_MAPS')
    os.environ['JIBB_DESK_MAPS'] = str(maps)
    try:
        assert ship.assemble('fixture').files == assembly.files
        rejects(lambda: ship.assemble('unknown'), 'no recorded desk map')
        rejects(lambda: ship.assemble('fixture', lib='value.hoon'), 'cannot replace')
        rejects(lambda: ship.assemble('fixture', golden='custom'), 'cannot replace')
        # Sources remain live inputs, not cached bytes from manifest creation.
        (root / 'value.hoon').write_text('43\n')
        assert ship.assemble('fixture').files['lib/value.hoon'][0] == b'43\n'
    finally:
        if previous is None:
            del os.environ['JIBB_DESK_MAPS']
        else:
            os.environ['JIBB_DESK_MAPS'] = previous

def arm_rejects(operation, fragment):
    try:
        operation()
    except arms.Unusable as error:
        assert fragment in str(error), str(error)
    else:
        raise AssertionError('accepted invalid library dependencies: ' + fragment)


with tempfile.TemporaryDirectory(prefix='jibb-arm-inputs-test-') as folder:
    root = Path(folder)
    suite_dir = root / 'suites'
    suite_dir.mkdir()
    files = {}

    def source(path, text):
        target = root / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        return target

    def library(name, text, path=None):
        target = source(path or 'sources/' + name + '.hoon', text)
        files['lib/' + name + '.hoon'] = (target.read_bytes(), str(target.relative_to(root)))
        return target

    def suite(name, header, directory=suite_dir):
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / (name + '.hoon')
        path.write_text(header + '\n|%\n++  test-smoke\n  %.y\n--\n')
        return arms.Suite(str(path), desk)

    plain = ':: synthetic library\n|%\n++  value  42\n--\n'
    compiler = library('jibb', plain)
    builder = library('jibb-build', plain)
    library('shared', '/+  jibb-build\n' + plain)
    library('left', '/+  shared\n' + plain)
    library('right', '/+  shared\n' + plain)
    library('raw-reader', '/*  builder  %hoon  /lib/jibb-build/hoon\n' + plain)
    library('lookalike', plain)
    files['lib/renamed.hoon'] = files['lib/jibb-build.hoon']
    files['lib/nested/builder.hoon'] = files['lib/jibb-build.hoon']
    link = root / 'sources/builder-link.hoon'
    link.symlink_to(builder)
    files['lib/symlinked.hoon'] = (link.read_bytes(), str(link.relative_to(root)))
    desk = arms.MappedDesk(files)

    with patch.object(arms, 'ROOT', str(root)):
        suites = [
            suite('direct', '/+  jibb-build'),
            suite('transitive', '/+  left'),
            suite('diamond', '/+  left, right'),
            suite('file-read', '/*  builder  %hoon  /lib/jibb-build/hoon'),
            suite('library-file-read', '/+  raw-reader'),
            suite('renamed', '/+  renamed'),
            suite('nested', '/+  nested-builder'),
            suite('symlinked', '/+  symlinked'),
            suite('unrelated', '/+  lookalike'),
            suite('jibb-build', ':: a suite name is not a dependency'),
            suite('ordinary', '/+  jibb'),
        ]
        expected = {'direct', 'transitive', 'diamond', 'file-read',
                    'library-file-read', 'renamed', 'nested', 'symlinked'}
        selected = arms.library_dependents(suites, desk, 'jibb-build', str(compiler))
        assert selected == expected, (selected, expected)
        assert arms.library_dependents(suites, desk, 'renamed', str(compiler)) == expected
        # Every generated program starts with the selected root compiler.
        assert arms.library_dependents(suites, desk, 'jibb', str(compiler)) == {
            item.name for item in suites}

        invalid_dir = root / 'invalid'
        library('cycle-a', '/+  cycle-b\n' + plain)
        library('cycle-b', '/+  cycle-a\n' + plain)
        cycle = suite('cycle', '/+  cycle-a', invalid_dir)
        arm_rejects(lambda: arms.library_dependents([cycle], desk, 'jibb-build', str(compiler)),
                    'cycle')
        missing = suite('missing', '/+  missing', invalid_dir)
        arm_rejects(lambda: arms.library_dependents([missing], desk, 'jibb-build', str(compiler)),
                    'missing')
        library('missing-file', '/*  data  %txt  /missing/txt\n' + plain)
        missing_file = suite('missing-file', '/+  missing-file', invalid_dir)
        arm_rejects(lambda: arms.library_dependents([missing_file], desk, 'jibb-build', str(compiler)),
                    'not on the jibb-dev desk')
        arm_rejects(lambda: arms.library_dependents(suites, desk, 'absent', str(compiler)),
                    'absent')

        def cli(*arguments):
            output = io.StringIO()
            with redirect_stdout(output), redirect_stderr(output):
                try:
                    status = arms.main(['--dir', str(suite_dir), '--lib', str(compiler),
                                        '--list', *arguments])
                except SystemExit as error:
                    status = error.code
            return status, output.getvalue()

        def listed(*arguments):
            status, output = cli(*arguments)
            assert status == 0, output
            return set(re.findall(r'^([a-z0-9-]+) \(', output, re.M))

        fake_ship = SimpleNamespace(assemble=lambda _: desk, Unable=arms.Unusable)
        with patch.object(arms, 'load_ship', return_value=fake_ship), \
                patch.object(arms, 'run', side_effect=AssertionError('unexpected eval')), \
                patch.object(arms, 'run_fast', side_effect=AssertionError('unexpected eval')):
            all_names = {item.name for item in suites}
            assert listed() == all_names
            assert listed('--include-library', 'jibb-build') == expected
            assert listed('--exclude-library', 'jibb-build') == all_names - expected
            ordinary = set()
            for index in range(1, 4):
                shard = ['--shard', '%d/3' % index]
                original = listed(*shard)
                retained = listed(*shard, '--exclude-library', 'jibb-build')
                moved = listed(*shard, '--include-library', 'jibb-build')
                assert retained == original - expected, (index, original, retained)
                assert moved == original & expected, (index, original, moved)
                assert not ordinary & retained
                ordinary.update(retained)
            assert ordinary | expected == all_names and not ordinary & expected
            status, output = cli('--include-library', 'jibb-build',
                                 '--exclude-library', 'jibb-build')
            assert status == 2, output
            mapping = root / 'desk.json'
            mapping.write_text(json.dumps({name: entry[1] for name, entry in files.items()}))
            for option in ('--include-library', '--exclude-library'):
                for conflict in (['--desk-map', str(mapping)], ['--report'], ['--update']):
                    status, output = cli(option, 'jibb-build', *conflict, 'direct')
                    assert status == 2, (option, conflict, output)

bench = importlib.machinery.SourceFileLoader(
    'check_inputs_bench', str(ROOT / 'tools/bench-eval')).load_module()
from noun import atom_to_bytes, cord, from_list, jam


with tempfile.TemporaryDirectory(prefix='jibb-bench-inputs-test-') as folder:
    root = Path(folder)

    def put(path, text):
        target = root / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        return target

    compiler = put('jibb-dev/lib/jibb.hoon', '|%\n++  value  42\n--\n')
    suite = put('tests/lib/fixture.hoon', '/+  jibb\n|%\n'
                '++  test-one\n  ~\n++  test-two\n  ~\n--\n')
    mapping = {'lib/jibb.hoon': 'jibb-dev/lib/jibb.hoon'}
    put('nix/eval-manifest.json', json.dumps({'arm_batches': [{
        'name': 'arms-fixture', 'suites': ['fixture'], 'desk': mapping,
        'paths': ['jibb-dev/lib/jibb.hoon', 'tests/lib/fixture.hoon'],
    }]}))
    for name in ('bench-eval', 'test-arms', 'urbit_eval.py', 'noun.py'):
        put('tools/' + name, 'synthetic tool input\n')
    runtime = put('mock-urbit', 'synthetic runtime\n')
    expected = ['OK fixture test-one', 'OK fixture test-two']

    def benchmark(output, *arguments):
        captured = io.StringIO()
        with redirect_stdout(captured), redirect_stderr(captured):
            status = bench.main(['--batch', 'arms-fixture', '--stage', 'full',
                                 '--output', str(output), *arguments])
        return status, captured.getvalue()

    def frame(lines):
        raw = atom_to_bytes(jam(from_list([cord(line) for line in lines])))
        return b'\0' + len(raw).to_bytes(4, 'little') + raw

    with patch.object(bench, 'ROOT', root), \
            patch.object(bench.arms, 'ROOT', str(root)), \
            patch.object(bench.ue, 'DEFAULT_LIB', str(compiler)), \
            patch.object(bench.ue, 'find_urbit', return_value=str(runtime)):
        dry = root / 'dry'
        with patch.object(bench.subprocess, 'run',
                          side_effect=AssertionError('dry run invoked Hoon')) as process:
            status, output = benchmark(dry, '--dry-run', '--stage', 'wrapped')
            assert status == 0, output
            process.assert_not_called()
            direct = bench.arms.program_for(
                [bench.arms.Suite(str(suite), bench.arms.DESK)], str(compiler), False)
            frozen = dry / 'arms-fixture-full.hoon'
            assert frozen.read_bytes() == direct.encode()
            assert (dry / 'arms-fixture-expected.wain').read_text().splitlines() == expected
            evidence = (dry / 'profile.json').read_bytes()
            status, output = benchmark(dry, '--dry-run')
            assert status == 2, output
            assert (dry / 'profile.json').read_bytes() == evidence
            assert frozen.read_bytes() == direct.encode()

        for name, raw, error, timeout, wanted in [
                ('pass', frame(expected), b'', False, 0),
                ('bail', b'synthetic crash\n', b'eval: bail: %exit\n', False, 1),
                ('wrong-wain', frame(list(reversed(expected))), b'', False, 1),
                ('timeout', b'partial trace\n', b'', True, 1)]:
            def fake_process(command, **kwargs):
                assert command == [str(runtime), 'eval', '-j', '-n']
                assert kwargs['input'] == direct.encode()
                kwargs['stdout'].write(raw)
                kwargs['stderr'].write(error)
                if timeout:
                    raise bench.subprocess.TimeoutExpired(command, kwargs['timeout'])
                return SimpleNamespace(returncode=0)

            destination = root / name
            with patch.object(bench.subprocess, 'run', side_effect=fake_process) as process:
                status, output = benchmark(destination)
                assert status == wanted, (name, status, output)
                assert process.call_count == 1
            record = json.loads((destination / 'arms-fixture-full.json').read_text())
            assert record['ok'] is (wanted == 0), record
            assert record['timed_out'] is timeout, record
            assert (destination / 'arms-fixture-full.stdout').read_bytes() == raw
            if wanted:
                assert (destination / record['failure_file']).read_text().strip()

print('check-inputs: assemblies, library dependencies, partitions and eval profiling passed')
