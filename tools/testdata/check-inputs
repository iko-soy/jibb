# ------------------------------------------------------------ ship sync
# A changed file too big to send for conversion, whose mark stores neither a
# cord nor a wain (a font), is compared by the size and hash of the %mime the
# desk gives back, so sync commits it and only then says the desk matches.
def noun_list(values):
    noun = 0
    for value in reversed(values):
        noun = (value, noun)
    return noun


def clay_noun(rel):
    return noun_list([ship.term(segment) for segment in ship.clay_path(rel)])


def short_hash(data):
    return int.from_bytes(hashlib.sha256(data).digest()[:8], 'little')


class FakeShip:
    """A desk held as {path: bytes}, answering sync's threads as the ship
    would for a cord mark (%hoon), a %kelvin file sent for conversion and
    an %octs font too big to send.  |commit takes the mount's files."""

    def __init__(self, pier, desk, source, mimes=True):
        self.pier, self.desk, self.source, self.mimes = pier, dict(desk), source, mimes
        self.rev, self.commits = 7, 0

    def require(self):
        pass

    def thread(self, hoon, timeout=600):
        if 'kiln-commit' in hoon:
            self.commits += 1
            mount = os.path.join(self.pier, 'my-app')
            self.desk = {}
            for folder, _, names in os.walk(mount):
                for name in names:
                    path = os.path.join(folder, name)
                    self.desk[os.path.relpath(path, mount)] = Path(path).read_bytes()
            self.rev += 1
            return (ship.term('done'), self.rev)
        expect('.^((list path) %ct pre)' in hoon, 'unexpected request:\n' + hoon[:300])
        page, conv, big = [], [], []
        for rel, data in sorted(self.desk.items()):
            mark = ship.clay_path(rel)[-1]
            if mark in ship.BYTE_MARKS:
                page.append((clay_noun(rel), (ship.term('cord'), short_hash(data))))
            else:
                page.append((clay_noun(rel), (ship.term('other'), 0)))
        for rel, data in sorted(self.source.items()):
            mark = ship.clay_path(rel)[-1]
            if mark in ship.BYTE_MARKS:
                continue
            have = self.desk.get(rel)
            if len(data) <= ship.CONV_BYTES:
                conv.append((clay_noun(rel), 0 if have == data else 1))
            elif have is None or not self.mimes:
                big.append((clay_noun(rel), 0))
            else:
                big.append((clay_noun(rel), (0, (len(have), short_hash(have)))))
        manifest_noun = (len(self.desk), (noun_list(conv), (noun_list(big), noun_list(page))))
        return (self.rev, (1 << 64, (0, manifest_noun)))


with tempfile.TemporaryDirectory(prefix='jibb-sync-test-') as pier:
    font = 'ui/static/fonts/inter.woff2'
    old_font, new_font = b'OLD\0' * 40000, b'NEW\0' * 40000    # over CONV_BYTES
    kelvin = b'[%zuse 409]\n'
    library = b'|%\n++  value  42\n--\n'
    source = {font: new_font, 'sys.kelvin': kelvin, 'lib/value.hoon': library}
    mount = os.path.join(pier, 'my-app')

    def put_mount(files):
        shutil.rmtree(mount, ignore_errors=True)
        for rel, data in files.items():
            os.makedirs(os.path.dirname(os.path.join(mount, rel)), exist_ok=True)
            Path(mount, rel).write_bytes(data)

    def sync(fake):
        assembly = ship.Assembly('my-app')
        for rel, data in source.items():
            assembly.add(rel, data, 'my-app/' + rel)
        output = io.StringIO()
        with patch.object(ship, 'ensure_desk', lambda *_args, **_kw: mount), \
                redirect_stdout(output):
            ship.sync_assembly(fake, assembly)
        return output.getvalue()

    stale = dict(source, **{font: old_font})
    fake = FakeShip(pier, stale, source)
    put_mount(stale)
    _, problems, _ = ship.verify(fake, 'my-app', {rel: (data, 'my-app/' + rel)
                                                  for rel, data in source.items()})
    expect(problems == ['/ui/static/fonts/inter/woff2 differs from my-app/' + font], problems)
    said = sync(fake)
    expect(fake.commits == 1 and fake.desk[font] == new_font, (fake.commits, said))
    expect('committed revision 8' in said and 'the desk matches the source' in said, said)
    # Nothing changed: no commit.  Only the mount changed: the desk already
    # matches, so sync restores the mount without a commit, which Clay would
    # ignore and change_and_wait would wait out.
    said = sync(fake)
    expect(fake.commits == 1 and 'nothing to commit' in said, said)
    Path(mount, font).write_bytes(old_font)
    said = sync(fake)
    expect(fake.commits == 1 and Path(mount, font).read_bytes() == new_font and
           'copied +0 ~1 -0; nothing to commit' in said, said)
    # A desk that can't give a big file back as %mime can't be called a match.
    _, problems, _ = ship.verify(FakeShip(pier, source, source, mimes=False), 'my-app',
                                 {rel: (data, 'my-app/' + rel) for rel, data in source.items()})
    expect(problems == ["/ui/static/fonts/inter/woff2 can't be compared with my-app/" + font +
                        ": the desk's %woff2 mark gives it no %mime"], problems)
    big_thread = ship.fill(ship.MANIFEST, DESK='my-app', NOW='now.bowl', FROM='0', COUNT='1',
                           BIG='~[/ui/static/fonts/inter/woff2]', CONV='~')
