#!/usr/bin/env python3
"""Check the exact todo API through the real /sur and mark readers."""
from pathlib import Path
import argparse
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--lib', default=str(root / 'jibb-dev/lib/jibb.hoon'))
args = parser.parse_args()
fixture = root / 'tests/type-api-paths/api.txt'
actual = root / 'my-app/ui/api/todo.jibb'
if fixture.read_bytes() != actual.read_bytes():
    sys.exit('todo API fixture differs from my-app/ui/api/todo.jibb')
reader = (root / 'jibb-dev/lib/jibb-import.hoon').read_text()
tests = (root / 'tests/lib/jibb-todo-api.hoon').read_text()
tests = tests[tests.index('\n|%\n') + 1:]
names = ('sur', 'action', 'todos', 'update', 'item', 'api', 'source',
         'negative', 'unsupported', 'expected', 'negative-expected')
program = ('=/  jibb  .\n=/  jibb-import\n' + reader + '\n' +
           ''.join('=/  ' + name + '=wain  (to-wain:format ' + name + '-text)\n'
                   for name in names) +
           '=/  suite\n' + tests +
           '\n=/  out  (todo-run:suite prelude internal sur-text action-text todos-text update-text item-text api-text source-text negative-text unsupported-text)\n'
           "^-  @t\n(of-wain:format ~[report.out '===NEGATIVE===' bad-report.out '===GUARD===' guards.out])\n")
fixtures = {'sur': 'tests/type-api-paths/todo-sur.txt',
            'action': 'tests/type-api-paths/todo-action.txt',
            'todos': 'tests/type-api-paths/todos.txt',
            'update': 'tests/type-api-paths/todo-update.txt',
            'item': 'tests/type-api-paths/todo-item.txt',
            'api': 'tests/type-api-paths/api.txt',
            **{name: 'tests/type-todo-api/' + name + '.txt'
               for name in ('source', 'negative', 'unsupported', 'expected', 'negative-expected')}}
with tempfile.TemporaryDirectory(prefix='jibb-todo-api-') as tmp:
    path = Path(tmp) / 'todo.hoon'
    path.write_text(program)
    command = [str(root / 'tools/hoon'), '--lib', args.lib, '--raw', '-f', str(path),
               '--cord', 'prelude=' + str(root / 'jibb-dev/lib/jibb/prelude.jibb'),
               '--cord', 'internal=' + str(root / 'jibb-dev/lib/jibb/internal.jibb')]
    for name, filename in fixtures.items():
        command += ['--cord', name + '-text=' + str(root / filename)]
    result = subprocess.run(command, stdout=subprocess.PIPE)
if result.returncode:
    sys.exit(result.returncode)
try:
    positive, rest = result.stdout.split(b'\n===NEGATIVE===\n', 1)
    negative, guard = rest.split(b'\n===GUARD===\n', 1)
except ValueError:
    sys.stderr.buffer.write(result.stdout)
    sys.exit('todo API test output was malformed')
if positive + b'\n' != (root / 'tests/type-todo-api/expected.txt').read_bytes():
    sys.stderr.buffer.write(positive + b'\n')
    sys.exit('todo API positive report differs from expected')
if negative + b'\n' != (root / 'tests/type-todo-api/negative-expected.txt').read_bytes():
    sys.stderr.buffer.write(negative + b'\n')
    sys.exit('todo API negative report differs from expected')
if guard != b'real todo interface and atomic guards passed\n':
    sys.stderr.buffer.write(guard)
    sys.exit('todo API interface guards failed')
print('real todo API reader and partial checker passed')
