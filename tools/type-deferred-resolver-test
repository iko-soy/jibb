#!/usr/bin/env python3
"""Evaluate the source-level deferred-resolver report."""
from pathlib import Path
import argparse, subprocess, sys, tempfile
root = Path(__file__).resolve().parent.parent
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--lib', default=str(root / 'jibb-dev/lib/jibb.hoon'))
a = p.parse_args()
core = (root / 'tests/lib/jibb-deferred-resolver.hoon').read_text()
core = core[core.index('\n|%\n') + 1:]
names = ['good', 'conflict', 'missing', 'hole', 'duplicate', 'face', 'store', 'stability-early', 'stability-late', 'stability-simple-early', 'stability-simple-late', 'stability-output-early', 'stability-output-late', 'stability-slot-early', 'stability-slot-late', 'public', 'internal']
bindings = ''.join('=/  '+n+'=wain  (to-wain:format '+n+'-text)\n' for n in names if n not in ('public', 'internal'))
bindings += ''.join('=/  '+n+'=@t  '+n+'-text\n' for n in ('public', 'internal'))
program = ('=/  jibb  .\n' + bindings + '=/  expected=wain  (to-wain:format expected-text)\n=/  suite\n' + core +
           '\n^-  @t\n=/  checked=tang  test-deferred-resolver:suite\n?~  checked  \'deferred resolver guards passed\'\n(crip "{<checked>}")\n')
with tempfile.TemporaryDirectory(prefix='jibb-deferred-') as d:
    f = Path(d) / 'report.hoon'
    f.write_text(program)
    cmd = [str(root/'tools/hoon'), '--lib', a.lib, '--raw', '-f', str(f)]
    for n in names:
        fixture = (root/'jibb-dev/lib/jibb'/('prelude.jibb' if n == 'public' else 'internal.jibb')) if n in ('public', 'internal') else root/'tests/type-deferred-resolver'/(n+'.txt')
        if not fixture.is_file() or fixture.stat().st_size == 0:
            sys.exit('missing or empty fixture: ' + str(fixture))
        cmd.extend(['--cord', n+'-text='+str(fixture)])
    cmd.extend(['--cord', 'expected-text='+str(root/'tests/type-deferred-resolver/expected.txt')])
    got = subprocess.run(cmd, stdout=subprocess.PIPE)
if got.returncode:
    sys.exit(got.returncode)
want = b'deferred resolver guards passed\n'
if got.stdout != want:
    sys.stderr.write(got.stdout.decode(errors='replace'))
    sys.exit(1)
print('deferred resolver guards passed')
