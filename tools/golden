#!/usr/bin/env python3
"""Run the golden tests through urbit eval, without a ship.

Each case is a folder, tests/golden/<case>/, holding source.jibb and the
expected outputs, tokens.txt (the layout pass) and tree.txt (the
parser).  The runner builds one Hoon program, `!:  =>  <library>
<harness>`, whose harness calls the library's

    ++  golden  |=  [file=path src=@t]  ^-  [tokens=@t tree=@t]

on every case, each under mule so that one crash doesn't stop the rest,
with file set to the case's Clay path, /tests/golden/<case>/source/jibb,
or its logical /ui path from path.txt. Cases with an expect-types: line
or types.txt also call +golden-types and compare its output with types.txt.
Cases with an expect-core: line or core.txt also lower the checked tree and
compare its canonical Core text with core.txt. An optional type-source.jibb
supplies the containing module for a fragment;
type-path.txt and type-exclude-molds.txt select its prelude context.
It runs the program with `urbit eval`, decodes the jammed result, and
compares each output with its file, which holds the output plus one
trailing newline.

A crash's output is CRASH and its trace.  A crash always fails, and
--update never writes one.

Exit status: 0 when every case passes, 1 when a case fails or crashes,
2 when the tests can't run (the library doesn't compile, a usage error).
"""

import argparse
import concurrent.futures
import difflib
import fnmatch
import os
import re
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import urbit_eval as ue  # noqa: E402
import golden_case  # noqa: E402
import prelude_groups  # noqa: E402
from noun import atom_to_bytes  # noqa: E402

DEFAULT_DIR = os.path.join(ue.ROOT, 'tests', 'golden')
MAGIC = b'jibb-golden'
KNOT = re.compile(r'^[a-z0-9\-.~_]+$')

HARNESS = r"""::  The harness tools/golden writes after the library.  It runs
::  golden:lib on each case under mule and returns one cord of fields,
::  each <length>:<bytes>, first jibb-golden and the case count, then
::  per case its name, status, tokens, tree, types, Core and module trees.
::
=>  [lib=. ..zuse]
|^  %+  rap  3
    :~  (fields ~['jibb-golden' '{count}'])
{runs}
    ==
::
++  run
  |=  [name=@t metadata=[logical=(unit path) check=? imports=(list [module=term mold=term source=@t]) marks=(list [name=term source=@t]) module-check=? modules=(list [label=@t at=path source=@t]) context=(unit @t) excluded=(list term) type-path=(unit path) core-check=?] src=@t]
  ^-  @t
  =/  at=path  ?~(logical.metadata (file name) u.logical.metadata)
  =/  parsed  (mule |.((golden:lib at src)))
  ?:  ?=(%| -.parsed)
    =/  why=@t  (crash p.parsed)
    (fields ~[name 'crash' why why why why why])
  =/  out=[tokens=@t tree=@t]  p.parsed
  =/  type-src=@t  ?~(context.metadata src u.context.metadata)
  =/  type-at=path  ?~(type-path.metadata at u.type-path.metadata)
  =/  typed  (mule |.({types-expr}))
  ?:  ?=(%| -.typed)
    (fields ~[name 'types-crash' tokens.out tree.out (crash p.typed) '' ''])
  =/  cored=(each @t tang)
    ?.  core-check.metadata  [%& '']
    %-  mule
      |.
        {core-expr}
  ?:  ?=(%| -.cored)
    (fields ~[name 'core-crash' tokens.out tree.out p.typed (crash p.cored) ''])
  =/  modules  (mule |.({modules-expr}))
  ?:  ?=(%| -.modules)
    (fields ~[name 'modules-crash' tokens.out tree.out p.typed p.cored (crash p.modules)])
  (fields ~[name 'ok' tokens.out tree.out p.typed p.cored p.modules])
::
++  file
  |=  name=@
  ^-  path
  ~[%tests %golden name %source %jibb]
::
++  text
  |=  lines=(list @t)
  ^-  @t
  (rap 3 lines)
::
++  crash
  |=  why=tang
  ^-  @t
  =/  lines=wall  (zing (turn (flop why) |=(a=tank (wash [0 80] a))))
  (rap 3 (join '\0a' `(list @t)`['CRASH' (turn lines crip)]))
::
++  fields
  |=  a=(list @t)
  ^-  @t
  %+  rap  3
  %+  turn  a
  |=  b=@t
  (rap 3 ~[(crip (a-co:co (met 3 b))) ':' b ','])
{import-helper}
{module-helper}
{prelude-helper}
--
"""

MODULE_HELPER = r"""
++  module-trees
  |=  fixtures=(list [label=@t at=path source=@t])
  ^-  @t
  %+  rap  3
  %+  join  '\0a'
  %+  turn  fixtures
  |=  fixture=[label=@t at=path source=@t]
  ~_  leaf+(trip label.fixture)
  =/  out  (golden:lib at.fixture source.fixture)
  (rap 3 ~[label.fixture '\0a' tree.out])
"""

IMPORT_HELPER = r"""
++  import-types
  |=  fixtures=(list [module=term mold=term source=@t])
  ^-  (list [module=term name=term result=*])
  %+  turn  fixtures
  |=  fixture=[module=term mold=term source=@t]
  ~_  leaf+"/sur/{(trip module.fixture)}.txt fixture"
  =/  source=@t  (fixture-text source.fixture)
  ?~  source  !!
  =/  cor=type  -:(ride -:!>(..zuse) source)
  =/  result=*  (read-named-diagnostic:reader module.fixture mold.fixture cor)
  [module.fixture mold.fixture ?:(?=(%ok -.result) [%& +.result] result)]
::
++  import-mark-sources
  |=  fixtures=(list [module=term mold=term source=@t])
  ^-  (list [module=term at=path source=@t])
  =/  seen=(list term)  ~
  |-
  ?~  fixtures  ~
  =/  duplicate=?  (lien seen |=(name=term =(name module.i.fixtures)))
  =.  seen  [module.i.fixtures seen]
  =/  rest=(list [module=term at=path source=@t])  $(fixtures t.fixtures)
  ?:  duplicate  rest
  [[module.i.fixtures ~[%sur module.i.fixtures %hoon] (fixture-text source.i.fixtures)] rest]
::
++  import-marks
  |=  [fixtures=(list [name=term source=@t]) surs=(list [module=term mold=term source=@t])]
  ^-  (list [name=term result=*])
  =/  sources=(list [module=term at=path source=@t])  (import-mark-sources surs)
  %+  turn  fixtures
  |=  fixture=[name=term source=@t]
  ~_  leaf+"/mar/{(trip name.fixture)}.txt fixture"
  =/  source=@t  (fixture-text source.fixture)
  ?~  source  !!
  =/  cor=type  -:(ride -:!>(..zuse) source)
  =/  result=*  (read-mark-source:reader name.fixture sources cor)
  [name.fixture ?:(?=(%& -.result) result (read-mark-diagnostic:reader name.fixture cor))]
::  Clay's %txt mark supplies lines, with a newline reconstructed per line.
++  fixture-text
  |=  source=@t
  ^-  @t
  (rap 3 (turn (to-wain:format source) |=(line=@t (cat 3 line '\0a'))))
"""


EPILOG = """\
A file holds its output plus one trailing newline.  A crash's output is
CRASH and its trace; a crash always fails, and --update never writes one.

Exit status: 0 when every case passes, 1 when a case fails or crashes, 2
when the tests can't run, as when the library doesn't compile.
"""


class Case:
    def __init__(self, name, folder):
        self.name = name
        self.folder = folder
        self.source_path = os.path.join(folder, 'source.jibb')
        try:
            self.logical_path = golden_case.source_path(folder)
            self.imports = golden_case.sur_imports(folder)
            self.marks = golden_case.mark_imports(folder)
            self.modules = golden_case.module_fixtures(folder)
            self.want_modules = golden_case.wants_modules(folder)
            self.excluded = golden_case.excluded_prelude_molds(folder)
            self.type_path = golden_case.type_path(folder)
            self.contract = golden_case.type_contract(folder)
        except ValueError as e:
            raise ue.ToolError(str(e))
        self.want_types = golden_case.wants_types(folder)
        self.want_core = golden_case.wants_core(folder)
        type_path = os.path.join(folder, 'type-source.jibb')
        self.type_source = None
        if os.path.isfile(type_path):
            with open(type_path, 'rb') as f:
                self.type_source = f.read()
        with open(self.source_path, 'rb') as f:
            self.source = f.read()
        self.crashed = False
        self.crash_kind = 'tokens'  # the output holding a crash's trace
        self.crash_at = None    # the innermost library spot of a crash
        self.outputs = {}       # 'tokens' and 'tree' -> bytes


def find_cases(root, globs):
    if not os.path.isdir(root):
        raise ue.ToolError('no such folder: %s' % ue.display_path(root))
    cases = []
    for name in sorted(os.listdir(root)):
        folder = os.path.join(root, name)
        if not os.path.isdir(folder):
            continue
        if not os.path.isfile(os.path.join(folder, 'source.jibb')):
            warn('skipping %s: it has no source.jibb' % ue.display_path(folder))
            continue
        if globs and not any(fnmatch.fnmatchcase(name, g) for g in globs):
            continue
        cases.append(Case(name, folder))
    return cases


def run_lines(case):
    """The harness's call for one case.  The source is written one line
    per cord, each but the last ending in its newline, so that a NUL
    before a newline survives; only NULs ending the file are lost, as
    they are in Clay, where the file is one atom.  A long line is cut
    into several cords, as Hoon reads a long cord literal in about
    quadratic time (ue.cord_pieces)."""
    lines = ue.cord_pieces(case.source)
    fixtures = []
    for module, mold, path in case.imports:
        with open(path, 'rb') as f:
            parts = ue.cord_pieces(f.read())
        source = '(rap 3 `(list @t)`~[%s])' % ' '.join(ue.cord_literal(p) for p in parts)
        fixtures.append('[%%%s %%%s %s]' % (module, mold, source))
    imports = '~[' + ' '.join(fixtures) + ']' if fixtures else '~'
    fixtures = []
    for name, path in case.marks:
        with open(path, 'rb') as f:
            parts = ue.cord_pieces(f.read())
        source = '(rap 3 `(list @t)`~[%s])' % ' '.join(ue.cord_literal(p) for p in parts)
        fixtures.append('[%%%s %s]' % (name, source))
    marks = '~[' + ' '.join(fixtures) + ']' if fixtures else '~'
    fixtures = []
    for logical, at, path in case.modules:
        with open(path, 'rb') as f:
            parts = ue.cord_pieces(f.read())
        source = '(rap 3 `(list @t)`~[%s])' % ' '.join(ue.cord_literal(p) for p in parts)
        fixtures.append('[%s %s %s]' % (ue.cord_literal(logical.encode()), at, source))
    modules = '~[' + ' '.join(fixtures) + ']' if fixtures else '~'
    context = '~'
    if case.type_source is not None:
        parts = ue.cord_pieces(case.type_source)
        context = '[~ (rap 3 `(list @t)`~[%s])]' % ' '.join(ue.cord_literal(p) for p in parts)
    excluded = '~[' + ' '.join('%' + n for n in case.excluded) + ']' if case.excluded else '~'
    out = ['        %%^  run  %s  [%s %s %s %s %s %s %s %s %s %s]' % (
               ue.cord_literal(case.name.encode()),
               '`' + case.logical_path if case.logical_path else '~',
               '%.y' if case.want_types else '%.n', imports, marks,
               '%.y' if case.want_modules else '%.n', modules, context, excluded,
               '`' + case.type_path if case.type_path else '~',
               '%.y' if case.want_core else '%.n'),
           '        %-  text',
           '        :~  ' + ue.cord_literal(lines[0])]
    out += ['            ' + ue.cord_literal(line) for line in lines[1:]]
    out.append('        ==')
    return out


def golden_program(lib_path, cases):
    prog = ue.library_program(lib_path)
    runs = '\n'.join(line for case in cases for line in run_lines(case))
    has_marks = any(c.marks for c in cases)
    has_modules = any(c.modules for c in cases)
    has_core = any(c.want_core for c in cases)
    has_module_types = any(c.want_modules and (c.want_types or c.want_core)
                           for c in cases)
    group_sources, private_sources, reader_sources = [], [], []
    if has_module_types:
        try:
            group_sources, private_sources, reader_sources = prelude_groups.load_all(ue.ROOT)
        except ValueError as error:
            raise ue.ToolError(str(error)) from error
    imported = any(c.imports or c.marks for c in cases)
    needs_reader = imported or bool(reader_sources)
    has_excluded = any(c.excluded for c in cases)
    harness = HARNESS
    if has_core:
        core = ue.read_text(os.path.join(ue.ROOT, 'jibb-dev', 'lib', 'jibb-core.hoon'))
        lower = ue.read_text(os.path.join(ue.ROOT, 'jibb-dev', 'lib', 'jibb-lower.hoon'))
        lower = '|%\n' + lower.split('\n|%\n', 1)[1]
        harness = harness.replace(
            '=>  [lib=. ..zuse]',
            '=/  jibb-lib  .\n=/  core-lib\n=>  ..zuse\n' + core +
            '\n=/  lower-lib\n=>  :*  jibb=jibb-lib  jibb-core=core-lib  ..zuse\n==\n' +
            lower + '\n=>  [lib=jibb-lib core-lib=core-lib lower-lib=lower-lib ..zuse]')
    if needs_reader:
        reader = ue.read_text(os.path.join(ue.ROOT, 'jibb-dev', 'lib', 'jibb-import.hoon'))
        if has_core:
            harness = harness.replace(
                '=>  [lib=jibb-lib core-lib=core-lib lower-lib=lower-lib ..zuse]',
                '=/  reader\n' + reader +
                '\n=>  [lib=jibb-lib reader=reader core-lib=core-lib lower-lib=lower-lib ..zuse]')
        else:
            harness = harness.replace('=>  [lib=. ..zuse]',
                                      '=/  jibb-lib  .\n=/  reader\n' + reader +
                                      '\n=>  [lib=jibb-lib reader=reader ..zuse]')
    types_value = ("(golden-types-with-marks:lib type-at type-src "
                  "(import-types imports.metadata) (import-marks marks.metadata imports.metadata))"
                  if has_marks else
                  "?~(imports.metadata (golden-types:lib type-at type-src) "
                  "(golden-types-imports:lib type-at type-src (import-types imports.metadata)))"
                  if imported else "(golden-types:lib type-at type-src)")
    if has_module_types:
        def source_expression(data):
            return '(rap 3 `(list @t)`~[%s])' % ' '.join(
                ue.cord_literal(part) for part in ue.cord_pieces(data))
        group_expression = '~[' + ' '.join(
            '[%%%s %s %s]' % (face, prelude_groups.hoon_path(path), source_expression(data))
            for face, path, _, data in group_sources) + ']' if group_sources else '~'
        private_entries = ['[%s %s]' % (prelude_groups.hoon_path(path), source_expression(data))
                           for _, path, _, data in private_sources]
        reader_paths = set()
        for _, _, path, _, data in reader_sources:
            if path not in reader_paths:
                private_entries.append('[%s %s]' % (prelude_groups.sur_path(path), source_expression(data)))
                reader_paths.add(path)
        private_expression = '~[' + ' '.join(private_entries) + ']' if private_entries else '~'
        reader_entries = ['[%%%s %%%s %s %s]' % (module, name, prelude_groups.sur_path(path), source_expression(data))
                          for module, name, path, _, data in reader_sources]
        reader_expression = ("(turn `(list [module=term name=term at=path source=@t])`~[" + ' '.join(reader_entries) + "] |=(entry=[module=term name=term at=path source=@t] =/(built=(each type tang) (mule |.(-:(ride -:!>(..zuse) source.entry))) [module.entry name.entry ?:(?=(%| -.built) [%| 'Hoon source could not be built'] (read-generic-source:reader module.entry name.entry at.entry source.entry p.built))])))") if reader_entries else '~'

        surs = '(import-types imports.metadata)' if imported else '~'
        marks = '(import-marks marks.metadata imports.metadata)' if imported else '~'
        modules = '(turn modules.metadata |=(item=[label=@t at=path source=@t] [at.item source.item]))'
        prepared = '`(without-molds u.prepared-prelude excluded.metadata)' if has_excluded else 'prepared-prelude'
        types_value = ('?:(module-check.metadata ?~(prepared-prelude '
                       '(golden-types-with-prelude-and-group-evidence:lib type-at type-src %s %s %s prelude-source internal-source prelude-group-sources prelude-group-modules prelude-reader-inputs) '
                       '(golden-types-with-prepared-prelude:lib type-at type-src %s %s %s %s)) %s)'
                       % (surs, marks, modules, surs, marks, modules, prepared, types_value))
    types_expr = '?:(check.metadata %s \'\')' % types_value
    simple_surs = '(import-types imports.metadata)' if imported else '~'
    simple_marks = '(import-marks marks.metadata imports.metadata)' if imported else '~'
    core_check = ('(check-jibb-file-for-lowering:lib type-at type-src %s %s ~ ~[type-at] ~ ~ ~ ~)'
                  % (simple_surs, simple_marks))
    if has_module_types:
        core_check = ('(check-jibb-file-for-lowering-prepared:lib type-at type-src %s %s %s ~[type-at] ~ u.prepared-lowering)'
                      % (surs, marks, modules))
    core_body = ('=/  built=jlowering-result:lib  %s\n'
                 '        ?:  ?=(%%| -.built)  (cat 3 \'lowering check failed: \' message.p.built)\n'
                 '        =/  lowered=(each module:core-lib @t)  (lower-checked-module:lower-lib root.p.built)\n'
                 '        ?:  ?=(%%| -.lowered)  (cat 3 \'Core lowering failed: \' p.lowered)\n'
                 '        (print-module:core-lib p.lowered)' % core_check)
    core_value = core_body
    if has_module_types:
        core_value = "?~  prepared-lowering  'prelude lowering preparation failed'\n        " + core_body
    prelude_helper = ''
    if has_module_types:
        prelude_path = os.path.join(ue.ROOT, 'jibb-dev', 'lib', 'jibb', 'prelude.jibb')
        try:
            with open(prelude_path, 'rb') as f:
                parts = ue.cord_pieces(f.read())
        except OSError as e:
            raise ue.ToolError('cannot read the Jibb prelude %s: %s' % (prelude_path, e))
        internal_path = os.path.join(ue.ROOT, 'jibb-dev', 'lib', 'jibb', 'internal.jibb')
        try:
            with open(internal_path, 'rb') as f:
                internal_parts = ue.cord_pieces(f.read())
        except OSError as e:
            raise ue.ToolError('cannot read the internal Jibb prelude %s: %s' % (internal_path, e))
        prelude_helper = """++  without-molds
  |=  [prepared=iprelude:lib excluded=(list term)]
  ^-  iprelude:lib
  =/  kept=imold-types:lib
    (skim molds.iface.prepared |=(m=[name=term template=ischeme:lib] !(lien excluded |=(n=term =(n name.m)))))
  =/  names=(list term)
    (skim molds.prepared |=(n=term !(lien excluded |=(x=term =(x n)))))
  [iface.prepared(molds kept) values.prepared names]
""" if has_excluded else ''
        prelude_helper += "++  prelude-source\n  ^-  @t\n  (rap 3 `(list @t)`~[%s])\n" % (
            ' '.join(ue.cord_literal(p) for p in parts))
        prelude_helper += "++  internal-source\n  ^-  @t\n  (rap 3 `(list @t)`~[%s])\n" % (
            ' '.join(ue.cord_literal(p) for p in internal_parts))
        prelude_expr = '(rap 3 `(list @t)`~[%s])' % (
            ' '.join(ue.cord_literal(p) for p in parts))
        internal_expr = '(rap 3 `(list @t)`~[%s])' % (
            ' '.join(ue.cord_literal(p) for p in internal_parts))
        prelude_preparation = (
            '=/  prepared-prelude\n'
            '  =/  prep  (mule |.((prepare-prelude-with-group-evidence:lib %s %s prelude-group-sources prelude-group-modules prelude-reader-inputs)))\n'
            '  ?:(?=(%%& -.prep) p.prep ~)'
            % (prelude_expr, internal_expr))
        if has_core:
            prelude_preparation = (
                '=/  prepared-lowering\n'
                '  =/  prep  (mule |.((prepare-prelude-with-group-evidence-for-lowering:lib %s %s prelude-group-sources prelude-group-modules prelude-reader-inputs)))\n'
                '  ?:(?=(%%& -.prep) p.prep ~)\n'
                % (prelude_expr, internal_expr)) + prelude_preparation
        #  Under mule: when preparing the prelude crashes, the cases that
        #  need it prepare it again under their own mule and fail with the
        #  trace, and the other cases still run.
        harness = harness.replace(
            '|^  %+  rap  3',
            '=/  prelude-group-sources  %s\n'
            '=/  prelude-group-modules  %s\n'
            '=/  prelude-reader-inputs  %s\n'
            '%s\n'
            '|^  %%+  rap  3' % (group_expression, private_expression, reader_expression, prelude_preparation))
    prog.add(harness.replace('{count}', str(len(cases)))
                    .replace('{runs}', runs)
                    .replace('{types-expr}', types_expr if any(c.want_types for c in cases) else "''")
                    .replace('{core-expr}', core_value if has_core else "''")
                    .replace('{import-helper}', IMPORT_HELPER if imported else '')
                    .replace('{modules-expr}', '(module-trees modules.metadata)' if has_modules else "''")
                    .replace('{module-helper}', MODULE_HELPER if has_modules else '')
                    .replace('{prelude-helper}', prelude_helper),
             '(harness)', 'harness')
    return prog


def parse_fields(data):
    """Split <length>:<bytes>, fields; raise ValueError if malformed."""
    fields, i = [], 0
    while i < len(data):
        colon = data.index(b':', i)
        end = colon + 1 + int(data[i:colon].replace(b'.', b''))
        if data[end:end + 1] != b',':
            raise ValueError('field at byte %d has no closing comma' % i)
        fields.append(data[colon + 1:end])
        i = end + 1
    return fields


def crash_text(prog, lines):
    """A CRASH output, its spots mapped to the library and the harness's
    frames, which depend on the batch, dropped; and where it crashed."""
    mapped, spots = ue.map_trace(prog, lines, keep=('lib',))
    text = '\n'.join(ue.fold_repeats(mapped)).encode('utf-8', 'surrogateescape')
    return text, ue.focus(spots)


def decode(prog, noun, cases):
    if not isinstance(noun, int):
        raise ue.ToolError('the harness returned a cell, not a cord')
    try:
        fields = parse_fields(atom_to_bytes(noun))
    except ValueError as e:
        raise ue.ToolError('the harness output is malformed: %s' % e)
    if fields[:2] != [MAGIC, str(len(cases)).encode()] or \
            len(fields) != 2 + 7 * len(cases):
        raise ue.ToolError('the harness output has the wrong shape')
    for i, case in enumerate(cases):
        name, status, tokens, tree, types, core, modules = fields[2 + 7 * i:9 + 7 * i]
        if name != case.name.encode():
            raise ue.ToolError('the harness output is out of order at %s'
                               % case.name)
        case.crashed = status in (b'crash', b'types-crash', b'core-crash', b'modules-crash')
        if status == b'crash':
            tokens, case.crash_at = crash_text(
                prog, tokens.decode('utf-8', 'surrogateescape').split('\n'))
            tree = types = core = tokens
        elif status == b'types-crash':
            case.crash_kind = 'types'
            types, case.crash_at = crash_text(
                prog, types.decode('utf-8', 'surrogateescape').split('\n'))
        elif status == b'core-crash':
            case.crash_kind = 'core'
            core, case.crash_at = crash_text(
                prog, core.decode('utf-8', 'surrogateescape').split('\n'))
        elif status == b'modules-crash':
            case.crash_kind = 'module-trees'
            modules, case.crash_at = crash_text(
                prog, modules.decode('utf-8', 'surrogateescape').split('\n'))
        case.outputs = {'tokens': tokens, 'tree': tree}
        if case.want_types:
            case.outputs['types'] = types
        if case.want_core:
            case.outputs['core'] = core
        if case.modules:
            case.outputs['module-trees'] = modules


def eval_crash(prog, res, case):
    """Mark a case crashed when its whole eval failed."""
    case.crashed = True
    out, case.crash_at = crash_text(prog, ['CRASH', res.describe()] + res.trace)
    case.outputs = {'tokens': out, 'tree': out}
    if case.want_types:
        case.outputs['types'] = out
    if case.want_core:
        case.outputs['core'] = out


def run_cases(lib_path, cases, opts):
    """Run the cases in one eval.  If the eval itself dies, which mule
    can't stop (out of memory, a timeout), split them in two and run each
    half, at most opts.jobs evals at once, until the cases that kill it
    run alone."""
    pool = concurrent.futures.ThreadPoolExecutor(opts.jobs)
    try:
        pending = {pool.submit(run_batch, lib_path, cases, opts, True)}
        while pending:
            done, pending = concurrent.futures.wait(
                pending, return_when=concurrent.futures.FIRST_COMPLETED)
            for f in done:
                for part in f.result():
                    pending.add(pool.submit(run_batch, lib_path, part, opts,
                                            False))
    finally:
        #  On an error or ^C, drop the evals that haven't started.
        pool.shutdown(wait=False, cancel_futures=True)


def run_batch(lib_path, cases, opts, top):
    """Run cases in one eval; the halves to run again if the eval died."""
    prog = golden_program(lib_path, cases)
    if opts.save_program and top:
        with open(opts.save_program, 'wb') as f:
            f.write(prog.encode())
    res = ue.run_eval(prog, jam=True, timeout=opts.timeout)
    if res.ok:
        decode(prog, res.noun, cases)
        return []
    if res.is_compile_error():
        lib = ue.display_path(lib_path)
        signature = ("error: the golden harness doesn't compile "
                     "against %s, whose golden arm must be\n"
                     "  ++  golden  |=  [file=path src=@t]  ^-  [tokens=@t tree=@t]"
                     % lib)
        if any(c.want_types for c in cases):
            signature += ("\nand whose golden-types arm must be\n"
                          "  ++  golden-types  |=  [file=path src=@t]  ^-  @t")
        report = ue.failure_report(
            prog, res, "error: %s doesn't compile" % lib,
            harness_headline=signature)
        hint = ue.lib_hint(ue.read_text(lib_path))
        raise ue.ToolError(report + ('\n\n' + hint if hint else ''))
    if len(cases) == 1:
        eval_crash(prog, res, cases[0])
        return []
    half = len(cases) // 2
    warn('%s while running %d cases at once; running each half to find '
         'which' % (res.describe(), len(cases)))
    return [cases[:half], cases[half:]]


# Output

def colour(code, text):
    return '\x1b[%sm%s\x1b[0m' % (code, text) if USE_COLOUR else text


def warn(msg):
    print('golden: ' + msg, file=sys.stderr)


def visible(line):
    """A diff line with control characters shown as \\xNN."""
    return re.sub(r'[\x00-\x1f\x7f]',
                  lambda m: '\\x%02x' % ord(m.group()), line)


def diff_lines(path, expected, actual):
    """A unified diff of a file's text against an output, or a note."""
    label = ue.display_path(path)
    act = actual.decode('utf-8', 'surrogateescape').split('\n')
    if expected is None:
        old, fromfile = [], '/dev/null'
    else:
        text = expected.decode('utf-8', 'surrogateescape')
        old = (text[:-1] if text.endswith('\n') else text).split('\n')
        fromfile = label
    out = []
    for line in difflib.unified_diff(old, act, fromfile=fromfile,
                                     tofile=label + ' (actual)', lineterm=''):
        line = visible(line)
        if line.startswith(('+++', '---')):
            out.append(colour('1', line))
        elif line.startswith('@@'):
            out.append(colour('36', line))
        elif line.startswith('+'):
            out.append(colour('32', line))
        elif line.startswith('-'):
            out.append(colour('31', line))
        else:
            out.append(line)
    if not out:
        out.append('%s differs only at its end: a file holds the output '
                   'plus one newline' % label)
    return out


def contract_problems(case):
    """Check diagnostic quality independently of its exact golden text."""
    if case.crashed or not case.contract:
        return []
    actual = case.outputs['types'].decode('utf-8', 'surrogateescape')
    lines = actual.splitlines()
    sites = [line for line in lines if re.match(r'^/[^\s:]+:[1-9][0-9]*:[1-9][0-9]*: ', line)]
    problems = []
    for kind, value in case.contract:
        if kind == 'message':
            if not lines or value not in lines[0]:
                problems.append('type contract requires diagnostic message ' + value)
            continue
        if kind == 'min-sites':
            if len(sites) < int(value):
                problems.append('type contract requires %s diagnostic sites; got %d' % (value, len(sites)))
            continue
        matches = [line[len(value)+2:] for line in sites if line.startswith(value + ': ')]
        if not matches:
            problems.append('type contract requires site ' + value)
        elif kind == 'typed-site' and not any(
                any(token in note for token in ('type', '@', '$-', '(list ', '(unit '))
                for note in matches):
            problems.append('type contract requires a type at ' + value)
        elif kind == 'unresolved-site' and not any(
                ('constructor' in note or 'tag' in note) and
                ('unresolved' in note or 'not fixed' in note) for note in matches):
            problems.append('type contract requires an unresolved tag or constructor at ' + value)
    return problems


def compare(case):
    """PASS or FAIL lines for one case."""
    if case.crashed:
        out = [colour('31', 'FAIL') + '  %s: crashed' % case.name]
        out += ['  ' + l for l in case.outputs[case.crash_kind]
                .decode('utf-8', 'surrogateescape').split('\n')]
        if case.crash_at is not None:
            out += ['  at %s' % case.crash_at.label(),
                    case.crash_at.excerpt(indent='    ')]
        return False, out
    problems = contract_problems(case)
    for kind in case.outputs:
        path = os.path.join(case.folder, kind + '.txt')
        want = case.outputs[kind] + b'\n'
        if os.path.isfile(path):
            with open(path, 'rb') as f:
                expected = f.read()
            if expected == want:
                continue
            problems += diff_lines(path, expected, case.outputs[kind])
        else:
            problems.append('%s is missing; tools/golden --update writes '
                            'it.  The output:' % ue.display_path(path))
            problems += diff_lines(path, None, case.outputs[kind])
    if not problems:
        return True, [colour('32', 'PASS') + '  ' + case.name]
    return False, ([colour('31', 'FAIL') + '  ' + case.name] +
                   ['  ' + l for l in problems])


def update(case):
    """Write a case's outputs; returns the paths written."""
    written = []
    for kind in case.outputs:
        path = os.path.join(case.folder, kind + '.txt')
        want = case.outputs[kind] + b'\n'
        try:
            with open(path, 'rb') as f:
                if f.read() == want:
                    continue
        except FileNotFoundError:
            pass
        with open(path, 'wb') as f:
            f.write(want)
        written.append(path)
    return written


def show(case):
    out = []
    for kind in case.outputs:
        out.append(colour('1', '==> %s: %s <==' % (case.name, kind)))
        out.append(case.outputs[kind].decode('utf-8', 'surrogateescape'))
    return out


def main(argv):
    ap = argparse.ArgumentParser(
        prog='tools/golden',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description='Run the golden tests (tests/golden/<case>/source.jibb) '
                    'through urbit eval and compare the outputs with '
                    'tokens.txt, tree.txt and any opted-in types.txt/core.txt.',
        epilog=EPILOG)
    ap.add_argument('--dir', default=DEFAULT_DIR,
                    help='the folder of cases (default: tests/golden).  The '
                    'file path passed to golden defaults to '
                    '/tests/golden/<case>/source/jibb; path.txt overrides it')
    ap.add_argument('--case', action='append', default=[], metavar='GLOB',
                    help='only cases whose name matches GLOB; repeatable')
    ap.add_argument('--lib', default=ue.DEFAULT_LIB, metavar='PATH',
                    help='the library (default: jibb-dev/lib/jibb.hoon)')
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument('--update', action='store_true',
                      help='write tokens.txt, tree.txt and opted-in types/core outputs')
    mode.add_argument('--show', action='store_true',
                      help='print the outputs without comparing')
    ap.add_argument('--timeout', type=float, default=600, metavar='SECONDS',
                    help='how long one urbit eval may run (default: 600)')
    ap.add_argument('--jobs', type=int, default=2, metavar='N',
                    help='evals at once when the cases are split up to find '
                    'which one kills the eval (default: 2)')
    ap.add_argument('--save-program', metavar='FILE',
                    help='also write the generated Hoon program to FILE')
    opts = ap.parse_args(argv)
    # Outputs that aren't UTF-8 are held with surrogateescape; print them
    # back out as the bytes they were.
    sys.stdout.reconfigure(errors='surrogateescape')

    try:
        cases = find_cases(os.path.abspath(opts.dir), opts.case)
        if not cases:
            raise ue.ToolError('no cases in %s%s' % (
                ue.display_path(opts.dir),
                ' match ' + ' '.join(opts.case) if opts.case else ''))
        if not os.path.isfile(opts.lib):
            raise ue.ToolError('no library at %s' % ue.display_path(opts.lib))
        for case in cases:
            if not KNOT.match(case.name):
                warn("%s isn't a knot (@ta), so the case can't be put in "
                     "Clay" % case.name)
        if sys.stderr.isatty():
            print('running %d case%s under urbit eval...' % (
                len(cases), '' if len(cases) == 1 else 's'),
                file=sys.stderr, flush=True)
        start = time.time()
        run_cases(os.path.abspath(opts.lib), cases, opts)
        took = time.time() - start
    except ue.ToolError as e:
        print(str(e), file=sys.stderr)
        return 2

    crashed = [c for c in cases if c.crashed]
    contract_failed = [c for c in cases if contract_problems(c)]
    if opts.show:
        for case in cases:
            print('\n'.join(show(case)))
            for problem in contract_problems(case):
                print('type contract: ' + problem)
        return 1 if crashed or contract_failed else 0

    if opts.update:
        written = []
        for case in cases:
            if case.crashed:
                print('\n'.join(compare(case)[1]))
                print('  not written: a crash is never an expected output')
                continue
            problems = contract_problems(case)
            if problems:
                print('FAIL  %s: %s' % (case.name, '; '.join(problems)))
                print('  not written: the type contract is not satisfied')
                continue
            for path in update(case):
                written.append(path)
                print('wrote %s' % ue.display_path(path))
        print('%d file%s written, %d case%s crashed (%.1f s)' % (
            len(written), '' if len(written) == 1 else 's',
            len(crashed), '' if len(crashed) == 1 else 's', took))
        return 1 if crashed or contract_failed else 0

    failed = 0
    for case in cases:
        ok, lines = compare(case)
        failed += not ok
        print('\n'.join(lines))
    passed = len(cases) - failed
    summary = '%d case%s: %d passed, %d failed' % (
        len(cases), '' if len(cases) == 1 else 's', passed, failed)
    if crashed:
        summary += ' (%d crashed)' % len(crashed)
    print(colour('32' if not failed else '31', summary) +
          ' (%.1f s)' % took)
    return 1 if failed else 0


USE_COLOUR = sys.stdout.isatty() and not os.environ.get('NO_COLOR')

if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
