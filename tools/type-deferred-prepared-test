#!/usr/bin/env python3
"""Evaluate prepared-prelude initializer recovery and report guards."""
from pathlib import Path
import argparse, subprocess, sys, tempfile
root = Path(__file__).resolve().parent.parent
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--lib', default=str(root/'jibb-dev/lib/jibb.hoon'))
p.add_argument('--hoon', default=str(root/'tools/hoon'))
a = p.parse_args()
core = (root / 'tests/lib/jibb-deferred-prepared.hoon').read_text()
core = core[core.index('\n|%\n') + 1:]
names = ['good', 'tuple-only', 'wrong-unit', 'wrong-draft', 'unrelated-tag', 'mold-collision',
         'no-final-cast', 'no-prelude', 'main', 'imported', 'expected', 'expected-control',
         'expected-tuple-only']
bindings = ''.join('=/  '+('main-source' if n == 'main' else n)+'=wain  (to-wain:format '+n+'-text)\n' for n in names)
at = '/ui/prepared/jibb'
checks = ['(check-prepared:suite %s %s %s)' % (where, source, valid)
          for where, source, valid in (
              (at, 'good', '&'), (at, 'tuple-only', '&'), (at, 'no-prelude', '&'),
              (at, 'wrong-unit', '|'), (at, 'wrong-draft', '|'),
              (at, 'unrelated-tag', '|'), (at, 'mold-collision', '|'),
              (at, 'no-final-cast', '|'), (at, 'main-source', '|'),
              (at, 'imported', '|'),
              ('/ui/api/prepared/jibb', 'good', '|'),
              ('/ui/stores/prepared/jibb', 'good', '|'))]
checks += ['check-no-prelude:suite', 'check-ordinary:suite', 'check-prepared-binding:suite',
           '(check-report:suite good expected)', '(check-report:suite tuple-only expected-tuple-only)',
           '(check-report:suite no-final-cast expected-control)']
with tempfile.TemporaryDirectory(prefix='jibb-deferred-prepared-') as d:
    f = Path(d) / 'report.hoon'
    for check in checks:
        program = ('=/  jibb  .\n' + bindings + '=/  suite\n' + core +
                   "\n^-  @t\n=/  checked=tang  " + check + "\n?~  checked  'prepared deferred inference guards passed'\n(crip \"{<checked>}\")\n")
        f.write_text(program)
        cmd = [a.hoon, '--lib', a.lib, '--raw', '-f', str(f),
               '--cord', 'prelude='+str(root/'jibb-dev/lib/jibb/prelude.jibb'),
               '--cord', 'internal='+str(root/'jibb-dev/lib/jibb/internal.jibb')]
        for n in names:
            fixture = root/'tests/type-deferred-prepared'/(n+'.txt')
            if not fixture.is_file() or fixture.stat().st_size == 0:
                sys.exit('missing or empty fixture: '+str(fixture))
            cmd.extend(['--cord', n+'-text='+str(fixture)])
        got = subprocess.run(cmd, stdout=subprocess.PIPE)
        if got.returncode:
            sys.exit(got.returncode)
        if got.stdout != b'prepared deferred inference guards passed\n':
            sys.stderr.write(got.stdout.decode(errors='replace'))
            sys.exit(1)
print('prepared deferred inference guards passed')
