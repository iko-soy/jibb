def build_state(ship, desk):
    """The revisions of the desk's last completed build and of the build in
    progress, each None when there is none."""
    done, running = scry(ship, '/gx/=jibb=/build/%s/noun' % desk,
                         '[(unit @ud) (unit @ud)]')
    return (None if done == 0 else done[1],
            None if running == 0 else running[1])


def module_revisions(ship, desk):
    """For the completed build, the revision whose build checked each module."""
    value = scry(ship, '/gx/=jibb=/modules/%s/noun' % desk, '(list [path @ud])')
    return {shiptool.path_text(at): rev for at, rev in shiptool.items(value)}


def wait_built(ship, desk, rev=0, timeout=1800):
    """Wait until a build at revision rev or later has completed and no other
    is running; its revision."""
    def done():
        finished, running = build_state(ship, desk)
        if running is None and finished is not None and finished >= rev:
            return finished
        return None
    with timed_phase('wait for build', desk=desk, revision=rev):
        return wait_for('%s to build revision %d' % (desk, rev), done, timeout)


def commit_file(ship, rel, data):
    """Write one fixture file, or delete it when data is None, and commit;
    the new revision."""
    return commit_files(ship, {rel: data})


def commit_files(ship, changes, *, desk=DESK):
    """Write or delete several desk files in one commit; the new revision."""
    with timed_phase('commit desk files', desk=desk, files=sorted(changes)):
        for rel, data in changes.items():
            path = os.path.join(ship.pier, desk, rel)
            if data is None:
                os.remove(path)
            else:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, 'wb') as f:
                    f.write(data)
        return shiptool.commit_and_wait(ship, desk, REPLY)


def commit_note(ship, data):
    """Commit new text for the fixture's note library; the new revision."""
    return commit_file(ship, NOTE_FILE, data)


def raw_clay_file(ship, desk, rel):
    """Read a unit of the stored noun, retaining each mark's representation."""
    thread = r"""
=/  m  (strand ,vase)
;<  =bowl:spider  bind:m  get-bowl
=/  pre=path  (en-beam [our.bowl %@@DESK@@ da+now.bowl] /)
=/  pax=path  (weld pre @@PATH@@)
%-  pure:m
!>  ^-  (unit *)
?.  .^(? %cu pax)  ~
[~ .^(* %cx pax)]
"""
    return ship.thread(shiptool.fill(
        thread, DESK=desk, PATH=shiptool.hoon_path(shiptool.clay_path(rel))),
        timeout=REPLY)


def republish_cached_app(ship, client, modules_before, urls_before):
    """Republish cleared my-app assets without dropping its compiler cache."""
    desk = 'my-app'
    # A visible root .txt file triggers Clay's revision watch without changing
    # any UI, library, imported type, mark, or published static file.
    marker = 'jibb-check-republish.txt'
    path = Path(ship.pier) / desk / marker
    original = path.read_bytes() if path.exists() else None
    clay_original = raw_clay_file(ship, desk, marker)
    committed = False
    try:
        payload = (original or b'') + b'\nJibb acceptance cached republish.\n'
        rev = commit_files(ship, {marker: payload}, desk=desk)
        committed = True
        wait_built(ship, desk, rev)
        expect(module_revisions(ship, desk) == modules_before,
               'republishing my-app after clear rechecked its modules')
    finally:
        with timed_phase('restore my-app republish marker'):
            # Restore source bytes even if writing or acknowledging the first
            # commit failed. An unaccepted first commit needs no new revision.
            if original is None:
                if path.exists():
                    path.unlink()
            else:
                path.write_bytes(original)
            if committed or raw_clay_file(ship, desk, marker) != clay_original:
                restored = shiptool.commit_and_wait(ship, desk, REPLY)
                wait_built(ship, desk, restored)
            actual = path.read_bytes() if path.exists() else None
            expect(actual == original, 'my-app republish marker source was not restored')
            expect(raw_clay_file(ship, desk, marker) == clay_original,
                   'my-app republish marker was not restored in Clay')
    expect(module_revisions(ship, desk) == modules_before,
           'restoring my-app republish marker rechecked its modules')
    expect(published(ship, desk) == {url: None for url in urls_before},
           'cached my-app republish changed its active asset URLs')
    for url in sorted(urls_before):
        status, headers, _ = client.request('GET', url)
        expect(status == 200, 'republished my-app asset %s was HTTP %d' % (url, status))
        expect(headers.get('cache-control') == IMMUTABLE,
               'republished my-app asset %s was not immutable' % url)


def expect_render_error(client, target, file, line, column, message, excerpt):
    """A failed render's exact source diagnostic, after HTML unescaping."""
    status, _, body = client.request('GET', target)
    expect(status == 500, '%s was HTTP %d, not 500: %r' % (target, status, body))
    found = re.search(rb'<pre>(.*?)</pre>', body, re.DOTALL)
    expect(found is not None, '%s had no diagnostic element: %r' % (target, body))
    actual = html.unescape(found.group(1).decode())
    expected = '%s:%d:%d: %s\n%s\n%s^' % (
        file, line, column, message, excerpt, ' ' * (column - 1))
    expect(actual == expected, '%s diagnostic was\n%s\nnot\n%s' % (target, actual, expected))


def wait_for(what, probe, timeout=600):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        try:
            value = probe()
            if value is not None:
                return value
            last = 'condition is not ready'
        except (OSError, ValueError, urllib.error.URLError,
                shiptool.Fail, shiptool.Unable) as error:
            last = str(error)
        time.sleep(1)
    raise ValueError('timed out waiting for %s: %s' % (what, last))


def desk_tests(ship, desk):
    """-jibb!test's outcomes for a desk: (module, [(arm, ok, message)])."""
    value = ship.thread(TEST.replace('@@DESK@@', desk), timeout=REPLY)
    modules = []
    for entry in shiptool.items(value):
        at, tests = entry
        modules.append((shiptool.path_text(at), [
            (shiptool.text(arm), ok == 0, shiptool.text(message))
            for arm, (ok, message) in shiptool.items(tests)]))
    return modules


def http_port(pier):
    ports = Path(pier) / '.http.ports'
    for line in ports.read_text().splitlines():
        words = line.split()
        if len(words) == 3 and words[1:] == ['insecure', 'public']:
            return int(words[0])
    raise ValueError('no insecure public HTTP port in %s' % ports)


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--clients', action='store_true',
                        help='run browser and Node acceptance before final suspension')
    parser.add_argument('--leave-suspended', action='store_true',
                        help='after success, leave the fixture suspended for pier shutdown')
    return parser.parse_args()


@timed_phase('total')
def main(args):
    ship = shiptool.Ship(shiptool.PIER, None, shiptool.CLICK)
    ship.require()
    original_note = (ROOT / 'tests' / 'host-fixture' / 'desk' / NOTE_FILE).read_bytes()
    dot = (ROOT / 'tests' / 'host-fixture' / 'desk' / DOT_FILE).read_bytes()
    suspended = False
    application_suspended = False
    edited = False
    dot_edited = False
    broken = False
    compiler_broken = False
    diagnostics = False
    cleared = False
    compiler = os.path.join('lib', 'jibb-build.hoon')
    good_compiler = None
    host_ready = False
    passed = False
    try:
        with timed_phase('suspend applications before host installation'):
            # Create minimal desks first, so suspension is effective even on a
            # fresh pier. Keep old host code from building newly synced sources.
            for desk in (DESK, 'my-app'):
                shiptool.ensure_desk(ship, desk)
            suspended = True
            application_suspended = True
            poke(ship, 'kiln-suspend-many', '~[%%%s %%my-app]' % DESK)
            wait_suspended(ship, (DESK, 'my-app'))

        with timed_phase('sync fixture'):
            shiptool.sync(ship, DESK, timeout=300)

        with timed_phase('sync my-app'):
            shiptool.sync(ship, 'my-app', timeout=300)

        with timed_phase('sync host'):
            shiptool.sync(ship, 'jibb', timeout=300)

        with timed_phase('install host with suspended applications'):
            poke(ship, 'kiln-revive', '%jibb')
            wait_for('host agent installation', lambda: route_count(ship) >= 0 or None)
            host_ready = True
            wait_suspended(ship, (DESK, 'my-app'))
            for desk in (DESK, 'my-app'):
                expect_unbuilt(ship, desk)

        with timed_phase('fresh fixture build'):
            # The first accepted discovery builds from the current desk; no
            # earlier host build or published files can supply the result.
            poke(ship, 'kiln-revive', '%' + DESK)
            suspended = False
            wait_for('initial fixture route', lambda: route_present(ship) or None)
            first = wait_built(ship, DESK, timeout=3600)

        with timed_phase('HTTP session setup'):
            origin = 'http://127.0.0.1:%d' % http_port(ship.pier)
            anonymous = Client(origin)
            cookies = http.cookiejar.CookieJar()
            owner = Client(origin, cookies)
            status, _, _ = owner.request(
                'POST', '/~/login', urllib.parse.urlencode({'password': PASSWORD}).encode())
            expect(status == 200, 'owner login failed with HTTP %d' % status)

        good_compiler = (Path(ship.pier) / DESK / compiler).read_bytes()
        with timed_phase('fresh my-app build'):
            expect_unbuilt(ship, 'my-app')
            started = time.monotonic()
            poke(ship, 'kiln-revive', '%my-app')
            application_suspended = False
            wait_for('real application route', lambda: route_present(ship, 'my-app') or None)
            wait_built(ship, 'my-app', timeout=3600)
            print('check-host: my-app\'s first build took %.0f s' % (time.monotonic() - started))

        with timed_phase('static HTTP and published assets'):
            wait_for('acknowledged static build', lambda: route_present(ship) or None)
            target = PAGE + '?tab=1&x=2'
            status, headers, body = anonymous.request('GET', target)
            expect(status == 307, 'logged-out request was HTTP %d, not 307' % status)
            expected = '/~/login?redirect=' + urllib.parse.quote(target, safe='')
            expect(headers.get('location') == expected,
                   'login target differed: %r != %r' % (headers.get('location'), expected))
            expect(body == b'', 'logged-out redirect unexpectedly had a body')

            status, headers, body = owner.request('GET', PAGE)
            expect(status == 200, 'owner About request was HTTP %d: %r' % (status, body))
            expect(headers.get_content_type() == 'text/html',
                   'About content type was %r' % headers.get('content-type'))
            expect(headers.get('cache-control') is None,
                   'private About response requested Eyre caching')
            for text in ('About this ship', BASE + '/blog',
                         'Hosted on Urbit. This page ships no JavaScript.'):
                expect(text.encode() in body, 'rendered About page is missing %r' % text)
            expect(b'<script' not in body, 'static About page contained JavaScript')
            expect(CSP in body, 'About did not carry its Content-Security-Policy')

            # The theme's stylesheet is a public, immutable file in Eyre's cache.
            sheets = STYLESHEET.findall(body)
            expect(len(sheets) == 1 and sheets[0].startswith((BASE + '/~jibb/s/0v').encode())
                   and sheets[0].endswith(b'.css'),
                   'About did not link one hashed stylesheet: %r' % sheets)
            stylesheet = sheets[0].decode()
            css = fetch_public(anonymous, stylesheet, 'text/css; charset=utf-8').decode()
            for text in (':root{--j-s1:4px;', '.j-column,.j-stack{display:flex;flex-direction:column}',
                         '.j-tone-accent{color:var(--j-accent)}', 'h1{font-size:2rem;'):
                expect(text in css, 'the stylesheet is missing %r' % text)
            expect('@font-face' not in css, 'the default theme loaded a font')

            status, headers, body = owner.request('HEAD', PAGE)
            expect(status == 200, 'HEAD About request was HTTP %d' % status)
            expect(headers.get_content_type() == 'text/html', 'HEAD lost HTML content type')
            expect(body == b'', 'HEAD returned a body')

            for target in (BASE, BASE + '/missing', BASE + '/static/missing.js',
                           BASE + '/parts/note'):
                status, _, _ = owner.request('GET', target)
                expect(status == 404, '%s was HTTP %d, not 404' % (target, status))
            expect_gone(anonymous, (BASE + '/static/0v1/img/dot.png', BASE + '/~jibb/s/0v1.css'),
                        'a static file no build made')
            status, headers, _ = owner.request('POST', PAGE, b'ignored=1')
            expect(status == 405, 'POST About request was HTTP %d, not 405' % status)
            expect(headers.get('allow') == 'GET, HEAD', '405 Allow header was not GET, HEAD')

            # A commit that changes one module checks only it and its importer
            # again; the other modules keep the revision their check came from.
            status, _, body = owner.request('GET', BASE + '/blog')
            expect(status == 200 and b'Nothing here yet.' in body,
                   'the blog page About links to was HTTP %d: %r' % (status, body))

            # A generic /sur mold checks; a misspelled one is the importer's own
            # diagnostic, at its site.
            status, _, body = owner.request('GET', BASE + '/tables')
            expect(status == 200 and b'A generic mold checked.' in body,
                   'the page with a generic /sur mold was HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', BASE + '/misspelled')
            expect(status == 500 and b'Hoon mold `tabel` is not declared' in body
                   and b'/ui/misspelled.jibb:8:15' in body,
                   'a misspelled /sur mold was HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', NOTES)
            expect(status == 200 and b'First note' in body,
                   'the notes page was HTTP %d: %r' % (status, body))

            # The notes page's image is sized from its file, at a URL naming a
            # hash of its bytes.
            dot_url, alt, width, height = notes_image(owner)
            expect(dot_url.startswith(BASE + '/static/0v') and dot_url.endswith('/img/dot.png'),
                   'the image was not at a hashed static URL: %r' % dot_url)
            expect((alt, width, height) == ('A green dot', 3, 2),
                   'the image was not described and sized from its file: %r'
                   % ((alt, width, height),))
            fetch_public(anonymous, dot_url, 'image/png', dot)
            # Its islands' JavaScript and the browser library are public,
            # immutable files too, at URLs naming a hash of their text.
            scripts = {url for url in published(ship, DESK)
                       if '/~jibb/m/' in url or '/~jibb/r/' in url}
            library = [url for url in scripts if '/~jibb/r/' in url]
            modules = [url for url in scripts if '/~jibb/m/' in url]
            expect(len(library) == 1 and len(modules) == 4,
                   'the fixture published scripts %r, not one library and its four islands'
                   % sorted(scripts))
            fetch_public(anonymous, library[0], 'text/javascript; charset=utf-8',
                         (ROOT / 'jibb-dev' / 'lib' / 'jibb' / 'runtime.js').read_bytes())
            for url in modules:
                body = fetch_public(anonymous, url, 'text/javascript; charset=utf-8')
                expect(body.startswith(b'// Generated from Jibb Core. Do not edit.'),
                       'an island module was not generated JavaScript: %r' % body[:80])
            # Two different pages use the same island with different data. Its
            # file belongs to the module, not to either page or initial model.
            island_hashes = []
            for route in ('/bench', '/bench-small'):
                status, _, body = owner.request('GET', BASE + route)
                expect(status == 200, '%s was HTTP %d' % (route, status))
                hashes = re.findall(rb'data-jibb-island="([^"]+)"', body)
                expect(len(hashes) == 1, '%s did not render exactly one island' % route)
                island_hashes.append(hashes[0].decode())
            expect(island_hashes[0] == island_hashes[1],
                   'two pages compiled the same island to different module files')
            expect(BASE + '/~jibb/m/' + island_hashes[0] + '.js' in modules,
                   'the shared island does not reference its published module')
            files = {stylesheet: None, dot_url: None, **{url: None for url in scripts}}
            expect(published(ship, DESK) == files,
                   'the fixture published %r' % published(ship, DESK))

        with timed_phase('note library incremental rebuild and restore'):
            before = module_revisions(ship, DESK)
            expect(set(before) == FIXTURE_MODULES,
                   'the fixture build checked %r' % sorted(before))
            expect(all(rev == first for rev in before.values()),
                   'the fresh fixture build reused earlier checks: %r' % before)
            edited = True
            rev = commit_note(ship, original_note.replace(b'First note', b'Second note'))
            wait_built(ship, DESK, rev)
            after = module_revisions(ship, DESK)
            expect(set(after) == FIXTURE_MODULES, 'the rebuild checked %r' % sorted(after))
            rechecked = {at for at, at_rev in after.items() if at_rev != before[at]}
            expect(rechecked == NOTE_CLOSURE,
                   'a commit to the note library checked %r again, not only it and '
                   'its importer' % sorted(rechecked))
            expect(all(after[at] == rev for at in NOTE_CLOSURE),
                   'the changed modules did not check at revision %d: %r' % (rev, after))
            status, _, body = owner.request('GET', NOTES)
            expect(status == 200 and b'Second note' in body and b'First note' not in body,
                   'the rebuilt notes page was not served: HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', PAGE)
            expect(status == 200 and b'About this ship' in body,
                   'About did not survive the rebuild: HTTP %d: %r' % (status, body))
            rev = commit_note(ship, original_note)
            edited = False
            wait_built(ship, DESK, rev)
            status, _, body = owner.request('GET', NOTES)
            expect(status == 200 and b'First note' in body,
                   'the restored notes page was not served: HTTP %d: %r' % (status, body))
            expect(published(ship, DESK) == files,
                   'editing a module changed the published files: %r' % published(ship, DESK))

        with timed_phase('static asset change deletion and restore'):
            # A changed file gets a new URL, and the old one stays a day for
            # pages already open.  A missing file is its page's compile error.
            changed = png(4, 5, (0x17, 0x73, 0x4f))
            dot_edited = True
            rev = commit_file(ship, DOT_FILE, changed)
            wait_built(ship, DESK, rev)
            new_url, _, width, height = notes_image(owner)
            expect(new_url != dot_url and (width, height) == (4, 5),
                   'the changed image was %r at %dx%d' % (new_url, width, height))
            fetch_public(anonymous, new_url, 'image/png', changed)
            fetch_public(anonymous, dot_url, 'image/png', dot)
            urls = published(ship, DESK)
            expect(urls.get(new_url, 0) is None and urls.get(stylesheet, 0) is None,
                   'the build did not publish its files: %r' % urls)
            expiry = urls.get(dot_url)
            expect(isinstance(expiry, int) and
                   abs(unix_time(expiry) - (time.time() + 86400)) < 3600,
                   'the replaced image was not kept for a day: %r' % urls)
            rev = commit_file(ship, DOT_FILE, None)
            wait_built(ship, DESK, rev)
            expect_render_error(
                owner, NOTES, '/ui/notes.jibb', 9, 5,
                'missing static asset: /static/img/dot.png',
                '    image %/static/img/dot.png "A green dot"')
            status, _, body = owner.request('GET', PAGE)
            expect(status == 200 and b'About this ship' in body,
                   'About did not survive a missing image elsewhere: HTTP %d' % status)
            rev = commit_file(ship, DOT_FILE, dot)
            dot_edited = False
            wait_built(ship, DESK, rev)
            expect(notes_image(owner)[0] == dot_url, 'the restored image changed its URL')
            fetch_public(anonymous, dot_url, 'image/png', dot)
            urls = published(ship, DESK)
            expect(urls.get(dot_url, 0) is None and isinstance(urls.get(new_url), int),
                   'restoring the image did not swap the files back: %r' % urls)

        with timed_phase('render diagnostics and restore'):
            # Host render diagnostics belong to the element's original call, even
            # through imported aliases and outer layouts, not to the page's root.
            diagnostics = True
            rev = commit_files(ship, DIAGNOSTIC_FILES)
            wait_built(ship, DESK, rev)
            expect_render_error(
                owner, BASE + '/diagnostics/direct', '/ui/diagnostics/direct.jibb', 4, 13,
                'link to a missing page: %/nowhere',
                '    para ~[(link %/nowhere "Nested")]')
            expect_render_error(
                owner, BASE + '/diagnostics/imported', '/ui/diagnostics/parts.jibb', 2, 11,
                'missing static asset: /static/img/gone.png',
                '  para ~[(image %/static/img/gone.png "Imported")]')
            expect_render_error(
                owner, BASE + '/diagnostics/data', '/ui/diagnostics/data.jibb', 4, 11,
                'missing static asset: /static/img/gone.png',
                '  para ~[(image %/static/img/gone.png "Data")]')
            expect_render_error(
                owner, BASE + '/diagnostics/island-page', '/ui/diagnostics/island.jibb', 6, 11,
                'link to a missing page: %/nowhere',
                '  para ~[(link %/nowhere "Island")]')
            status, _, body = owner.request('GET', BASE + '/diagnostics/island-page')
            expect(b'This part of the page stopped working' not in body,
                   'an island reference error became its crash notice')
            rev = commit_file(ship, DOT_FILE, b'odd')
            dot_edited = True
            wait_built(ship, DESK, rev)
            expect_render_error(
                owner, BASE + '/diagnostics/unreadable', '/ui/diagnostics/unreadable.jibb', 1, 10,
                'static image has no size this build can read: /static/img/dot.png',
                '++ main (image %/static/img/dot.png "Unreadable")')
            changes = {name: None for name in DIAGNOSTIC_FILES}
            changes[DOT_FILE] = dot
            rev = commit_files(ship, changes)
            diagnostics = False
            dot_edited = False
            wait_built(ship, DESK, rev)
            status, _, _ = owner.request('GET', BASE + '/diagnostics/direct')
            expect(status == 404, 'a deleted diagnostic page was HTTP %d, not 404' % status)

        with timed_phase('broken import and recovery'):
            # An imported /sur file that does not build is that page's error;
            # the build still completes and the other pages are unaffected.
            broken = True
            rev = commit_file(ship, BROKEN_FILE, BROKEN_SOURCE)
            wait_built(ship, DESK, rev)
            status, _, body = owner.request('GET', BROKEN)
            expect(status == 500 and
                   b'cannot build imported Hoon source /sur/unused.hoon' in body,
                   'a page importing an unbuildable /sur was HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', PAGE)
            expect(status == 200 and b'About this ship' in body,
                   'About did not survive a broken import elsewhere: HTTP %d' % status)
            rev = commit_file(ship, BROKEN_FILE, None)
            broken = False
            wait_built(ship, DESK, rev)
            status, _, _ = owner.request('GET', BROKEN)
            expect(status == 404, 'a deleted page was HTTP %d, not 404' % status)

        with timed_phase('broken compiler and recovery'):
            # A build that cannot run, here because the desk's compiler does not
            # build, keeps the last good pages and their files.
            compiler_broken = True
            rev = commit_file(ship, compiler, good_compiler + b'\n!!!\n')
            wait_built(ship, DESK, rev)
            status, _, body = owner.request('GET', PAGE)
            expect(status == 200 and b'About this ship' in body,
                   'a build whose compiler does not build replaced About: HTTP %d: %r'
                   % (status, body))
            fetch_public(anonymous, stylesheet, 'text/css; charset=utf-8', css.encode())
            rev = commit_file(ship, compiler, good_compiler)
            compiler_broken = False
            wait_built(ship, DESK, rev)

        with timed_phase('application theme and dynamic HTTP'):
            # my-app's theme names a font, its dark tones and a wider layout.
            status, _, body = owner.request('GET', MY_APP_BASE + '/about')
            expect(status == 200 and b'About this ship' in body,
                   'my-app About was HTTP %d: %r' % (status, body))
            sheets = STYLESHEET.findall(body)
            expect(len(sheets) == 1, 'my-app About did not link one stylesheet: %r' % sheets)
            app_css = fetch_public(anonymous, sheets[0].decode(), 'text/css; charset=utf-8').decode()
            fonts = FONT.findall(app_css)
            expect(len(fonts) == 1 and fonts[0].startswith(MY_APP_BASE + '/static/0v')
                   and fonts[0].endswith('/fonts/inter.woff2'),
                   'my-app\'s stylesheet did not load its theme font: %r' % fonts)
            fetch_public(anonymous, fonts[0], 'font/woff2', FONT_FILE.read_bytes())
            for text in ('@media (prefers-color-scheme:dark){:root{--j-normal:#eee;',
                         '@media (min-width:60rem){.j-stack{flex-direction:row}}'):
                expect(text in app_css, 'my-app\'s stylesheet is missing %r' % text)
            # Pages with data render per request from a fresh scry of my-app's
            # %blog agent; nothing about them is cached.
            status, headers, body = owner.request('GET', MY_APP_BASE + '/blog')
            expect(status == 200 and b'Hello, Urbit' in body and b'Pages from a scry' in body,
                   'worked example 2 was HTTP %d: %r' % (status, body))
            expect(headers.get('cache-control') is None, 'a page with data asked to be cached')
            status, _, body = owner.request('GET', MY_APP_BASE + '/blog/hello-urbit')
            expect(status == 200 and b'<h1' in body and b'Hello, Urbit' in body
                   and b'address is hello-urbit.' in body,
                   'the _slug page was HTTP %d: %r' % (status, body))
            status, _, body = owner.request('HEAD', MY_APP_BASE + '/blog/hello-urbit')
            expect(status == 200 and body == b'', 'HEAD of a page with data was HTTP %d: %r'
                   % (status, body))
            status, headers, _ = anonymous.request('GET', MY_APP_BASE + '/blog/hello-urbit')
            expect(status == 307, 'a logged-out reader of a page with data got HTTP %d' % status)
            status, _, body = owner.request('GET', MY_APP_BASE + '/blog/no-such-post')
            expect(status == 404 and b'did not answer /post/no-such-post' in body,
                   'a path the agent rejects was HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', MY_APP_BASE + '/blog/malformed')
            expect(status == 500 and b'does not fit its type' in body,
                   'an answer that does not fit its type was HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', MY_APP_BASE + '/blog/Not%20a%20knot')
            expect(status == 404 and b'is not a @ta' in body,
                   'a segment that is not a knot was HTTP %d: %r' % (status, body))
            ship.thread(shiptool.fill(shiptool.POKE, AGENT='blog', MARK='noun',
                                      VALUE="[%add 'Fresh from a poke' ~.fresh-post]"),
                        timeout=REPLY)
            status, _, body = owner.request('GET', MY_APP_BASE + '/blog')
            expect(status == 200 and b'Fresh from a poke' in body,
                   'worked example 2 did not read a fresh scry: HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', MY_APP_BASE + '/blog/fresh-post')
            expect(status == 200 and b'Fresh from a poke' in body,
                   'the _slug page did not read a fresh scry: HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', BASE + '/numbered/12')
            expect(status == 200 and b'Number 12' in body,
                   'a page with a @ud parameter was HTTP %d: %r' % (status, body))
            status, _, body = owner.request('GET', BASE + '/numbered/twelve')
            expect(status == 404 and b'is not a @ud' in body,
                   'an unparseable parameter was HTTP %d: %r' % (status, body))
            for _ in range(2):
                status, _, body = owner.request('GET', BASE + '/crash')
                expect(status == 500 and b'crashed in its view' in body,
                       'a crashing render was HTTP %d: %r' % (status, body))
            # buttons is a library with the expected 3:16 error: it is not a page.
            for target in (MY_APP_BASE + '/todo-list', MY_APP_BASE + '/stores/cart',
                           MY_APP_BASE + '/components/card', MY_APP_BASE + '/api/todo',
                           MY_APP_BASE + '/components/buttons'):
                status, _, body = owner.request('GET', target)
                expect(status == 404, 'non-page %s was HTTP %d, not 404: %r' % (target, status, body))

        with timed_phase('published cache contents'):
            status, _, body = owner.request('GET', '/~debug/eyre/cache.json')
            expect(status == 200, 'could not read Eyre cache: HTTP %d' % status)
            cache = json.loads(body)
            fixture_files = set(published(ship, DESK))
            app_files = set(published(ship, 'my-app'))
            cached = {entry.get('url') for entry in cache}
            # An entry whose val is null is one Eyre no longer serves: a file
            # an earlier build retired.
            private = [entry for entry in cache
                       if entry.get('val') is not None
                       and any(base in entry.get('url', '') for base in (BASE, MY_APP_BASE))
                       and entry.get('url') not in fixture_files | app_files]
            expect(not private, 'a private page appeared in Eyre cache: %r' % private)
            expect(fixture_files | app_files <= cached,
                   'published files were not in Eyre cache: %r'
                   % sorted((fixture_files | app_files) - cached))

        with timed_phase('desk Nock tests'):
            # -jibb!test runs each test- arm under /ui/tests as Nock.
            for desk, wanted in EXPECTED_TESTS.items():
                got = desk_tests(ship, desk)
                expect(got == wanted, '-jibb!test %%%s gave %r, not %r' % (desk, got, wanted))

        with timed_phase('clear cache and republish'):
            # -jibb!clear takes every desk's files out of Eyre's cache; the next
            # build publishes its files again.
            app_modules_before_clear = module_revisions(ship, 'my-app')
            cleared = True
            ship.thread(CLEAR, timeout=REPLY)
            expect(published(ship, DESK) == {} and published(ship, 'my-app') == {},
                   'clearing left published files')
            expect_gone(anonymous, sorted(fixture_files | app_files), 'after -jibb!clear')
            edited = True
            rev = commit_note(ship, original_note.replace(b'First note', b'Third note'))
            wait_built(ship, DESK, rev)
            expect(published(ship, DESK) == files,
                   'the build after clearing published %r' % published(ship, DESK))
            fetch_public(anonymous, stylesheet, 'text/css; charset=utf-8', css.encode())
            fetch_public(anonymous, dot_url, 'image/png', dot)
            rev = commit_note(ship, original_note)
            edited = False
            wait_built(ship, DESK, rev)

        with timed_phase('cached my-app republish after clear'):
            republish_cached_app(ship, anonymous, app_modules_before_clear, app_files)
            # Earlier failures retain the cold-rebuild fallback in cleanup.
            cleared = False

        if args.clients:
            for name in ('check-browser', 'check-node-tests'):
                with timed_phase('run ' + name):
                    result = subprocess.run([sys.executable, str(ROOT / 'tools' / name)])
                    expect(result.returncode == 0,
                           '%s exited with status %d' % (name, result.returncode))

        with timed_phase('suspend fixture'):
            suspended = True
            poke(ship, 'kiln-suspend-many', '~[%%%s]' % DESK)
            wait_for('route removal after suspend', lambda: not route_present(ship) or None)
            status, _, _ = owner.request('GET', PAGE)
            expect(status == 404, 'suspended desk route was HTTP %d, not 404' % status)
            expect(published(ship, DESK) == {}, 'a suspended desk kept published files')
            # Out of Eyre's cache, the files fall to Eyre's other bindings, which
            # send a logged-out reader to the login page: ask as the owner.
            expect_gone(owner, (stylesheet, dot_url), 'after suspending the desk')

        print('check-host: default theme, real Clay imports, page kinds, static files, '
              'stylesheets, pages with data, -jibb!test, -jibb!clear, incremental rebuild, '
              'HTTP and suspend passed')
        passed = True
        return 0
    finally:
        if not (passed and args.leave_suspended):
            with timed_phase('cleanup and revival'):
                try:
                    # Leave the dedicated fixture usable for a subsequent run, including
                    # when an assertion above fails. This revives only our fixture desk.
                    if edited:
                        commit_note(ship, original_note)
                    if dot_edited:
                        commit_file(ship, DOT_FILE, dot)
                    if broken:
                        commit_file(ship, BROKEN_FILE, None)
                    if compiler_broken:
                        commit_file(ship, compiler, good_compiler)
                    if diagnostics:
                        commit_files(ship, {name: None for name in DIAGNOSTIC_FILES})
                    poke(ship, 'kiln-revive', '%' + DESK)
                    if suspended and host_ready:
                        wait_for('fixture revival after acceptance', lambda: route_present(ship) or None)
                finally:
                    try:
                        if cleared and not application_suspended:
                            # Earlier failures may leave my-app without its files.
                            application_suspended = True
                            poke(ship, 'kiln-suspend-many', '~[%my-app]')
                            wait_for('application suspension after clearing',
                                     lambda: not route_present(ship, 'my-app') or None)
                    finally:
                        if application_suspended:
                            poke(ship, 'kiln-revive', '%my-app')


if __name__ == '__main__':
    try:
        sys.exit(main(parse_args()))
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError,
            urllib.error.URLError, shiptool.Fail, shiptool.Unable) as error:
        print('check-host: %s' % error, file=sys.stderr)
        sys.exit(1)
