_TIMING_STACK = []


def timing_record(record):
    destination = os.environ.get('JIBB_CHECK_TIMINGS')
    if destination:
        with open(destination, 'a', encoding='utf-8') as stream:
            stream.write(json.dumps(record, sort_keys=True) + '\n')
            stream.flush()


@contextmanager
def timed_phase(name, *, tool=None, **details):
    """Report inclusive wall time without changing the phase's result/errors.

    Browser and Node runners may reuse this helper, optionally naming ``tool``.
    By default the executable name labels the runner; depth distinguishes phase
    totals from nested commit/build waits.
    JIBB_CHECK_TIMINGS optionally receives flushed JSONL start/finish records,
    even when the parent check runner buffers stdout until this tool exits.
    """
    runner = tool or Path(sys.argv[0]).name
    depth = len(_TIMING_STACK)
    print('%s: begin %s' % (runner, name), flush=True)
    record = {'tool': runner, 'name': name, 'depth': depth, 'details': details}
    timing_record(dict(record, event='start', elapsed=0, status='running'))
    _TIMING_STACK.append(name)
    started = time.monotonic()
    completed = False
    try:
        yield
        completed = True
    finally:
        elapsed = time.monotonic() - started
        _TIMING_STACK.pop()
        status = 'completed' if completed else 'failed'
        print('%s: %s %s in %.3f s' % (runner, name, status, elapsed), flush=True)
        timing_record(dict(record, event='finish', elapsed=round(elapsed, 6), status=status))


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Client:
    def __init__(self, origin, cookies=None):
        handlers = [NoRedirect()]
        if cookies is not None:
            handlers.append(urllib.request.HTTPCookieProcessor(cookies))
        self.origin = origin
        self.opener = urllib.request.build_opener(*handlers)

    def request(self, method, target, data=None):
        req = urllib.request.Request(self.origin + target, data=data, method=method)
        try:
            with self.opener.open(req, timeout=REPLY) as response:
                return response.status, response.headers, response.read()
        except urllib.error.HTTPError as response:
            with response:
                return response.code, response.headers, response.read()


def expect(condition, message):
    if not condition:
        raise ValueError(message)


def poke(ship, mark, value):
    ship.thread(shiptool.fill(shiptool.POKE, AGENT='hood', MARK=mark, VALUE=value),
                timeout=REPLY)


def desk_zests(ship, desks):
    """Read Clay's current state, independently of host installation."""
    value = ship.thread(shiptool.fill(
        DESK_ZESTS, DESKS='~[%s]' % ' '.join('%' + desk for desk in desks)),
        timeout=REPLY)
    return {shiptool.text(desk): shiptool.text(zest)
            for desk, zest in shiptool.items(value)}


def wait_suspended(ship, desks):
    def stopped():
        states = desk_zests(ship, desks)
        return states if all(states.get(desk) == 'dead' for desk in desks) else None
    return wait_for('Clay to suspend %s' % ', '.join(desks), stopped)


