class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Client:
    def __init__(self, origin, cookies=None):
        handlers = [NoRedirect()]
        if cookies is not None:
            handlers.append(urllib.request.HTTPCookieProcessor(cookies))
        self.origin = origin
        self.opener = urllib.request.build_opener(*handlers)

    def request(self, method, target, data=None):
        req = urllib.request.Request(self.origin + target, data=data, method=method)
        try:
            with self.opener.open(req, timeout=REPLY) as response:
                return response.status, response.headers, response.read()
        except urllib.error.HTTPError as response:
            with response:
                return response.code, response.headers, response.read()


def expect(condition, message):
    if not condition:
        raise ValueError(message)


def poke(ship, mark, value):
    ship.thread(shiptool.fill(shiptool.POKE, AGENT='hood', MARK=mark, VALUE=value),
                timeout=REPLY)


def route_count(ship):
    care, path = shiptool.parse_scry('/gx/=jibb=/routes/noun')
    return ship.thread(shiptool.fill(
        shiptool.SCRY, TYPE='@ud', CARE=care, PATH=path, NOW='now.bowl',
        RESULT='(pure:m !>(val))'), timeout=REPLY)


def route_present(ship, desk=DESK):
    care, path = shiptool.parse_scry('/gx/=jibb=/routes/%s/noun' % desk)
    value = ship.thread(shiptool.fill(
        shiptool.SCRY, TYPE='?', CARE=care, PATH=path, NOW='now.bowl',
        RESULT='(pure:m !>(val))'), timeout=REPLY)
    return value == 0


def scry(ship, spec, mold):
    care, path = shiptool.parse_scry(spec)
    return ship.thread(shiptool.fill(
        shiptool.SCRY, TYPE=mold, CARE=care, PATH=path, NOW='now.bowl',
        RESULT='(pure:m !>(val))'), timeout=REPLY)


def published(ship, desk):
    """The URLs the desk has in Eyre's cache: each maps to None while its
    last build uses it, and to the time it expires once retired."""
    value = scry(ship, '/gx/=jibb=/static/%s/noun' % desk, '(list [@t (unit @da)])')
    return {shiptool.text(url): (None if expiry == 0 else expiry[1])
            for url, expiry in shiptool.items(value)}


def unix_time(da):
    """An @da as Unix seconds."""
    return (da >> 64) - 0x8000000cce9e0d80


def png(width, height, rgb):
    """A PNG of one colour."""
    def chunk(kind, data):
        return (struct.pack('>I', len(data)) + kind + data +
                struct.pack('>I', zlib.crc32(kind + data) & 0xffffffff))
    rows = b''.join(b'\0' + bytes(rgb) * width for _ in range(height))
    return (b'\x89PNG\r\n\x1a\n' +
            chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0)) +
            chunk(b'IDAT', zlib.compress(rows)) + chunk(b'IEND', b''))


def fetch_public(client, url, media_type, data=None):
    """A static file: public, from Eyre's cache, immutable; its bytes."""
    status, headers, body = client.request('GET', url)
    expect(status == 200, 'static file %s was HTTP %d: %.200r' % (url, status, body))
    expect(headers.get('content-type') == media_type,
           '%s had content type %r, not %r' % (url, headers.get('content-type'), media_type))
    expect(headers.get('cache-control') == IMMUTABLE,
           '%s was not cached as immutable: %r' % (url, headers.get('cache-control')))
    expect(data is None or body == data, '%s did not serve its file\'s bytes' % url)
    return body


def expect_gone(client, urls, why):
    for url in urls:
        status, _, _ = client.request('GET', url)
        expect(status == 404, '%s: %s was HTTP %d, not 404' % (why, url, status))


