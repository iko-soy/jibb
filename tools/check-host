               'a page drawing a deleted image was HTTP %d: %r' % (status, body))
        status, _, body = owner.request('GET', PAGE)
        expect(status == 200 and b'About this ship' in body,
               'About did not survive a missing image elsewhere: HTTP %d' % status)
        rev = commit_file(ship, DOT_FILE, dot)
        dot_edited = False
        wait_built(ship, DESK, rev)
        expect(notes_image(owner)[0] == dot_url, 'the restored image changed its URL')
        fetch_public(anonymous, dot_url, 'image/png', dot)
        urls = published(ship, DESK)
        expect(urls.get(dot_url, 0) is None and isinstance(urls.get(new_url), int),
               'restoring the image did not swap the files back: %r' % urls)

        # An imported /sur file that does not build is that page's error;
        # the build still completes and the other pages are unaffected.
        broken = True
        rev = commit_file(ship, BROKEN_FILE, BROKEN_SOURCE)
        wait_built(ship, DESK, rev)
        status, _, body = owner.request('GET', BROKEN)
        expect(status == 500 and
               b'cannot build imported Hoon source /sur/unused.hoon' in body,
               'a page importing an unbuildable /sur was HTTP %d: %r' % (status, body))
        status, _, body = owner.request('GET', PAGE)
        expect(status == 200 and b'About this ship' in body,
               'About did not survive a broken import elsewhere: HTTP %d' % status)
        rev = commit_file(ship, BROKEN_FILE, None)
        broken = False
        wait_built(ship, DESK, rev)
        status, _, _ = owner.request('GET', BROKEN)
        expect(status == 404, 'a deleted page was HTTP %d, not 404' % status)

        # A build that cannot run, here because the desk's compiler does not
        # build, keeps the last good pages and their files.
        compiler_broken = True
        rev = commit_file(ship, compiler, good_compiler + b'\n!!!\n')
        wait_built(ship, DESK, rev)
        status, _, body = owner.request('GET', PAGE)
        expect(status == 200 and b'About this ship' in body,
               'a build whose compiler does not build replaced About: HTTP %d: %r'
               % (status, body))
        fetch_public(anonymous, stylesheet, 'text/css; charset=utf-8', css.encode())
        rev = commit_file(ship, compiler, good_compiler)
        compiler_broken = False
        wait_built(ship, DESK, rev)

        # my-app's theme names a font, its dark tones and a wider layout.
        status, _, body = owner.request('GET', MY_APP_BASE + '/about')
        expect(status == 200 and b'About this ship' in body,
               'my-app About was HTTP %d: %r' % (status, body))
        sheets = STYLESHEET.findall(body)
        expect(len(sheets) == 1, 'my-app About did not link one stylesheet: %r' % sheets)
        app_css = fetch_public(anonymous, sheets[0].decode(), 'text/css; charset=utf-8').decode()
        fonts = FONT.findall(app_css)
        expect(len(fonts) == 1 and fonts[0].startswith(MY_APP_BASE + '/static/0v')
               and fonts[0].endswith('/fonts/inter.woff2'),
               'my-app\'s stylesheet did not load its theme font: %r' % fonts)
        fetch_public(anonymous, fonts[0], 'font/woff2', FONT_FILE.read_bytes())
        for text in ('@media (prefers-color-scheme:dark){:root{--j-normal:#eee;',
                     '@media (min-width:60rem){.j-stack{flex-direction:row}}'):
            expect(text in app_css, 'my-app\'s stylesheet is missing %r' % text)
        # Pages with data render per request from a fresh scry of my-app's
        # %blog agent; nothing about them is cached.
        status, headers, body = owner.request('GET', MY_APP_BASE + '/blog')
        expect(status == 200 and b'Hello, Urbit' in body and b'Pages from a scry' in body,
               'worked example 2 was HTTP %d: %r' % (status, body))
        expect(headers.get('cache-control') is None, 'a page with data asked to be cached')
        status, _, body = owner.request('GET', MY_APP_BASE + '/blog/hello-urbit')
        expect(status == 200 and b'<h1' in body and b'Hello, Urbit' in body
               and b'address is hello-urbit.' in body,
               'the _slug page was HTTP %d: %r' % (status, body))
        status, _, body = owner.request('HEAD', MY_APP_BASE + '/blog/hello-urbit')
        expect(status == 200 and body == b'', 'HEAD of a page with data was HTTP %d: %r'
               % (status, body))
        status, headers, _ = anonymous.request('GET', MY_APP_BASE + '/blog/hello-urbit')
        expect(status == 307, 'a logged-out reader of a page with data got HTTP %d' % status)
        status, _, body = owner.request('GET', MY_APP_BASE + '/blog/no-such-post')
        expect(status == 404 and b'did not answer /post/no-such-post' in body,
               'a path the agent rejects was HTTP %d: %r' % (status, body))
        status, _, body = owner.request('GET', MY_APP_BASE + '/blog/malformed')
        expect(status == 500 and b'does not fit its type' in body,
               'an answer that does not fit its type was HTTP %d: %r' % (status, body))
        status, _, body = owner.request('GET', MY_APP_BASE + '/blog/Not%20a%20knot')
        expect(status == 404 and b'is not a @ta' in body,
               'a segment that is not a knot was HTTP %d: %r' % (status, body))
        ship.thread(shiptool.fill(shiptool.POKE, AGENT='blog', MARK='noun',
                                  VALUE="[%add 'Fresh from a poke' ~.fresh-post]"),
                    timeout=REPLY)
        status, _, body = owner.request('GET', MY_APP_BASE + '/blog')
        expect(status == 200 and b'Fresh from a poke' in body,
               'worked example 2 did not read a fresh scry: HTTP %d: %r' % (status, body))
        status, _, body = owner.request('GET', MY_APP_BASE + '/blog/fresh-post')
        expect(status == 200 and b'Fresh from a poke' in body,
               'the _slug page did not read a fresh scry: HTTP %d: %r' % (status, body))
        status, _, body = owner.request('GET', BASE + '/numbered/12')
        expect(status == 200 and b'Number 12' in body,
               'a page with a @ud parameter was HTTP %d: %r' % (status, body))
        status, _, body = owner.request('GET', BASE + '/numbered/twelve')
        expect(status == 404 and b'is not a @ud' in body,
               'an unparseable parameter was HTTP %d: %r' % (status, body))
        for _ in range(2):
            status, _, body = owner.request('GET', BASE + '/crash')
            expect(status == 500 and b'crashed in its view' in body,
                   'a crashing render was HTTP %d: %r' % (status, body))
        # buttons is a library with the expected 3:16 error: it is not a page.
        for target in (MY_APP_BASE + '/todo-list', MY_APP_BASE + '/stores/cart',
                       MY_APP_BASE + '/components/card', MY_APP_BASE + '/api/todo',
                       MY_APP_BASE + '/components/buttons'):
            status, _, body = owner.request('GET', target)
            expect(status == 404, 'non-page %s was HTTP %d, not 404: %r' % (target, status, body))

        status, _, body = owner.request('GET', '/~debug/eyre/cache.json')
        expect(status == 200, 'could not read Eyre cache: HTTP %d' % status)
        cache = json.loads(body)
        fixture_files = set(published(ship, DESK))
        app_files = set(published(ship, 'my-app'))
        cached = {entry.get('url') for entry in cache}
        # An entry whose val is null is one Eyre no longer serves: a file
        # an earlier build retired.
        private = [entry for entry in cache
                   if entry.get('val') is not None
                   and any(base in entry.get('url', '') for base in (BASE, MY_APP_BASE))
                   and entry.get('url') not in fixture_files | app_files]
        expect(not private, 'a private page appeared in Eyre cache: %r' % private)
        expect(fixture_files | app_files <= cached,
               'published files were not in Eyre cache: %r'
               % sorted((fixture_files | app_files) - cached))

        # -jibb!test runs each test- arm under /ui/tests as Nock.
        for desk, wanted in EXPECTED_TESTS.items():
            got = desk_tests(ship, desk)
            expect(got == wanted, '-jibb!test %%%s gave %r, not %r' % (desk, got, wanted))

        # -jibb!clear takes every desk's files out of Eyre's cache; the next
        # build publishes its files again.
        cleared = True
        ship.thread(CLEAR, timeout=REPLY)
        expect(published(ship, DESK) == {} and published(ship, 'my-app') == {},
               'clearing left published files')
        expect_gone(anonymous, sorted(fixture_files | app_files), 'after -jibb!clear')
        edited = True
        rev = commit_note(ship, original_note.replace(b'First note', b'Third note'))
        wait_built(ship, DESK, rev)
        expect(published(ship, DESK) == files,
               'the build after clearing published %r' % published(ship, DESK))
        fetch_public(anonymous, stylesheet, 'text/css; charset=utf-8', css.encode())
        fetch_public(anonymous, dot_url, 'image/png', dot)
        rev = commit_note(ship, original_note)
        edited = False
        wait_built(ship, DESK, rev)

        poke(ship, 'kiln-suspend-many', '~[%%%s]' % DESK)
        suspended = True
        wait_for('route removal after suspend', lambda: not route_present(ship) or None)
        status, _, _ = owner.request('GET', PAGE)
        expect(status == 404, 'suspended desk route was HTTP %d, not 404' % status)
        expect(published(ship, DESK) == {}, 'a suspended desk kept published files')
        # Out of Eyre's cache, the files fall to Eyre's other bindings, which
        # send a logged-out reader to the login page: ask as the owner.
        expect_gone(owner, (stylesheet, dot_url), 'after suspending the desk')
        print('check-host: default theme, real Clay imports, page kinds, static files, '
              'stylesheets, pages with data, -jibb!test, -jibb!clear, incremental rebuild, '
              'HTTP and suspend passed')
        return 0
    finally:
        # Leave the dedicated fixture usable for a subsequent run, including
        # when an assertion above fails. This revives only our fixture desk.
        if edited:
            commit_note(ship, original_note)
        if dot_edited:
            commit_file(ship, DOT_FILE, dot)
        if broken:
            commit_file(ship, BROKEN_FILE, None)
        if compiler_broken:
            commit_file(ship, compiler, good_compiler)
        poke(ship, 'kiln-revive', '%' + DESK)
        if suspended:
            wait_for('fixture revival after acceptance', lambda: route_present(ship) or None)
        if cleared and not application_suspended:
            # Clearing left my-app's pages without their files: build it again.
            poke(ship, 'kiln-suspend-many', '~[%my-app]')
            wait_for('application suspension after clearing',
                     lambda: not route_present(ship, 'my-app') or None)
            application_suspended = True
        if application_suspended:
            poke(ship, 'kiln-revive', '%my-app')


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError,
            urllib.error.URLError, shiptool.Fail, shiptool.Unable) as error:
        print('check-host: %s' % error, file=sys.stderr)
        sys.exit(1)
