#!/bin/sh
# Checks that the formatter leaves every example in the doc unchanged: each
# Jibb block of docs/spec, which tools/doc-blocks keeps as a doc-* golden
# case's source.  Checks this repository's formatter: the jibb that $JIBB_BIN
# names, as Nix sets it to the CLI it built from this source, or else
# jibb-cli built here with cargo.  A jibb on PATH may be another version, so
# it is never used.
set -eu
cd "$(dirname "$0")/.."
if [ -n "${JIBB_BIN:-}" ]; then
  jibb=$JIBB_BIN
else
  cargo build --quiet --manifest-path jibb-cli/Cargo.toml --bin jibb
  jibb=${CARGO_TARGET_DIR:-jibb-cli/target}/debug/jibb
fi
if ! "$jibb" fmt --check tests/golden/doc-*/source.jibb; then
  echo "doc-format: the formatter changes the doc examples above; format them and update docs/spec" >&2
  exit 1
fi
echo "doc-format: $jibb leaves all $(ls -d tests/golden/doc-* | wc -l) doc examples unchanged"
