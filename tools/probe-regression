def probe_file(group):
    if group == 'imports':
        return 'imports', PROBES / 'errors/import-check.hoon'
    if group.startswith('errors-'):
        return 'plain', PROBES / 'errors' / (group[7:] + '.jibb')
    return 'app', PROBES / 'variants' / (group + '.jibb')


def is_negative(group, label):
    if group == 'imports':
        return label not in IMPORT_VALID and label != 'RAW-good'
    if group.startswith('errors-'):
        return label not in ERROR_VALID
    name = label.split()[-1]
    if group in ('p9', 'p10'):
        return True
    if group == 'p8':
        return name not in P8_VALID
    if group == 'p5':
        return name in P5_ERRORS
    return label in EXACT or label in REQUIRED or label in RULES


def sections(group):
    mode, path = probe_file(group)
    raw = path.read_text(encoding='utf-8')
    if mode == 'imports':
        matches = re.findall(r"\['((?:I|M)[^']+)' (/\S+) '((?:\\.|[^'])*)'", raw)
        if len(matches) != 21:
            raise ValueError('expected 21 module probes in ' + str(path))
        cases = [(label, at, source.replace('\\0a', '\n')) for label, at, source in matches]
        return cases + [('RAW-' + name, '/ui/probe/jibb', '') for name in RAW_NAMES]
    out = []
    for part in raw.split('#### ')[1:]:
        label, sep, source = part.partition('\n')
        words = label.split()
        if not sep or not words:
            raise ValueError('invalid probe section in %s: %s' % (path, label))
        if mode == 'plain':
            if len(words) != 1:
                raise ValueError('invalid plain probe label: ' + label)
            at = '/ui/probe/jibb'
        else:
            if not label.startswith('/') or not (len(words) == 2 or
                                                   len(words) == 3 and words[1] == 'module'):
                raise ValueError('invalid app probe label: ' + label)
            at = words[0]
            if label == '/ui/update/jibb core-update-alone':
                # The doc block is a fragment, checked in its actual island
                # context rather than as a module with unbound names.
                todo = (ROOT / 'my-app/ui/todo-list.jibb').read_text()
                original = (ROOT / 'tests/golden/doc-core-02-update/source.jibb').read_text()
                if todo.count(original) != 1:
                    raise ValueError('todo island no longer contains the doc update')
                source = todo.replace(original, source.rstrip('\n') + '\n')
                at = '/ui/todo-list/jibb'
                label = at + ' core-update-alone'
        out.append((label, at, source))
    if not out or len({label for label, _, _ in out}) != len(out):
        raise ValueError('empty or duplicate sections in %s' % path)
    return out


def parse_output(output, imports=False):
    prefix = output.find('#### ')
    if prefix < 0:
        raise ValueError('checker returned no probe sections')
    results = []
    for part in output[prefix:].split('#### ')[1:]:
        label, sep, body = part.partition('\n')
        if not sep:
            raise ValueError('malformed checker output')
        if imports and label == 'RAW':
            for line in body.strip().splitlines():
                name, separator, desc = line.partition(': ')
                if not separator or name not in RAW_NAMES:
                    raise ValueError('malformed raw importer result: ' + line)
                results.append(('RAW-' + name, 0 if desc == 'ok' else 1, desc))
        elif body.startswith('CHECKED\n'):
            results.append((label, 0, ''))
        elif body.startswith('REJECTED: '):
            results.append((label, 1, body[len('REJECTED: '):].rstrip('\n')))
        elif body.startswith('CRASH\n'):
            raise ValueError('checker crashed for ' + label + '\n' + body[6:])
        else:
            raise ValueError('missing checker outcome for ' + label)
    return results


def eval_process(groups, debug):
    """Run ordered (mode, cases) groups with shared immutable setup."""
    # Reassemble the input from checked sections so the Core fragment can be
    # embedded in its island; do not change any other source.
    with tempfile.TemporaryDirectory(prefix='jibb-probes-') as tmp:
        batched = len(groups) > 1
        command = [str(PROBES / 'run'), 'batch' if batched else groups[0][0]]
        if not debug:
            command.append('--no-debug')
        for index, (mode, cases) in enumerate(groups):
            if mode != 'imports':
                source_path = Path(tmp) / ('cases-%d.jibb' % index)
                source_path.write_text(''.join('#### ' + label + '\n' + source
                                              for label, _, source in cases),
                                       encoding='utf-8')
                if batched:
                    command.extend(['--group', mode])
                command.append(str(source_path))
        result = subprocess.run(command, cwd=ROOT, text=True, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)
    return command, result


def resource_failure(result):
    return result.returncode and ('bail: %meme' in result.stderr or
                                  'bail: %oops' in result.stderr)


def eval_results(group, cases, debug=True):
    mode, _ = probe_file(group)
    command, result = eval_process([(mode, cases)], debug)
    if result.returncode:
        if mode != 'imports' and len(cases) > 1 and resource_failure(result):
            middle = len(cases) // 2
            print('%s: splitting %d probes after eval could not finish the batch' %
                  (group, len(cases)), file=sys.stderr, flush=True)
            return (eval_results(group, cases[:middle], debug) +
                    eval_results(group, cases[middle:], debug))
        raise ValueError('%s failed:\n%s' % (' '.join(command), result.stderr))
    return parse_output(result.stdout, mode == 'imports')


def eval_batches(items, max_groups=5, max_app_groups=3):
    """Bound shared setup without mixing imports or group contexts."""
    if not 1 <= max_groups <= 5 or not 1 <= max_app_groups <= 3:
        raise ValueError('batches allow one to five groups and one to three app groups')
    batches = []
    pending = []
    app_count = 0
    for item in items:
        mode = probe_file(item[0])[0]
        if (mode == 'imports' or len(pending) == max_groups or
                mode == 'app' and app_count == max_app_groups):
            if pending:
                batches.append(pending)
                pending = []
                app_count = 0
        if mode == 'imports':
            batches.append([item])
        else:
            pending.append(item)
            app_count += mode == 'app'
    if pending:
        batches.append(pending)
    return batches


def eval_batch_results(items, debug=True):
    """Return one result list per group, retaining each mode's context."""
    groups = [(probe_file(group)[0], cases) for group, cases in items]
    if (not 1 <= len(groups) <= 5 or
            sum(mode == 'app' for mode, _ in groups) > 3 or
            any(mode == 'imports' for mode, _ in groups)):
        raise ValueError('a source batch requires one to five groups, at most three app groups')
    if len(items) == 1:
        return [eval_results(*items[0], debug=debug)]
    command, result = eval_process(groups, debug)
    if resource_failure(result):
        print('%s: running source groups separately after eval could not finish the batch' %
              ', '.join(group for group, _ in items), file=sys.stderr, flush=True)
        return [eval_results(group, cases, debug) for group, cases in items]
    if result.returncode:
        raise ValueError('%s failed:\n%s' % (' '.join(command), result.stderr))
    results = parse_output(result.stdout)
    if len(results) != sum(len(cases) for _, cases in items):
        raise ValueError('checker did not return each batched probe in order')
    grouped = []
    offset = 0
    for _, cases in items:
        selected = results[offset:offset + len(cases)]
        if [label for label, _, _ in selected] != [label for label, _, _ in cases]:
            raise ValueError('checker did not return each batched probe in order')
        grouped.append(selected)
        offset += len(cases)
    return grouped


def ship_prefix(revision=None):
    """Prepare Clay inputs once, optionally at the revision returned by sync."""
    template = app.prepare_thread(app.ui_modules())
    before, marker, _ = template.partition('%-  pure:m\n!>  %+  turn  modules')
    if not marker:
        raise ValueError('my-app thread shape changed')
    if revision is not None:
        if type(revision) is not int or revision < 0:
            raise ValueError('invalid my-app Clay revision')
        binding = '=/  now=@da  now.bowl\n'
        if (before.count(binding) != 1 or before.count('da+now') != 1 or
                before.count('(scot %da now)') != 10):
            raise ValueError('my-app thread revision selectors changed')
        before = before.replace(binding, '=/  revision=@ud  %s\n' % shiptool.hoon_ud(revision))
        before = before.replace('da+now', 'ud+revision')
        before = before.replace('(scot %da now)', '(scot %ud revision)')
        if 'now.bowl' in before or 'da+now' in before:
            raise ValueError('my-app thread retained a live revision selector')
    return before


def ship_source_literals(cases):
    literals = []
    extras = []
    for label, at, source in cases:
        src = shiptool.hoon_cord(source.encode())
        at_literal = '(stab ' + shiptool.hoon_cord(at.encode()) + ')'
        literals.append('[' + shiptool.hoon_cord(label.encode()) + ' ' + at_literal + ' ' + src + ']')
        if len(label.split()) == 3:
            extras.append('[' + at_literal + ' ' + src + ']')
    return shiptool.hoon_list(literals), shiptool.hoon_list(extras)


def ship_thread(group, cases, revision=None):
    """The original single-group program, also used for resource fallback."""
    before = ship_prefix(revision)
    literals, extra_literal = ship_source_literals(cases)
    # Plain probes use only the prelude, as in the review's check.hoon.
    mode, _ = probe_file(group)
    args = ('~ ~ ~' if mode == 'plain' else 'ext marks available')
    thread = before + '''=/  extra=(list [at=path source=@t])  ''' + extra_literal + '''
=/  baseline=(list [at=path source=@t])
  (skip modules |=(entry=[at=path source=@t] (lien extra |=(e=[at=path source=@t] =(at.entry at.e)))))
=/  all-modules=(list [at=path source=@t])  (weld extra baseline)
=/  cases=(list [label=@t at=path source=@t])  ''' + literals + '''
%-  pure:m
!>  %+  turn  cases
|=  c=[label=@t at=path source=@t]
=/  available=(list [at=path source=@t])
  (skip all-modules |=(entry=[at=path source=@t] =(at.entry at.c)))
=/  result=(each * [message=@t overlap=*])
  !<((each * [message=@t overlap=*]) (slym check [at.c source.c ''' + args + ''' ~[at.c] values.p.detailed molds.p.detailed ~ `iface.p.detailed]))
?:  ?=(%& -.result)  [label.c %& '']
[label.c %| message.p.result]
'''
    return thread


def ship_results(ship, group, cases, revision=None):
    if group == 'imports':
        return ship_import_results(ship)
    thread = ship_thread(group, cases, revision)
    if shiptool.click_argument_bytes(thread) > SHIP_BATCH_BYTES:
        raise ValueError('ship probe group %s exceeds the click request limit' % group)
    out = []
    for label, (flag, message) in app.proper_list(ship.thread(thread, timeout=1800)):
        out.append((shiptool.text(label), flag, shiptool.text(message)))
    return out


# click -i still passes the escaped program as one Linux command argument.
# Leave room below its 128 KiB limit; never split a group's module fixtures.
SHIP_BATCH_BYTES = 120000


def ship_batch_thread(items, revision=None):
    modes = [probe_file(group)[0] for group, _ in items]
    if (not 1 <= len(items) <= 5 or modes.count('app') > 3 or
            'imports' in modes):
        raise ValueError('a ship source batch requires one to five groups, at most three app groups')
    entries = []
    for (group, cases), mode in zip(items, modes):
        if mode == 'plain' and any(at != '/ui/probe/jibb' for _, at, _ in cases):
            raise ValueError('plain ship probes require /ui/probe/jibb')
        literals, extras = ship_source_literals(cases)
        entries.append('[%s %%%s %s %s]' %
                       (shiptool.hoon_cord(group.encode()), mode, extras, literals))
    return ship_prefix(revision) + '''=/  groups=(list [name=@t mode=?(%app %plain) extra=(list [at=path source=@t]) cases=(list [label=@t at=path source=@t])])  ''' + shiptool.hoon_list(entries) + '''
%-  pure:m
!>  %+  turn  groups
|=  group=[name=@t mode=?(%app %plain) extra=(list [at=path source=@t]) cases=(list [label=@t at=path source=@t])]
=/  baseline=(list [at=path source=@t])
  (skip modules |=(entry=[at=path source=@t] (lien extra.group |=(e=[at=path source=@t] =(at.entry at.e)))))
=/  all-modules=(list [at=path source=@t])  (weld extra.group baseline)
:-  name.group
%+  turn  cases.group
|=  c=[label=@t at=path source=@t]
:-  label.c
::  Retain only the compact result after each case leaves its road.
%-  mule
|.
^-  [flag=? message=@t]
=/  available=(list [at=path source=@t])
  (skip all-modules |=(entry=[at=path source=@t] =(at.entry at.c)))
=/  sample=*
  ?:  =(%plain mode.group)
    [at.c source.c ~ ~ ~ ~[at.c] values.p.detailed molds.p.detailed ~ `iface.p.detailed]
  [at.c source.c ext marks available ~[at.c] values.p.detailed molds.p.detailed ~ `iface.p.detailed]
=/  result=(each * [message=@t overlap=*])
  !<((each * [message=@t overlap=*]) (slym check sample))
?:  ?=(%& -.result)  [%& '']
[%| message.p.result]
'''


def ship_batches(items, revision=None):
    """Bound group count and click's actual escaped argument size."""
    def partition(batch):
        if len(batch) == 1:
            group, cases = batch[0]
            if (group != 'imports' and
                    shiptool.click_argument_bytes(ship_thread(group, cases, revision)) > SHIP_BATCH_BYTES):
                raise ValueError('ship probe group %s exceeds the click request limit' % group)
            return [batch]
        if shiptool.click_argument_bytes(ship_batch_thread(batch, revision)) <= SHIP_BATCH_BYTES:
            return [batch]
        middle = len(batch) // 2
        return partition(batch[:middle]) + partition(batch[middle:])
    return [part for batch in eval_batches(items) for part in partition(batch)]


def ship_batch_decode(items, noun):
    """Validate the entire protocol before any result can count as a pass."""
    def proper_list(value):
        values = []
        while isinstance(value, tuple):
            if len(value) != 2:
                raise ValueError('malformed ship probe list')
            head, value = value
            values.append(head)
        if type(value) is not int or value != 0:
            raise ValueError('malformed ship probe list')
        return values

    def atom(value):
        if type(value) is not int or value < 0:
            raise ValueError('malformed ship probe atom')
        return shiptool.text(value)

    rows = proper_list(noun)
    if len(rows) != len(items):
        raise ValueError('checker did not return each ship group in order')
    grouped = []
    for (group, cases), entry in zip(items, rows):
        if not isinstance(entry, tuple) or len(entry) != 2 or atom(entry[0]) != group:
            raise ValueError('checker did not return each ship group in order')
        reported = proper_list(entry[1])
        if len(reported) != len(cases):
            raise ValueError('checker did not return each ship probe in order')
        results = []
        for (label, _, _), row in zip(cases, reported):
            if not isinstance(row, tuple) or len(row) != 2 or atom(row[0]) != label:
                raise ValueError('checker did not return each ship probe in order')
            attempted = row[1]
            if (not isinstance(attempted, tuple) or len(attempted) != 2 or
                    type(attempted[0]) is not int or attempted[0] not in (0, 1)):
                raise ValueError('malformed ship probe attempt')
            if attempted[0] == 1:
                proper_list(attempted[1])
                trace = '\n'.join(shiptool.tang_lines(attempted[1]))
                raise ValueError('ship probe %s %s crashed:\n%s' % (group, label, trace))
            result = attempted[1]
            if (not isinstance(result, tuple) or len(result) != 2 or
                    type(result[0]) is not int or result[0] not in (0, 1)):
                raise ValueError('malformed ship probe result')
            results.append((label, result[0], atom(result[1])))
        grouped.append(results)
    return grouped


def ship_batch_results(ship, items, revision=None):
    if not items:
        raise ValueError('no probe groups selected for ship')
    if len(items) == 1:
        return [ship_results(ship, *items[0], revision=revision)]
    thread = ship_batch_thread(items, revision)
    if shiptool.click_argument_bytes(thread) > SHIP_BATCH_BYTES:
        return [results for batch in ship_batches(items, revision)
                for results in ship_batch_results(ship, batch, revision)]
    try:
        noun = ship.thread(thread, timeout=1800 * len(items))
    except shiptool.Fail as error:
        # Only an avow reply confirms that the failed thread has finished.
        # A timeout/closed socket can leave it running; never retry those.
        if revision is None or str(error).split('\n', 1)[0] not in (
                'the thread failed: %meme', 'the thread failed: %oops'):
            raise
        print('%s: running ship groups separately after a terminal resource failure' %
              ', '.join(group for group, _ in items), file=sys.stderr, flush=True)
        return [ship_results(ship, group, cases, revision=revision) for group, cases in items]
    return ship_batch_decode(items, noun)


def ship_batch(ship, items, revision=None):
    if not items:
        raise ValueError('no probe groups selected for ship')
    try:
        grouped = ship_batch_results(ship, items, revision)
        return [(group, cases, compare(group, cases, results), None)
                for (group, cases), results in zip(items, grouped)]
    except (OSError, UnicodeError, ValueError, shiptool.Fail, shiptool.Unable) as error:
        return [(group, cases, [], str(error)) for group, cases in items]


def ship_runs(ship, batches, revision=None):
    """Do not queue another request after an uncertain thread failure."""
    for batch in batches:
        outcomes = ship_batch(ship, batch, revision)
        yield outcomes
        if any(error is not None for _, _, _, error in outcomes):
            return


def import_ship_suite():
    """Build the import probe suite from its source and explicit group manifest."""
    source = (PROBES / 'errors/import-check.hoon').read_text()
    old = '=>  [lib=jibb-lib reader=reader prelude=prelude internal=internal groups=groups group-sources=group-sources reader-evidence=reader-evidence ..zuse]'
    new = '=>  [lib=jibb reader=jibb-import prelude=prelude internal=internal groups=groups group-sources=group-sources reader-evidence=reader-evidence ..zuse]'
    if not source.startswith(old):
        raise ValueError('the import probe subject changed; regenerate its ship suite')
    source = new + source[len(old):]
    groups, private, readers = prelude_groups.load_all(str(ROOT))
    headers, group_entries, private_entries = [], [], []
    for number, (face, logical, _, _) in enumerate(groups + private):
        binding = 'probe-group-' + str(number)
        path = prelude_groups.hoon_path(logical)
        headers.append('/*  %s  %%jibb  %s/jibb\n' % (binding, logical))
        if face is None:
            private_entries.append('[%s %s]' % (path, binding))
        else:
            group_entries.append('[%%%s %s %s]' % (face, path, binding))
    reader_entries = []
    reader_paths = set()
    for number, (module, name, logical, _, data) in enumerate(readers):
        binding = 'probe-reader-' + str(number)
        headers.append('/*  %s  %%hoon  %s/hoon\n' % (binding, logical))
        path = prelude_groups.sur_path(logical)
        value = binding
        if logical not in reader_paths:
            private_entries.append('[%s %s]' % (path, value))
            reader_paths.add(logical)
        reader_entries.append('[%%%s %%%s %s %s]' % (module, name, path, value))
    prefix = ('=/  groups  ' + shiptool.hoon_list(group_entries) + '\n'
              '=/  group-sources  ' + shiptool.hoon_list(private_entries) + '\n'
              '=/  reader-evidence  (turn `(list [module=term name=term at=path source=@t])`' + shiptool.hoon_list(reader_entries) +
              ' |=(entry=[module=term name=term at=path source=@t] [module.entry name.entry '
              '(read-generic-source:jibb-import module.entry name.entry at.entry source.entry -:(ride -:!>(..zuse) source.entry))]))\n')
    return ("::  Generated from the review's errors/import-check.hoon; the probe runner checks this copy.\n"
            '/+  jibb, jibb-import\n'
            '/*  prelude  %jibb  /lib/jibb/prelude/jibb\n'
            '/*  internal  %jibb  /lib/jibb/internal/jibb\n' + ''.join(headers) +
            '|%\n++  report\n' +
            ''.join('  ' + line for line in (prefix + source).splitlines(keepends=True)) + '--\n')


def ship_import_results(ship):
    expected = import_ship_suite()
    suite = ROOT / 'tests/probes/jibb-probe-import.hoon'
    if suite.read_text() != expected:
        raise ValueError('ship import probe differs from the review source: ' + str(suite))
    shiptool.sync(ship, 'jibb-dev')
    thread = '''=/  m  (strand ,vase)
;<  =bowl:spider  bind:m  get-bowl
=/  now=@da  now.bowl
=/  probe=vase  .^(vase %ca /[(scot %p our.bowl)]/jibb-dev/[(scot %da now)]/tests/probes/jibb-probe-import/hoon)
(pure:m (slap probe (ream 'report')))
'''
    return parse_output(shiptool.tape(ship.thread(thread, timeout=1800)), True)


def compare(group, cases, results):
    labels = [label for label, _, _ in cases]
    if [label for label, _, _ in results] != labels:
        raise ValueError('checker did not return each probe in order')
    failures = []
    sources = {label: (at, source) for label, at, source in cases}
    for label, flag, message in results:
        if flag not in (0, 1):
            raise ValueError('malformed checker result for ' + label)
        if group == 'imports' and label.startswith('RAW-'):
            name = label[4:]
            if name == 'good':
                if flag or message != 'ok':
                    failures.append((label, 'valid raw import rejected', message))
            elif (not flag or not message.startswith('invalid ') or
                  not all(any(word in message.lower() for word in alternatives)
                          for alternatives in RAW_INVALID[name])):
                failures.append((label, 'wrong raw importer diagnostic', message))
            continue
        if not is_negative(group, label):
            if flag:
                failures.append((label, 'valid probe rejected', message))
            continue
        if not flag:
            failures.append((label, 'invalid probe accepted', ''))
        elif label in EXACT:
            if message != EXACT[label]:
                failures.append((label, 'wrong diagnostic', message))
        elif label in REQUIRED:
            fragments, site, count = REQUIRED[label]
            normalized = message.replace('`', '')
            locations = re.findall(re.escape(site) + r'\d+:\d+:', message)
            carets = re.findall(r'(?m)^[ \t]*\^[~ \t]*$', message)
            if (not all(fragment in normalized for fragment in fragments) or
                    len(set(locations)) < count or len(carets) < count):
                failures.append((label, 'wrong diagnostic or missing sites', message))
        elif label in RULES:
            at, source = sources[label]
            rule = RULES[label]
            lines = source.splitlines()
            display = at[:-len('/jibb')] + '.jibb' if at.endswith('/jibb') else at
            valid = 'unsupported' not in message.lower() and 'not supported' not in message.lower()
            reason_message = message.replace('`', '') if rule.get('normalize_backticks') else message
            for alternatives in rule['reasons']:
                valid &= any(reason.lower() in reason_message.lower() for reason in alternatives)
            for site in rule['sites']:
                line_no, token = site[:2]
                occurrence = site[2] if len(site) == 3 else 1
                if line_no < 1 or line_no > len(lines):
                    raise ValueError('diagnostic site line missing in ' + label)
                line = lines[line_no - 1]
                offset = -1
                for _ in range(occurrence):
                    offset = line.find(token, offset + 1)
                    if offset < 0:
                        raise ValueError('diagnostic site token missing in ' + label + ': ' + token)
                valid &= ('%s:%d:%d:' % (display, line_no, offset + 1)) in message
                valid &= line in message
            carets = len(re.findall(r'(?m)^[ \t]*\^[~ \t]*$', message))
            valid &= carets >= len(rule['sites'])
            if 'other_file' in rule:
                other = re.escape(rule['other_file'])
                valid &= bool(re.search(other + r':\d+:\d+:', message))
                valid &= carets >= len(rule['sites']) + 1
            if not valid:
                failures.append((label, 'wrong diagnostic or missing sites', message))
        else:
            failures.append((label, 'expected diagnostic and sites still need annotation', message))
    return failures


def eval_group(group, cases, fast=False):
    """Return failures/error; a debug retry explains, never clears, failure."""
    def attempt(debug):
        try:
            return compare(group, cases, eval_results(group, cases, debug)), None
        except (OSError, UnicodeError, ValueError) as error:
            return [], str(error)
    failures, error = attempt(not fast)
    if not fast or not (failures or error):
        return failures, error
    return replay_failure(group, failures, error, attempt)


def replay_failure(group, failures, error, attempt):
    """Replay one group for diagnostics without clearing its first failure."""
    print('%s: fast eval failed; rerunning with debug spots' % group,
          file=sys.stderr, flush=True)
    repeated, detail = attempt(True)
    if detail is None:
        detail = '\n'.join('%s: %s\n%s' % failure for failure in repeated)
        if not detail:
            detail = 'all probes passed; fast failure retained'
    detail = 'instrumented diagnostic rerun:\n' + detail
    if error is not None:
        return failures, error + '\n' + detail
    return [(label, reason, message + '\n' + detail)
            for label, reason, message in failures], None


def eval_batch(items, fast=False):
    if not items:
        raise ValueError('no probe groups selected for eval')
    if len(items) == 1:
        group, cases = items[0]
        failures, error = eval_group(group, cases, fast)
        return [(group, cases, failures, error)]
    try:
        grouped = eval_batch_results(items, debug=not fast)
        outcomes = [(group, cases, compare(group, cases, results), None)
                    for (group, cases), results in zip(items, grouped)]
    except (OSError, UnicodeError, ValueError) as error:
        outcomes = [(group, cases, [], str(error)) for group, cases in items]
    if not fast:
        return outcomes
    replayed = []
    for group, cases, failures, error in outcomes:
        if failures or error:
            def attempt(debug):
                try:
                    return compare(group, cases, eval_results(group, cases, debug)), None
                except (OSError, UnicodeError, ValueError) as caught:
                    return [], str(caught)
            failures, error = replay_failure(group, failures, error, attempt)
        replayed.append((group, cases, failures, error))
    return replayed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--backend', choices=('eval', 'ship'), default='eval')
    parser.add_argument('-j', '--jobs', type=int, default=1,
                        help='parallel eval batches (ship batches run sequentially)')
    parser.add_argument('--fast', action='store_true',
                        help='eval without debug spots, rerun failures with them')
    parser.add_argument('groups', nargs='*', choices=GROUPS)
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error('--jobs must be positive')
    groups = args.groups or GROUPS
    try:
        groups_cases = [(group, sections(group)) for group in groups]
        ship = None
        revision = None
        if args.backend == 'ship':
            ship = shiptool.Ship(shiptool.PIER, None, shiptool.CLICK)
            ship.require()
            revision = shiptool.sync(ship, 'my-app')
        def run_batch(items):
            try:
                return eval_batch(items, args.fast)
            except (OSError, UnicodeError, ValueError, shiptool.Fail, shiptool.Unable) as error:
                return [(group, cases, [], str(error)) for group, cases in items]

        errors = []
        run_failed = False
        with ExitStack() as stack:
            if ship:
                outcomes = ship_runs(ship, ship_batches(groups_cases, revision), revision)
            else:
                pool = stack.enter_context(ThreadPoolExecutor(max_workers=args.jobs))
                outcomes = pool.map(run_batch, eval_batches(groups_cases))
            for group, cases, failures, run_error in (
                    outcome for batch_outcomes in outcomes for outcome in batch_outcomes):
                if run_error is not None:
                    run_failed = True
                    print('%s: no complete results for %d probes\n%s' %
                          (group, len(cases), run_error), file=sys.stderr, flush=True)
                    continue
                print('%s: %d/%d met their expected outcome' %
                      (group, len(cases) - len(failures), len(cases)), flush=True)
                errors.extend((group, *failure) for failure in failures)
                for label, kind, message in failures:
                    print('FAIL %s %s: %s%s' % (group, label, kind,
                          '\n' + message if message else ''),
                          file=sys.stderr, flush=True)
        return 2 if run_failed else (1 if errors else 0)
    except (OSError, UnicodeError, ValueError, shiptool.Fail, shiptool.Unable) as error:
        print('probe-regression: %s' % error, file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
