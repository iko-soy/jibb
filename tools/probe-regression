#!/usr/bin/env python3
"""Strict full-check regression for the milestone 2 review probes.

Valid probes must check. Invalid probes must fail with the specified
message and sites. Missing diagnostic expectations and unsupported valid
probes are failures, never expected passes.

--fast omits Hoon debug spots under eval and repeats failures with spots;
the diagnostic retry cannot clear a failure. Resource isolation retains
the selected mode, and ship checks are unchanged.

Eval shares immutable setup across at most three adjacent app groups.
Each group retains its own module overrides and each case its own eval road.
"""

import argparse
from concurrent.futures import ThreadPoolExecutor
from importlib.machinery import SourceFileLoader
import json
import re
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
PROBES = ROOT / 'docs/reviews/2026-11-03-milestone-2-probes'
sys.path.insert(0, str(ROOT / 'tools'))
shiptool = SourceFileLoader('jibb_probe_ship', str(ROOT / 'tools/ship')).load_module()
app = SourceFileLoader('jibb_probe_app', str(ROOT / 'tools/check-my-app')).load_module()
import prelude_groups

GROUPS = (tuple('p%d' % n for n in range(1, 11)) +
          tuple('errors-p%d' % n for n in range(1, 6)) + ('imports',))
# These cases have complete exact expectations. Other invalid cases are
# explicitly tracked but cannot pass until their message and sites are
# annotated; rejecting them with an unrelated generic message is not enough.
EXACT = {
    'E07-overlap':
        'module mold overlap has overlapping cases\n'
        '/ui/probe.jibb:2:3: first union case\n  @t\n  ^\n'
        '/ui/probe.jibb:3:3: overlapping case\n  @ud\n  ^',
    'E07b-overlap-records':
        'module mold pt has overlapping cases\n'
        '/ui/probe.jibb:2:3: first union case\n  [a=@ud b=@ud]\n  ^\n'
        '/ui/probe.jibb:3:3: overlapping case\n  [x=@ud y=@ud]\n  ^',
    'E17-dup-fields-mold':
        'record field `a` is repeated\n'
        '/ui/probe.jibb:1:7: first field\n+$ r [a=@ud a=@t]\n      ^\n'
        '/ui/probe.jibb:1:13: repeated field\n+$ r [a=@ud a=@t]\n            ^',
    'E17b-dup-fields-expr':
        'record field `a` is repeated\n'
        '/ui/probe.jibb:1:7: first field\n++ v [a=1 a=2]\n      ^\n'
        '/ui/probe.jibb:1:11: repeated field\n++ v [a=1 a=2]\n          ^',
    'X4-pt-tuple-meant':
        'module mold pt has overlapping cases\n'
        '/ui/probe.jibb:2:3: first union case\n  @ud\n  ^\n'
        '/ui/probe.jibb:3:3: overlapping case\n  @ud\n  ^',
