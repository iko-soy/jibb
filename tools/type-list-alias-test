#!/usr/bin/env python3
"""Compare source-backed list alias preparation under eval."""
from pathlib import Path
import argparse
import difflib
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--lib', default=str(root / 'jibb-dev/lib/jibb.hoon'))
parser.add_argument('--update', action='store_true')
args = parser.parse_args()
tests = (root / 'tests/lib/jibb-list-alias-guards.hoon').read_text()
tests = tests[tests.index('\n|%\n') + 1:]
expression = '=/  jibb  .\n=/  expected=wain  ~\n=/  suite\n' + tests + '\nlist-alias-output:suite\n'
with tempfile.TemporaryDirectory(prefix='jibb-list-alias-') as tmp:
    program = Path(tmp) / 'guards.hoon'
    program.write_text(expression)
    result = subprocess.run([str(root / 'tools/hoon'), '--lib', args.lib, '--raw', '-f', str(program)], stdout=subprocess.PIPE)
if result.returncode:
    sys.exit(result.returncode)
expected_path = root / 'tests/type-list-alias/expected.txt'
if args.update:
    expected_path.write_bytes(result.stdout)
    print('updated list alias guards golden')
    sys.exit(0)
expected = expected_path.read_bytes()
if result.stdout != expected:
    sys.stderr.writelines(difflib.unified_diff(expected.decode().splitlines(keepends=True), result.stdout.decode().splitlines(keepends=True), fromfile='expected.txt', tofile='actual'))
    sys.exit(1)
print('list alias guards golden passed')
