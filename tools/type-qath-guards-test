#!/usr/bin/env python3
"""Run the shared qath fuel, face, and source-provenance guards under eval."""
from pathlib import Path
import argparse
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--lib', default=str(root / 'jibb-dev/lib/jibb.hoon'))
args = parser.parse_args()
with tempfile.TemporaryDirectory(prefix='jibb-qath-guards-') as tmp:
    for kind in ('fuel', 'source'):
        tests = (root / f'tests/lib/jibb-qath-{kind}.hoon').read_text()
        tests = tests[tests.index('\n|%\n') + 1:]
        expression = ('=/  jibb  .\n=/  real-internal=@t  internal\n=/  suite\n' + tests +
                      f'\n=/  failures=(list tape)  qath-{kind}-errors:suite\n^-  @t\n' +
                      "?~  failures  'qath guards passed'\n" +
                      '(of-wain:format (turn failures crip))\n')
        program = Path(tmp) / f'{kind}.hoon'
        program.write_text(expression)
        command = [str(root / 'tools/hoon'), '--lib', args.lib, '--raw', '-f', str(program),
                   '--cord', 'internal=' + str(root / 'jibb-dev/lib/jibb/internal.jibb')]
        result = subprocess.run(command, stdout=subprocess.PIPE)
        if result.returncode:
            sys.exit(result.returncode)
        if result.stdout != b'qath guards passed\n':
            sys.stderr.buffer.write(result.stdout)
            sys.exit(1)
print('qath fuel, face, and source guards passed')
