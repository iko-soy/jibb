#!/usr/bin/env python3
"""Compare the Hoon importer's projections with their golden file."""

from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
fixture = root / 'tests' / 'importer'
command = [str(root / 'tools' / 'hoon'), '--lib', str(root / 'jibb-dev' / 'lib' / 'jibb-import.hoon'),
           '--raw', '--cord', 'small=' + str(fixture / 'small.txt'),
           '--cord', 'epic=' + str(fixture / 'tlon-epic.txt'),
           '--cord', 'presence=' + str(fixture / 'tlon-presence.txt'),
           '--cord', 'docs=' + str(fixture / 'tlon-docs.txt'),
           '--cord', 'shadow=' + str(fixture / 'shadow.txt'),
           '--cord', 'shadow-static=' + str(fixture / 'shadow-static.txt'),
           '--cord', 'ford=' + str(fixture / 'ford.txt'),
           '--cord', 'mark=' + str(fixture / 'mark.txt'),
           '--cord', 'mark-rec=' + str(fixture / 'mark-recursive.txt'),
           '--cord', 'mark-gate=' + str(fixture / 'mark-gate.txt'),
           '--cord', 'mark-basic=' + str(fixture / 'mark-list.txt'),
           '--cord', 'origin-trans=' + str(fixture / 'origin-transitive.txt'),
           '--cord', 'origin-first=' + str(fixture / 'origin-first.txt'),
           '--cord', 'origin-other=' + str(fixture / 'origin-other.txt'),
           '(fixture-output small epic presence docs shadow shadow-static ford mark mark-rec mark-gate mark-basic origin-trans origin-first origin-other)']
result = subprocess.run(command, stdout=subprocess.PIPE)
if result.returncode:
    sys.exit(result.returncode)
expected = (fixture / 'tree.txt').read_bytes()
if result.stdout != expected:
    import difflib
    sys.stderr.writelines(difflib.unified_diff(
        expected.decode().splitlines(keepends=True),
        result.stdout.decode().splitlines(keepends=True),
        fromfile='expected tree.txt', tofile='actual types'))
    sys.exit(1)
print('importer golden: 182 projections passed')
