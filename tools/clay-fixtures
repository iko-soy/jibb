#!/usr/bin/env python3
"""Build and inspect example /sur and mark fixtures through Clay.

Each fixture is a thread in tests/clay-fixtures, NAME.txt, which
tools/ship runs on the ship; what it prints must equal NAME-expected.txt.
The threads build my-app's own /sur and marks on the my-app desk. The
files only they need, a /sur with a Ford import, a mark and the real
Tlon notes /sur (a link to a golden case's fixture), are in
tests/clay-fixtures/desk, which the jibb-fixtures desk adds to my-app.
Both desks are synced first.
"""

from pathlib import Path
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
ship = root / 'tools' / 'ship'
fixtures = root / 'tests' / 'clay-fixtures'

#  (thread, what a mismatch says, what a pass says), in the order they run
FIXTURES = [
    ('build', 'Clay fixture builds differ', 'Clay fixture builds: 7 passed'),
    ('import', 'Clay imports differ',
     'Clay importer golden: 4 projections passed'),
    # Clay-built library cores as well as a Clay-built /sur; the selected
    # reader result goes to the full checker.
    ('bridge', 'Clay bridge differs',
     'Clay importer/checker bridge golden passed'),
    ('full-import', 'Clay full import differs',
     'Clay imported /sur full-check golden passed'),
    ('record-bridge', 'Clay record bridge differs',
     'Clay record importer/checker bridge golden passed'),
    # A /sur with a Ford import has a different parent subject. This
    # records the actual shape for provenance work without claiming
    # support.
    ('ford', 'Clay Ford subject differs', 'Clay Ford subject golden passed'),
    ('ford-import', 'Clay Ford import differs',
     'Clay Ford importer golden passed'),
    ('ford-recursive', 'Clay recursive Ford import differs',
     'Clay recursive Ford importer golden passed'),
    ('ford-nested-union', 'Clay nested union import differs',
     'Clay nested Ford union importer golden passed'),
    ('ford-nested-union-bridge', 'Clay nested union bridge differs',
     'Clay nested Ford union importer/checker bridge golden passed'),
    ('tlon-mop', 'Clay Tlon mop import differs',
     'Clay Tlon named-mold mop importer golden passed'),
    ('mark-shape', 'Clay mark subject differs',
     'Clay mark subject golden passed'),
    ('mark-import', 'Clay mark import differs',
     'Clay mark importer golden passed'),
    ('mark-update-import', 'Clay union mark import differs',
     'Clay union mark importer golden passed'),
    ('mark-bridge', 'Clay mark bridge differs',
     'Clay mark importer/checker bridge golden passed'),
]


def output(name, tmp):
    """What the fixture's thread prints."""
    thread = fixtures / (name + '.txt')
    if name == 'import':
        # Inject the reader rather than copying it into the fixture: Clay
        # supplies each compiled /sur type graph, and the current reader
        # examines its molds.
        reader = (root / 'jibb-dev/lib/jibb-import.hoon').read_text()
        template = thread.read_text()
        if template.count('@@READER@@') != 1:
            sys.exit('Clay import fixture needs exactly one reader placeholder')
        binding = '=/  reader\n' + ''.join(
            '  ' + line for line in reader.splitlines(keepends=True))
        thread = Path(tmp) / 'import.hoon'
        thread.write_text(template.replace('@@READER@@', binding))
    return subprocess.run([str(ship), 'run', str(thread)],
                          stdout=subprocess.PIPE, check=True).stdout


try:
    for desk in ('my-app', 'jibb-fixtures'):
        subprocess.run([str(ship), 'sync', desk], check=True)
    with tempfile.TemporaryDirectory(prefix='jibb-clay-') as tmp:
        for name, differs, passed in FIXTURES:
            got = output(name, tmp)
            want = 'tests/clay-fixtures/%s-expected.txt' % name
            expected = (root / want).read_bytes()
            if got != expected:
                print('%s from %s' % (differs, want), file=sys.stderr)
                print('expected:', expected.decode().rstrip(), file=sys.stderr)
                print('actual:  ', got.decode().rstrip(), file=sys.stderr)
                sys.exit(1)
            print(passed)
except subprocess.CalledProcessError as error:
    sys.exit(error.returncode)
