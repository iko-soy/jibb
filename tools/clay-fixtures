#!/usr/bin/env python3
"""Build and inspect example /sur and mark fixtures through Clay."""

from pathlib import Path
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
ship = root / 'tools' / 'ship'
fixtures = root / 'tests' / 'clay-fixtures'
try:
    subprocess.run([str(ship), 'sync', 'my-app'], check=True)
    result = subprocess.run([str(ship), 'run', str(fixtures / 'build.txt')],
                            stdout=subprocess.PIPE, check=True)
except subprocess.CalledProcessError as error:
    sys.exit(error.returncode)
expected = (fixtures / 'expected.txt').read_bytes()
if result.stdout != expected:
    print('Clay fixture builds differ from tests/clay-fixtures/expected.txt',
          file=sys.stderr)
    print('expected:', expected.decode().rstrip(), file=sys.stderr)
    print('actual:  ', result.stdout.decode().rstrip(), file=sys.stderr)
    sys.exit(1)
print('Clay fixture builds: 7 passed')

# Inject the reader rather than copying it into the fixture: Clay supplies
# each compiled /sur type graph, and the current reader examines its molds.
reader = (root / 'jibb-dev/lib/jibb-import.hoon').read_text()
template = (fixtures / 'import.txt').read_text()
if template.count('@@READER@@') != 1:
    sys.exit('Clay import fixture needs exactly one reader placeholder')
binding = '=/  reader\n' + ''.join('  ' + line for line in reader.splitlines(keepends=True))
with tempfile.TemporaryDirectory(prefix='jibb-clay-import-') as tmp:
    program = Path(tmp) / 'import.hoon'
    program.write_text(template.replace('@@READER@@', binding))
    try:
        result = subprocess.run([str(ship), 'run', str(program)],
                                stdout=subprocess.PIPE, check=True)
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
expected = (fixtures / 'import-expected.txt').read_bytes()
if result.stdout != expected:
    print('Clay imports differ from tests/clay-fixtures/import-expected.txt', file=sys.stderr)
    print('expected:', expected.decode().rstrip(), file=sys.stderr)
    print('actual:  ', result.stdout.decode().rstrip(), file=sys.stderr)
    sys.exit(1)
print('Clay importer golden: 4 projections passed')

