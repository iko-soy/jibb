::
::  +check: run golden:jibb on a case and compare both outputs
::
++  check
  |=  [case=@ta src=@t tokens=(unit wain) tree=(unit wain)]
  ^-  tang
  (check-at case /tests/golden/[case]/source/jibb src tokens tree)
::
++  check-at
  |=  [case=@ta at=path src=@t tokens=(unit wain) tree=(unit wain)]
  ^-  tang
  =/  out=[tokens=@t tree=@t]  (golden:jibb at src)
  %+  weld
    (compare (file case "tokens.txt") tokens tokens.out)
  (compare (file case "tree.txt") tree tree.out)
::
++  file
  |=  [case=@ta name=tape]
  ^-  tape
  "tests/golden/{(trip case)}/{name}"
::
::  +compare: a file's lines against those of an output plus a newline
::
++  compare
  |=  [name=tape want=(unit wain) got=@t]
  ^-  tang
  =/  have=wain  (to-wain:format (cat 3 got '\0a'))
  ?~  want
    :-  leaf+"{name} is missing; tools/golden --update writes it"
    (turn have |=(l=@t leaf+"  | {(trip l)}"))
  ?:  =(u.want have)
    ~
  =/  n=@ud  (first-difference u.want have)
  :~  leaf+"{name} differs from the output at line {(a-co:co +(n))}:"
      leaf+"  expected: {(line-at u.want n)}"
      leaf+"  actual:   {(line-at have n)}"
  ==
::
++  first-difference
  |=  [a=wain b=wain]
  =|  n=@ud
  |-  ^-  @ud
  ?~  a  n
  ?~  b  n
  ?.  =(i.a i.b)  n
  $(a t.a, b t.b, n +(n))
::
++  line-at
  |=  [lines=wain n=@ud]
  ^-  tape
  ?:  (gte n (lent lines))
    "(the end of the file)"
  ?:  =('' (snag n lines))
    "(an empty line)"
  (trip (snag n lines))
::
++  check-types
  |=  [case=@ta at=path src=@t want=(unit wain)]
  ^-  tang
  (compare (file case "types.txt") want (golden-types:jibb at src))
::
++  check-import-types
  |=  [case=@ta at=path src=@t want=(unit wain) fixtures=(list [module=term mold=term source=wain])]
  ^-  tang
  =/  result  (mule |.((import-types-result at src fixtures)))
  ?:  ?=(%| -.result)
    [leaf+"fixture compilation or type checking crashed" p.result]
  (compare (file case "types.txt") want p.result)
::
++  import-types-result
  |=  [at=path src=@t fixtures=(list [module=term mold=term source=wain])]
  ^-  @t
  =/  external=(list [module=term name=term result=*])
    %+  turn  fixtures
    |=  fixture=[module=term mold=term source=wain]
    ~_  leaf+"/sur/{(trip module.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [module.fixture mold.fixture (read-named:jibb-import module.fixture mold.fixture cor)]
  (golden-types-imports:jibb at src external)
::
++  check-mark-types
  |=  [case=@ta at=path src=@t want=(unit wain) fixtures=(list [module=term mold=term source=wain]) marks=(list [name=term source=wain])]
  ^-  tang
  =/  result  (mule |.((mark-types-result at src fixtures marks)))
  ?:  ?=(%| -.result)
    [leaf+"fixture compilation or type checking crashed" p.result]
  (compare (file case "types.txt") want p.result)
::
++  mark-types-result
  |=  [at=path src=@t fixtures=(list [module=term mold=term source=wain]) marks=(list [name=term source=wain])]
  ^-  @t
  =/  external=(list [module=term name=term result=*])
    %+  turn  fixtures
    |=  fixture=[module=term mold=term source=wain]
    ~_  leaf+"/sur/{(trip module.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [module.fixture mold.fixture (read-named:jibb-import module.fixture mold.fixture cor)]
  =/  mark-external=(list [name=term result=*])
    %+  turn  marks
    |=  fixture=[name=term source=wain]
    ~_  leaf+"/mar/{(trip name.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [name.fixture (read-mark:jibb-import name.fixture cor)]
  (golden-types-with-marks:jibb at src external mark-external)
::
++  check-module-trees
  |=  [case=@ta want=(unit wain) fixtures=(list [label=@t at=path source=@t])]
  ^-  tang
  =/  result  (mule |.((module-trees-result fixtures)))
  ?:  ?=(%| -.result)
    [leaf+"module fixture parsing crashed" p.result]
  (compare (file case "module-trees.txt") want p.result)
::
++  module-trees-result
  |=  fixtures=(list [label=@t at=path source=@t])
  ^-  @t
  =/  actual=@t
    %+  rap  3
    %+  join  '\0a'
    %+  turn  fixtures
    |=  fixture=[label=@t at=path source=@t]
    ~_  leaf+(trip label.fixture)
    =/  out  (golden:jibb at.fixture source.fixture)
    (rap 3 ~[label.fixture '\0a' tree.out])
  actual
::
++  check-module-types
  |=  [case=@ta at=path src=@t want=(unit wain) fixtures=(list [module=term mold=term source=wain]) marks=(list [name=term source=wain]) modules=(list [label=@t at=path source=@t])]
  ^-  tang
  =/  result  (mule |.((module-types-result at src fixtures marks modules)))
  ?:  ?=(%| -.result)
    [leaf+"fixture compilation or type checking crashed" p.result]
  (compare (file case "types.txt") want p.result)
::
++  module-types-result
  |=  [at=path src=@t fixtures=(list [module=term mold=term source=wain]) marks=(list [name=term source=wain]) modules=(list [label=@t at=path source=@t])]
  ^-  @t
  =/  external=(list [module=term name=term result=*])
    %+  turn  fixtures
    |=  fixture=[module=term mold=term source=wain]
    ~_  leaf+"/sur/{(trip module.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [module.fixture mold.fixture (read-named:jibb-import module.fixture mold.fixture cor)]
  =/  mark-external=(list [name=term result=*])
    %+  turn  marks
    |=  fixture=[name=term source=wain]
    ~_  leaf+"/mar/{(trip name.fixture)}.txt fixture"
    ?~  source.fixture  !!
    =/  text=@t  (rap 3 (turn source.fixture |=(line=@t (cat 3 line '\0a'))))
    =/  cor=type  -:(ride -:!>(..zuse) text)
    [name.fixture (read-mark:jibb-import name.fixture cor)]
  =/  sources=(list [path=path source=@t])
    (turn modules |=(item=[label=@t at=path source=@t] [at.item source.item]))
  ?~  prepared-prelude
    (golden-types-with-prelude:jibb at src external mark-external sources prelude-source)
  (golden-types-with-prepared-prelude:jibb at src external mark-external sources prepared-prelude)
--
