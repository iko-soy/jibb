  (check ~.lex-tight-qath-bad-2 src-247 `tok-247 `tre-247)
++  test-lex-tight-qath-bad-3
  (check ~.lex-tight-qath-bad-3 src-248 `tok-248 `tre-248)
++  test-lex-tight-qath-ok-1
  (check ~.lex-tight-qath-ok-1 src-249 `tok-249 `tre-249)
++  test-lex-tight-unit-bad-1
  (check ~.lex-tight-unit-bad-1 src-250 `tok-250 `tre-250)
++  test-lex-tight-unit-ok-1
  (check ~.lex-tight-unit-ok-1 src-251 `tok-251 `tre-251)
++  test-lex-tight-wing-bad-1
  (check ~.lex-tight-wing-bad-1 src-252 `tok-252 `tre-252)
++  test-lex-tight-wing-ok-1
  (check ~.lex-tight-wing-ok-1 src-253 `tok-253 `tre-253)
::
::  +check: run golden:jibb on a case and compare both outputs
::
++  check
  |=  [case=@ta src=@t tokens=(unit wain) tree=(unit wain)]
  ^-  tang
  =/  out=[tokens=@t tree=@t]
    (golden:jibb /tests/golden/[case]/source/jibb src)
  %+  weld
    (compare (file case "tokens.txt") tokens tokens.out)
  (compare (file case "tree.txt") tree tree.out)
::
++  file
  |=  [case=@ta name=tape]
  ^-  tape
  "tests/golden/{(trip case)}/{name}"
::
::  +compare: a file's lines against those of an output plus a newline
::
++  compare
  |=  [name=tape want=(unit wain) got=@t]
  ^-  tang
  =/  have=wain  (to-wain:format (cat 3 got '\0a'))
  ?~  want
    :-  leaf+"{name} is missing; tools/golden --update writes it"
    (turn have |=(l=@t leaf+"  | {(trip l)}"))
  ?:  =(u.want have)
    ~
  =/  n=@ud  (first-difference u.want have)
  :~  leaf+"{name} differs from the output at line {(a-co:co +(n))}:"
      leaf+"  expected: {(line-at u.want n)}"
      leaf+"  actual:   {(line-at have n)}"
  ==
::
++  first-difference
  |=  [a=wain b=wain]
  =|  n=@ud
  |-  ^-  @ud
  ?~  a  n
  ?~  b  n
  ?.  =(i.a i.b)  n
  $(a t.a, b t.b, n +(n))
::
++  line-at
  |=  [lines=wain n=@ud]
  ^-  tape
  ?:  (gte n (lent lines))
    "(the end of the file)"
  ?:  =('' (snag n lines))
    "(an empty line)"
  (trip (snag n lines))
--
