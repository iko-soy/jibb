+$ input
  [%item flag=? text=@t]
  %none
+$ result
  %good
  %empty
++ local-id |= x x
++ passthrough |= x=input x
++ grouped |= x=input ^- (list @t)
  ?- (x)
    [%item flag words] ~[words]
    %none ~
++ call |= x=input ^- (list @t)
  ?- (local-id x)
    [%item flag words] ~[words]
    %none ~
++ nested |= x=input ^- result
  ?- (local-id (passthrough x))
    [%item flag words] %good
    %none %empty
++ finite |= x=input ^- (list @t)
  ?- (local-id x)
    [%item %.y words] ~[words]
    [%item %.n words] ~[]
    %none ~
++ wrong |= x=input ^- result
  ?- (local-id x)
    [%item flag words] %missing
    %none %empty
++ missing |= x=input ^- (list @t)
  ?- (local-id x)
    %none ~
++ dead |= x=input ^- (list @t)
  ?- (local-id x)
    %none ~
    %none ~
    [%item flag words] ~[words]
++ shadow |= x=input ^- result
  ?- (local-id x)
    [%item flag same] %good
    %none %empty
++ pending |= x=input ^- result
  ~& %dangling
    ?- (local-id x)
      [%item flag words] %good
      %none %empty
++ unknown |= x ^- (list @t)
  ?- (local-id x)
    [%item flag words] ~[words]
    %none ~
++ nonunion |= x=@t ^- (list @t)
  ?- (local-id x)
    [%item flag words] ~[words]
    %none ~
++ explicit |= [x=input y=A] ^- (list A)
  ?- (local-id x)
    [%item flag words] ~["text"]
    %none ~
+$ payload |$ [A]
  [%present value=A]
  %none
++ shared |= [x=(payload A) y=A] ^- (list A)
  ?- (local-id x)
    [%present v] ~[y v]
    %none ~
++ bad-subject |= x=input ^- result
  ?- (passthrough "wrong")
    [%item flag words] %missing
    %none %empty
++ first-of |= [a b] a
++ pending-subject |= x=input ^- result
  ?- (first-of x %dangling)
    [%item flag words] %good
    %none %empty
++ duplicate-flag-subject |= x=@t ^- (list @t)
  ?- (passthrough x)
    %.y ~[]
    %.y ~[]
++ bad-unit-subject |= x=@t ^- (list @t)
  ?- (passthrough x)
    ~ ~[]
    [~ value] ~[]
