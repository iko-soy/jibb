++ empty ^- (list @t) ~
++ one ^- (list @t) ["a" ~]
++ zero-tail ^- (list @t) ["a" %$]
++ zero-number ^- (list @t) ["a" %0]
++ zero-amp ^- (list @t) ["a" %&]
++ multiple ^- (list @t) ["a" ["b" ~]]
++ nested ^- (list (list @t)) [~["a"] ~]
++ nested-cons ^- (list (list @t)) [["a" ~] ~]
++ take |= xs=(list @t) xs
++ call (take ["hi" ~])










