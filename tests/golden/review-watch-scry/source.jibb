+$ model @ud
+$ msg @t
++ init |= data=@t ^- model 0
++ update |= [m=msg s=model] ^- [model (list (cmd msg))] [s ~]
++ view |= s=model ^- (element msg) (text "ok")
++ request ^- (ask msg)
  [%agent api="/ui/api/demo" case=%plain agent=%demo path=~ scry=`~ receive=|=(input=[mark=@tas state=(unit @ud) fact=*] [state=0 message="ok"])]
++ subs |= s=model ^- (list (sub msg)) ~[[%watch request]]
++ main (program init update view subs)
