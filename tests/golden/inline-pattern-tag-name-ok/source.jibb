+$ step
  [%move %left n=@ud]
  [%move %right n=@ud]
  [text=@t %draft]
  [text=@t %sent at=@da]
  %stop
+$ colour
  %red
  %green
+$ shape
  [%circle red=@ud]
  [%label text=@t]
  %blank

++ describe |= s=step
  ?- s
    [%move %left n]   "left {n}"
    [%move %right n]  "right {n}"
    [t %draft]        t
    [t %sent sent-at] t
    %stop             "stop"
++ elsewhere |= s=step
  ?- s
    [%move %left n]   "left {n}"
    [%move %right n]  "right {n}"
    [move %draft]     move
    [t %sent sent-at] t
    %stop             "stop"
++ rest |= s=step
  ?- s
    [%move left]      "move"
    [t %draft]        t
    [t %sent sent-at] t
    %stop             "stop"
++ aura |= s=shape
  ?- s
    [%circle red]  "{red}"
    [%label green] green
    %blank         "blank"
++ other-union |= s=shape
  ?- s
    [%circle r]  "{r}"
    [%label t]   t
    red          "other"
++ sample |= stop=step "sample"
++ sample-bare ^- $-(step @t) |= stop "sample"
++ atom |= s=@tas
  ?- s
    %stop  "stop"
    stop   "other"
++ noun |= s=*
  ?- s
    stop  "any"
