++ identity |= x=(cmd @t) x
++ generic |= x=(cmd A) x
++ nav ^- (cmd @t) [%go url="/home"]
++ time ^- (cmd @t) [%now reply=|=(d=@da "done")]
++ bad ^- (cmd @t) [%go url=~zod]
++ send |= p=poke
  ^- (cmd @t) [%poke p |=(r=(unit @t) "done")]
++ wait ^- (cmd @t) [%wait ~s30 "done"]
++ who ^- (cmd @t) [%who |=(p=@p "done")]
++ wrong-message ^- (cmd @t) [%wait ~s30 ~zod]
++ wrap-value |= x=A ^- (cmd A) [%wait ~s30 x]
++ wrap-value-text (wrap-value "hello")
++ wrap-value-ship (wrap-value ~zod)
++ wrong-reply ^- (cmd @t) [%who |=(p=@p ~zod)]
++ commands ^- (list (cmd @t)) ~[[%go "/home"] [%wait ~s30 "done"]]
++ commands-bad ^- (list (cmd @t)) ~[[%go "/home"] [%wait ~s30 ~zod]]
++ wrong-poke |= p=poke
  ^- (cmd @t) [%poke p |=(r=@p "done")]
++ wrong-case ^- (cmd @t) %oops
++ use-text |= x=(cmd @t) x
++ cross (use-text (wrap-value ~zod))
