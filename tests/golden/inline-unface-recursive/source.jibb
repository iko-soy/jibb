++ weld2 (unface
  |= [xs=(list A) ys=(list A)] ^- (list A)
    ?- xs
      ~ ys
      [item rest] [item (weld2 rest ys)]
++ joined (weld2 ~[1] ~[2])
++ even (unface
  |= n=@ud ^- ?
    ?- (eq n 0)
      %.y %.y
      %.n (odd (dec n))
++ odd (unface
  |= n=@ud ^- ?
    ?- (eq n 0)
      %.y %.n
      %.n (even (dec n))
++ outer |= n=@ud
  ++ count (unface
    |= [a=@ud b=@ud] ^- @ud
      ?- (eq a 0)
        %.y b
        %.n (count (dec a) b)
  (count n 1)
