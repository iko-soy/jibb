++ copy |= xs=(list @t)
  ^- (list @t)
    ?- xs
      ~ ~
      [item rest] [item (copy rest)]
++ copy-reverse |= xs=(list @t)
  ^- (list @t)
    ?- xs
      [item rest] [item (copy-reverse rest)]
      ~ ~
++ boolean |= b=?
  ^- (list @t)
    ?- b
      %.y ~[]
      %.n ["hi" ~]
++ unit-branch |= x=(unit @t)
  ^- (list @t)
    ?- x
      ~ ~[]
      [~ item] [item ~]
++ nested |= xs=(list @t)
  ^- (list @t)
    ?- xs
      ~
        ?- %.y
          %.y ~[]
          %.n ["x" ~]
      [item rest] [item (copy rest)]
++ consume |= xs=(list @t) xs
++ call |= b=?
  (consume
    ?- b
      %.y ~[]
      %.n ["hi" ~]
++ bad-head |= b=?
  ^- (list @t)
    ?- b
      %.y ~[]
      %.n [~zod ~]
++ bad-tail |= b=?
  ^- (list @t)
    ?- b
      %.y ["hi" ~zod]
      %.n ~[]
++ pending |= b=?
  ~& %unknown
    ^- (list @t)
      ?- b
        %.y ~[]
        %.n ["hi" ~]
++ pending-null |= b=?
  ~& ~
    ^- (list @t)
      ?- b
        %.y ~[]
        %.n ["hi" ~]
++ incomplete |= xs=(list @t)
  ^- (list @t)
    ?- xs
      ~ ~[]
++ duplicate |= xs=(list @t)
  ^- (list @t)
    ?- xs
      ~ ~[]
      ~ ~[]
      [item rest] [item ~]
++ opposite |= b=?
  ^- (list @t)
    ?- b
      %.y [~zod ~]
      %.n ["hi" ~]
++ escape |= xs=(list @t)
  ^- (list @t)
    ?- xs
      ~ [item ~]
      [item rest] [item ~]
++ bad-recursive |= xs=(list @t)
  ^- (list @t)
    ?- xs
      ~ ~[]
      [item rest] [item (bad-recursive ~zod)]
