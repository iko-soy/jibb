++ drop-text (drop `"hi")
++ drop-ship (drop `~zod)
++ skim-text (skim ~["hi"] |=(x=@t %.y))
++ skim-ship (skim ~[~zod] |=(x=@p %.n))
++ skip-text (skip ~["hi"] |=(x=@t %.n))
++ skip-ship (skip ~[~zod] |=(x=@p %.y))
++ murn-text (murn ~["hi"] |=(x=@t `x))
++ murn-ship (murn ~[~zod] |=(x=@p `x))
++ join-text (join "," ~["a" "b"])
++ join-ship (join ~zod ~[~nec ~bud])
++ snip-text (snip ~["a" "b"])
++ snip-ship (snip ~[~zod ~nec])
++ bad-drop (drop "hi")
++ bad-skim (skim ~["hi"] |=(x=@p %.y))
++ bad-join (join ~zod ~["hi"])
