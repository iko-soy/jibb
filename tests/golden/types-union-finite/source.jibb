+$ msg
  [%p left=? right=?]
  %other
++ boolean-table |= m=msg
  ?- m
    [%p %.y %.y] "a"
    [%p %.y %.n] "b"
    [%p %.n %.y] "c"
    [%p %.n %.n] "d"
    %other "e"
++ parent |= m=msg
  ?- m
    [%p %.y %.y] 0x1f
    [%p %.y %.n] ^- @u 0x1f
    [%p %.n %.y] 0
    [%p %.n %.n] 0x2f
    %other ^- @u 0x1f
++ wildcard |= m=msg
  ?- m
    [%p %.y *] "a"
    [%p %.n *] "b"
    %other "e"
++ covered |= m=msg
  ?- m
    [%p %.y *] "a"
    [%p %.y %.n] "b"
    * "e"

+$ choice
  [%a on=?]
  %other
++ missing |= x=choice
  ?- x
    [%a %.y] "yes"
    %other "other"
++ typed |= x=choice
  ?- x
    [%a value] value
    %other %.n
++ duplicate |= x=choice
  ?- x
    [%a %.y] "yes"
    [%a %$] "duplicate"
    * "other"
++ shadow |= x=choice
  ?- x
    [%a missing] "yes"
    %other "other"
++ many-bind |= x=choice
  ?- x
    value "anything"
    %other "dead"
