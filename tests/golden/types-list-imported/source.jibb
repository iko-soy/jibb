/-  fixture
++ take |= xs=texts.fixture xs
++ as-written |= xs=texts.fixture ^- (list @t) xs
++ to-imported |= xs=(list @t) (take xs)
++ literal (take ~["hi"])
++ bad |= xs=ships.fixture (take xs)
++ cons (take ["hi" ~])
++ empty ^- texts.fixture ~
++ bad-cons ^- texts.fixture [~zod ~]
++ branch |= b=?
  ^- texts.fixture
    ?- b
      %.y ~[]
      %.n ["hi" ~]
