++ bind-text (bind `"hi" |=(x x))
++ bind-ship (bind `~zod |=(x x))
++ biff-text (biff `"hi" |=(x `x))
++ both-mixed (both `"hi" `~zod)
++ clap-text (clap `"hi" `"there" |=(p=[@t @t] "yes"))
++ clef-mixed (clef `"hi" `~zod |=(p=[@t @p] `"ok"))
++ flit-text ((flit |=(x=@t %.y)) "hi")
++ wrong (bind `~zod |=(x=@t x))
++ pending
  ~& %open
    (both `"hi" `~zod)
++ clap-ship (clap `~zod `~bus |=(p=[@p @p] ~zod))
++ clef-ship (clef `"hi" `~zod |=(p=[@t @p] `~zod))
++ clap-bad (clap `"hi" `~zod |=(p=[@t @t] "yes"))
++ clef-bad (clef `"hi" `~zod |=(p=[@p @t] `"ok"))
++ hunt-first (hunt |=(p=[@t @t] %.y) `"a" `"b")
++ hunt-second (hunt |=(p=[@t @t] %.n) `"a" `"b")
++ hunt-left (hunt |=(p=[@t @t] %.y) ~ `"b")
++ hunt-right (hunt |=(p=[@t @t] %.n) `"a" ~)
++ hunt-bad (hunt |=(p=[@t @t] %.y) `"a" `~zod)
++ hunt-gate-bad (hunt |=(p=[@t @p] %.y) `"a" `"b")
