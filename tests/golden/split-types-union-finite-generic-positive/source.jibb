+$ msg |$ [A B]
  [%ok bit=? val=A]
  [%err bit=? val=B]
++ shared |= m=(msg A A)
  ?- m
    [%ok %.y value] value
    [%ok %.n value] value
    [%err %.y value] value
    [%err %.n value] value


















+$ choice |$ [A]
  [%hit on=? payload=A]
  %other
++ getter |= input=(choice @t)
  ?- input
    [%hit %.y payload] payload
    [%hit %.n payload] payload
    %other "other"
++ flag |= input=(choice @t)
  ?- input
    [%hit on *] on
    %other %.n
++ atom-parts |= input=(choice @t)
  ?- input
    [%hit %.y "hello"] "yes"
    * "no"





