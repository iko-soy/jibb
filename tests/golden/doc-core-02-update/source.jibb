++ update |= [=msg m=model]
  ?- msg
    [%typed t]
      ?- (gth (lent (tuba (trip t))) 80)
        %.y  [m(draft=t error=`"Too long") ~]
        %.n  [m(draft=t error=~) ~]
    %submit        [m(draft="") ~[[%poke (todo-action.todo [%add draft.m]) |=%acked]]]
    [%toggled id]  [m ~[[%poke (todo-action.todo [%toggle id]) |=%acked]]]
    [%got ts]      [m(todos=ts) ~]
    [%acked err]   [m(error=err) ~]
