+$ msg
  %add
  %remove
  [%noted text=@t]
++ choose |= b=?
  ^- msg
    ?- b
      %.y %add
      %.n %remove
++ records |= b=?
  ^- msg
    ?- b
      %.y [%noted "hi"]
      %.n %add










++ nested |= b=?
  ^- msg
    ?- b
      %.y
        ?- b
          %.y %add
          %.n %remove
      %.n %remove
++ grouped |= b=?
  ^- msg
    (
      ?- b
        %.y %add
        %.n %remove
++ consume |= x=msg "ok"
++ call |= b=?
  (consume
    ?- b
      %.y %add
      %.n %remove










