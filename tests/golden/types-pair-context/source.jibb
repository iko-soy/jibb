+$ spacing
  %s0
  %s1
  %s2
  %s3
+$ extent
  [%fill n=@ud]
  %shrink
+$ attribute
  [%gap spacing]
  [%pad spacing]
  [%width extent]
+$ other-attribute
  [%gap spacing]
  [%pad spacing]
  [%width extent]
++ one ^- attribute gap+%s2
++ equiv ^- attribute [%gap %s2]
++ attributes ^- (list attribute) ~[gap+%s2 pad+%s3 width+[%fill 1]]
++ gap-structural ^- [@tas @tas] gap+%s2
++ nested ^- attribute width+[%fill 1]
++ mismatch ^- attribute gap+%shrink
++ missing ^- attribute width+[%oops 1]
++ pending gap+%s2
++ cross-origin ^- attribute ^- other-attribute gap+%s2
++ noun-pair ^- [* *] gap+%s2
++ atom-pair ^- [@ta @tas] gap+%s2
++ wrong-head ^- [@ud @tas] gap+%s2
++ wrong-number ^- attribute width+[%fill "hi"]
++ unrelated
  ~& %dangling
    ^- attribute gap+%s2
