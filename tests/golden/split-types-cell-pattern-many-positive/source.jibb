++ three |= args=[@t @p ?]
  ?- args
    [a b c] c
++ four |= args=[@t @p ? @ux]
  ?- args
    [a b c d] d
++ rest |= args=[@t @p [? @ux]]
  ?- args
    [a b c] c
++ infer |= x
  ?- x
    [a b c] [c b a]















++ record |= args=[a=@t b=@p c=?]
  ?- args
    [a b c] a
++ nested |= args=[@t [@p ?] @ux]
  ?- args
    [a [b c] d] d
++ wildcard |= args=[@t @p ?]
  ?- args
    [a * c] c





