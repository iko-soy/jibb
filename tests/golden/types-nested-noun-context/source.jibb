+$ msg
  %ready
  %idle
+$ inner |$ [A]
  [%one item=A]
  [%two item=A]
+$ null-out |$ [A]
  [~ item=(inner A)]
  [%other value=@ud]
+$ flag-out |$ [A]
  [%.y item=(inner A)]
  [%other value=@ud]
+$ term-out |$ [A]
  [%$ item=(inner A)]
  [%other value=@ud]
+$ competitors |$ [A]
  [~ item=(inner A)]
  [%.y value=@p]
++ inner |= x=A ^- (inner A) [%one x]
++ null-null ^- (null-out msg) [~ (inner %ready)]
++ flag-null ^- (null-out msg) [%.y (inner %ready)]
++ term-null ^- (null-out msg) [%$ (inner %ready)]
++ null-flag ^- (flag-out msg) [~ (inner %ready)]
++ flag-flag ^- (flag-out msg) [%.y (inner %ready)]
++ term-flag ^- (flag-out msg) [%$ (inner %ready)]
++ null-term ^- (term-out msg) [~ (inner %ready)]
++ flag-term ^- (term-out msg) [%.y (inner %ready)]
++ term-term ^- (term-out msg) [%$ (inner %ready)]
++ wrong-inner ^- (null-out msg) [%$ (inner %missing)]
++ wrong-payload ^- (flag-out @t) [~ (inner ~zod)]
++ pending
  ~& %orphan
    ^- (term-out msg) [%.y (inner %ready)]
++ unknown-target |= x=A ^- A [~ (inner %ready)]
++ ambiguous ^- (competitors msg) [~ (inner %ready)]
