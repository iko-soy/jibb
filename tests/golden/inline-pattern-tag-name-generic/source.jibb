+$ step
  [%go n=@ud]
  %stop
+$ outcome |$ [A]
  [%ok value=A]
  %fail
+$ reason
  %fail
  %late

++ own-case |= o=(outcome @t)
  ?- o
    [%ok v]  v
    fail     "failed"
++ own-head |= o=(outcome reason)
  ?- o
    [ok r]  "x"
    %fail   "failed"
++ argument |= o=(outcome reason)
  ?- o
    [%ok fail]  "x"
    %fail       "failed"
++ maybe |= u=(unit step)
  ?- u
    ~         "none"
    [~ stop]  "s"
++ items |= xs=(list step)
  ?- xs
    ~            "none"
    [stop rest]  "s"
