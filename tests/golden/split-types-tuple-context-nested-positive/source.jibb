+$ msg
  %go
  %stay
++ take |= p=[payload=msg xs=(list @t)] p
++ ok (take [payload=%go xs=~])



++ nest |= p=[data=[payload=msg xs=(list @t)] z=@p] p
++ nested (nest [data=[payload=%stay xs=~] z=~zod])








++ generic |= p=[left=A right=A] p

+$ typed [%typed text=@t]
++ use-ctor |= p=[f=$-(@t typed) payload=@t] p
++ constructor (use-ctor [f=|=%typed payload="hi"])

