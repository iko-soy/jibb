+$ msg
  %idle
  %busy
+$ other
  %idle
  %busy
+$ choice |$ [A B]
  [%one value=A]
  [%two value=B]
+$ swap |$ [A B] (choice B A)
+$ repeated |$ [A] (choice A A)
+$ phantom |$ [A B] (choice A @p)
++ wrap |= x=A ^- (choice A @p) [%one x]
++ wrap-repeat |= x=A ^- (repeated A) [%one x]
++ use-msg ^- (choice msg @p) (wrap %idle)
++ use-alias ^- (swap @p msg) (wrap %idle)
++ use-repeated ^- (repeated msg) (wrap-repeat %idle)
++ use-distinct ^- (choice other @p) (wrap %idle)
++ independent |= [m=msg n=other]
  [(^- (choice msg @p) (wrap m)) (^- (choice other @p) (wrap n))]
++ pending
  ~& %orphan
    ^- (choice msg @p) (wrap %idle)
++ wrong-case ^- (choice msg @p) (wrap %absent)
