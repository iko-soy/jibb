#### /ui/probe/jibb pattern-pair-units
++ pair-sum |= p=[(unit @ud) (unit @ud)]
  ?- p
    [[~ a] [~ b]]  (add a b)
    *              0
#### /ui/probe/jibb clap-units
++ summed (clap `1 `2 add)
#### /ui/probe/jibb pattern-lit-ud
++ lit |= n=@ud
  ?- n
    1.000  %.y
    *      %.n
#### /ui/probe/jibb pattern-lit-ship
++ who |= s=@p
  ?- s
    ~zod  "zod"
    *     "other"
#### /ui/probe/jibb pattern-lit-cord
++ milk |= t=@t
  ?- t
    "milk"  %.y
    *       %.n
#### /ui/probe/jibb pattern-list-cons
++ first |= xs=(list @ud)
  ?- xs
    ~       0
    [x xs2] x
#### /ui/probe/jibb pattern-list-one-catch
++ one |= xs=(list @ud)
  ?- xs
    [x ~]  x
    *      0
#### /ui/probe/jibb pattern-trailing-rest
++ second |= p=[(unit @ud) (unit @ud)]
  ?- p
    [~ b]  b
    *      ~
#### /ui/probe/jibb print-sum-annotated
++ shown ^- @t "{(add 1 2)}"
#### /ui/probe/jibb print-ud-var
++ shown |= n=@ud "{n} items"
#### /ui/probe/jibb print-generic-error
++ shown |= n=A
  "{(add n 1)}"
