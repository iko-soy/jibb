++ bad (inc %.y)
#### /ui/probe/jibb inc-generic-print
++ inc |= n=A (add n 1)
#### /ui/probe/jibb eq-gates-unsound?
++ same-as |= [a=A b=A] (eq a b)
++ bad (same-as same same)
#### /ui/probe/jibb eq-generic-print
++ same-as |= [a=A b=A] (eq a b)
#### /ui/probe/jibb clamp-print
++ clamp |= [lo=A hi=A n=A]
  ?- (gth n hi)
    %.y  hi
    %.n
      ?- (gth lo n)
        %.y  lo
        %.n  n
