#### /ui/index/jibb BAD-island-data-atom
/=  todo       /ui/api/todo
/=  todo-list  /ui/todo-list

++ main (page load view)
++ load |=(~ (todos.todo same))

++ view |= ts=(list item.todo)
  column ~[pad+%s3] ~[
    heading 1 "My ship"
    island main.todo-list 5
#### /ui/index/jibb BAD-view-sample
/=  todo       /ui/api/todo
/=  todo-list  /ui/todo-list

++ main (page load view)
++ load |=(~ (todos.todo same))

++ view |= ts=(list @t)
  column ~[pad+%s3] ~[
    heading 1 "My ship"
    text "x"
#### /ui/todo-list/jibb BAD-cmd-bare-tag
/=  todo  /ui/api/todo

++ main (program init update view subs)

+$ model [todos=(list item.todo) draft=@t error=(unit @t)]
+$ msg
  [%typed text=@t]
  %submit
  [%toggled id=@ud]
  [%got todos=(list item.todo)]
  [%acked err=(unit @t)]

++ init |= ts=(list item.todo)
  [todos=ts draft="" error=~]

++ update |= [=msg m=model]
  ?- msg
    [%typed t]
      ?- (gth (lent (tuba (trip t))) 80)
        %.y  [m(draft=t error=`"Too long") ~]
        %.n  [m(draft=t error=~) ~]
    %submit        [m(draft="") ~[(poke.todo [%add draft.m] |=%acked)]]
    [%toggled id]  [m ~[(poke.todo [%toggle id] |=%acked)]]
    [%got ts]      [m(todos=ts) ~[%submit]]
    [%acked err]   [m(error=err) ~]

++ subs |= m=model
  ~[[%watch (todos.todo |=%got)]]

++ view |= m=model
  column ~[gap+%s2] ~[
    heading 2 "Todos"
    each (turn todos.m row-of)
    row ~[gap+%s1] ~[
      el ~[width+[%fill 1]] (field "New todo" draft.m |=%typed)
      button "Add" %submit
    el ~[tone+%danger] (text (fall error.m ""))

++ row-of |= t=item.todo
  [id.t (toggle done.t text.t [%toggled id.t])]
#### /ui/basket/jibb BAD-cart-poke-case
::  /ui/basket.jibb
/=  cart  /ui/stores/cart

++ main (program init update view subs)

+$ model [cart=state.cart note=@t]
+$ msg
  [%noted text=@t]
  %add
  %toggle
  [%got cart=state.cart]
  [%acked err=(unit @t)]

++ init |= ~
  [cart=[items=~ open=%.n] note=""]

++ update |= [=msg m=model]
  ?- msg
    [%noted t]     [m(note=t) ~]
    %add           [m(note="") ~[(poke.cart [%remove note.m] |=%acked)]]
    %toggle        [m ~[(poke.cart %toggle |=%acked)]]
    [%got c]       [m(cart=c) ~]
    [%acked err]   [m ~]

++ subs |= m=model
  ~[[%watch (state.cart |=%got)]]

++ view |= m=model
  column ~[gap+%s1] ~[
    (text "{(lent items.cart.m)} items")
    field "Item" note.m |=%noted
    button "Add" %add
