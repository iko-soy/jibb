#### /ui/basket/jibb basket-typo-addd
::  /ui/basket.jibb
/=  cart  /ui/stores/cart

++ main (program init update view subs)

+$ model [cart=state.cart note=@t]
+$ msg
  [%noted text=@t]
  %add
  %toggle
  [%got cart=state.cart]
  [%acked err=(unit @t)]

++ init |= ~
  [cart=[items=~ open=%.n] note=""]

++ update |= [=msg m=model]
  ?- msg
    [%noted t]     [m(note=t) ~]
    %add           [m(note="") ~[(poke.cart [%add note.m] |=%acked)]]
    %toggle        [m ~[(poke.cart %toggle |=%acked)]]
    [%got c]       [m(cart=c) ~]
    [%acked err]   [m ~]

++ subs |= m=model
  ~[[%watch (state.cart |=%got)]]

++ view |= m=model
  column ~[gap+%s1] ~[
    (text "{(lent items.cart.m)} items")
    field "Item" note.m |=%noted
    button "Add" %addd
