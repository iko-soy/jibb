#### /ui/index/jibb page-main-hand-built-load
/=  todo       /ui/api/todo
/=  todo-list  /ui/todo-list

++ main (page load view)
++ load |= ~
  ^- (ask (list item.todo))
  [%agent api="/ui/api/todo" case=%todos agent=%todo path=~[%todos] scry=~ receive=receive]
++ receive |= input=[mark=@tas state=(unit *) fact=*]
  ^- [state=* message=(list item.todo)] [state=0 message=~]

++ view |= ts=(list item.todo)
  column ~[pad+%s3] ~[
    heading 1 "My ship"
    island main.todo-list ts
#### /ui/index/jibb page-main-typed-load
/=  todo       /ui/api/todo
/=  todo-list  /ui/todo-list

++ main (page load view)
++ load |=(~ (todo-by-id.todo 1 same))

++ view |= item=todo-item.todo
  text "One todo"
#### /ui/index/jibb page-main-diff-load
/=  todo       /ui/api/todo
/=  todo-list  /ui/todo-list

++ main (page load view)
++ fold |= [d=[%todo-update todo-update.todo] s=todos.todo] s
++ load |=(~ (changes.todo same fold))

++ view |= ts=(list item.todo)
  column ~[pad+%s3] ~[
    heading 1 "My ship"
    island main.todo-list ts
#### /ui/stores/cart/jibb store-alias-main
::  /ui/stores/cart.jibb
+$ state [items=(list @t) open=?]
+$ poke
  [%add item=@t]
  %toggle

++ main (build init update)
++ init ^- state [items=~ open=%.n]
++ update |= [a=poke s=state]
  ?- a
    [%add item]  s(items=[item items.s])
    %toggle      s(open=(not open.s))
++ build store
#### /ui/stores/cart/jibb store-hand-main
::  /ui/stores/cart.jibb
+$ state [items=(list @t) open=?]
+$ poke
  [%add item=@t]
  %toggle

++ main [init update]
++ init ^- state [items=~ open=%.n]
++ update |= [a=poke s=state]
  ?- a
    [%add item]  s(items=[item items.s])
    %toggle      s(open=(not open.s))
