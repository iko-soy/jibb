#### /ui/stores/cart/jibb cart-init-uncast-tuple
::  /ui/stores/cart.jibb
+$ state [items=(list @t) open=?]
+$ poke
  [%add item=@t]
  %toggle

++ main (store init update)
++ init [~ %.n]
++ update |= [a=poke s=state]
  ?- a
    [%add item]  s(items=[item items.s])
    %toggle      s(open=(not open.s))
#### /ui/stores/cart/jibb cart-init-uncast-nonull
::  /ui/stores/cart.jibb
+$ state [count=@ud open=?]
+$ poke
  [%add item=@t]
  %toggle

++ main (store init update)
++ init [count=0 open=%.n]
++ update |= [a=poke s=state]
  ?- a
    [%add item]  s(count=(add 1 count.s))
    %toggle      s(open=(not open.s))
