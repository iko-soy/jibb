#### /ui/index/jibb page-main-page-alias
/=  todo       /ui/api/todo
/=  todo-list  /ui/todo-list

++ make-page page
++ main (make-page load view)
++ load |=(~ (todos.todo same))

++ view |= ts=(list item.todo)
  column ~[pad+%s3] ~[
    heading 1 "My ship"
    island main.todo-list ts
