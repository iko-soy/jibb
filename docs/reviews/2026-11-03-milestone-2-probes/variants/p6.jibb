#### /ui/todo-list/jibb castinit-update-helper
/=  todo  /ui/api/todo

++ main (program init update view subs)

+$ model [todos=(list item.todo) draft=@t error=(unit @t)]
+$ msg
  [%typed text=@t]
  %submit
  [%toggled id=@ud]
  [%got todos=(list item.todo)]
  [%acked err=(unit @t)]

++ init |= ts=(list item.todo)
  ^- model [ts "" ~]

++ update |= [=msg m=model]
  ?- msg
    [%typed t]
      ?- (gth (lent (tuba (trip t))) 80)
        %.y  [m(draft=t error=`"Too long") ~]
        %.n  [m(draft=t error=~) ~]
    %submit        [m(draft="") ~[(add-cmd draft.m)]]
    [%toggled id]  [m ~[(poke.todo [%toggle id] |=%acked)]]
    [%got ts]      [m(todos=ts) ~]
    [%acked err]   [m(error=err) ~]

++ subs |= m=model
  ~[[%watch (todos.todo |=%got)]]

++ view |= m=model
  column ~[gap+%s2] ~[
    heading 2 "Todos"
    each (turn todos.m row-of)
    row ~[gap+%s1] ~[
      el ~[width+[%fill 1]] (field "New todo" draft.m |=%typed)
      button "Add" %submit
    el ~[tone+%danger] (text (fall error.m ""))

++ row-of |= t=item.todo
  [id.t (toggle done.t text.t [%toggled id.t])]

++ add-cmd |= d=@t
  (poke.todo [%add d] |=%acked)
#### /ui/todo-list/jibb castinit-second-sub-every
/=  todo  /ui/api/todo

++ main (program init update view subs)

+$ model [todos=(list item.todo) draft=@t error=(unit @t)]
+$ msg
  [%typed text=@t]
  %submit
  [%toggled id=@ud]
  [%got todos=(list item.todo)]
  [%acked err=(unit @t)]
  [%tick at=@da]

++ init |= ts=(list item.todo)
  ^- model [ts "" ~]

++ update |= [=msg m=model]
  ?- msg
    [%typed t]
      ?- (gth (lent (tuba (trip t))) 80)
        %.y  [m(draft=t error=`"Too long") ~]
        %.n  [m(draft=t error=~) ~]
    %submit        [m(draft="") ~[(poke.todo [%add draft.m] |=%acked)]]
    [%toggled id]  [m ~[(poke.todo [%toggle id] |=%acked)]]
    [%got ts]      [m(todos=ts) ~]
    [%acked err]   [m(error=err) ~]
    [%tick at]     [m ~]

++ subs |= m=model
  ~[[%watch (todos.todo |=%got)] [%every ~s30 |=%tick]]

++ view |= m=model
  column ~[gap+%s2] ~[
    heading 2 "Todos"
    each (turn todos.m row-of)
    row ~[gap+%s1] ~[
      el ~[width+[%fill 1]] (field "New todo" draft.m |=%typed)
      button "Add" %submit
    el ~[tone+%danger] (text (fall error.m ""))

++ row-of |= t=item.todo
  [id.t (toggle done.t text.t [%toggled id.t])]
