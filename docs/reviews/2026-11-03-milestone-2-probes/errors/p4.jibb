#### X1-multiarg-site
++ v (add 1 "x")
#### X2-pt-valid
+$ pt
  @t
  [@ud @ud]
++ a ^- pt "x"
#### X3-pt-faced-cases
+$ pt
  x=@ud
  y=@ud
#### X4-pt-tuple-meant
+$ pt
  @ud
  @ud
#### X5-step-doc-missing-stop
+$ step
  [%move %left n=@ud]
  [%move %right n=@ud]
  [text=@t %draft]
  [text=@t %sent at=@da]
  %stop
++ describe |= s=step
  ?- s
    [%move %left n]   "left {n}"
    [%move %right n]  "right {n}"
    [t %draft]        t
    [t %sent sent-at] t
#### X6-title-trim-annotated
++ title ^- @t (trim title)
