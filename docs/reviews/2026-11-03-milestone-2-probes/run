#!/usr/bin/env python3
"""Rerun review probes: run plain FILE, run app FILE, or run imports.

App mode accepts up to three independent groups, adding --app-source FILE
for each source after the positional file. Each group keeps its own module
overrides; output follows source order.
"""

import argparse
from pathlib import Path
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
sys.path.insert(0, str(ROOT / 'tools'))
import prelude_groups


def hoon_list(entries):
    return '~[' + ' '.join(entries) + ']' if entries else '~'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=('plain', 'app', 'imports'))
    parser.add_argument('source', nargs='?')
    parser.add_argument('--app-source', action='append', default=[], metavar='FILE',
                        help='another independent app group (at most three total; '
                             'positional source first, then option order)')
    parser.add_argument('--no-debug', action='store_true',
                        help='omit Hoon debug spots for the fast regression pass')
    args = parser.parse_args()
    if args.app_source and args.mode != 'app':
        parser.error('--app-source is only for app mode')
    app_sources = ([args.source] if args.source is not None else []) + args.app_source
    if args.mode == 'plain' and args.source is None:
        parser.error('plain requires a sectioned source file')
    if args.mode == 'app' and not 1 <= len(app_sources) <= 3:
        parser.error('app requires one to three independent source files')
    command = [str(ROOT / 'tools/hoon'), '--raw']
    if args.no_debug:
        command.append('--no-debug')
    if args.mode == 'app' and len(app_sources) > 1:
        command.extend(['--timeout', str(600 * len(app_sources))])

    def cord(name, path):
        command.extend(['--cord', name + '=' + str(path)])

    cord('prelude', ROOT / 'jibb-dev/lib/jibb/prelude.jibb')
    cord('internal', ROOT / 'jibb-dev/lib/jibb/internal.jibb')
    groups, private, readers = prelude_groups.load_all(str(ROOT))
    group_entries, private_entries = [], []
    for number, (face, logical, filename, _) in enumerate(groups + private):
        binding = 'probe-group-' + str(number)
        cord(binding, filename)
        path = prelude_groups.hoon_path(logical)
        if face is None:
            private_entries.append('[%s %s]' % (path, binding))
        else:
            group_entries.append('[%%%s %s %s]' % (face, path, binding))
    reader_entries = []
    reader_paths = set()
    for number, (module, name, logical, filename, _) in enumerate(readers):
        binding = 'probe-reader-' + str(number)
        cord(binding, filename)
        path = prelude_groups.sur_path(logical)
        if logical not in reader_paths:
            private_entries.append('[%s %s]' % (path, binding))
            reader_paths.add(logical)
        reader_entries.append('[%%%s %%%s %s %s]' % (module, name, path, binding))
    reader_core = ('=/  prelude-reader\n=>  ..zuse\n' +
                   (ROOT / 'jibb-dev/lib/jibb-import.hoon').read_text() + '\n')
    prefix = (reader_core + '=/  groups  ' + hoon_list(group_entries) + '\n'
              '=/  group-sources  ' + hoon_list(private_entries) + '\n'
              '=/  reader-evidence  (turn `(list [module=term name=term at=path source=@t])`' + hoon_list(reader_entries) +
              ' |=(entry=[module=term name=term at=path source=@t] [module.entry name.entry '
              '(read-generic-source:prelude-reader module.entry name.entry at.entry source.entry -:(ride -:!>(..zuse) source.entry))]))\n')
    with tempfile.TemporaryDirectory(prefix='jibb-review-') as scratch:
        scratch = Path(scratch)
        if args.mode == 'plain':
            expression = prefix + (HERE / 'check.hoon').read_text()
        elif args.mode == 'app':
            # Standalone ride uses the explicit /sur face supplied in app-check.
            for name, mark in [('action', 'todo-action'), ('todos', 'todos'),
                               ('update', 'todo-update'), ('item', 'todo-item'),
                               ('posts', 'posts'), ('postmark', 'post')]:
                path = scratch / (mark + '.hoon')
                lines = (ROOT / 'my-app/mar' / (mark + '.hoon')).read_text().splitlines(True)
                path.write_text(''.join(line for line in lines if not line.startswith('/-')))
                cord(name, path)
            for name, path in [('sur', 'sur/todo.hoon'), ('blogsur', 'sur/blog.hoon'),
                               ('todoapi', 'ui/api/todo.jibb'), ('todolist', 'ui/todo-list.jibb'),
                               ('blogapi', 'ui/api/blog.jibb'), ('card', 'ui/components/card.jibb'),
                               ('cart', 'ui/stores/cart.jibb')]:
                cord(name, ROOT / 'my-app' / path)
            source_bindings = []
            for number, source in enumerate(app_sources):
                binding = 'probe-source-' + str(number)
                cord(binding, Path(source).resolve())
                source_bindings.append(binding)
            expression = (prefix + '=/  imp  prelude-reader\n' +
                          '=/  sources=(list @t)  ' + hoon_list(source_bindings) + '\n' +
                          (HERE / 'app-check.hoon').read_text())
        else:
            expression = ('=/  jibb-lib  .\n=/  reader\n' +
                          (ROOT / 'jibb-dev/lib/jibb-import.hoon').read_text() +
                          '\n' + prefix + (HERE / 'errors/import-check.hoon').read_text())
        if args.source is not None and args.mode != 'app':
            cord('src', Path(args.source).resolve())
        path = scratch / 'check.hoon'
        path.write_text(expression)
        return subprocess.run(command + ['-f', str(path)], cwd=ROOT).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print('review probes: ' + str(error), file=sys.stderr)
        sys.exit(2)
