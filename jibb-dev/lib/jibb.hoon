    %opaque  |($(typ body.typ) (lien args.typ |=(c=itype (itype-has-fixed-atom c))))
    %refined  $(typ proof.typ)
    %var       |
    %fvar      |
    %avar      |
    %rvar      |
    %nvar      |
    %rnvar      |
    %atom      &
    %any-atom  &
    %flag      &
    %noun  |
    %empty  |
    %tag       &
    %const     &
