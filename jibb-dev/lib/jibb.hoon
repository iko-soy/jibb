  |=  [file=path src=@t imp=import]
  ^-  span
  =/  tokens=(list token)  (layout file src)
  |-
  ?~  tokens  at.imp
  ?.  =(beg.at.i.tokens beg.at.imp)  $(tokens t.tokens)
