::
++  coverage-valid-items
  |=  [items=(list pattern) t=itype sub=isub fuel=@ud]
  ^-  (unit ?)
  ?~  items  ~
  ?:  =(0 fuel)  ~
  ?~  t.items  (coverage-pattern-valid i.items t sub (dec fuel))
