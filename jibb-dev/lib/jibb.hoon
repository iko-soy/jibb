    %apply
      ?~  ref.sh  ~
      =/  args=(unit [types=(list itype) state=istate])  (infer-shape-args args.sh state)
      ?~  args  ~
      =/  n=term  i.ref.sh
      =/  keyed=(unit [types=(list itype) sub=isub])
