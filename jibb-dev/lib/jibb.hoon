        =/  key  $(node -.+>.node)
        ?~  key  ~
        =/  value  $(node -.+.+>.node)
        ?~  value  ~
        `[[%unknown ~] |(has.u.key has.u.value)]
      ?:  ?=([%apply ?(%unit %set %qeu) [* ~]] node)
        =/  item  $(node -.+>.node)
        ?~  item  ~
        `[[%unknown ~] has.u.item]
      ?.  ?=([%apply %list [* ~]] node)  ~
      =/  item  $(node -.+>.node)
      ?~  item  ~
      `[[%or ~[[%atom `0] [%cell pat.u.item [%unknown ~]]]] has.u.item]
    %face
      ?.  ?=([%face @ *] node)  ~
      ?.  (jibb-face-name +<.node)  ~
      $(node +>.node)
    %cell
      ?.  ?=([%cell * *] node)  ~
      =/  left  $(node +<.node)
      ?~  left  ~
      =/  right  $(node +>.node)
      ?~  right  ~
      `[[%cell pat.u.left pat.u.right] |(has.u.left has.u.right)]
    %fork
      =/  cases  (rec-patterns +.node module name)
      ?~  cases  ~
      ?~  pats.u.cases  ~
      ?~  t.pats.u.cases  ~
      ?.  (rec-patterns-disjoint pats.u.cases)  ~
      `[[%or pats.u.cases] has.u.cases]
  ==
::
++  rec-patterns
  |=  [nodes=* module=term name=term]
  ^-  (unit [pats=(list upat) has=?])
  ?@  nodes  ?:(=(nodes 0) `[~ |] ~)
  =/  first  (rec-pattern -.nodes module name)
  ?~  first  ~
  =/  rest  $(nodes +.nodes)
  ?~  rest  ~
  `[[pat.u.first pats.u.rest] |(has.u.first has.u.rest)]
