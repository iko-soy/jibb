::
+$  iprelude-group-source  [face=term at=path source=@t]
++  prelude-extra-bundle
  |=  [modules=jbundle by-path=(map path @t) out=jbundle]
  ^-  (unit [by-path=(map path @t) out=jbundle])
  ?~  modules  `[by-path out]
  =/  m=jsource  i.modules
  ?:  |(=(at.m /lib/jibb/prelude/jibb) =(at.m /lib/jibb/internal/jibb) =(at.m /lib/jibb/primitives/jibb))  ~
  =/  prior=(unit @t)  (~(get by by-path) at.m)
  ?^  prior
    ?.  =(u.prior source.m)  ~
    $(modules t.modules)
  $(modules t.modules, by-path (~(put by by-path) at.m source.m), out [m out])
++  prelude-group-bundle
  |=  [sources=(list iprelude-group-source) seen-faces=(set term) by-path=(map path @t) out=jbundle]
  ^-  (unit jbundle)
  ?~  sources  `out
  =/  g=iprelude-group-source  i.sources
  ?.  (jibb-face-name face.g)  ~
  ?:  (reserved-name face.g)  ~
  ?:  (~(has in:..zuse seen-faces) face.g)  ~
  ?:  |(=(at.g /lib/jibb/prelude/jibb) =(at.g /lib/jibb/internal/jibb) =(at.g /lib/jibb/primitives/jibb))  ~
  =/  prior=(unit @t)  (~(get by by-path) at.g)
  ?^  prior
    ?.  =(u.prior source.g)  ~
    $(sources t.sources, seen-faces (~(put in:..zuse seen-faces) face.g))
  $(sources t.sources, seen-faces (~(put in:..zuse seen-faces) face.g), by-path (~(put by by-path) at.g source.g), out [[at.g source.g] out])
++  prelude-groups-check
  |=  [sources=(list iprelude-group-source) bundle=jbundle prep=iprelude cache=jcache private=(unit ifile)]
  ^-  (unit [groups=(list iprelude-group) cache=jcache])
  (prelude-groups-check-with-externals sources bundle prep cache private ~)
++  prelude-groups-check-with-externals
  |=  [sources=(list iprelude-group-source) bundle=jbundle prep=iprelude cache=jcache private=(unit ifile) externals=iexternals]
  ^-  (unit [groups=(list iprelude-group) cache=jcache])
  ?~  sources  `[~ cache]
  =/  g=iprelude-group-source  i.sources
  ?:  |((lien values.prep |=(n=term =(n face.g))) (lien molds.prep |=(n=term =(n face.g))))  ~
  =/  checked=jfile-detailed-result
    (infer-jibb-file-with-group-private at.g source.g externals ~ bundle ~[at.g] values.prep molds.prep cache `iface.prep private)
  ?:  ?=(%| -.checked)  ~
  =/  f=ifile  iface.p.checked
  =/  rest=(unit [groups=(list iprelude-group) cache=jcache])  $(sources t.sources, cache cache.p.checked)
  ?~  rest  ~
  `[[[face.g at.f values.f molds.f derived.f elaborations.f dependencies.f source.f graph.f (prelude-checked-dependencies cache.p.checked)] groups.u.rest] cache.u.rest]
++  prelude-checked-dependencies
  |=  cache=jcache
  ^-  (list iprelude-dependency)
  ?~  cache  ~
  =/  f=ifile  iface.i.cache
  [[at.i.cache values.f molds.f derived.f elaborations.f dependencies.f source.f graph.f] $(cache t.cache)]
++  prelude-group-markers
  |=  sources=(list iprelude-group-source)
  ^-  (list iprelude-group)
  ?~  sources  ~
  [[face.i.sources at.i.sources ~ ~ ~ ~ ~ `source.i.sources ~ ~] $(sources t.sources)]
::  Rechecking may allocate different inference IDs. Freshen both closed
::  schemes from the same empty state and compare the complete graph and
::  witnesses, preserving sharing and every variable restriction.
++  prelude-scheme-equivalent
  |=  [a=ischeme b=ischeme]
  ^-  ?
  ?.  &(?=(~ (scheme-free-vars a)) ?=(~ (scheme-free-vars b)))  |
  ?:  =(a b)  &
  =/  x=(unit [typ=itype state=istate])  (instantiate-scheme a *istate)
  ?~  x  |
  =/  y=(unit [typ=itype state=istate])  (instantiate-scheme b *istate)
  ?~  y  |
  ?&  =(typ.u.x typ.u.y)
      =(next.state.u.x next.state.u.y)
      =(sub.state.u.x sub.state.u.y)
  ==
++  prelude-retains-checked-schemes
  |=  [before=ifile after=ifile]
  ^-  ?
  ?&  %+  levy  values.before
      |=  e=[name=term scheme=ischeme]
      =/  found=(unit ischeme)  (ienv-lookup name.e values.after)
      ?~(found | (prelude-scheme-equivalent u.found scheme.e))
      %+  levy  molds.before
      |=  e=[name=term template=ischeme]
      =/  found=(unit ischeme)  (find-jibb-mold name.e after)
      ?~(found | (prelude-scheme-equivalent u.found template.e))
  ==
++  prepare-prelude-with-groups
  |=  [src=@t internal-source=@t sources=(list iprelude-group-source)]
  ^-  (unit iprelude)
  (prepare-prelude-with-group-bundle src internal-source sources ~)
::  Generic external evidence is trusted only with the exact /sur source
::  it names.  The host supplies reader-produced descriptors; matching the
::  path and source here binds those nouns to this prelude preparation.
++  prelude-external-evidence-valid-raw
  |=  [externals=iexternals modules=jbundle]
  ^-  ?
  ?~  externals  &
  =/  e=[module=term name=term result=*]  i.externals
  ?:  (lien t.externals |=(other=[module=term name=term result=*] &(=(module.other module.e) =(name.other name.e))))  |
  ?.  ?=([%& [%generic-source @ * * @ * @]] result.e)  |
  =/  proof=[%generic-source arity=@ud body=* at=path source=@t arm=* scope=@]
    ;;([%generic-source arity=@ud body=* at=path source=@t arm=* scope=@] +.result.e)
  ?.  =(at.proof ~[%sur module.e %hoon])  |
  =/  matches=jbundle  (skim modules |=(m=jsource =(at.m at.proof)))
  ?.  ?=([* ~] matches)  |
  ?.  =(source.i.matches source.proof)  |
  $(externals t.externals)
::
++  prelude-external-evidence-valid
  |=  [externals=iexternals modules=jbundle]
  ^-  ?
  =/  safe=(each ? tang)  (mule |.((prelude-external-evidence-valid-raw externals modules)))
  ?:  ?=(%| -.safe)  |
  p.safe
::
++  prepare-prelude-with-group-bundle
  |=  [src=@t internal-source=@t sources=(list iprelude-group-source) modules=jbundle]
  ^-  (unit iprelude)
  (prepare-prelude-with-group-evidence src internal-source sources modules ~)
::
++  prepare-prelude-with-group-evidence
  |=  [src=@t internal-source=@t sources=(list iprelude-group-source) modules=jbundle externals=iexternals]
  ^-  (unit iprelude)
  ?.  (prelude-external-evidence-valid externals modules)  ~
  =/  faces=(list term)  (turn sources |=(g=iprelude-group-source face.g))
  =/  built=(unit ifile)  (partial-prelude-interface-mode src `internal-source ~ faces)
  ?~  built  ~
  =/  parsed=(each module error)  (parse /lib/jibb/prelude/jibb src)
  ?:  ?=(%| -.parsed)  ~
  =/  vals=(list term)  (global-value-names defs.p.parsed)
  =/  molds=(list term)  (turn (collect-simple-molds defs.p.parsed) |=(m=[name=term body=shape] name.m))
  =/  prep=(unit iprelude)  `[u.built vals molds]
  ?~  prep  ~
  =/  extra=(unit [by-path=(map path @t) out=jbundle])  (prelude-extra-bundle modules *(map path @t) ~)
  ?~  extra  ~
  =/  bundle=(unit jbundle)  (prelude-group-bundle sources *(set term) by-path.u.extra out.u.extra)
  ?~  bundle  ~
  ::  During checking, exact source/path markers give each group its own
  ::  declaration scope.  They contain no exported type or value evidence.
  =/  checking=iprelude  u.prep(iface iface.u.prep(groups (prelude-group-markers sources)))
  =/  private=(unit ifile)  (infer-private-internal internal-source src)
  =/  checked=(unit [groups=(list iprelude-group) cache=jcache])  (prelude-groups-check-with-externals sources u.bundle checking ~ private externals)
  ?~  checked  ~
  ::  A public mold or gate may refer to a checked qualified group.
  ::  Recheck the same public source with those interfaces in scope.
  =/  completed=(unit ifile)  (partial-prelude-interface-with-groups src `internal-source groups.u.checked)
  ?~  completed  ~
  ::  Groups were checked against the bootstrap prelude. Every scheme they
  ::  could have used there must still have exactly the checked meaning.
  ?.  (prelude-retains-checked-schemes iface.u.prep u.completed)  ~
  `[u.completed (weld faces values.u.prep) (weld faces molds.u.prep)]
::
++  prelude-group-check-error
  |=  [sources=(list iprelude-group-source) bundle=jbundle prep=iprelude cache=jcache private=(unit ifile)]
  ^-  (unit @t)
  (prelude-group-check-error-with-evidence sources bundle prep cache private ~)
++  prelude-group-check-error-with-evidence
  |=  [sources=(list iprelude-group-source) bundle=jbundle prep=iprelude cache=jcache private=(unit ifile) evidence=iexternals]
  ^-  (unit @t)
  ?~  sources  ~
  =/  g=iprelude-group-source  i.sources
  ?:  |((lien values.prep |=(n=term =(n face.g))) (lien molds.prep |=(n=term =(n face.g))))  ~
  =/  checked=jfile-detailed-result
    (infer-jibb-file-with-group-private at.g source.g evidence ~ bundle ~[at.g] values.prep molds.prep cache `iface.prep private)
  ?:  ?=(%| -.checked)  `message.p.checked
  $(sources t.sources, cache cache.p.checked)
::
++  prelude-group-core-error
  |=  [src=@t internal-source=@t sources=(list iprelude-group-source) modules=jbundle]
  ^-  (unit @t)
  (prelude-group-core-error-with-evidence src internal-source sources modules ~)
++  prelude-group-core-error-with-evidence
  |=  [src=@t internal-source=@t sources=(list iprelude-group-source) modules=jbundle evidence=iexternals]
  ^-  (unit @t)
  =/  faces=(list term)  (turn sources |=(g=iprelude-group-source face.g))
  =/  built=(unit ifile)  (partial-prelude-interface-mode src `internal-source ~ faces)
  ?~  built  (prelude-mode-core-error src `internal-source ~ faces)
  =/  parsed=(each module error)  (parse /lib/jibb/prelude/jibb src)
  ?:  ?=(%| -.parsed)  ~
  =/  vals=(list term)  (global-value-names defs.p.parsed)
  =/  molds=(list term)  (turn (collect-simple-molds defs.p.parsed) |=(m=[name=term body=shape] name.m))
  =/  prep=(unit iprelude)  `[u.built vals molds]
  ?~  prep  ~
  =/  extra=(unit [by-path=(map path @t) out=jbundle])  (prelude-extra-bundle modules *(map path @t) ~)
  ?~  extra  ~
  =/  bundle=(unit jbundle)  (prelude-group-bundle sources *(set term) by-path.u.extra out.u.extra)
  ?~  bundle  ~
  ::  During checking, exact source/path markers give each group its own
  ::  declaration scope.  They contain no exported type or value evidence.
  =/  checking=iprelude  u.prep(iface iface.u.prep(groups (prelude-group-markers sources)))
  =/  private=(unit ifile)  (infer-private-internal internal-source src)
  =/  checked=(unit [groups=(list iprelude-group) cache=jcache])  (prelude-groups-check-with-externals sources u.bundle checking ~ private evidence)
  ?~  checked  (prelude-group-check-error-with-evidence sources u.bundle checking ~ private evidence)
  ::  A public mold or gate may refer to a checked qualified group.
  ::  Recheck the same public source with those interfaces in scope.
  (prelude-mode-core-error src `internal-source groups.u.checked ~)
::
++  module-values-complete
  |=  [ds=(list def) env=ienv]
  ^-  ?
  ?~  ds  &
  ?:  ?=(%mold -.i.ds)  $(ds t.ds)
  ?~  (ienv-lookup name.i.ds env)  |
  $(ds t.ds)
::
::  Names the value a failed full check stops at, for its message only.  A
::  value whose module dependencies all resolved failed on its own, so the
::  first such missing value is named.  Otherwise every missing value waits
::  on another, so following the first one each waits on, from the first
::  missing value, reaches a value twice, which is named.  The walk is over
::  lexical dependency graph: sample, pattern and body-local binders do
::  not produce module edges. Scope errors are reported independently;
::  this fallback identifies only an unresolved dependency.
++  module-limit-sample-site
  |=  s=sample
  ^-  span
  ?-  -.s
    %face  at.shape.s
    %bare  at.shape.s
    *  at.s
  ==
::
++  module-limit-expression
  |=  e=expr
  ^-  [at=span description=tape]
  ?-  -.e
    %group  $(e inner.e)
    %cast  [at.shape.e "cast mold"]
    %gate  [(module-limit-sample-site sample.e) "gate sample mold"]
    %gate-wide  [(module-limit-sample-site sample.e) "gate sample mold"]
    %call  [(span-of e) "call"]
    %branch  [(span-of e) "match"]
    %list  [(span-of e) "list"]
    %tuple  [(span-of e) "cell"]
    *  [(span-of e) "expression"]
  ==
::
++  find-jibb-cache
  |=  [at=path cache=jcache]
  ^-  (unit ifile)
  ?~  cache  ~
  ?:  =(at at.i.cache)  `iface.i.cache
  $(cache t.cache)
::
::  These certificates retain the complete checked source closure. The
::  trusted host must supply the identical prepared prelude and reader nouns.
::  Exact bundle equality binds all source paths and versions; the set
::  retains transitive paths for active-cycle checks. Request-bearing graphs
::  alone have a size limit; incompatible diamond evidence fails closed.
++  request-graph-requests-add
  |=  [pending=(list irequest-evidence) acc=(list irequest-evidence) fuel=@ud]
  ^-  (unit (list irequest-evidence))
  ?~  pending  `acc
  ?:  =(0 fuel)  ~
  =/  hit=(list irequest-evidence)
    (skim acc |=(x=irequest-evidence &(=(api-at.x api-at.i.pending) =(name.x name.i.pending))))
  ?^  hit
    ?.  ?=([* ~] hit)  ~
    ?.  =(i.hit i.pending)  ~
    $(pending t.pending, fuel (dec fuel))
  $(pending t.pending, acc [i.pending acc], fuel (dec fuel))
++  request-graph-inputs-match
  |=  [g=irequest-graph externals=iexternals marks=imark-externals modules=jbundle values=(list term) molds=(list term) prelude=(unit ifile)]
  ^-  ?
  ?&  =(bundle-input.g modules)
      =(prelude-input.g prelude)
      =(prelude-values.g values)
      =(prelude-molds.g molds)
      =(externals.g externals)
      =(marks.g marks)
  ==
++  request-graph-bounded
  |=  g=irequest-graph
  ^-  ?
  =/  total=@ud  (add (lent requests.g) (lent stores.g))
  &((lte (lent ~(tap in:..zuse paths.g)) 256) (lte total 256))
::
++  store-graph-requests-add
  |=  [pending=(list istore-request-evidence) acc=(list istore-request-evidence) fuel=@ud]
  ^-  (unit (list istore-request-evidence))
  ?~  pending  `acc
  ?:  =(0 fuel)  ~
  =/  hit=(list istore-request-evidence)
    (skim acc |=(x=istore-request-evidence =(store-at.x store-at.i.pending)))
  ?^  hit
    ?.  ?=([* ~] hit)  ~
    ?.  =(i.hit i.pending)  ~
    $(pending t.pending, fuel (dec fuel))
  $(pending t.pending, acc [i.pending acc], fuel (dec fuel))
::
++  request-graph-merge
  |=  [imports=ijimports g=irequest-graph fuel=@ud]
  ^-  (unit irequest-graph)
  ?~  imports  `g
  ?:  =(0 fuel)  ~
  =/  child=ifile  interface.i.imports
  ?~  graph.child  ~
  =/  cg=irequest-graph  u.graph.child
  ?.  ?&  =(bundle-input.g bundle-input.cg)
           =(prelude-input.g prelude-input.cg)
           =(prelude-values.g prelude-values.cg)
           =(prelude-molds.g prelude-molds.cg)
           =(externals.g externals.cg)
           =(marks.g marks.cg)
       ==
    ~
  =/  merged=(set path)  (~(uni in:..zuse paths.g) paths.cg)
  =/  rs=(unit (list irequest-evidence))
    (request-graph-requests-add requests.cg requests.g (add 1 (lent requests.cg)))
  ?~  rs  ~
  =/  ss=(unit (list istore-request-evidence))
    (store-graph-requests-add stores.cg stores.g (add 1 (lent stores.cg)))
  ?~  ss  ~
  =/  total=@ud  (add (lent u.rs) (lent u.ss))
  ?:  &(?=(^ u.rs) |((gth (lent ~(tap in:..zuse merged)) 256) (gth total 256)))  ~
  ?:  &(?=(^ u.ss) |((gth (lent ~(tap in:..zuse merged)) 256) (gth total 256)))  ~
  $(imports t.imports, g g(paths merged, requests u.rs, stores u.ss), fuel (dec fuel))
++  request-graph-reusable
  |=  [f=ifile src=@t externals=iexternals marks=imark-externals modules=jbundle active=(list path) values=(list term) molds=(list term) prelude=(unit ifile)]
  ^-  ?
  ?~  source.f  |
  ?.  =(u.source.f src)  |
  ?~  graph.f  |
  =/  g=irequest-graph  u.graph.f
  ?.  (request-graph-inputs-match g externals marks modules values molds prelude)  |
  ?.  (~(has in:..zuse paths.g) at.f)  |
  !(lien active |=(p=path (~(has in:..zuse paths.g) p)))
::
++  resolve-jibb-imports
  |=  [imports=(list import) externals=iexternals mark-externals=imark-externals modules=jbundle active=(list path) prelude-values=(list term) prelude-molds=(list term) cache=jcache prelude=(unit ifile)]
  ^-  jimports-result
  =/  result=jimports-detailed-result
    (resolve-jibb-imports-detailed imports externals mark-externals modules active prelude-values prelude-molds cache prelude)
  ?:  ?=(%| -.result)  [%| message.p.result]
  [%& p.result]
++  resolve-jibb-imports-detailed
  |=  [imports=(list import) externals=iexternals mark-externals=imark-externals modules=jbundle active=(list path) prelude-values=(list term) prelude-molds=(list term) cache=jcache prelude=(unit ifile)]
  ^-  jimports-detailed-result
  (resolve-jibb-imports-at imports externals mark-externals modules active prelude-values prelude-molds cache prelude ~)
::
::  A cycle error crosses every import edge that reached it.  Keep each
::  edge's own source, including the root source absent from the bundle.
::  Add only the import statement in the known containing source.  Direct
::  resolver callers without that source retain the original failure.
++  import-error-context
  |=  [failure=jfile-failure target=path site=span context=(unit jsource)]
  ^-  jfile-failure
  ?~  context  failure
  =/  excerpt=@t
    (show-error source.u.context [at.u.context line.beg.site col.beg.site "imports {(show-file target)} here"])
  [(of-wain:format ~[message.failure excerpt]) overlap.failure]
::
++  import-cycle-context
  |=  [failure=jfile-failure target=path site=span context=(unit jsource)]
  ^-  jfile-failure
  ?~  context  failure
  =/  prefix=@t  'import cycle at '
  ?.  =(prefix (end [3 (met 3 prefix)] message.failure))  failure
  =/  excerpt=@t
    (show-error source.u.context [at.u.context line.beg.site col.beg.site "imports {(show-file target)} here"])
  [(of-wain:format ~[message.failure excerpt]) overlap.failure]
::
++  resolve-jibb-imports-at
  |=  [imports=(list import) externals=iexternals mark-externals=imark-externals modules=jbundle active=(list path) prelude-values=(list term) prelude-molds=(list term) cache=jcache prelude=(unit ifile) context=(unit jsource)]
  ^-  jimports-detailed-result
  ?~  imports  [%& [~ cache]]
  ?.  ?=(%jibb -.i.imports)  $(imports t.imports)
  =/  at=path  (weld path.i.imports `path`~[%jibb])
  ?:  =(at /lib/jibb/internal/jibb)
    [%| (import-error-context ['the prelude internal module is private' ~] at at.i.imports context)]
  ?:  =(at /lib/jibb/primitives/jibb)
    [%| (import-error-context ['the prelude primitive interface is private' ~] at at.i.imports context)]
  ?:  (lien active |=(p=path =(p at)))
    [%| (import-cycle-context [(crip "import cycle at {(spud at)}") ~] at at.i.imports context)]
  =/  found=jbundle  (skim modules |=(m=jsource =(at at.m)))
  ?~  found  [%| (import-error-context [(crip "module source missing: {(spud at)}") ~] at at.i.imports context)]
  ?^  t.found  [%| (import-error-context [(crip "duplicate module sources: {(spud at)}") ~] at at.i.imports context)]
  =/  cached=(unit ifile)  (find-jibb-cache at cache)
  =/  iface=jfile-detailed-result
    ?^  cached
      ?.  =(at.u.cached at)  [%| ['cached module identity needs unsupported inference' ~]]
      ?~  graph.u.cached
        ::  A detached legacy interface has unknown evidence. Rebuild it
        ::  against the current graph, without retaining any stale entry.
        =/  clean=jcache  (skim cache |=(x=[at=path iface=ifile] !=(at.x at)))
        (infer-jibb-file-detailed at source.i.found externals mark-externals modules [at active] prelude-values prelude-molds clean prelude)
      ?.  (request-graph-reusable u.cached source.i.found externals mark-externals modules active prelude-values prelude-molds prelude)
        [%| ['cached module evidence needs unsupported inference' ~]]
      =/  kind=(unit checked-kind)  (checked-main-kind u.cached prelude)
      ?~  kind  [%| ['cached module kind needs unsupported inference' ~]]
      [%& [u.cached cache u.kind]]
    (infer-jibb-file-detailed at source.i.found externals mark-externals modules [at active] prelude-values prelude-molds cache prelude)
  ?:  ?=(%| -.iface)  [%| (import-cycle-context p.iface at at.i.imports context)]
  =/  rest=jimports-detailed-result  $(imports t.imports, cache cache.p.iface)
  ?:  ?=(%| -.rest)  rest
  [%& [[[face.i.imports iface.p.iface] resolved.p.rest] cache.p.rest]]
::
::  Provisional declaration extraction only; this does not derive asks,
::  validate imported types, or claim that an API module has checked.
+$  iapi-path  [at=span name=term segments=(list pseg) full=term diffs=(list term) scry=(unit (list pseg))]
++  api-path-mark
  |=  [sh=shape marks=(list term)]
  ^-  (unit term)
  ?.  ?=(%ref -.sh)  ~
  ?.  ?=([@ ~] names.sh)  ~
  ?.  (unique-value-name i.names.sh marks)  ~
  `i.names.sh
::
++  api-path-diffs
  |=  [shapes=(list shape) marks=(list term) used=(list term)]
  ^-  (unit (list term))
  ?~  shapes  `~
  =/  n=(unit term)  (api-path-mark i.shapes marks)
  ?~  n  ~
  ?:  (lien used |=(x=term =(x u.n)))  ~
  =/  rest=(unit (list term))  $(shapes t.shapes, used [u.n used])
  ?~  rest  ~
  `[u.n u.rest]
::
++  api-path-payload
  |=  [sh=shape marks=(list term)]
  ^-  (unit [full=term diffs=(list term)])
  =/  direct=(unit term)  (api-path-mark sh marks)
  ?^  direct  `[u.direct ~]
  ?.  ?=(%apply -.sh)  ~
  ?.  =(~[%facts] ref.sh)  ~
  ?~  args.sh  ~
  ?~  t.args.sh  ~
  =/  full=(unit term)  (api-path-mark i.args.sh marks)
  ?~  full  ~
  =/  diffs=(unit (list term))  (api-path-diffs t.args.sh marks ~[u.full])
  ?~  diffs  ~
  `[u.full u.diffs]
::
+$  iapi-parameter  [name=term aura=@ta at=span]
++  api-path-parameters
  |=  [segments=(list pseg) seen=(list term)]
  ^-  (unit (list iapi-parameter))
  ?~  segments  `~
  ?:  ?=(%knot -.i.segments)  $(segments t.segments)
  =/  seg=pseg  i.segments
  ?.  ?=(%typed -.seg)  ~
  ?:  =(0 aura.seg)  ~
  ?:  (lien seen |=(n=term =(n name.seg)))  ~
  =/  rest=(unit (list iapi-parameter))  $(segments t.segments, seen [name.seg seen])
  ?~  rest  ~
  `[[name.seg aura.seg at.seg] u.rest]
::
++  api-scry-parameters-compatible
  |=  [scry=(list iapi-parameter) watch=(list iapi-parameter)]
  ^-  ?
  ?~  scry  &
  ?.  (lien watch |=(p=iapi-parameter &(=(name.p name.i.scry) =(aura.p aura.i.scry))))  |
  $(scry t.scry)
::
++  api-path-one
  |=  [sh=shape marks=(list term)]
  ^-  (unit iapi-path)
  ?.  ?=(%cell -.sh)  ~
  =/  fs=(list field)  fields.sh
  ?~  fs  ~
  ?~  t.fs  ~
  ?~  t.t.fs  ~
  ?:  (gth (lent fs) 4)  ~
  ?.  ?=(%bare -.i.fs)  ~
  =/  tag=shape  shape.i.fs
  ?.  ?=(%const -.tag)  ~
  ?.  =(%term form.lit.tag)  ~
  =/  name=term  val.lit.tag
  ?.  (jibb-face-name name)  ~
  ?.  ?=(%bare -.i.t.fs)  ~
  =/  path-shape=shape  shape.i.t.fs
  ?.  ?=(%path -.path-shape)  ~
  ?.  ?=(%bare -.i.t.t.fs)  ~
  =/  payload=(unit [full=term diffs=(list term)])  (api-path-payload shape.i.t.t.fs marks)
  ?~  payload  ~
  =/  scry=(unit (unit (list pseg)))
    ?~  t.t.t.fs  `~
    =/  entry=field  i.t.t.t.fs
    ?.  ?=(%face -.entry)  ~
    ?.  =(%scry name.entry)  ~
    ?.  ?=(%path -.shape.entry)  ~
    ``segs.shape.entry
  ?~  scry  ~
  =/  params=(unit (list iapi-parameter))  (api-path-parameters segs.path-shape ~)
  ?~  params  ~
  ?^  u.scry
    =/  scry-params=(unit (list iapi-parameter))  (api-path-parameters u.u.scry ~)
    ?~  scry-params  ~
    ?.  (api-scry-parameters-compatible u.scry-params u.params)  ~
    `[at.sh name segs.path-shape full.u.payload diffs.u.payload u.scry]
  `[at.sh name segs.path-shape full.u.payload diffs.u.payload u.scry]
::
++  api-path-many
  |=  [shapes=(list shape) marks=(list term) seen=(list term)]
  ^-  (unit (list iapi-path))
  ?~  shapes  `~
  =/  one=(unit iapi-path)  (api-path-one i.shapes marks)
  ?~  one  ~
  ?:  (lien seen |=(n=term =(n name.u.one)))  ~
  =/  rest=(unit (list iapi-path))  $(shapes t.shapes, seen [name.u.one seen])
  ?~  rest  ~
  `[u.one u.rest]
::
++  api-path-declaration
  |=  [sh=shape marks=(list term)]
  ^-  (unit (list iapi-path))
  ?:  ?=(%union -.sh)  (api-path-many cases.sh marks ~)
  (api-path-many ~[sh] marks ~)
::
::  Derived gates share the value namespace. /% marks name molds; /- and
::  /= also introduce faces that cannot be shadowed by a derived value.
++  api-import-faces
  |=  imports=(list import)
  ^-  (list term)
  ?~  imports  ~
  ?-  -.i.imports
    %mark  $(imports t.imports)
    %sur   [name.i.imports $(imports t.imports)]
    %jibb  [face.i.imports $(imports t.imports)]
  ==
::
++  api-derived-names-valid
  |=  [paths=(list iapi-path) poke-names=(list term) mod=module prelude-values=(list term)]
  ^-  ?
  =/  path-names=(list term)  (turn paths |=(p=iapi-path name.p))
  =/  derived=(list term)  (weld path-names poke-names)
  ?:  (lien derived reserved-name)  |
  =/  outer=(list term)  (weld prelude-values (weld (global-value-names defs.mod) (api-import-faces imports.mod)))
  (levy derived |=(n=term &((unique-value-name n derived) !(lien outer |=(x=term =(n x))))))
::
::  The definite error behind some failures of the check above.  An API
::  exports `poke` when it declares `+$ poke`, and a request per case of a
::  `+$ paths` that reads as path cases; these names surely exist, so a clash
::  among them or with the module's scope is an error (grammar, Modules).  A
::  reserved `proj` stays unsupported, as in the check above.
++  api-derived-clash
  |=  [mod=module prelude-values=(list term)]
  ^-  (unit idiag)
  =/  declared=(list term)  (collect-mark-imports imports.mod)
  =/  declarations=(list def)
    (skim defs.mod |=(d=def &(?=(%mold -.d) =(%paths name.d))))
  =/  cases=(list [name=term at=span note=tape])
    ?.  ?=([* ~] declarations)  ~
    =/  decl=def  i.declarations
    ?>  ?=(%mold -.decl)
    =/  paths=(unit (list iapi-path))  (api-path-declaration shape.decl declared)
    ?~  paths  ~
    (turn u.paths |=(p=iapi-path [name.p at.p "`{(trip name.p)}` is derived from this path case"]))
  =/  pokes=(list def)
    (skim defs.mod |=(d=def &(?=(%mold -.d) =(%poke name.d))))
  =/  derived=(list [name=term at=span note=tape])
    ?.  ?=([* ~] pokes)  cases
    (snoc cases [%poke at.i.pokes "`poke` is derived from this mold"])
  =/  names=(list term)  (turn derived |=(x=[name=term at=span note=tape] name.x))
  =/  outer=(list term)  (weld prelude-values (weld (global-value-names defs.mod) (api-import-faces imports.mod)))
  =/  clashes=(list term)
    %+  skip  names
    |=  n=term
    ?|  (reserved-name n)
        &((unique-value-name n names) !(lien outer |=(x=term =(n x))))
    ==
  ?~  clashes  ~
  =/  sites=(list [at=span note=tape])
    %+  murn  derived
    |=  x=[name=term at=span note=tape]
    ?.  =(i.clashes name.x)  ~
    `[at.x note.x]
  `(derived-name-clash "API" i.clashes sites mod)
::
::  Analysis only. Successful external entries must be unchanged results
::  produced for the declared marks; no request interface is produced.
+$  iapi-mark-type  [name=term typ=itype]
+$  iapi-path-typed  [path=iapi-path full=itype diffs=(list iapi-mark-type)]
++  api-diff-types
  |=  [names=(list term) externals=imark-externals declared=(list term) prelude=ifile]
  ^-  (unit (list iapi-mark-type))
  ?~  names  `~
  =/  typ=(unit itype)  (find-imported-mark-prelude i.names externals declared prelude)
  ?~  typ  ~
  =/  tail=(unit (list iapi-mark-type))  $(names t.names)
  ?~  tail  ~
  `[[i.names u.typ] u.tail]
::
++  api-path-types
  |=  [paths=(list iapi-path) externals=imark-externals declared=(list term) prelude=ifile]
  ^-  (unit (list iapi-path-typed))
  ?~  paths  `~
  =/  full=(unit itype)  (find-imported-mark-prelude full.i.paths externals declared prelude)
  ?~  full  ~
  =/  diffs=(unit (list iapi-mark-type))  (api-diff-types diffs.i.paths externals declared prelude)
  ?~  diffs  ~
  =/  tail=(unit (list iapi-path-typed))  $(paths t.paths)
  ?~  tail  ~
  `[[i.paths u.full u.diffs] u.tail]
::
++  api-poke-mark-names
  |=  [pokes=(list def) declared=(list term)]
  ^-  (unit (list term))
  ?~  pokes  `~
  ?^  t.pokes  ~
  =/  d=def  i.pokes
  ?.  ?=(%mold -.d)  ~
  =/  sh=shape  shape.d
  ?:  ?=(%union -.sh)  (api-path-diffs cases.sh declared ~)
  =/  name=(unit term)  (api-path-mark sh declared)
  ?~  name  ~
  `~[u.name]
::
++  api-path-analysis
  |=  [mod=module externals=imark-externals prelude-values=(list term) prelude-molds=(list term) prelude=ifile]
  ^-  (unit (list iapi-path-typed))
  ?:  (lien defs.mod def-has-hole)  ~
  ?^  (duplicate-defs defs.mod)  ~
  =/  ds=(list def)  defs.mod
  =/  declarations=(list def)
    (skim ds |=(d=def &(?=(%mold -.d) =(%paths name.d))))
  ?.  ?=([* ~] declarations)  ~
  =/  pokes=(list def)
    (skim ds |=(d=def &(?=(%mold -.d) =(%poke name.d))))
  ?:  (gth (lent pokes) 1)  ~
  =/  ordinary=(list def)
    (skim ds |=(d=def !&(?=(%mold -.d) |(=(%paths name.d) =(%poke name.d)))))
  ?.  (module-scope-valid mod(defs ordinary) prelude-values prelude-molds)  ~
  =/  declared=(list term)  (collect-mark-imports imports.mod)
  =/  poke-names=(unit (list term))  (api-poke-mark-names pokes declared)
  ?~  poke-names  ~
  =/  decl=def  i.declarations
  ?>  ?=(%mold -.decl)
  =/  paths=(unit (list iapi-path))  (api-path-declaration shape.decl declared)
  ?~  paths  ~
  =/  derived-pokes=(list term)  ?~(pokes ~ ~[%poke])
  ?.  (api-derived-names-valid u.paths derived-pokes mod prelude-values)  ~
  (api-path-types u.paths externals declared prelude)
::
::  Source/graph entry for path analysis only. The returned paths retain
::  reader-derived mark types and import resolution has checked reachable
::  Jibb dependencies. This is not an API interface or a module check.
++  api-path-analysis-source
  |=  [file=path src=@t externals=iexternals marks=imark-externals modules=jbundle prepared=(unit iprelude)]
  ^-  (each (list iapi-path-typed) @t)
  ?.  ?=([%ui %api @ %jibb ~] file)  [%| 'API path analysis requires /ui/api/<agent>.jibb']
  =/  parsed  (parse file src)
  ?:  ?=(%| -.parsed)  [%| 'API path source does not parse']
  =/  duplicate=(unit idiag)  (duplicate-defs defs.p.parsed)
  ?^  duplicate  [%| (show-duplicate-fields file src u.duplicate)]
  ?~  prepared  [%| 'API path analysis needs the prepared prelude']
  =/  public=ifile  iface.u.prepared
  ::  The analysis below would call a derived-name clash unsupported.
  =/  clash=(unit idiag)  (api-derived-clash p.parsed values.u.prepared)
  ?^  clash  [%| (show-duplicate-fields file src u.clash)]
  =/  prelude=(unit ifile)  `iface.u.prepared
  =/  deps=jimports-result
    (resolve-jibb-imports imports.p.parsed externals marks modules ~[file] values.u.prepared molds.u.prepared ~ prelude)
  ?:  ?=(%| -.deps)  [%| p.deps]
  =/  paths=(unit (list iapi-path-typed))
    (api-path-analysis p.parsed marks values.u.prepared molds.u.prepared public)
  ?~  paths  [%| 'API path declaration needs unsupported analysis']
  [%& u.paths]
::
::  Analysis evidence retains the API source, the prepared interface, the
::  caller's reader results and the resolved Jibb dependency cache alongside
::  the typed path declarations.  Reader results and prepared interfaces are
::  trusted inputs: this does not verify their underlying Hoon source/version,
::  create requests or check the provenance of arbitrary values.
+$  iapi-path-evidence
  [at=path source=@t prepared=iprelude externals=iexternals marks=imark-externals dependencies=jcache paths=(list iapi-path-typed)]
++  api-path-evidence-source
  |=  [file=path src=@t externals=iexternals marks=imark-externals modules=jbundle prepared=(unit iprelude)]
  ^-  (each iapi-path-evidence @t)
  ?.  ?=([%ui %api @ %jibb ~] file)  [%| 'API path evidence requires /ui/api/<agent>.jibb']
  =/  parsed  (parse file src)
  ?:  ?=(%| -.parsed)  [%| 'API path evidence source does not parse']
  =/  duplicate=(unit idiag)  (duplicate-defs defs.p.parsed)
  ?^  duplicate  [%| (show-duplicate-fields file src u.duplicate)]
  ?~  prepared  [%| 'API path evidence needs the prepared prelude']
  ::  The analysis below would call a derived-name clash unsupported.
  =/  clash=(unit idiag)  (api-derived-clash p.parsed values.u.prepared)
  ?^  clash  [%| (show-duplicate-fields file src u.clash)]
  =/  public=ifile  iface.u.prepared
  =/  deps=jimports-result
    (resolve-jibb-imports imports.p.parsed externals marks modules ~[file] values.u.prepared molds.u.prepared ~ `public)
  ?:  ?=(%| -.deps)  [%| p.deps]
  =/  paths=(unit (list iapi-path-typed))
    (api-path-analysis p.parsed marks values.u.prepared molds.u.prepared public)
  ?~  paths  [%| 'API path declaration needs unsupported analysis']
  [%& [file src u.prepared externals marks cache.p.deps u.paths]]
::  Graph-aware variant preserves the caller active stack and cache.
++  api-path-evidence-graph
  |=  [file=path src=@t externals=iexternals marks=imark-externals modules=jbundle active=(list path) cache=jcache prepared=(unit iprelude)]
  ^-  (each iapi-path-evidence @t)
  ?~  active  [%| 'API analysis needs an active graph']
  ?.  =(i.active file)  [%| 'API analysis active graph does not start at the source']
  ?:  (lien t.active |=(p=path =(p file)))  [%| 'API analysis active graph contains a cycle']
  ?.  ?=([%ui %api @ %jibb ~] file)  [%| 'API path evidence requires /ui/api/<agent>.jibb']
  =/  parsed  (parse file src)
  ?:  ?=(%| -.parsed)  [%| 'API path evidence source does not parse']
  =/  duplicate=(unit idiag)  (duplicate-defs defs.p.parsed)
  ?^  duplicate  [%| (show-duplicate-fields file src u.duplicate)]
  ?~  prepared  [%| 'API path evidence needs the prepared prelude']
  ::  The analysis below would call a derived-name clash unsupported.
  =/  clash=(unit idiag)  (api-derived-clash p.parsed values.u.prepared)
  ?^  clash  [%| (show-duplicate-fields file src u.clash)]
  =/  public=ifile  iface.u.prepared
  =/  deps=jimports-result
    (resolve-jibb-imports imports.p.parsed externals marks modules active values.u.prepared molds.u.prepared cache `public)
  ?:  ?=(%| -.deps)  [%| p.deps]
  =/  paths=(unit (list iapi-path-typed))
    (api-path-analysis p.parsed marks values.u.prepared molds.u.prepared public)
  ?~  paths  [%| 'API path declaration needs unsupported analysis']
  [%& [file src u.prepared externals marks cache.p.deps u.paths]]
::
::  This query classifies a unique path declaration only.  Missing evidence
::  or a nonunique name is unknown; it proves nothing about an ask value.
::  Like prepared interfaces, the supplied evidence is a trusted host input.
++  api-path-watchability
  |=  [evidence=(unit iapi-path-evidence) case-name=term]
  ^-  ?(%watchable %not-watchable %unknown)
  ?~  evidence  %unknown
  =/  found=(list iapi-path-typed)
    (skim paths.u.evidence |=(p=iapi-path-typed =(name.path.p case-name)))
  ?.  ?=([* ~] found)  %unknown
  ?~  scry.path.i.found  %watchable
  %not-watchable
::
::  These are declaration-derived request components, not a callable gate,
::  an ask value, or proof of a value's provenance.  Keep the exact trusted
::  source/reader evidence until a later checked interface and lowerer can
::  attach it to a generated request.  No argument ordering is claimed here.
+$  iapi-request-parameter  [name=term typ=itype at=span]
+$  iapi-request-parts
  [evidence=iapi-path-evidence path=iapi-path-typed parameters=(list iapi-request-parameter) reply-sample=itype fold=(unit itype) watchability=?(%watchable %not-watchable)]
++  api-request-parameter-types
  |=  params=(list iapi-parameter)
  ^-  (unit (list iapi-request-parameter))
  ?~  params  `~
  =/  aura=@ta  aura.i.params
  ?.  |(?=(?(%u %ud %ux %uv %t %ta %tas %p %da %dr) aura) =('tD' aura))  ~
  =/  rest=(unit (list iapi-request-parameter))  $(params t.params)
  ?~  rest  ~
  `[[name.i.params [%atom aura] at.i.params] u.rest]
::
::  A fold consumes a checked tagged diff and the previous full value.
++  api-request-fold-type
  |=  p=iapi-path-typed
  ^-  (unit (unit itype))
  ?~  diffs.p  `~
  =/  cases=(list itype)
    %+  turn  diffs.p
    |=  d=iapi-mark-type
    =/  literal=lit  [%term %tas name.d (crip ['%' (trip name.d)])]
    [%cell [%const literal] typ.d]
  ?~  cases  ~
  =/  diff=itype  ?~(t.cases i.cases [%union cases ~ ~ ~])
  ``[%fn [%cell diff full.p] full.p]
::  Request parameters occur in path order, followed by reply and fold.
++  api-request-sample
  |=  [parameters=(list iapi-request-parameter) callback=itype fold=(unit itype)]
  ^-  itype
  =/  args=(list itype)
    (weld (turn parameters |=(p=iapi-request-parameter typ.p)) [callback ?~(fold ~ ~[u.fold])])
  |-
  ?~  args  !!
  ?~  t.args  i.args
  [%cell i.args $(args t.args)]
::
++  api-request-parts
  |=  [evidence=(unit iapi-path-evidence) case-name=term]
  ^-  (unit iapi-request-parts)
  ?~  evidence  ~
  =/  found=(list iapi-path-typed)
    (skim paths.u.evidence |=(p=iapi-path-typed =(name.path.p case-name)))
  ?.  ?=([* ~] found)  ~
  =/  p=iapi-path-typed  i.found
  =/  raw=(unit (list iapi-parameter))  (api-path-parameters segments.path.p ~)
  ?~  raw  ~
  =/  params=(unit (list iapi-request-parameter))  (api-request-parameter-types u.raw)
  ?~  params  ~
  =/  fold=(unit (unit itype))  (api-request-fold-type p)
  ?~  fold  ~
  =/  watch=?(%watchable %not-watchable)  ?~(scry.path.p %watchable %not-watchable)
  `[u.evidence p u.params full.p u.fold watch]
::
::  Check ordinary API molds and values plus every declared mark type using
::  the same trusted source, prepared prelude and reader inputs as path
::  evidence.  Keep elaborations with those inputs for a later interface.
::  This is partial analysis: an unused /- core is not independently checked.
::  Standalone source analysis has no derived values; graph callers may supply
::  checked derived schemes. No API is exported or given runtime behavior here.
+$  iapi-support-evidence
  [paths=iapi-path-evidence values=ienv molds=imold-types marks=(list iapi-mark-type) elaborations=(list iwidth-definition)]
++  api-support-analysis-source
  |=  [file=path src=@t externals=iexternals marks=imark-externals modules=jbundle prepared=(unit iprelude)]
  ^-  (each iapi-support-evidence @t)
  =/  path-result  (api-path-evidence-source file src externals marks modules prepared)
  ?:  ?=(%| -.path-result)  [%| p.path-result]
  =/  evidence=iapi-path-evidence  p.path-result
  =/  parsed  (parse file src)
  ?:  ?=(%| -.parsed)  [%| 'API source does not parse']
  =/  mod=module  p.parsed
  =/  ordinary=(list def)
    (skim defs.mod |=(d=def !&(?=(%mold -.d) |(=(%paths name.d) =(%poke name.d)))))
  =/  prep=iprelude  prepared.evidence
  ?.  (module-scope-valid mod(defs ordinary) values.prep molds.prep)  [%| 'API ordinary scope needs unsupported inference']
  =/  vals=(list term)  (global-value-names ordinary)
  ?:  (lien vals |=(n=term =(n %main)))  [%| 'API module kind needs unsupported inference']
  =/  declared=(list term)  (collect-mark-imports imports.mod)
  =/  mark-types=(unit (list iapi-mark-type))  (api-diff-types declared marks declared iface.prep)
  ?~  mark-types  [%| 'API declared marks need unsupported inference']
  =/  prelude=(unit ifile)  `iface.prep
  =/  deps=jimports-result
    (resolve-jibb-imports imports.mod externals marks modules ~[file] values.prep molds.prep dependencies.evidence prelude)
  ?:  ?=(%| -.deps)  [%| p.deps]
  =/  molds=imolds  (collect-simple-molds ordinary)
  =/  globals=(list term)  (weld values.prep (weld (import-binding-names imports.mod) vals))
  =/  surs=(list term)  (collect-sur-imports imports.mod)
  =/  reserved=(list term)  (weld molds.prep (turn resolved.p.deps |=(j=[face=term interface=ifile] face.j)))
  =/  top=(list term)  (turn molds |=(m=[name=term body=shape] name.m))
  =/  state=istate  *istate
  =.  state  state(molds molds, globals globals, externals externals, surs surs, mark-externals marks, marks declared, jimports resolved.p.deps, reserved-molds reserved, in-mold |, at file, top-molds top, prelude prelude, jrec-fuel 256, globals-imports |, general-defer |)
  =/  mts=(each imold-types @t)  (module-mold-types molds state)
  ?:  ?=(%| -.mts)  [%| p.mts]
  =/  resolution=iresolved  (resolve-groups ordinary molds globals externals surs marks declared resolved.p.deps reserved file prelude)
  ?^  failures.resolution
    =/  failure=[name=term diag=idiag]  i.failures.resolution
    [%| (show-inference-diagnostic file src name.failure diag.failure)]
  ?.  (module-values-complete ordinary env.resolution)  [%| 'API ordinary definitions need unsupported inference']
  [%& [evidence env.resolution p.mts u.mark-types artifacts.resolution]]
::  Preserve the same graph context through supporting definitions.
++  api-support-analysis-graph
  |=  [file=path src=@t externals=iexternals marks=imark-externals modules=jbundle active=(list path) cache=jcache prepared=(unit iprelude)]
  ^-  (each iapi-support-evidence @t)
  (api-support-analysis-graph-with-env file src externals marks modules active cache prepared ~)
::
++  api-support-analysis-graph-with-env
  |=  [file=path src=@t externals=iexternals marks=imark-externals modules=jbundle active=(list path) cache=jcache prepared=(unit iprelude) outer=ienv]
  ^-  (each iapi-support-evidence @t)
  =/  path-result  (api-path-evidence-graph file src externals marks modules active cache prepared)
  ?:  ?=(%| -.path-result)  [%| p.path-result]
  =/  evidence=iapi-path-evidence  p.path-result
  =/  parsed  (parse file src)
  ?:  ?=(%| -.parsed)  [%| 'API source does not parse']
  =/  mod=module  p.parsed
  =/  ordinary=(list def)
    (skim defs.mod |=(d=def !&(?=(%mold -.d) |(=(%paths name.d) =(%poke name.d)))))
  =/  prep=iprelude  prepared.evidence
  ?.  (module-scope-valid mod(defs ordinary) values.prep molds.prep)  [%| 'API ordinary scope needs unsupported inference']
  =/  vals=(list term)  (global-value-names ordinary)
  ?:  (lien vals |=(n=term =(n %main)))  [%| 'API module kind needs unsupported inference']
  =/  declared=(list term)  (collect-mark-imports imports.mod)
  =/  mark-types=(unit (list iapi-mark-type))  (api-diff-types declared marks declared iface.prep)
  ?~  mark-types  [%| 'API declared marks need unsupported inference']
  =/  prelude=(unit ifile)  `iface.prep
  =/  deps=jimports-result
    (resolve-jibb-imports imports.mod externals marks modules active values.prep molds.prep dependencies.evidence prelude)
  ?:  ?=(%| -.deps)  [%| p.deps]
  =/  molds=imolds  (collect-simple-molds ordinary)
  =/  globals=(list term)  (weld values.prep (weld (import-binding-names imports.mod) vals))
  =/  surs=(list term)  (collect-sur-imports imports.mod)
  =/  reserved=(list term)  (weld molds.prep (turn resolved.p.deps |=(j=[face=term interface=ifile] face.j)))
  =/  top=(list term)  (turn molds |=(m=[name=term body=shape] name.m))
  =/  state=istate  *istate
  =.  state  state(molds molds, globals globals, externals externals, surs surs, mark-externals marks, marks declared, jimports resolved.p.deps, reserved-molds reserved, in-mold |, at file, top-molds top, prelude prelude, jrec-fuel 256, globals-imports |, general-defer |)
  =/  mts=(each imold-types @t)  (module-mold-types molds state)
  ?:  ?=(%| -.mts)  [%| p.mts]
  =/  resolution=iresolved  (resolve-groups-with-env ordinary outer molds globals externals surs marks declared resolved.p.deps reserved file prelude)
  ?^  failures.resolution
    =/  failure=[name=term diag=idiag]  i.failures.resolution
    [%| (show-inference-diagnostic file src name.failure diag.failure)]
  ?.  (module-values-complete ordinary env.resolution)  [%| 'API ordinary definitions need unsupported inference']
  [%& [evidence env.resolution p.mts u.mark-types artifacts.resolution]]
::
++  compatible-raw-poke
  |=  prelude=iprelude
  ^-  (unit ischeme)
  =/  public=ifile  iface.prelude
  ?.  =(at.public /lib/jibb/prelude/jibb)  ~
  =/  poke=(unit ischeme)  (find-jibb-mold %raw-poke public)
  ?~  poke  ~
  ?^  vars.u.poke  ~
  ?.  ?=(%union -.typ.u.poke)  ~
  ?^  args.typ.u.poke  ~
  ?.  =(origin.typ.u.poke `[/lib/jibb/internal/jibb %raw-poke])  ~
  ?:  (itype-has-tag typ.u.poke)  ~
  =/  private=(list iwidth-dependency)
    (skim dependencies.public |=(d=iwidth-dependency =(at.d /lib/jibb/internal/jibb)))
  ?.  ?=([* ~] private)  ~
  ?~  source.i.private  ~
  =/  agent-case=itype
    [%cell [%const [%term %tas %agent '%agent']] [%cell [%face %agent [%atom %tas]] [%cell [%face %mark [%atom %tas]] [%face %payload [%noun ~]]]]]
  =/  store-case=itype
    [%cell [%const [%term %tas %store '%store']] [%cell [%face %module [%atom %t]] [%cell [%face %action [%atom %tas]] [%face %payload [%noun ~]]]]]
  ?.  =((turn cases.typ.u.poke |=(t=itype (itype-slots-as-faces t))) (turn ~[agent-case store-case] |=(t=itype (itype-slots-as-faces t))))  ~
  poke
::
++  request-compatible-ask
  |=  prelude=iprelude
  ^-  (unit ischeme)
  =/  public=ifile  iface.prelude
  ?.  =(at.public /lib/jibb/prelude/jibb)  ~
  =/  ask=(unit ischeme)  (find-jibb-mold %ask public)
  ?~  ask  ~
  ?.  ?=([@ ~] vars.u.ask)  ~
  ?.  ?=(%union -.typ.u.ask)  ~
  ?.  =(origin.typ.u.ask `[/lib/jibb/internal/jibb %ask])  ~
  ?.  (identity-union-parameters vars.u.ask args.typ.u.ask)  ~
  =/  m=@ud  i.vars.u.ask
  ?:  (itype-var-is-atom m typ.u.ask)  ~
  ?.  (levy (itype-vars typ.u.ask) |=(n=@ud =(n m)))  ~
  ?:  (itype-has-tag typ.u.ask)  ~
  =/  private=(list iwidth-dependency)
    (skim dependencies.public |=(d=iwidth-dependency =(at.d /lib/jibb/internal/jibb)))
  ?.  ?=([* ~] private)  ~
  ?~  source.i.private  ~
  =/  path=(unit ischeme)  (find-jibb-mold %path public)
  ?~  path  ~
  ?^  vars.u.path  ~
  =/  path-type=itype  [%collection %list ~[[%atom %ta]]]
  ?.  =(typ.u.path path-type)  ~
  =/  unit-template=(unit ischeme)  (find-jibb-mold %unit public)
  ?~  unit-template  ~
  ?.  (standard-unit-template u.unit-template /lib/jibb/prelude/jibb)  ~
  =/  state-unit=(unit itype)  (template-apply u.unit-template ~[[%noun ~]])
  ?~  state-unit  ~
  =/  path-unit=(unit itype)  (template-apply u.unit-template ~[path-type])
  ?~  path-unit  ~
  =/  output=itype  [%cell [%face %state [%noun ~]] [%face %message [%var m]]]
  =/  agent-input=itype  [%cell [%face %mark [%atom %tas]] [%cell [%face %state u.state-unit] [%face %fact [%noun ~]]]]
  =/  store-input=itype  [%cell [%face %state u.state-unit] [%face %fact [%noun ~]]]
  =/  pure-case=itype  [%cell [%const [%term %tas %pure '%pure']] [%face %value [%var m]]]
  =/  agent-case=itype
    [%cell [%const [%term %tas %agent '%agent']] [%cell [%face %api [%atom %t]] [%cell [%face %case [%atom %tas]] [%cell [%face %agent [%atom %tas]] [%cell [%face %path path-type] [%cell [%face %scry u.path-unit] [%face %receive [%fn agent-input output]]]]]]]]
  =/  store-case=itype
    [%cell [%const [%term %tas %store '%store']] [%cell [%face %module [%atom %t]] [%cell [%face %name [%atom %tas]] [%face %receive [%fn store-input output]]]]]
  ?.  =((turn cases.typ.u.ask |=(t=itype (itype-slots-as-faces t))) (turn ~[pure-case agent-case store-case] |=(t=itype (itype-slots-as-faces t))))  ~
  ask
::
++  api-mark-exports
  |=  [marks=(list term) all=(list term) externals=imark-externals prelude=ifile]
  ^-  imold-types
  ?~  marks  ~
  =/  t=(unit itype)  (find-imported-mark-prelude i.marks externals all prelude)
  ?~  t  $(marks t.marks)
  [[i.marks [u.t ~ ~]] $(marks t.marks)]
::
::  Experimental direct poke-only API. Unsupported API declarations fail
::  as a whole; supplied mark reader results retain their existing boundary.
++  api-poke-interface
  |=  [at=path mod=module mark-externals=imark-externals prelude-values=(list term) prelude-molds=(list term) prelude=(unit ifile)]
  ^-  (unit ifile)
  =/  out=(each ifile @t)
    (api-poke-interface-result at mod mark-externals prelude-values prelude-molds prelude)
  ?:(?=(%& -.out) `p.out ~)
::
::  The same check, naming the part that stopped it.  Each reason says which
::  part is outside this fragment and claims no error in the module, except
::  duplicate definitions, an error the full check reports first, as for
::  other modules.
++  api-poke-interface-result
  |=  [at=path mod=module mark-externals=imark-externals prelude-values=(list term) prelude-molds=(list term) prelude=(unit ifile)]
  ^-  (each ifile @t)
  ?:  (lien defs.mod def-has-hole)  [%| 'API holes need unsupported inference']
  ?.  ?=([%ui %api @ %jibb ~] at)  [%| 'API path evidence requires /ui/api/<agent>.jibb']
  ?^  (duplicate-defs defs.mod)  [%| 'API has duplicate definitions']
  ?~  prelude  [%| 'API poke prelude needs unsupported inference']
  ?.  =(at.u.prelude /lib/jibb/prelude/jibb)  [%| 'API poke prelude needs unsupported inference']
  =/  poke=(unit ischeme)  (find-jibb-mold %raw-poke u.prelude)
  ?~  poke  [%| 'API poke prelude needs unsupported inference']
  ?.  ?=(%union -.typ.u.poke)  [%| 'API poke prelude needs unsupported inference']
  ?^  vars.u.poke  [%| 'API poke prelude needs unsupported inference']
  =/  compatible=?
    %+  lien  cases.typ.u.poke
    |=  c=itype
    =/  plain=itype  (itype-slots-as-faces c)
    ?=([%cell [%const [%term %tas %agent *]] [%cell [%face %agent [%atom %tas]] [%cell [%face %mark [%atom %tas]] [%face %payload [%noun ~]]]]] plain)
  ?.  compatible  [%| 'API poke prelude needs unsupported inference']
  ::  Definitions come before imports so that a module with more than a
  ::  `+$ poke` is not described by its imports.
  =/  ds=(list def)  defs.mod
  ?.  ?=([[%mold *] ~] ds)  [%| 'poke-only API definitions need unsupported inference']
  ?.  =(%poke name.i.ds)  [%| 'poke-only API definitions need unsupported inference']
  ?.  (module-scope-valid mod(defs ~) prelude-values prelude-molds)  [%| 'API import scope needs unsupported inference']
  ?.  (levy imports.mod |=(i=import ?=(%mark -.i)))  [%| 'poke-only API imports need unsupported inference']
  =/  marks=(list term)  (collect-mark-imports imports.mod)
  ?.  ?=([@ ~] marks)  [%| 'poke-only API mark imports need unsupported inference']
  =/  sh=shape  shape.i.ds
  ?.  ?=([%ref *] sh)  [%| 'API poke mold needs unsupported inference']
  ?.  ?=([@ ~] names.sh)  [%| 'API poke mold needs unsupported inference']
  =/  n=term  i.names.sh
  ?.  (unique-value-name n marks)  [%| 'API poke mold needs unsupported inference']
  ?:  |((lien prelude-values |=(x=term =(n x))) (lien prelude-molds |=(x=term =(n x))))  [%| 'API poke mold needs unsupported inference']
  =/  results=@ud  (lent (skim mark-externals |=(e=[mark=term result=*] =(n mark.e))))
  ?:  =(0 results)  [%| (crip "API poke mark %{(trip n)} has no reader result")]
  ?.  =(1 results)  [%| (crip "API poke mark %{(trip n)} has duplicate reader results")]
  =/  mark=(unit itype)  (find-imported-mark-prelude n mark-externals marks u.prelude)
  ?~  mark  [%| 'API poke mark reader result needs unsupported inference']
  =/  sc=(unit ischeme)  (derived-poke-command-scheme u.prelude u.mark)
  ?~  sc  [%| 'API poke command needs unsupported inference']
  [%& [~[[%poke u.sc]] (api-mark-exports marks marks mark-externals u.prelude) at ~[[n i.t.t.at n]] ~ ~ ~ ~ ~]]
::
::  Source-proven ordinary helpers validate each selected /sur dependency.
::  Unused or less direct cores remain unsupported by this first interface.
++  api-sur-covered
  |=  [surs=(list term) defs=(list def) externals=iexternals all=(list term)]
  ^-  ?
  ?~  surs  &
  =/  found=(list def)
    %+  skim  defs
    |=  d=def
    ?.  ?=(%mold -.d)  |
    ?.  ?=(%ref -.shape.d)  |
    ?.  ?=([@ [@ ~]] names.shape.d)  |
    =(i.t.names.shape.d i.surs)
  ?~  found  |
  =/  selected=def  i.found
  ?.  ?=(%mold -.selected)  |
  =/  sh=shape  shape.selected
  ?.  ?=(%ref -.sh)  |
  ?.  ?=([@ [@ ~]] names.sh)  |
  =/  checked=(unit itype)  (find-imported-mold i.surs i.names.sh externals all)
  ?~  checked  |
  $(surs t.surs)
::
+$  imulti-request-gates  [values=ienv requests=(list irequest-evidence)]
++  api-request-gates
  |=  [paths=(list iapi-path-typed) ev=iapi-path-evidence ask=ischeme file=path src=@t public=@t internal=@t externals=iexternals marks=imark-externals fuel=@ud]
  ^-  (unit imulti-request-gates)
  ?~  paths  `[~ ~]
  ?:  =(0 fuel)  ~
  =/  p=iapi-path-typed  i.paths
  =/  parts=(unit iapi-request-parts)  (api-request-parts `ev name.path.p)
  ?~  parts  ~
  ?^  (itype-vars reply-sample.u.parts)  ~
  ?:  (itype-has-tag reply-sample.u.parts)  ~
  =/  open-fold=?
    ?~  fold.u.parts  |
    |(?=(^ (itype-vars u.fold.u.parts)) (itype-has-tag u.fold.u.parts))
  ?:  open-fold  ~
  =/  result=(unit itype)  (template-apply ask ~[[%var 0]])
  ?~  result  ~
  =/  callback=itype  [%fn reply-sample.u.parts [%var 0]]
  =/  sample=itype  (api-request-sample parameters.u.parts callback fold.u.parts)
  =/  scheme=ischeme  [[%fn sample u.result] ~[0] ~]
  =/  prep=iprelude  prepared.ev
  =/  req=irequest-evidence
    [file name.path.p p src public internal values.prep molds.prep externals marks]
  =/  rest=(unit imulti-request-gates)
    $(paths t.paths, fuel (dec fuel))
  ?~  rest  ~
  `[[[name.path.p scheme] values.u.rest] [req requests.u.rest]]
::
++  api-poke-from-checked
  |=  [file=path mod=module marks=imark-externals values=(list term) molds=(list term) prelude=(unit ifile)]
  ^-  (unit [values=ienv derived=(list iderived)])
  =/  pokes=(list def)
    (skim defs.mod |=(d=def &(?=(%mold -.d) =(%poke name.d))))
  ?~  pokes  `[~ ~]
  ?.  ?=([* ~] pokes)  ~
  =/  declared=(list term)  (collect-mark-imports imports.mod)
  =/  ns=(unit (list term))  (api-poke-mark-names pokes declared)
  ?~  ns  ~
  ?.  ?=([@ ~] u.ns)  ~
  =/  matching=(list import)
    %+  skim  imports.mod
    |=  i=import
    ?.  ?=(%mark -.i)  |
    =(mark.i i.u.ns)
  ?.  ?=([* ~] matching)  ~
  =/  checked=(unit ifile)
    (api-poke-interface file mod(defs pokes, imports matching) marks values molds prelude)
  ?~  checked  ~
  `[values.u.checked derived.u.checked]
::
::  The partial interface is published atomically: all paths, ordinary
::  source definitions, declared marks and the poke must check. Unselected
::  /sur bindings, runtime validation and value watchability remain unproved.
++  multi-request-interface-graph
  |=  [file=path src=@t externals=iexternals marks=imark-externals modules=jbundle active=(list path) cache=jcache prepared=(unit iprelude)]
  ^-  (each [iface=ifile cache=jcache] @t)
  =/  path-result
    (api-path-evidence-graph file src externals marks modules active cache prepared)
  ?:  ?=(%| -.path-result)  [%| p.path-result]
  =/  ev=iapi-path-evidence  p.path-result
  =/  parsed  (parse file src)
  ?:  ?=(%| -.parsed)  [%| 'request source does not parse']
  =/  mod=module  p.parsed
  ?.  (levy imports.mod |=(i=import ?=(?(%mark %sur) -.i)))
    [%| 'request imports need unsupported inference']
  =/  surs=(list term)  (collect-sur-imports imports.mod)
  ?.  (api-sur-covered surs defs.mod externals surs)
    [%| 'API source dependency needs unsupported inference']
  ?~  paths.ev  [%| 'request count needs unsupported inference']
  =/  ask=(unit ischeme)  (request-compatible-ask prepared.ev)
  ?~  ask  [%| 'request ask needs unsupported inference']
  =/  prep=iprelude  prepared.ev
  =/  public=ifile  iface.prep
  ?~  source.public  [%| 'request prelude source needs unsupported inference']
  =/  private=(list iwidth-dependency)
    (skim dependencies.public |=(d=iwidth-dependency =(at.d /lib/jibb/internal/jibb)))
  ?.  ?=([* ~] private)  [%| 'request internal source needs unsupported inference']
  ?~  source.i.private  [%| 'request internal source needs unsupported inference']
  =/  gates=(unit imulti-request-gates)
    (api-request-gates paths.ev ev u.ask file src u.source.public u.source.i.private externals marks 256)
  ?~  gates  [%| 'request paths need unsupported inference']
  =/  poke=(unit [values=ienv derived=(list iderived)])
    (api-poke-from-checked file mod marks values.prep molds.prep `public)
  ?~  poke  [%| 'API poke needs unsupported inference']
  =/  out
    (api-support-analysis-graph-with-env file src externals marks modules active dependencies.ev prepared (weld values.u.gates values.u.poke))
  ?:  ?=(%| -.out)  [%| p.out]
  =/  support=iapi-support-evidence  p.out
  =/  mark-molds=imold-types
    (turn marks.support |=(m=iapi-mark-type [name.m [typ.m ~ ~]]))
  =/  exports=imold-types  (weld mark-molds molds.support)
  =/  names=(list term)  (turn exports |=(m=[name=term template=ischeme] name.m))
  ?.  (levy names |=(n=term (unique-value-name n names)))
    [%| 'API exported molds need unsupported inference']
  =/  env=ienv  (weld values.u.gates (weld values.u.poke values.support))
  =/  graph=irequest-graph
    [(silt `(list path)`~[file]) requests.u.gates ~ modules `public values.prep molds.prep externals marks]
  =/  iface=ifile
    [env exports file derived.u.poke elaborations.support ~ `src `graph ~]
  [%& [iface dependencies.ev]]
::
::  Locate main and direct component names for source diagnostics only.
::  Module classification and component checking use their inferred types.
++  program-main-def
  |=  ds=(list def)
  ^-  (unit def)
  ?~  ds  ~
  ?:  &(?=(%value -.i.ds) =(%main name.i.ds))  `i.ds
  $(ds t.ds)
::
++  program-main-wing
  |=  e=expr
  ^-  (unit term)
  ?:  ?=(%group -.e)  $(e inner.e)
  ?.  ?=(%wing -.e)  ~
  ?.  ?=([@ ~] names.e)  ~
  `i.names.e
::
++  program-main-parts
  |=  d=def
  ^-  (unit [init=term update=term view=term subs=term])
  ?.  ?=(%value -.d)  ~
  |-
  ?:  ?=(%group -.val.d)  $(val.d inner.val.d)
  ?.  ?=(%call -.val.d)  ~
  =/  head=(unit term)  (program-main-wing head.val.d)
  ?~  head  ~
  ?.  =(%program u.head)  ~
  ?.  ?=([* * * * ~] args.val.d)  ~
  =/  args=(list expr)  args.val.d
  ?>  ?=([* * * * ~] args)
  =/  init=(unit term)  (program-main-wing i.args)
  =/  update=(unit term)  (program-main-wing i.t.args)
  =/  view=(unit term)  (program-main-wing i.t.t.args)
  =/  subs=(unit term)  (program-main-wing i.t.t.t.args)
  ?~  init  ~
  ?~  update  ~
  ?~  view  ~
  ?~  subs  ~
  `[u.init u.update u.view u.subs]
::
+$  istore-declaration  [action=term defs=(list def)]
::  A failure carries a diagnostic only when it is a definite error of the
::  source; every other failure is unsupported and carries none.
++  store-declaration
  |=  [mod=module prelude-values=(list term) prelude-molds=(list term)]
  ^-  (each istore-declaration (unit idiag))
  =/  ds=(list def)  defs.mod
  =/  pokes=(list def)
    (skim ds |=(d=def &(?=(%mold -.d) =(%poke name.d))))
  ?.  ?=([* ~] pokes)  [%| ~]
  =/  states=(list def)
    (skim ds |=(d=def &(?=(%mold -.d) =(%state name.d))))
  ?.  ?=([* ~] states)  [%| ~]
  =/  poke=def  i.pokes
  =/  state=def  i.states
  ?>  &(?=(%mold -.poke) ?=(%mold -.state))
  ?:  ?=(%generic -.shape.state)  [%| ~]
  ?:  ?=(%generic -.shape.poke)  [%| ~]
  =/  action=term  %poke
  =/  ordinary=(list def)  ds
  =/  derived=(list term)  ~[%state action]
  ?:  (lien derived reserved-name)  [%| ~]
  =/  outer=(list term)
    (weld prelude-values (weld (global-value-names ordinary) (api-import-faces imports.mod)))
  =/  clashes=(list term)
    (skip derived |=(n=term &((unique-value-name n derived) !(lien outer |=(x=term =(n x))))))
  ::  main's `store` is the prelude's builder when the prelude declares it and
  ::  nothing local takes the name.  Only then do the derived names surely
  ::  exist, and then a clash is an error even where the scope also fails, as
  ::  for an import face that clashes with both a derived name and its mold.
  =/  builder=?
    ?&  (lien prelude-values |=(x=term =(x %store)))
        !(lien (global-value-names ds) |=(x=term =(x %store)))
        !(lien (import-binding-names imports.mod) |=(x=term =(x %store)))
    ==
  ?:  &(?=(^ clashes) builder (lien outer |=(x=term =(x i.clashes))))
    =/  from=span  ?:(=(%state i.clashes) at.state at.poke)
    =/  derived=[at=span note=tape]  [from "`{(trip i.clashes)}` is derived from this mold"]
    [%| `(derived-name-clash "store" i.clashes ~[derived] mod)]
  ?.  (module-scope-valid mod prelude-values prelude-molds)  [%| ~]
  ?^  clashes  [%| ~]
  [%& [action ordinary]]
::
::  A store or API exports names derived from its declarations, and a
::  clashing derived name is an error (grammar, Modules).  Show where the name
::  is derived and the definition, import face or other derived name it
::  clashes with; a prelude name has no site in the module.
++  derived-name-clash
  |=  [kind=tape n=term derived=(list [at=span note=tape]) mod=module]
  ^-  idiag
  =/  values=(list span)
    (murn defs.mod |=(d=def ?.(&(?=(%value -.d) =(n name.d)) ~ `at.d)))
  =/  faces=(list span)
    %+  murn  imports.mod
    |=  i=import
    ?-  -.i
      %mark  ~
      %sur   ?.(=(n name.i) ~ `at.i)
      %jibb  ?.(=(n face.i) ~ `at.i)
    ==
  =/  head=tape  "{kind} derived name `{(trip n)}` clashes with"
  ?^  values
    ["{head} a definition" (weld derived ~[[i.values "clashing definition"]])]
  ?^  faces
    ["{head} an import face" (weld derived ~[[i.faces "clashing import face"]])]
  ?:  ?=([* * *] derived)
    ["{head} another derived name" derived]
  ["{head} a prelude name" derived]
::
++  program-transparent
  |=  e=expr
  ^-  expr
  ?-  -.e
    %group  $(e inner.e)
    %cast   $(e val.e)
    %body   ?~(defs.e $(e final.e) e)
    *       e
  ==
::
++  derived-poke-command-scheme
  |=  [prelude=ifile action=itype]
  ^-  (unit ischeme)
  =/  prep=iprelude  [prelude ~ ~]
  =/  raw=(unit ischeme)  (compatible-raw-poke prep)
  ?~  raw  ~
  =/  command=(unit ischeme)  (find-jibb-mold %cmd prelude)
  =/  unit-template=(unit ischeme)  (find-jibb-mold %unit prelude)
  ?~  command  ~
  ?~  unit-template  ~
  ?.  (standard-unit-template u.unit-template /lib/jibb/prelude/jibb)  ~
  ?.  ?=([@ ~] vars.u.command)  ~
  ?.  ?=(%union -.typ.u.command)  ~
  ?.  =(origin.typ.u.command `[/lib/jibb/prelude/jibb %cmd])  ~
  ?.  (identity-union-parameters vars.u.command args.typ.u.command)  ~
  =/  m=@ud  i.vars.u.command
  ?:  (itype-var-is-atom m typ.u.command)  ~
  ?.  (levy (itype-vars typ.u.command) |=(n=@ud =(n m)))  ~
  ?:  (itype-has-tag typ.u.command)  ~
  =/  error=(unit itype)  (template-apply u.unit-template ~[[%atom %t]])
  ?~  error  ~
  ?.  ?=(%union -.typ.u.raw)  ~
  =/  poke-case=itype
    [%cell [%const [%term %tas %poke '%poke']] [%cell [%face %p typ.u.raw(label `'raw-poke')] [%face %reply [%fn u.error [%var m]]]]]
  =/  go-case=itype
    [%cell [%const [%term %tas %go '%go']] [%face %url [%atom %t]]]
  =/  wait-case=itype
    [%cell [%const [%term %tas %wait '%wait']] [%cell [%face %gap [%atom %dr]] [%face %msg [%var m]]]]
  =/  now-case=itype
    [%cell [%const [%term %tas %now '%now']] [%face %reply [%fn [%atom %da] [%var m]]]]
  =/  who-case=itype
    [%cell [%const [%term %tas %who '%who']] [%face %reply [%fn [%atom %p] [%var m]]]]
  ?.  =((turn cases.typ.u.command |=(t=itype (itype-slots-as-faces t))) (turn ~[poke-case go-case wait-case now-case who-case] |=(t=itype (itype-slots-as-faces t))))  ~
  =/  command-result=(unit itype)  (template-apply u.command ~[[%var 0]])
  ?~  command-result  ~
  `[[%fn [%cell action [%fn u.error [%var 0]]] u.command-result] ~[0] ~]
::
++  store-derived-schemes
  |=  [prelude=ifile values=(list term) molds=(list term) state=itype action=itype]
  ^-  (unit [state=ischeme action=ischeme])
  =/  prep=iprelude  [prelude values molds]
  =/  ask=(unit ischeme)  (request-compatible-ask prep)
  ?~  ask  ~
  ?^  (itype-vars state)  ~
  ?^  (itype-vars action)  ~
  ?:  |((itype-has-tag state) (itype-has-tag action))  ~
  =/  result=(unit itype)  (template-apply u.ask ~[[%var 0]])
  ?~  result  ~
  =/  request=ischeme  [[%fn [%fn state [%var 0]] u.result] ~[0] ~]
  =/  constructor=(unit ischeme)  (derived-poke-command-scheme prelude action)
  ?~  constructor  ~
  `[request u.constructor]
::
::  Abstract values retain proof per value occurrence, independently of types.
+$  iav-site  [file=path at=span]
+$  iav-value  [site=iav-site node=iav-node]
+$  iav-node
  $%  [%unknown ~]
               [%data ~]
               [%limit ~]
               [%seal ~]
               [%effects checks=(list iav-value) body=iav-value]
               [%bottom ~]
               [%atom value=@]
               [%cell head=iav-value tail=iav-value]
               [%face name=term body=iav-value]
               [%typed typ=itype body=iav-value]
               [%choice values=(list iav-value)]
               [%closure file=path sample=sample body=expr frames=(list iav-frame)]
               [%constructor tag=@]
               [%module file=path]
               [%request-gate file=path name=term]
      [%request file=path name=term]
  ==
+$  iav-frame  [bindings=(list [name=term value=iav-value]) defs=(list def)]
+$  iav-scope  [file=path frames=(list iav-frame)]
+$  iav-context  [files=(map path ifile) prelude=ifile graph=irequest-graph modules=(map path module)]
+$  iav-active  (list [file=path at=span closure=* argument=*])
++  iav-context-new
  |=  [files=(map path ifile) prelude=ifile graph=irequest-graph]
  ^-  iav-context
  =/  modules=(map path module)  *(map path module)
  =/  remaining=(list [p=path q=ifile])  ~(tap by files)
  |-
  ?~  remaining  [files prelude graph modules]
  =/  iface=ifile  q.i.remaining
  ?~  source.iface  $(remaining t.remaining)
  =/  parsed=(each module error)  (parse at.iface u.source.iface)
  ?:  ?=(%| -.parsed)  $(remaining t.remaining)
  $(remaining t.remaining, modules (~(put by modules) at.iface p.parsed))
++  iav-unknown
  |=  site=iav-site
  ^-  iav-value
  [site %unknown ~]
++  iav-plain
  |=  value=iav-value
  ^-  iav-value
  ?-  -.node.value
    ?(%face %typed %effects)  $(value body.node.value)
    *  value
  ==
++  iav-at-call
  |=  [value=iav-value site=iav-site]
  ^-  iav-value
  =.  site.value  site
  ?:  ?=(%typed -.node.value)
    value(body.node (iav-at-call body.node.value site))
  ?:  ?=(%face -.node.value)
    value(body.node (iav-at-call body.node.value site))
  value
++  iav-choice
  |=  [site=iav-site values=(list iav-value)]
  ^-  iav-value
  =/  possible=(list iav-value)
    (skip values |=(v=iav-value ?=(%bottom -.node.v)))
  ?~  possible  [site %bottom ~]
  ?:  (levy t.possible |=(v=iav-value =(v i.possible)))  i.possible
  [site %choice possible]
++  iav-checks
  |=  [value=iav-value fuel=@ud]
  ^-  (list iav-value)
  ?:  =(0 fuel)  ~[[site.value %limit ~]]
  ?-  -.node.value
    %limit  ~[value]
    %effects  (weld checks.node.value $(value body.node.value, fuel (dec fuel)))
    ?(%typed %face)  $(value body.node.value, fuel (dec fuel))
    %cell  (weld $(value head.node.value, fuel (dec fuel)) $(value tail.node.value, fuel (dec fuel)))
    %choice  (zing (turn values.node.value |=(v=iav-value (iav-checks v (dec fuel)))))
    *  ~
  ==
++  iav-carry
  |=  [value=iav-value sources=(list iav-value) fuel=@ud]
  ^-  iav-value
  =/  checks=(list iav-value)
    (zing (turn sources |=(v=iav-value (iav-checks v fuel))))
  ?~  checks  value
  [site.value %effects checks value]
++  iav-seal
  |=  [arg=iav-value site=iav-site fuel=@ud]
  ^-  iav-value
  ?:  =(0 fuel)  [site %limit ~]
  =/  plain=iav-value  (iav-plain arg)
  ?:  ?=(%choice -.node.plain)
    (iav-choice site (turn values.node.plain |=(v=iav-value (iav-seal v site (dec fuel)))))
  ?:  ?=(%bottom -.node.plain)  [site %bottom ~]
  ?.  ?=(%cell -.node.plain)  [site %limit ~]
  =/  tag=iav-value  (iav-plain head.node.plain)
  ?.  ?=(%atom -.node.tag)  [site %limit ~]
  ?.  =(%island value.node.tag)  (iav-unknown site)
  =/  program=iav-value  (iav-axis tail.node.plain 2 fuel)
  [site %effects ~[program] (iav-unknown site)]
++  iav-axis
  |=  [value=iav-value axis=@ud fuel=@ud]
  ^-  iav-value
  (iav-carry (iav-axis-raw value axis fuel) ~[value] fuel)
++  iav-axis-raw
  |=  [value=iav-value axis=@ud fuel=@ud]
  ^-  iav-value
  ?:  |(=(0 fuel) =(0 axis))  (iav-unknown site.value)
  ?:  =(1 axis)  value
  ?:  ?=(%data -.node.value)  value
  ?:  ?=(%effects -.node.value)  $(value body.node.value, fuel (dec fuel))
  ?:  ?=(%typed -.node.value)
    =/  body=iav-value  (iav-axis body.node.value axis (dec fuel))
    =/  typ=(unit itype)  (iav-type-axis typ.node.value axis fuel)
    ?~  typ
      ::  Retain an already known value. The absence proof refines only
      ::  an unknown projection; it must not erase a finite list's end.
      =/  plain=iav-value  (iav-plain body)
      ?.  ?=(%unknown -.node.plain)  body
      ?.  (iav-gate-free-value value fuel)  body
      (iav-carry [site.value %data ~] ~[body] fuel)
    [site.value %typed u.typ body]
  ?:  ?=(%face -.node.value)  $(value body.node.value, fuel (dec fuel))
  ?:  ?=(%choice -.node.value)
    (iav-choice site.value (turn values.node.value |=(v=iav-value (iav-axis v axis (dec fuel)))))
  ?.  ?=(%cell -.node.value)  (iav-unknown site.value)
  =/  next=iav-value  ?:(=(2 (cap axis)) head.node.value tail.node.value)
  $(value next, axis (mas axis), fuel (dec fuel))
++  iav-type-axis
  |=  [typ=itype axis=@ud fuel=@ud]
  ^-  (unit itype)
  ?:  |(=(0 fuel) =(0 axis))  ~
  ?:  =(1 axis)  `typ
  ?:  ?=(?(%face %slot) -.typ)  $(typ body.typ, fuel (dec fuel))
  ?.  ?=(%cell -.typ)  ~
  $(typ ?:(=(2 (cap axis)) hed.typ tal.typ), axis (mas axis), fuel (dec fuel))
++  iav-type-field
  |=  [typ=itype name=term axis=@ud fuel=@ud]
  ^-  (list @ud)
  ?:  =(0 fuel)  ~
  ?:  ?=(?(%face %slot) -.typ)
    ?:(=(name name.typ) ~[axis] ~)
  ?.  ?=(%cell -.typ)  ~
