++  rec-patterns-disjoint
  |=  pats=(list upat)
  ^-  ?
  ?~  pats  &
  ?.  (levy t.pats |=(p=upat =(%disjoint (union-relate i.pats p))))  |
  $(pats t.pats)
::
::
::
::  Repeated faces along an imported record spine fail closed. Hoon's type
::  graph can erase unfaced nested-cell boundaries, so that alone does not
::  prove the original source repeated a name within one record. A faced
::  body and each union alternative have separate scopes. Check recursive
::  roots before making them opaque; unused molds are never inspected.
::
++  imported-faces-valid
  |=  node=*
  ^-  ?
  ?@  node  &
  ?+  -.node  &
    %face  ?:(?=([%face @ *] node) $(node +>.node) |)
    %cell  ?:(?=([%cell * *] node) (imported-record-faces-valid node ~) |)
    %fork  (imported-faces-valid-list +.node)
    %apply  ?:(?=([%apply @ *] node) (imported-faces-valid-list +>.node) |)
    %named
      ?.  ?=([%named @ @ *] node)  |
      =/  n=[%named module=@ name=@ body=*]  ;;([%named module=@ name=@ body=*] node)
      (imported-faces-valid body.n)
  ==
::
++  imported-faces-valid-list
  |=  nodes=*
  ^-  ?
  ?@  nodes  =(nodes 0)
  ?.  (imported-faces-valid -.nodes)  |
  $(nodes +.nodes)
::
++  imported-record-faces-valid
  |=  [node=* names=(list @)]
  ^-  ?
  ?:  ?=([%cell * *] node)
    =/  head=*  +<.node
    =/  rest=*  +>.node
    ?:  ?=([%face @ *] head)
      ?:  (lien names |=(n=@ =(n +<.head)))  |
      ?.  (imported-faces-valid +>.head)  |
      $(node rest, names [+<.head names])
    ?.  (imported-faces-valid head)  |
    $(node rest)
  ?:  ?=([%face @ *] node)
    ?:  (lien names |=(n=@ =(n +<.node)))  |
    (imported-faces-valid +>.node)
  (imported-faces-valid node)
::
++  import-to-itype
  |=  node=*
  ^-  (unit itype)
  (import-to-itype-standard node ~)
::
++  import-to-itype-standard
  |=  [node=* standard=(unit ischeme)]
  ^-  (unit itype)
  ?@  node  ~
  ?+  -.node  ~
    %noun  ?:(=(node [%noun ~]) `[%noun ~] ~)
    %atom
      ::  A Hoon loobean singleton is one of the two Jibb loobeans.
      ?:  ?=([%atom %f [~ @]] node)
        =/  value=@  +>+.node
        ?.  |(=(value 0) =(value 1))  ~
        =/  printed=@t  ?:(=(value 0) '%.y' '%.n')
        `[%const [%loobean %f value printed]]
      ::  Hoon's null singleton is the same noun as Jibb's `~` mold.
      ::  Other non-term singleton atoms remain unsupported here.
      ?:  ?=([%atom %n [~ @]] node)
        ?.  =(0 +>+.node)  ~
        `[%const [%null %n 0 '~']]
      ::  Numeric singleton heads in Hoon unions retain their exact noun.
      ?:  ?=([%atom %ud [~ @]] node)
        =/  value=@ud  +>+.node
        `[%const [%number %ud value (scot %ud value)]]
      ?:  ?=([%atom %tas [~ @]] node)
        =/  value=@  +>+.node
        ?.  |(=(value 0) (jibb-face-name value))  ~
        =/  printed=@t  ?:(=(value 0) '%$' (cat 3 '%' value))
        `[%const [%term %tas value printed]]
      ?.  ?=([%atom @ ~] node)  ~
      =/  aura=@ta  (@ta +<.node)
      ?:  =(%$ aura)  `[%any-atom ~]
      ?.  |(?=(?(%u %ud %ux %uv %uw %t %ta %tas %p %da %dr) aura) =('tD' aura))  ~
      `[%atom aura]
    %named
      ?.  ?=([%named @ @ *] node)  ~
      =/  n=[%named module=@ name=@ body=*]  ;;([%named module=@ name=@ body=*] node)
      ::  The standard-library owner uses the reserved, non-name %$
      ::  origin, which cannot collide with a source module name.
      ?.  &(|(=(%$ module.n) (jibb-face-name module.n)) (jibb-face-name name.n))  ~
      ?.  ?=([%fork *] body.n)  ~
      =/  proof=(unit irec-pattern)  (rec-pattern body.n (@tas module.n) (@tas name.n))
      ?~  proof  ~
      ?.  has.u.proof  ~
      =/  label=@t  ?:(=(%$ module.n) (@t name.n) (crip "{(trip name.n)}.{(trip module.n)}"))
      `[%recursive (@tas module.n) (@tas name.n) `label]
    %apply
      ?.  ?=([%apply @ *] node)  ~
      =/  name=term  (@tas +<.node)
      =/  arity=@ud
        ?:  |(=(%list name) =(%unit name) =(%set name) =(%qeu name))  1
        ?:  |(=(%map name) =(%mop name) =(%jar name) =(%jug name))  2
        0
      ?:  =(arity 0)  ~
      =/  args=(unit (list itype))  (import-to-itypes-standard +>.node standard)
      ?~  args  ~
      ?.  =(arity (lent u.args))  ~
      =/  keyed=(unit [types=(list itype) sub=isub])  (itype-collection-keys name u.args ~)
      ?~  keyed  ~
      ?:  =(%unit name)
        ?.  ?=([* ~] types.u.keyed)  ~
        ?~  standard  `[%collection name types.u.keyed]
        ?.  (standard-unit-template u.standard /lib/jibb/prelude/jibb)  ~
        =/  nil=itype  [%const [%null %n 0 '~']]
        `[%union ~[nil [%cell nil [%slot %u i.types.u.keyed]]] `[/lib/jibb/prelude/jibb %unit] `%unit types.u.keyed]
      `[%collection name types.u.keyed]
    %fork
      ::  Hoon's ordinary ? mold is the fork of its two %f singletons.
      =/  raw=*  +.node
      ?:  |(=(raw ~[[%atom %f `0] [%atom %f `1]]) =(raw ~[[%atom %f `1] [%atom %f `0]]))
        `[%flag ~]
      =/  cases=(unit (list itype))  (import-to-itypes-standard raw standard)
      ?~  cases  ~
      ?~  u.cases  ~
      ?~  t.u.cases  ~
      ?:  (import-has-loobean-singleton u.cases)  ~
      ?.  (import-cases-disjoint u.cases)  ~
      `[%union u.cases ~ ~ ~]
    %face
      ?.  ?=([%face @ *] node)  ~
      =/  name=@  +<.node
      ?.  (jibb-face-name name)  ~
      =/  body=(unit itype)  $(node +>.node)
      ?~  body  ~
      `[%face (@tas name) u.body]
    %cell
      ?.  ?=([%cell * *] node)  ~
      =/  left=(unit itype)  $(node +<.node)
      ?~  left  ~
      =/  right=(unit itype)  $(node +>.node)
      ?~  right  ~
      =/  head=itype  u.left
      =/  tail=itype  u.right
      =?  head  ?=(%face -.head)  [%slot name.head body.head]
      =?  tail  ?=(%face -.tail)  [%slot name.tail body.tail]
      `[%cell head tail]
  ==
::
++  import-direct-loobean
  |=  t=itype
  ^-  ?
  ?:  ?=(?(%face %slot) -.t)  $(t body.t)
  ?:  ?=(%union -.t)  (import-has-loobean-singleton cases.t)
  ?=([%const [%loobean *]] t)
::
++  import-has-loobean-singleton
  |=  cases=(list itype)
  ^-  ?
  ?~  cases  |
  ?:  (import-direct-loobean i.cases)  &
  $(cases t.cases)
::
++  import-to-itypes-standard
  |=  [nodes=* standard=(unit ischeme)]
  ^-  (unit (list itype))
  ?@  nodes  ?:(=(nodes 0) `~ ~)
  =/  first  (import-to-itype-standard -.nodes standard)
  ?~  first  ~
  =/  rest  $(nodes +.nodes, standard standard)
  ?~  rest  ~
  `[u.first u.rest]
::
++  import-type-pattern
  |=  typ=itype
  ^-  upat
  ?-  -.typ
    %noun   [%all ~]
    %empty  [%empty ~]
    %atom   [%atom ~]
    %any-atom  [%atom ~]
    %flag   [%or ~[[%atom `0] [%atom `1]]]
    %const  [%atom `val.literal.typ]
    ?(%face %slot)   $(typ body.typ)
    %cell   [%cell $(typ hed.typ) $(typ tal.typ)]
    %union  [%or (turn cases.typ |=(t=itype (import-type-pattern t)))]
    *       [%unknown ~]
  ==
::
++  import-cases-disjoint
  |=  cases=(list itype)
  ^-  ?
  ?~  cases  &
  =/  first=upat  (import-type-pattern i.cases)
  ?.  (levy t.cases |=(t=itype =(%disjoint (union-relate first (import-type-pattern t)))))  |
  $(cases t.cases)
::
::  A generic Hoon collection descriptor comes only from the source reader.
::  Revalidate the entire descriptor before applying it to Jibb types.
++  import-generic-vars
  |=  [index=@ud count=@ud]
  ^-  (list @ud)
  ?:  =(index count)  ~
  [index $(index +(index))]
++  import-generic-nodes
  |=  [nodes=* arity=@ud sub=isub fuel=@ud standard=(unit ischeme)]
  ^-  (unit [types=(list itype) sub=isub left=@ud])
  ?@  nodes  ?:(=(nodes 0) `[~ sub fuel] ~)
  =/  first=(unit [typ=itype sub=isub left=@ud])
    (import-generic-node -.nodes arity sub fuel standard)
  ?~  first  ~
  =/  rest=(unit [types=(list itype) sub=isub left=@ud])
    $(nodes +.nodes, sub sub.u.first, fuel left.u.first)
  ?~  rest  ~
