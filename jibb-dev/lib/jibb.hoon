++  icore-fit-joins-walk
  |=  [left=itype right=itype sub=isub at=span context=span fuel=@ud]
  ^-  (list icore-edge)
  ?:  =(0 fuel)  ~[[%join left right at context]]
  =.  fuel  (dec fuel)
