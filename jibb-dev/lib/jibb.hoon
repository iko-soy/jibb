::
++  infer-sample
  |=  [s=sample env=ienv state=istate]
  ^-  isample-result
  ?-  -.s
    %bind
      ?:  |((reserved-name name.s) ?=(^ (ienv-lookup name.s env)) (lien globals.state |=(x=term =(x name.s))))
        [%| "sample shadows a name"]
      =/  t=itype  [%var next.state]
