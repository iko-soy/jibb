    %cell      |($(t hed.t) $(t tal.t))
  ==
++  itype-var-is-restricted
  |=  [n=@ud t=itype]
  ^-  ?
  ?-  -.t
    %opaque  |($(t body.t) (lien args.t |=(c=itype (itype-var-is-restricted n c))))
    %refined  $(t proof.t)
    %var       |
    %fvar      |
    %avar      |
    %rvar      =(n id.t)
    %nvar      |
    %rnvar      |
    %atom      |
    %any-atom  |
    %flag      |
    %noun  |
    %empty  |
    %tag       |
