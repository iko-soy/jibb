  =/  proof=[%generic-source arity=@ud body=* at=path source=@t arm=* scope=@]
    ;;([%generic-source arity=@ud body=* at=path source=@t arm=* scope=@] raw)
  ?:  |(=(0 arity.proof) (gth arity.proof 16))  ~
  ?~  at.proof  ~
