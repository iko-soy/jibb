        ?~  template  ~
        ?~  vars.u.template  ~
        =/  applied=(unit [typ=itype sub=isub])  (template-apply-sub u.template types.u.args sub.state.u.args)
        ?~  applied  ~
        =.  sub.state.u.args  sub.u.applied
