++  iav-field
  |=  [value=iav-value name=term context=iav-context fuel=@ud]
  ^-  iav-value
  (iav-carry (iav-field-raw value name context fuel) ~[value] fuel)
++  iav-field-raw
  |=  [value=iav-value name=term context=iav-context fuel=@ud]
