++  itype-family-related
  |=  [a=itype b=itype sub=isub]
  ^-  ?
  =.  a  (itype-walk a sub)
  =.  b  (itype-walk b sub)
  ?:  &(?=(%atom -.a) ?=(%atom -.b))
    ?.  !=(aura.a aura.b)  |
    |((aura-prefix aura.a aura.b) (aura-prefix aura.b aura.a))
  ?:  &(?=(%collection -.a) ?=(%collection -.b))
    ?.  =(name.a name.b)  |
    (itype-family-related-collection-args args.a args.b sub)
