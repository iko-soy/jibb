::
++  infer-simple-fields
  |=  [fields=(list field) state=istate]
  ^-  (unit [typ=itype state=istate])
  ?~  fields  ~
  =/  field-shape=shape
    ?-  -.i.fields
      %bare  shape.i.fields
      %face  shape.i.fields
      %pun   [%ref at.i.fields ~[name.i.fields]]
    ==
  =/  head=(unit [typ=itype state=istate])  (infer-simple-shape field-shape state)
  ?~  head  ~
