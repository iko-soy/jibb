::
++  itype-var-is-atom
  |=  [n=@ud t=itype]
  ^-  ?
  ?-  -.t
    %opaque  |($(t body.t) (lien args.t |=(c=itype (itype-var-is-atom n c))))
    %refined  $(t proof.t)
    %var       |
    %fvar      |
    %avar      =(n id.t)
    %rvar      =(n id.t)
    %nvar      =(n id.t)
    %rnvar      =(n id.t)
    %atom      |
    %any-atom  |
    %flag      |
    %noun  |
    %empty  |
    %tag       |
    %const     |
    %union     |((lien cases.t |=(c=itype (itype-var-is-atom n c))) (lien args.t |=(c=itype (itype-var-is-atom n c))))
    %recursive  |
    %mrec       (lien args.t |=(c=itype (itype-var-is-atom n c)))
