::
++  shadow-definitions-scope
  |=  [defs=(list def) scope=ishadow-scope file=path src=@t external=?]
  ^-  ishadow-scope
  ?~  defs  scope
  ?.  ?=(%value -.i.defs)  $(defs t.defs)
  =/  site=span  at.i.defs
  =/  origin=idsite  ?:(external [%external file src site "earlier binding"] [site "earlier binding"])
