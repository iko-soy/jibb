++  shadow-prelude-scope
  |=  prelude=(unit ifile)
  ^-  ishadow-scope
  ?~  prelude  ~
  ?~  source.u.prelude  ~
  =/  parsed=(each module error)  (parse at.u.prelude u.source.u.prelude)
  ?:  ?=(%| -.parsed)  ~
  =/  visible=(list def)
