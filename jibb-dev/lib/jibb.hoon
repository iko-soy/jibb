  =.  raw  raw.anchored-raw
  =.  st  state.anchored-raw
  =/  scheme=(unit ischeme)  (icore-generalize-preserved raw typ level.state st)
  ?~  scheme  `[%| (icore-definition-diagnostic d ["definition constraints could not be generalized" ~])]
