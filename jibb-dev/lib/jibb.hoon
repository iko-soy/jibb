    %tvar
      =/  param=(unit itype)  (iparam-lookup name.sh params.state)
      ?^  param  `[u.param state]
      ?:  in-mold.state  ~
      =/  n=(unit @ud)  (icap-lookup name.sh caps.state)
      ?^  n  `[[%var u.n] state]
      =/  id=@ud  (named-var name.sh next.state)
