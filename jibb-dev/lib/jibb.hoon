      =/  found=(unit shape)  (find-simple-mold n molds.state)
      ?~  found
        ?:  (lien molds.state |=(m=[name=term body=shape] =(name.m n)))  ~
        ?~  prelude.state  ~
        =/  prelude-entry=(unit ischeme)  (find-jibb-mold n u.prelude.state)
        ?~  prelude-entry  ~
        ?^  vars.u.prelude-entry  ~
        `[typ.u.prelude-entry state]
