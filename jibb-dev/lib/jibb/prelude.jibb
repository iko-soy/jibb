/= internal /lib/jibb/internal
+$ raw-poke raw-poke.internal
+$ qath qath.internal

::  Initial prelude functions. The rest of the inventory is still to come.

++ same |= x=A x

++ head |= p=[A B]
  ?- p
  [a b] a

++ tail |= p=[A B]
  ?- p
  [a b] b

++ not |= b=?
  ?- b
  %.y %.n
  %.n %.y

++ eq |= args=[A A] (eq-data.internal args)

+$ list |$ [A]
  ~
  [i=A t=(list A)]

+$ unit |$ [A]
  ~
  [~ u=A]

++ fall |= args=[(unit A) A]
  ?- args
  [maybe fallback]
    ?- maybe
    ~ fallback
    [~ value] value

++ need |= maybe=(unit A)
  ?- maybe
  ~ !!
  [~ value] value

++ weld |= args=[(list A) (list A)]
  ?- args
  [xs ys] ^- (list A)
    ?- xs
    ~ ys
    [item rest] [item (weld rest ys)]

++ turn |= args=[(list A) $-(A B)]
  ?- args
  [xs f] ^- (list B)
    ?- xs
    ~ ~
    [item rest] [(f item) (turn rest f)]

+$ dime [p=@ta q=@]

+$ hair [p=@ud q=@ud]

+$ pint [p=[p=@ q=@] q=[p=@ q=@]]

+$ coin
  [%$ p=dime]
  [%blob p=*]
  [%many p=(list coin)]

+$ pair |$ [A B] [p=A q=B]

+$ trel |$ [A B C] [p=A q=B r=C]

+$ qual |$ [A B C D] [p=A q=B r=C s=D]

+$ cord @t

+$ knot @ta

+$ tape (list @tD)

+$ path (list knot)

+$ axis @
+$ bean ?
+$ flag ?
+$ char @t
+$ byts [wid=@ud dat=@]
+$ noun *
+$ tour (list @c)
+$ tarp [d=@ud h=@ud m=@ud s=@ud f=(list @ux)]
+$ date [[a=? y=@ud] m=@ud t=tarp]
+$ term @tas
+$ wain (list cord)
+$ wall (list tape)
+$ stud
  [mark=@tas]
  [auth=@tas type=path]

+$ tank
  cord
  [%leaf p=tape]
  [%palm p=(qual tape tape tape tape) q=(list tank)]
  [%rose p=(trel tape tape tape) q=(list tank)]

+$ tang (list tank)

+$ nail [p=hair q=tape]

+$ edge [p=hair q=(unit [p=* q=nail])]

+$ rule $-(nail edge)

+$ spot [p=path q=pint]

+$ toon
  [%0 p=*]
  [%1 p=*]
  [%2 p=(list tank)]

+$ like |$ [A] [p=hair q=(unit [p=A q=nail])]

++ like |= [f=$-(A B) result=(like A)]
  ++ mapped ^- (unit [p=B q=nail])
    ?- q.result
    ~ ~
    [~ value] `[p=(f p.value) q=q.value]
  ^- (like B) [p=p.result q=mapped]

++ wonk |= veq=(like A)
  ?- q.veq
  ~ !!
  [~ product] p.product

+$ lone |$ [A] [p=A]

+$ lest |$ [A] [i=A t=(list A)]

+$ pole |$ [A]
  ~
  [A (pole A)]

+$ quip |$ [A B] [(list A) B]

+$ tree |$ [A]
  ~
  [n=A l=(tree A) r=(tree A)]

+$ each |$ [A B]
  [%| p=B]
  [%& p=A]

+$ bloq @

++ some |= item=A `item

++ lure |= item=A
  ^- (list A) [item ~]

++ snoc |= args=[(list A) A]
  ?- args
  [xs item] (weld xs [item ~])

++ flop |= xs=(list A)
  ++ reverse-into |= args=[(list A) (list A)]
    ?- args
    [rest acc]
      ?- rest
      ~ acc
      [item more] (reverse-into more [item acc])
  (reverse-into xs ~)

++ drop |= maybe=(unit A) ^- (list A)
  ?- maybe
  ~ ~
  [~ value] [value ~]

++ bond |= fallback=$-(~ A)
  |= maybe=(unit A)
    ?- maybe
    ~ (fallback ~)
    [~ value] value

++ bind |= args=[(unit A) $-(A B)]
  ?- args
  [maybe f] ^- (unit B)
    ?- maybe
    ~ ~
    [~ value] `(f value)

++ biff |= args=[(unit A) $-(A (unit B))]
  ?- args
  [maybe f] ^- (unit B)
    ?- maybe
    ~ ~
    [~ value] (f value)

++ both |= args=[(unit A) (unit B)]
  ?- args
  [first second] ^- (unit [A B])
    ?- first
    ~ ~
    [~ a]
      ?- second
      ~ ~
      [~ b] `[a b]

++ clap |= args=[(unit A) (unit A) $-([A A] A)]
  ?- args
  [first second combine] ^- (unit A)
    ?- first
    ~ second
    [~ a]
      ?- second
      ~ first
      [~ b] `(combine a b)

++ hunt |= args=[$-([A A] ?) (unit A) (unit A)]
  ?- args
  [choose first second] ^- (unit A)
    ?- first
    ~ second
    [~ a]
      ?- second
      ~ first
      [~ b]
        ?- (choose a b)
        %.y first
        %.n second

++ mate |= args=[(unit A) (unit A)]
  ?- args
  [first second] ^- (unit A)
    ?- second
    ~ first
    [~ b]
      ?- first
      ~ second
      [~ a]
        ?- (eq a b)
        %.y first
        %.n !!

++ clef |= args=[(unit A) (unit B) $-([A B] (unit C))]
  ?- args
  [first second combine] ^- (unit C)
    ?- first
    ~ ~
    [~ a]
      ?- second
      ~ ~
      [~ b] (combine a b)

++ skim |= args=[(list A) $-(A ?)]
  ?- args
  [xs predicate] ^- (list A)
    ?- xs
    ~ ~
    [item rest]
      ?- (predicate item)
      %.y [item (skim rest predicate)]
      %.n (skim rest predicate)

++ skip |= args=[(list A) $-(A ?)]
  ?- args
  [xs predicate] ^- (list A)
    ?- xs
    ~ ~
    [item rest]
      ?- (predicate item)
      %.y (skip rest predicate)
      %.n [item (skip rest predicate)]

++ levy |= args=[(list A) $-(A ?)] ^- ?
  ?- args
  [xs predicate]
    ?- xs
    ~ %.y
    [item rest]
      ?- (predicate item)
      %.y (levy rest predicate)
      %.n %.n

++ lien |= args=[(list A) $-(A ?)] ^- ?
  ?- args
  [xs predicate]
    ?- xs
    ~ %.n
    [item rest]
      ?- (predicate item)
      %.y %.y
      %.n (lien rest predicate)

++ roll |= args=[(list A) B $-([A B] B)]
  ?- args
  [xs start combine]
    ?- xs
    ~ start
    [item rest] (roll rest (combine item start) combine)

++ reel |= args=[(list A) B $-([A B] B)]
  ?- args
  [xs start combine]
    ?- xs
    ~ start
    [item rest] (combine item (reel rest start combine))

++ flit |= predicate=$-(A ?)
  |= value=A ^- (unit A)
    ?- (predicate value)
    %.y `value
    %.n ~

++ murn |= args=[(list A) $-(A (unit B))]
  ?- args
  [xs f] ^- (list B)
    ?- xs
    ~ ~
    [item rest]
      ?- (f item)
      ~ (murn rest f)
      [~ value] [value (murn rest f)]

++ join |= args=[A (list A)]
  ?- args
  [separator xs] ^- (list A)
    ?- xs
    ~ ~
    [item rest]
      ?- rest
      ~ [item ~]
      [next more] [item [separator (join separator rest)]]

++ snip |= xs=(list A) ^- (list A)
  ?- xs
  ~ ~
  [item rest]
    ?- rest
    ~ ~
    [next more] [item (snip rest)]

++ rear |= xs=(list A)
  ?- xs
  ~ !!
  [item rest]
    ?- rest
    ~ item
    [next more] (rear rest)

++ snag |= args=[@ud (list A)]
  ?- args
  [index xs]
    ?- xs
    ~ !!
    [item rest]
      ?- (eq index 0)
      %.y item
      %.n (snag (dec index) rest)

++ scag |= args=[@ud (list A)] ^- (list A)
  ?- args
  [count xs]
    ?- (eq count 0)
    %.y ~
    %.n
      ?- xs
      ~ ~
      [item rest] [item (scag (dec count) rest)]

++ slag |= args=[@ud (list A)] ^- (list A)
  ?- args
  [count xs]
    ?- (eq count 0)
    %.y xs
    %.n
      ?- xs
      ~ ~
      [item rest] (slag (dec count) rest)

++ reap |= args=[@ud A] ^- (list A)
  ?- args
  [count item]
    ?- (eq count 0)
    %.y ~
    %.n [item (reap (dec count) item)]

++ sort |= args=[(list A) $-([A A] ?)] ^- (list A)
  ?- args
  [xs before]
    ?- xs
    ~ ~
    [pivot rest]
      ++ left (skim rest |=(item=A (before item pivot)))
      ++ right (skip rest |=(item=A (before item pivot)))
      (weld (sort left before) [pivot (sort right before)])

++ gulf |= args=[A A] ^- (list A)
  ?- args
  [start finish]
    ?- (gth start finish)
    %.y !!
    %.n
      ?- (eq start finish)
      %.y [start ~]
      %.n [start (gulf (add start 1) finish)]

++ oust |= args=[[@ud @ud] (list A)] ^- (list A)
  ?- args
  [[start count] xs] (weld (scag start xs) (slag (add start count) xs))

++ swag |= args=[[@ud @ud] (list A)] ^- (list A)
  ?- args
  [[start count] xs] (scag count (slag start xs))

++ snap |= args=[(list A) @ud A] ^- (list A)
  ?- args
  [xs index item] (weld (scag index xs) [item (slag (add index 1) xs)])

++ into |= args=[(list A) @ud A] ^- (list A)
  ?- args
  [xs index item] (weld (scag index xs) [item (slag index xs)])

++ skid |= args=[(list A) $-(A ?)] ^- [p=(list A) q=(list A)]
  ?- args
  [xs predicate] [p=(skim xs predicate) q=(skip xs predicate)]

++ cork |= gates=[$-(A B) $-(B C)]
  ?- gates
  [f g] |= x=A (g (f x))

++ corl |= gates=[$-(B C) $-(A B)]
  ?- gates
  [f g] |= x=A (f (g x))

++ cury |= args=[$-([A B] C) A]
  ?- args
  [f a] |= b=B (f a b)

++ curr |= args=[$-([A B] C) B]
  ?- args
  [f b] |= a=A (f a b)

+$ cmd |$ [M]
  [%poke p=raw-poke reply=$-((unit @t) M)]
  [%go url=@t]
  [%wait gap=@dr msg=M]
  [%now reply=$-(@da M)]
  [%who reply=$-(@p M)]

++ gth |= args=[A A] (gth-atom.internal args)
++ add |= args=[A A] (add-atom.internal args)
++ dec |= atom=A (dec-atom.internal atom)
++ max |= args=[A A]
  ?- args
  [a b]
    ?- (gth a b)
    %.y a
    %.n b

++ min |= args=[A A]
  ?- args
  [a b]
    ?- (gth a b)
    %.y b
    %.n a

++ sub |= args=[A A]
  ?- args
  [a b]
    ?- (eq b 0)
    %.y a
    %.n (sub (dec a) (dec b))

++ mul |= args=[A A]
  ?- args
  [a b]
    ?- (eq a 0)
    %.y a
    %.n (add b (mul (dec a) b))

+$ ask |$ [M] (ask.internal M)
++ pure |= x=M ^- (ask M) [%pure x]

::  This mold describes the value; island watchability needs separate proof.
+$ sub |$ [M]
  [%watch a=(ask M)]
  [%every gap=@dr reply=$-(@da M)]
  [%url reply=$-(path M)]

::  Count a finite list with the source-backed addition gate.
++ lent |= xs=(list A) ^- @ud
  ?- xs
  ~ 0
  [item rest] (add 1 (lent rest))

++ lth |= args=[A A]
  ?- args
  [x y] (gth y x)

++ gte |= args=[A A]
  ?- args
  [x y] (not (gth y x))

++ lte |= args=[A A]
  ?- args
  [x y] (not (gth x y))

++ zing |= xss=(list (list A)) ^- (list A)
  ?- xss
  ~ ~
  [xs rest] (weld xs (zing rest))

++ lead |= first=A |= second=B [first second]
++ late |= second=B |= first=A [first second]

++ succ |= x=A (add x 1)

++ trip |= value=@t (trip-text.internal value)
++ tuba |= values=(list @tD) (tuba-text.internal values)

::  UI values are source-level descriptions only.  Nested element payloads are
::  erased in the nonrecursive union; the public constructors below retain the
::  typed composition boundaries.  Raw-constructor encapsulation, rendering and
::  execution are not established by this slice.
+$ length
  [%chars n=@ud]
  [%fill n=@ud]
  %shrink

+$ align
  %start
  %center
  %end

+$ role
  %body
  %caption
  %label

+$ tone
  %normal
  %muted
  %accent
  %danger

+$ attr
  [%pad %s0]
  [%pad %s1]
  [%pad %s2]
  [%pad %s3]
  [%gap %s0]
  [%gap %s1]
  [%gap %s2]
  [%gap %s3]
  [%width width=length]
  [%align align=align]
  [%role role=role]
  [%tone tone=tone]

::  The public element type is sealed by the private compiler interface.
+$ element |$ [M] (opaque.internal (element-node.internal M attr qath))

++ row |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%row attrs kids]))

++ column |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%column attrs kids]))

++ wrap |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%wrap attrs kids]))

++ stack |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%stack attrs kids]))

++ el |= [attrs=(list attr) kid=(element M)]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%el attrs kid]))

++ para |= kids=(list (element M))
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%para kids]))

++ text |= words=@t
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%text words]))

++ heading |= [level=@ud words=@t]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%heading level words]))

++ each |= items=(list [key=K el=(element M)])
  ++ checked (turn items |=(item [key=(checked-key.internal key.item) el=el.item]))
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%each checked]))

++ table |= [columns=(list [header=@t width=length align=align]) rows=(list [key=K cells=(list (element M))])]
  ++ checked (turn rows |=(entry [key=(checked-key.internal key.entry) cells=cells.entry]))
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%table columns checked]))

++ image |= [source=qath description=@t]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%image source description]))

++ image-unsafe |= [source=[url=@t width=@ud height=@ud] description=@t]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%image-unsafe source description]))

++ link |= [target=qath label=@t]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%link target label]))

++ link-unsafe |= [target=@t label=@t]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%link-unsafe target label]))

++ button |= [label=@t message=M]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%button label message]))

++ toggle |= [on=? label=@t message=M]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%toggle on label message]))

++ field |= [label=@t value=@t reply=$-(@t M)]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%field label value reply]))

++ form |= [message=M kids=(list (element M))]
  ^- (element M) (seal.internal (^- (element-node.internal M attr qath) [%form message kids]))

+$ theme
  [ space=[s1=@t s2=@t s3=@t]
    tones=[normal=@t background=@t accent=@t danger=@t muted=@t]
    wide=@t
    lang=@t
    zone=@t
    font=(unit qath)
    dark=(unit [tones=[normal=@t background=@t accent=@t danger=@t muted=@t]])

+$ program |$ [Data Model Msg]
  [ init=$-(Data Model)
    update=$-([Msg Model] [Model (list (cmd Msg))])
    view=$-(Model (element Msg))
    subs=$-(Model (list (sub Msg)))

++ program |= [init=$-(Data Model) update=$-([Msg Model] [Model (list (cmd Msg))]) view=$-(Model (element Msg)) subs=$-(Model (list (sub Msg)))]
  ^- (program Data Model Msg) [init update view subs]

++ island |= [p=(program Data Model Msg) data=Data]
  ++ check-data |= value=Data (eq value value)
  ++ check-model |= model=Model (eq model model)
  ^- (element !!) (seal.internal (^- (element-node.internal !! attr qath) [%island [p data]]))

+$ page |$ [Params Data]
  [load=$-(Params (ask Data)) view=$-(Data (element !!))]

++ page |= [load=$-(Params (ask Data)) view=$-(Data (element !!))]
  ^- (page Params Data) [load view]

+$ store |$ [S] [init=S update=*]

++ store |= [init=S update=$-([A S] S)]
  ^- (store S) [init update]

++ dvr |= args=[A A] ^- [p=A q=A]
  ?- args
  [a b]
    ?- (eq b 0)
    %.y !!
    %.n
      ?- (gth b a)
      %.y [p=0 q=a]
      %.n
        ?- (dvr (sub a b) b)
        [quotient remainder] [p=(add quotient 1) q=remainder]

++ div |= args=[A A]
  ?- args
  [a b]
    ++ result (dvr a b)
    p.result

++ mod |= args=[A A]
  ?- args
  [a b]
    ++ result (dvr a b)
    q.result

++ pow |= args=[A A]
  ?- args
  [a b]
    ?- (eq b 0)
    %.y 1
    %.n (mul a (pow a (dec b)))

+$ gate $-(* *)

+$ mold $-(* *)

::  Collection identity, sublist search, a stateful map, equality and root.

++ homo |= xs=(list A) xs

++ fand |= [needle=(list A) haystack=(list A)] ^- (list @ud)
  ?- needle
  ~ ~
  *
    ?- haystack
    ~ ~
    [item rest]
      ++ shifted (turn (fand needle rest) |=(index=@ud (add index 1)))
      ?- (eq needle (scag (lent needle) haystack))
      %.y [0 shifted]
      %.n shifted

++ find |= [needle=(list A) haystack=(list A)] ^- (unit @ud)
  ?- needle
  ~ ~
  *
    ?- haystack
    ~ ~
    [item rest]
      ?- (eq needle (scag (lent needle) haystack))
      %.y `0
      %.n (bind (find needle rest) |=(index=@ud (add index 1)))

++ spin |= args=[(list A) B $-([A B] [C B])] ^- [p=(list C) q=B]
  ?- args
  [xs state apply]
    ?- xs
    ~ [p=~ q=state]
    [item rest]
      ?- (apply item state)
      [mapped next]
        ++ result (spin rest next apply)
        [p=[mapped p.result] q=q.result]

++ test |= args=[A A] (eq args)

++ sqt |= value=A ^- [p=A q=A]
  ++ root |= [low high]
    ?- (lth (add low 1) high)
    %.n low
    %.y
      ++ middle (div (add low high) 2)
      ?- (lte (mul middle middle) value)
      %.y (root middle high)
      %.n (root low middle)
  ++ result (root 0 (add value 1))
  [p=result q=(sub value (mul result result))]


::  ASCII case conversion and list splitting follow Hoon 135.
++ cass |= letters=tape
  ++ lower-byte |= byte=@tD
    ?- (gte byte (snag 0 (trip "A")))
    %.n byte
    %.y
      ?- (lte byte (snag 0 (trip "Z")))
      %.n byte
      %.y (add byte (sub (snag 0 (trip "a")) (snag 0 (trip "A"))))
  turn letters lower-byte

++ cuss |= letters=tape
  ++ upper-byte |= byte=@tD
    ?- (gte byte (snag 0 (trip "a")))
    %.n byte
    %.y
      ?- (lte byte (snag 0 (trip "z")))
      %.n byte
      %.y (sub byte (sub (snag 0 (trip "a")) (snag 0 (trip "A"))))
  turn letters upper-byte

++ trim |= args=[@ud (list A)] ^- [p=(list A) q=(list A)]
  ?- args
  [count xs]
    ?- (eq count 0)
    %.y [p=~ q=xs]
    %.n
      ?- xs
      ~ [p=~ q=~]
      [item rest]
        ++ halves (trim (dec count) rest)
        [p=[item p.halves] q=q.halves]

++ crip |= bytes=tape (crip-text.internal bytes)
++ tufa |= points=(list @c) (tufa-text.internal points)

+$ bite
  bloq
  [bloq=bloq step=step.hoon]

::  Calendar and formatting gates retain the Hoon 135 sample and product types.
++ year |= value=date (pack-date.internal value)
++ yore |= value=@da (unpack-date.internal value)
++ scot |= value=dime (format-knot.internal value)
++ scow |= value=dime (format-tape.internal value)
++ slaw |= args=[@tas @ta] ^- (unit @)
  ++ parsed (parse-atom.internal args)
  ?- valid.parsed
  %.y `value.parsed
  %.n ~
++ slav |= args=[@tas @ta] (need (slaw args))

::  Hoon map retains its key constraint and map identity.
+$ map |$ [K V] (map.hoon K V)

++ by
  ++ get |= [m=(map K V) k=K] (map-get.internal m k)
  ++ put |= [m=(map K V) k=K v=V] (map-put.internal m k v)
  [get=get put=put]
