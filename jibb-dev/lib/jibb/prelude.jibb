/= internal /lib/jibb/internal
+$ poke poke.internal
+$ qath qath.internal

::  Initial prelude functions. The rest of the inventory is still to come.

++ same |= x=A x

++ head |= p=[A B]
  ?- p
    [a b] a

++ tail |= p=[A B]
  ?- p
    [a b] b

++ not |= b=?
  ?- b
    %.y %.n
    %.n %.y

+$ list |$ [A]
  ~
  [i=A t=(list A)]

+$ unit |$ [A]
  ~
  [~ u=A]

++ fall |= args=[(unit A) A]
  ?- args
    [maybe fallback]
      ?- maybe
        ~ fallback
        [~ value] value

++ need |= maybe=(unit A)
  ?- maybe
    ~ !!
    [~ value] value

++ weld |= args=[(list A) (list A)]
  ?- args
    [xs ys]
      ^- (list A)
        ?- xs
          ~ ys
          [item rest] [item (weld rest ys)]

++ turn |= args=[(list A) $-(A B)]
  ?- args
    [xs f]
      ^- (list B)
        ?- xs
          ~ ~
          [item rest] [(f item) (turn rest f)]

+$ dime [p=@ta q=@]

+$ hair [p=@ud q=@ud]

+$ pint [p=[p=@ q=@] q=[p=@ q=@]]

+$ coin
  [%$ p=dime]
  [%blob p=*]
  [%many p=(list coin)]

+$ pair |$ [A B] [p=A q=B]

+$ trel |$ [A B C] [p=A q=B r=C]

+$ qual |$ [A B C D] [p=A q=B r=C s=D]

+$ cord @t

+$ knot @ta

+$ tape (list @tD)

+$ path (list knot)

+$ tank
  cord
  [%leaf p=tape]
  [%palm p=(qual tape tape tape tape) q=(list tank)]
  [%rose p=(trel tape tape tape) q=(list tank)]

+$ nail [p=hair q=tape]

+$ edge [p=hair q=(unit [p=* q=nail])]

+$ rule $-(nail edge)

+$ spot [p=path q=pint]

+$ toon
  [%0 p=*]
  [%1 p=*]
  [%2 p=(list tank)]

+$ like |$ [A] [p=hair q=(unit [p=A q=nail])]

++ like |= [f=$-(A B) result=(like A)]
  ++ mapped
    ^- (unit [p=B q=nail])
      ?- q.result
        ~ ~
        [~ value] `[p=(f p.value) q=q.value]
  ^- (like B) [p=p.result q=mapped]

++ wonk |= veq=(like A)
  ?- q.veq
    ~ !!
    [~ product] p.product

+$ lone |$ [A] [p=A]

+$ lest |$ [A] [i=A t=(list A)]

+$ pole |$ [A]
  ~
  [A (pole A)]

+$ quip |$ [A B] [(list A) B]

+$ tree |$ [A]
  ~
  [n=A l=(tree A) r=(tree A)]

+$ each |$ [A B]
  [%| p=B]
  [%& p=A]

+$ bloq @

++ some |= item=A `item

++ lure |= item=A
  ^- (list A) [item ~]

++ snoc |= args=[(list A) A]
  ?- args
    [xs item] (weld xs [item ~])

++ flop |= xs=(list A)
  ++ reverse-into |= args=[(list A) (list A)]
    ?- args
      [rest acc]
        ?- rest
          ~ acc
          [item more] (reverse-into more [item acc])
  (reverse-into xs ~)

++ drop |= maybe=(unit A)
  ^- (list A)
    ?- maybe
      ~ ~
      [~ value] [value ~]

++ bond |= fallback=$-(~ A)
  |= maybe=(unit A)
    ?- maybe
      ~ (fallback ~)
      [~ value] value

++ bind |= args=[(unit A) $-(A B)]
  ?- args
    [maybe f] ^- (unit B)
      ?- maybe
        ~ ~
        [~ value] `(f value)

++ biff |= args=[(unit A) $-(A (unit B))]
  ?- args
    [maybe f] ^- (unit B)
      ?- maybe
        ~ ~
        [~ value] (f value)

++ both |= args=[(unit A) (unit B)]
  ?- args
    [first second] ^- (unit [A B])
      ?- first
        ~ ~
        [~ a]
          ?- second
            ~ ~
            [~ b] `[a b]

++ clap |= args=[(unit A) (unit A) $-([A A] A)]
  ?- args
    [first second combine] ^- (unit A)
      ?- first
        ~ second
        [~ a]
          ?- second
            ~ first
            [~ b] `(combine a b)

++ clef |= args=[(unit A) (unit B) $-([A B] (unit C))]
  ?- args
    [first second combine] ^- (unit C)
      ?- first
        ~ ~
        [~ a]
          ?- second
            ~ ~
            [~ b] (combine a b)

++ skim |= args=[(list A) $-(A ?)]
  ?- args
    [xs predicate] ^- (list A)
        ?- xs
          ~ ~
          [item rest]
            ?- (predicate item)
              %.y [item (skim rest predicate)]
              %.n (skim rest predicate)

++ skip |= args=[(list A) $-(A ?)]
  ?- args
    [xs predicate] ^- (list A)
        ?- xs
          ~ ~
          [item rest]
            ?- (predicate item)
              %.y (skip rest predicate)
              %.n [item (skip rest predicate)]

++ levy |= args=[(list A) $-(A ?)]
  ^- ?
    ?- args
      [xs predicate]
        ?- xs
          ~ %.y
          [item rest]
            ?- (predicate item)
              %.y (levy rest predicate)
              %.n %.n

++ lien |= args=[(list A) $-(A ?)]
  ^- ?
    ?- args
      [xs predicate]
        ?- xs
          ~ %.n
          [item rest]
            ?- (predicate item)
              %.y %.y
              %.n (lien rest predicate)

++ roll |= args=[(list A) B $-([A B] B)]
  ?- args
    [xs start combine]
      ?- xs
        ~ start
        [item rest] (roll rest (combine item start) combine)

++ reel |= args=[(list A) B $-([A B] B)]
  ?- args
    [xs start combine]
      ?- xs
        ~ start
        [item rest] (combine item (reel rest start combine))

++ flit |= predicate=$-(A ?)
  |= value=A
    ^- (unit A)
      ?- (predicate value)
        %.y `value
        %.n ~

++ murn |= args=[(list A) $-(A (unit B))]
  ?- args
    [xs f] ^- (list B)
        ?- xs
          ~ ~
          [item rest]
            ?- (f item)
              ~ (murn rest f)
              [~ value] [value (murn rest f)]

++ join |= args=[A (list A)]
  ?- args
    [separator xs] ^- (list A)
        ?- xs
          ~ ~
          [item rest]
            ?- rest
              ~ [item ~]
              [next more] [item [separator (join separator rest)]]

++ snip |= xs=(list A)
  ^- (list A)
    ?- xs
      ~ ~
      [item rest]
        ?- rest
          ~ ~
          [next more] [item (snip rest)]

++ rear |= xs=(list A)
  ?- xs
    ~ !!
    [item rest]
      ?- rest
        ~ item
        [next more] (rear rest)

++ cork |= gates=[$-(A B) $-(B C)]
  ?- gates
    [f g] |= x=A (g (f x))

++ corl |= gates=[$-(B C) $-(A B)]
  ?- gates
    [f g] |= x=A (f (g x))

++ cury |= args=[$-([A B] C) A]
  ?- args
    [f a] |= b=B (f a b)

++ curr |= args=[$-([A B] C) B]
  ?- args
    [f b] |= a=A (f a b)

+$ cmd |$ [M]
  [%poke p=poke reply=$-((unit @t) M)]
  [%go url=@t]
  [%wait gap=@dr msg=M]
  [%now reply=$-(@da M)]
  [%who reply=$-(@p M)]

++ gth |= args=[A A] (gth-atom.internal args)
++ add |= args=[A A] (add-atom.internal args)
++ dec |= atom=A (dec-atom.internal atom)

+$ ask |$ [M] (ask.internal M)
++ pure |= x=M ^- (ask M) [%pure x]

::  This mold describes the value; island watchability needs separate proof.
+$ sub |$ [M]
  [%watch a=(ask M)]
  [%every gap=@dr reply=$-(@da M)]
  [%url reply=$-(path M)]

::  Count a finite list with the source-backed addition gate.
++ lent |= xs=(list A)
  ^- @ud
    ?- xs
      ~ 0
      [item rest] (add 1 (lent rest))

++ lth |= args=[A A]
  ?- args
    [x y] (gth y x)

++ gte |= args=[A A]
  ?- args
    [x y] (not (gth y x))

++ lte |= args=[A A]
  ?- args
    [x y] (not (gth x y))

++ zing |= xss=(list (list A))
  ^- (list A)
    ?- xss
      ~ ~
      [xs rest] (weld xs (zing rest))

++ lead |= first=A |= second=B [first second]
++ late |= second=B |= first=A [first second]

++ succ |= x=A (add x 1)

++ trip |= value=@t (trip-text.internal value)
++ tuba |= values=(list @tD) (tuba-text.internal values)

::  UI values are source-level descriptions only.  Nested element payloads are
::  erased in the nonrecursive union; the public constructors below retain the
::  typed composition boundaries.  Raw-constructor encapsulation, rendering and
::  execution are not established by this slice.
+$ length
  [%chars n=@ud]
  [%fill n=@ud]
  %shrink

+$ align
  %start
  %center
  %end

+$ role
  %body
  %caption
  %label

+$ tone
  %normal
  %muted
  %accent
  %danger

+$ attr
  [%pad %s0]
  [%pad %s1]
  [%pad %s2]
  [%pad %s3]
  [%gap %s0]
  [%gap %s1]
  [%gap %s2]
  [%gap %s3]
  [%width width=length]
  [%align align=align]
  [%role role=role]
  [%tone tone=tone]

+$ element |$ [M]
  [%row attrs=(list attr) kids=*]
  [%column attrs=(list attr) kids=*]
  [%wrap attrs=(list attr) kids=*]
  [%stack attrs=(list attr) kids=*]
  [%el attrs=(list attr) kid=*]
  [%para kids=*]
  [%text words=@t]
  [%heading level=@ud words=@t]
  [%each items=*]
  [%table columns=* rows=*]
  [%image source=qath description=@t]
  [%image-unsafe source=[url=@t width=@ud height=@ud] description=@t]
  [%link target=qath label=@t]
  [%link-unsafe target=@t label=@t]
  [%button label=@t message=M]
  [%toggle on=? label=@t message=M]
  [%field label=@t value=@t reply=$-(@t M)]
  [%form message=M kids=*]
  [%island payload=*]

++ row |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) [%row attrs kids]

++ column |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) [%column attrs kids]

++ wrap |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) [%wrap attrs kids]

++ stack |= [attrs=(list attr) kids=(list (element M))]
  ^- (element M) [%stack attrs kids]

++ el |= [attrs=(list attr) kid=(element M)]
  ^- (element M) [%el attrs kid]

++ para |= kids=(list (element M))
  ^- (element M) [%para kids]

++ text |= words=@t
  ^- (element M) [%text words]

++ heading |= [level=@ud words=@t]
  ^- (element M) [%heading level words]

++ each |= items=(list [key=K el=(element M)])
  ^- (element M) [%each items]

++ table |= [columns=(list [header=@t width=length align=align]) rows=(list [key=K cells=(list (element M))])]
  ^- (element M) [%table columns rows]

++ image |= [source=qath description=@t]
  ^- (element M) [%image source description]

++ image-unsafe |= [source=[url=@t width=@ud height=@ud] description=@t]
  ^- (element M) [%image-unsafe source description]

++ link |= [target=qath label=@t]
  ^- (element M) [%link target label]

++ link-unsafe |= [target=@t label=@t]
  ^- (element M) [%link-unsafe target label]

++ button |= [label=@t message=M]
  ^- (element M) [%button label message]

++ toggle |= [on=? label=@t message=M]
  ^- (element M) [%toggle on label message]

++ field |= [label=@t value=@t reply=$-(@t M)]
  ^- (element M) [%field label value reply]

++ form |= [message=M kids=(list (element M))]
  ^- (element M) [%form message kids]

+$ program |$ [D X M]
  [init=$-(D X) update=$-([M X] [X (list (cmd M))]) view=$-(X (element M)) subs=$-(X (list (sub M)))]

++ program |= [init=$-(D X) update=$-([M X] [X (list (cmd M))]) view=$-(X (element M)) subs=$-(X (list (sub M)))]
  ^- (program D X M) [init update view subs]

++ island |= [p=(program D X M) data=D]
  ^- (element !!) [%island [p data]]

+$ page |$ [R D]
  [load=$-(R (ask D)) view=$-(D (element !!))]

++ page |= [load=$-(R (ask D)) view=$-(D (element !!))]
  ^- (page R D) [load view]
