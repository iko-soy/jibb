/= internal /lib/jibb/internal
+$ poke poke.internal

::  Initial prelude functions. The rest of the inventory is still to come.

++ same |= x=A x

++ head |= p=[A B]
  ?- p
    [a b] a

++ tail |= p=[A B]
  ?- p
    [a b] b

++ not |= b=?
  ?- b
    %.y %.n
    %.n %.y

+$ list |$ [A]
  ~
  [i=A t=(list A)]

+$ unit |$ [A]
  ~
  [~ u=A]

++ fall |= args=[(unit A) A]
  ?- args
    [maybe fallback]
      ?- maybe
        ~ fallback
        [~ value] value

++ need |= maybe=(unit A)
  ?- maybe
    ~ !!
    [~ value] value

++ weld |= args=[(list A) (list A)]
  ?- args
    [xs ys]
      ^- (list A)
        ?- xs
          ~ ys
          [item rest] [item (weld rest ys)]

++ turn |= args=[(list A) $-(A B)]
  ?- args
    [xs f]
      ^- (list B)
        ?- xs
          ~ ~
          [item rest] [(f item) (turn rest f)]

+$ dime [p=@ta q=@]

+$ hair [p=@ud q=@ud]

+$ pint [p=[p=@ q=@] q=[p=@ q=@]]

+$ coin
  [%$ p=dime]
  [%blob p=*]
  [%many p=(list coin)]

+$ pair |$ [A B] [p=A q=B]

+$ trel |$ [A B C] [p=A q=B r=C]

+$ qual |$ [A B C D] [p=A q=B r=C s=D]

+$ cord @t

+$ knot @ta

+$ tape (list @tD)

+$ path (list knot)

+$ tank
  cord
  [%leaf p=tape]
  [%palm p=(qual tape tape tape tape) q=(list tank)]
  [%rose p=(trel tape tape tape) q=(list tank)]

+$ nail [p=hair q=tape]

+$ edge [p=hair q=(unit [p=* q=nail])]

+$ rule $-(nail edge)

+$ spot [p=path q=pint]

+$ toon
  [%0 p=*]
  [%1 p=*]
  [%2 p=(list tank)]

+$ like |$ [A] [p=hair q=(unit [p=A q=nail])]

++ wonk |= veq=(like A)
  ?- q.veq
    ~ !!
    [~ product] p.product

+$ lone |$ [A] [p=A]

+$ lest |$ [A] [i=A t=(list A)]

+$ pole |$ [A]
  ~
  [A (pole A)]

+$ quip |$ [A B] [(list A) B]

+$ tree |$ [A]
  ~
  [n=A l=(tree A) r=(tree A)]

+$ each |$ [A B]
  [%| p=B]
  [%& p=A]

+$ bloq @

++ some |= item=A `item

++ lure |= item=A
  ^- (list A) [item ~]

++ snoc |= args=[(list A) A]
  ?- args
    [xs item] (weld xs [item ~])

++ flop |= xs=(list A)
  ++ reverse-into |= args=[(list A) (list A)]
    ?- args
      [rest acc]
        ?- rest
          ~ acc
          [item more] (reverse-into more [item acc])
  (reverse-into xs ~)

++ drop |= maybe=(unit A)
  ^- (list A)
    ?- maybe
      ~ ~
      [~ value] [value ~]

++ bond |= fallback=$-(~ A)
  |= maybe=(unit A)
    ?- maybe
      ~ (fallback ~)
      [~ value] value

++ bind |= args=[(unit A) $-(A B)]
  ?- args
    [maybe f] ^- (unit B)
      ?- maybe
        ~ ~
        [~ value] `(f value)

++ biff |= args=[(unit A) $-(A (unit B))]
  ?- args
    [maybe f] ^- (unit B)
      ?- maybe
        ~ ~
        [~ value] (f value)

++ both |= args=[(unit A) (unit B)]
  ?- args
    [first second] ^- (unit [A B])
      ?- first
        ~ ~
        [~ a]
          ?- second
            ~ ~
            [~ b] `[a b]

++ clap |= args=[(unit A) (unit A) $-([A A] A)]
  ?- args
    [first second combine] ^- (unit A)
      ?- first
        ~ second
        [~ a]
          ?- second
            ~ first
            [~ b] `(combine a b)

++ clef |= args=[(unit A) (unit B) $-([A B] (unit C))]
  ?- args
    [first second combine] ^- (unit C)
      ?- first
        ~ ~
        [~ a]
          ?- second
            ~ ~
            [~ b] (combine a b)

++ skim |= args=[(list A) $-(A ?)]
  ?- args
    [xs predicate] ^- (list A)
        ?- xs
          ~ ~
          [item rest]
            ?- (predicate item)
              %.y [item (skim rest predicate)]
              %.n (skim rest predicate)

++ skip |= args=[(list A) $-(A ?)]
  ?- args
    [xs predicate] ^- (list A)
        ?- xs
          ~ ~
          [item rest]
            ?- (predicate item)
              %.y (skip rest predicate)
              %.n [item (skip rest predicate)]

++ levy |= args=[(list A) $-(A ?)]
  ^- ?
    ?- args
      [xs predicate]
        ?- xs
          ~ %.y
          [item rest]
            ?- (predicate item)
              %.y (levy rest predicate)
              %.n %.n

++ lien |= args=[(list A) $-(A ?)]
  ^- ?
    ?- args
      [xs predicate]
        ?- xs
          ~ %.n
          [item rest]
            ?- (predicate item)
              %.y %.y
              %.n (lien rest predicate)

++ roll |= args=[(list A) B $-([A B] B)]
  ?- args
    [xs start combine]
      ?- xs
        ~ start
        [item rest] (roll rest (combine item start) combine)

++ reel |= args=[(list A) B $-([A B] B)]
  ?- args
    [xs start combine]
      ?- xs
        ~ start
        [item rest] (combine item (reel rest start combine))

++ flit |= predicate=$-(A ?)
  |= value=A
    ^- (unit A)
      ?- (predicate value)
        %.y `value
        %.n ~

++ murn |= args=[(list A) $-(A (unit B))]
  ?- args
    [xs f] ^- (list B)
        ?- xs
          ~ ~
          [item rest]
            ?- (f item)
              ~ (murn rest f)
              [~ value] [value (murn rest f)]

++ join |= args=[A (list A)]
  ?- args
    [separator xs] ^- (list A)
        ?- xs
          ~ ~
          [item rest]
            ?- rest
              ~ [item ~]
              [next more] [item [separator (join separator rest)]]

++ snip |= xs=(list A)
  ^- (list A)
    ?- xs
      ~ ~
      [item rest]
        ?- rest
          ~ ~
          [next more] [item (snip rest)]

++ rear |= xs=(list A)
  ?- xs
    ~ !!
    [item rest]
      ?- rest
        ~ item
        [next more] (rear rest)

++ cork |= gates=[$-(A B) $-(B C)]
  ?- gates
    [f g] |= x=A (g (f x))

++ corl |= gates=[$-(B C) $-(A B)]
  ?- gates
    [f g] |= x=A (f (g x))

++ cury |= args=[$-([A B] C) A]
  ?- args
    [f a] |= b=B (f a b)

++ curr |= args=[$-([A B] C) B]
  ?- args
    [f b] |= a=A (f a b)

+$ cmd |$ [M]
  [%poke p=poke reply=$-((unit @t) M)]
  [%go url=@t]
  [%wait gap=@dr msg=M]
  [%now reply=$-(@da M)]
  [%who reply=$-(@p M)]

++ gth |= args=[A A] (gth-atom.internal args)
