::  Static element decoding. The Hoon build facade authenticates seals and
::  recursively renders children before calling this typed node renderer.
+$ vnode |$ [A]
  [%text words=@t]
  [%node tag=@t attrs=(list [name=@t value=@t]) kids=(list A)]
  [%link target=qath label=@t]
  [%link-unsafe target=@t label=@t]
  [%image source=qath description=@t]
  [%image-unsafe source=[url=@t width=@ud height=@ud] description=@t]

::  Style attributes are the theme stylesheet's atomic classes, one family
::  each; the build facade keeps only the last attribute of each family.
::  A width is a class, and chars and fill carry their number inline, as a
::  custom property the stylesheet reads along the axis the width is on.
++ css-unsigned |= n=@ud
  ^- @t
  ++ dot (snag 0 (trip "."))
  (crip (skip (scow %ud n) |=(byte=@tD (eq byte dot))))

++ fill-weight |= n=@ud
  ^- @ud
  ?- (gth 1 n)
  %.y 1
  %.n n

++ length-attrs |= value=length
  ^- (list [name=@t value=@t])
  ?- value
  %shrink ~[["class:width" "j-shrink"]]
  [%chars n] ~[["class:width" "j-chars"] ["style:--j-chars" "{(css-unsigned n)}ch"]]
  [%fill n] ~[["class:width" "j-fill"] ["style:--j-fill" (css-unsigned (fill-weight n))]]

++ tone-attrs |= value=tone
  ^- (list [name=@t value=@t])
  ?- value
  %danger ~[["class:tone" "j-tone-danger"] ["aria-live" "polite"]]
  %normal ~[["class:tone" "j-tone-normal"]]
  %muted ~[["class:tone" "j-tone-muted"]]
  %accent ~[["class:tone" "j-tone-accent"]]

++ decode-attr |= [skin=theme value=attr]
  ^- (list [name=@t value=@t])
  ?- value
  [%pad %s0] ~[["class:pad" "j-pad-s0"]]
  [%pad %s1] ~[["class:pad" "j-pad-s1"]]
  [%pad %s2] ~[["class:pad" "j-pad-s2"]]
  [%pad %s3] ~[["class:pad" "j-pad-s3"]]
  [%gap %s0] ~[["class:gap" "j-gap-s0"]]
  [%gap %s1] ~[["class:gap" "j-gap-s1"]]
  [%gap %s2] ~[["class:gap" "j-gap-s2"]]
  [%gap %s3] ~[["class:gap" "j-gap-s3"]]
  [%width w] (length-attrs w)
  [%align %start] ~[["class:align" "j-align-start"]]
  [%align %center] ~[["class:align" "j-align-center"]]
  [%align %end] ~[["class:align" "j-align-end"]]
  [%role %body] ~[["class:role" "j-role-body"]]
  [%role %caption] ~[["class:role" "j-role-caption"]]
  [%role %label] ~[["class:role" "j-role-label"]]
  [%tone t] (tone-attrs t)

++ layout-base |= tag=@t
  ^- (list [name=@t value=@t])
  ~[["class:layout" "j-{tag}"]]

++ heading-tag |= level=@ud
  ^- @t
  ++ clamped ?- (gth 1 level)
    %.y 1
    %.n ?- (gth level 6)
      %.y 6
      %.n level
  "h{(crip (scow %ud clamped))}"

++ render-row |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "row") attrs.payload) kids.payload]

++ render-column |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "column") attrs.payload) kids.payload]

++ render-wrap |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "wrap") attrs.payload) kids.payload]

++ render-stack |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "stack") attrs.payload) kids.payload]

++ render-el |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kid=A]]
  ^- (vnode A)
  ++ own ^- (list [name=@t value=@t]) ~[["class:layout" "j-el"]]
  ++ all ^- (list [name=@t value=@t]) (weld own attrs.payload)
  [%node "div" all ~[kid.payload]]

::  A paragraph of phrasing content alone, which the build facade tells
::  it, is a <p>; the HTML parser would end a <p> at any other child, so a
::  paragraph with one is a <div> styled as a paragraph.
++ render-para |= [skin=theme payload=[phrasing=? kids=(list A)]]
  ^- (vnode A)
  ?- phrasing.payload
  %.y [%node "p" ~ kids.payload]
  %.n [%node "div" ~[["class:layout" "j-para"]] kids.payload]

++ render-text |= [skin=theme words=@t]
  ^- (vnode !!) [%text words]

++ render-heading |= [skin=theme payload=[level=@ud words=@t]]
  ^- (vnode (vnode !!))
  [%node (heading-tag level.payload) ~[["tabindex" "-1"]] ~[[%text words.payload]]]

++ render-link |= [skin=theme payload=[target=qath label=@t]]
  ^- (vnode !!) [%link target.payload label.payload]

::  The build facade decides whether an unchecked URL is a link at all.
++ render-link-unsafe |= [skin=theme payload=[target=@t label=@t]]
  ^- (vnode !!) [%link-unsafe target.payload label.payload]

++ render-image |= [skin=theme payload=[source=qath description=@t]]
  ^- (vnode !!) [%image source.payload description.payload]

++ render-image-unsafe |= [skin=theme payload=[source=[url=@t width=@ud height=@ud] description=@t]]
  ^- (vnode !!) [%image-unsafe source.payload description.payload]
::  Inside an island.  The browser owns these once the island starts, so a
::  control's message, an each's keys and a row's key stay out of the HTML.
++ render-each |= [skin=theme kids=(list A)]
  ^- (vnode A)
  [%node "div" ~[["data-each" ""] ["style:display" "contents"]] kids]

++ render-button |= [skin=theme label=@t]
  ^- (vnode (vnode !!))
  [%node "button" ~[["type" "button"]] ~[[%text label]]]

++ render-toggle |= [skin=theme payload=[on=? label=@t]]
  ^- (vnode !!)
  ++ checked ^- (list [name=@t value=@t])
    ?- on.payload
    %.y ~[["checked" ""]]
    %.n ~
  [%node "input" (weld ~[["type" "checkbox"] ["aria-label" label.payload]] checked) ~]

::  A field is read-only until its island starts (Decisions: Inputs).
++ render-field |= [skin=theme payload=[label=@t value=@t]]
  ^- (vnode !!)
  [%node "input" ~[["type" "text"] ["value" value.payload] ["aria-label" label.payload] ["readonly" ""]] ~]

++ render-form |= [skin=theme kids=(list A)]
  ^- (vnode A)
  [%node "div" ~ kids]

++ align-style |= value=align
  ^- (list [name=@t value=@t])
  ?- value
  %start ~[["style:text-align" "start"]]
  %center ~[["style:text-align" "center"]]
  %end ~[["style:text-align" "end"]]

++ render-table-head |= [skin=theme payload=[header=@t width=length align=align]]
  ^- (vnode (vnode !!))
  ++ attrs ^- (list [name=@t value=@t])
    (weld ~[["scope" "col"]] (weld (length-attrs width.payload) (align-style align.payload)))
  [%node "th" attrs ~[[%text header.payload]]]

::  The table's own attributes and each column's body-cell attributes. A
::  table with a fill column spans its container, the fill columns sharing
::  it by weight, and a shrink column's cells keep their content's width.
++ render-table |= [skin=theme columns=(list [header=@t width=length align=align])]
  ^- [attrs=(list [name=@t value=@t]) cells=(list (list [name=@t value=@t]))]
  ++ column-weight |= col=[header=@t width=length align=align]
    ^- @ud
    ?- width.col
    [%fill n] (fill-weight n)
    * 0
  ++ weights-total ^- @ud (roll (turn columns column-weight) 0 add)
  ++ table-base ^- (list [name=@t value=@t])
    ~[["style:border-collapse" "collapse"] ["style:max-width" "100%"]]
  ++ table-span ^- (list [name=@t value=@t])
    ?- (eq weights-total 0)
    %.y ~
    %.n ~[["style:width" "100%"] ["style:--j-fills" (css-unsigned weights-total)]]
  ++ column-cell |= col=[header=@t width=length align=align]
    ^- (list [name=@t value=@t])
    ?- width.col
    %shrink ~[["class:width" "j-shrink"]]
    * ~
  [attrs=(weld table-base table-span) cells=(turn columns column-cell)]
