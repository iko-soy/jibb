::  Static element decoding. The Hoon build facade authenticates seals and
::  recursively renders children before calling this typed node renderer.
+$ vnode |$ [A]
  [%text words=@t]
  [%node tag=@t attrs=(list [name=@t value=@t]) kids=(list A)]
  [%link target=qath label=@t]
  [%link-unsafe target=@t label=@t]
  [%image source=qath description=@t]
  [%image-unsafe source=[url=@t width=@ud height=@ud] description=@t]

::  Style attributes are the theme stylesheet's atomic classes, one family
::  each, so the last of a family wins. Only chars and fill are inline.
++ fill-weight |= n=@ud
  ^- @ud
  ?- (gth 1 n)
  %.y 1
  %.n n

++ length-attrs |= value=length
  ^- (list [name=@t value=@t])
  ?- value
  %shrink ~[["class:width" "j-shrink"]]
  [%chars n] ~[["style:flex" "0 0 {n}ch"]]
  [%fill n]
    ~[["style:flex" "{(fill-weight n)} 1 0%"] ["style:min-width" "0"]]

++ tone-attrs |= value=tone
  ^- (list [name=@t value=@t])
  ?- value
  %danger ~[["class:tone" "j-tone-danger"] ["aria-live" "polite"]]
  %normal ~[["class:tone" "j-tone-normal"]]
  %muted ~[["class:tone" "j-tone-muted"]]
  %accent ~[["class:tone" "j-tone-accent"]]

++ decode-attr |= [skin=theme value=attr]
  ^- (list [name=@t value=@t])
  ?- value
  [%pad %s0] ~[["class:pad" "j-pad-s0"]]
  [%pad %s1] ~[["class:pad" "j-pad-s1"]]
  [%pad %s2] ~[["class:pad" "j-pad-s2"]]
  [%pad %s3] ~[["class:pad" "j-pad-s3"]]
  [%gap %s0] ~[["class:gap" "j-gap-s0"]]
  [%gap %s1] ~[["class:gap" "j-gap-s1"]]
  [%gap %s2] ~[["class:gap" "j-gap-s2"]]
  [%gap %s3] ~[["class:gap" "j-gap-s3"]]
  [%width w] (length-attrs w)
  [%align %start] ~[["class:align" "j-align-start"]]
  [%align %center] ~[["class:align" "j-align-center"]]
  [%align %end] ~[["class:align" "j-align-end"]]
  [%role %body] ~[["class:role" "j-role-body"]]
  [%role %caption] ~[["class:role" "j-role-caption"]]
  [%role %label] ~[["class:role" "j-role-label"]]
  [%tone t] (tone-attrs t)

++ layout-base |= tag=@t
  ^- (list [name=@t value=@t])
  ~[["class:layout" "j-{tag}"]]

++ heading-tag |= level=@ud
  ^- @t
  ++ clamped ?- (gth 1 level)
    %.y 1
    %.n ?- (gth level 6)
      %.y 6
      %.n level
  "h{(crip (scow %ud clamped))}"

++ render-row |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "row") attrs.payload) kids.payload]

++ render-column |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "column") attrs.payload) kids.payload]

++ render-wrap |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "wrap") attrs.payload) kids.payload]

++ render-stack |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "stack") attrs.payload) kids.payload]

++ render-el |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kid=A]]
  ^- (vnode A)
  ++ own ^- (list [name=@t value=@t]) ~[["class:layout" "j-el"]]
  ++ all ^- (list [name=@t value=@t]) (weld own attrs.payload)
  [%node "div" all ~[kid.payload]]

++ render-para |= [skin=theme kids=(list A)]
  ^- (vnode A)
  [%node "p" ~ kids]

++ render-text |= [skin=theme words=@t]
  ^- (vnode !!) [%text words]

++ render-heading |= [skin=theme payload=[level=@ud words=@t]]
  ^- (vnode (vnode !!))
  [%node (heading-tag level.payload) ~[["tabindex" "-1"]] ~[[%text words.payload]]]

++ render-link |= [skin=theme payload=[target=qath label=@t]]
  ^- (vnode !!) [%link target.payload label.payload]

::  The build facade decides whether an unchecked URL is a link at all.
++ render-link-unsafe |= [skin=theme payload=[target=@t label=@t]]
  ^- (vnode !!) [%link-unsafe target.payload label.payload]

++ render-image |= [skin=theme payload=[source=qath description=@t]]
  ^- (vnode !!) [%image source.payload description.payload]

++ render-image-unsafe |= [skin=theme payload=[source=[url=@t width=@ud height=@ud] description=@t]]
  ^- (vnode !!) [%image-unsafe source.payload description.payload]