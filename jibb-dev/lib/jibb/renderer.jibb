::  Static element decoding. The Hoon build facade authenticates seals and
::  recursively renders children before calling this typed node renderer.
+$ vnode |$ [A]
  [%text words=@t]
  [%node tag=@t attrs=(list [name=@t value=@t]) kids=(list A)]
  [%link target=qath label=@t]

++ fill-weight |= n=@ud
  ^- @ud
  ?- (gth 1 n)
  %.y 1
  %.n n

++ length-attrs |= value=length
  ^- (list [name=@t value=@t])
  ?- value
  %shrink ~[["style:flex" "0 0 auto"] ["style:width" "auto"]]
  [%chars n] ~[["style:flex" "0 0 {(scot %ud n)}ch"]]
  [%fill n]
    ~[["style:flex" "{(scot %ud (fill-weight n))} 1 0%"] ["style:min-width" "0"]]

++ tone-color |= [skin=theme value=tone]
  ^- @t
  ?- value
  %normal normal.tones.skin
  %muted muted.tones.skin
  %accent accent.tones.skin
  %danger danger.tones.skin

++ tone-attrs |= [skin=theme value=tone]
  ^- (list [name=@t value=@t])
  ?- value
  %danger
    ~[["data-tone" "danger"] ["style:color" (tone-color skin value)] ["aria-live" "polite"]]
  %normal ~[["data-tone" "normal"] ["style:color" (tone-color skin value)]]
  %muted ~[["data-tone" "muted"] ["style:color" (tone-color skin value)]]
  %accent ~[["data-tone" "accent"] ["style:color" (tone-color skin value)]]

++ decode-attr |= [skin=theme value=attr]
  ^- (list [name=@t value=@t])
  ?- value
  [%pad %s0] ~[["style:padding" "0"]]
  [%pad %s1] ~[["style:padding" s1.space.skin]]
  [%pad %s2] ~[["style:padding" s2.space.skin]]
  [%pad %s3] ~[["style:padding" s3.space.skin]]
  [%gap %s0] ~[["style:gap" "0"]]
  [%gap %s1] ~[["style:gap" s1.space.skin]]
  [%gap %s2] ~[["style:gap" s2.space.skin]]
  [%gap %s3] ~[["style:gap" s3.space.skin]]
  [%width w] (length-attrs w)
  [%align %start] ~[["style:text-align" "start"] ["style:justify-content" "flex-start"]]
  [%align %center] ~[["style:text-align" "center"] ["style:justify-content" "center"]]
  [%align %end] ~[["style:text-align" "end"] ["style:justify-content" "flex-end"]]
  [%role %body] ~[["data-role" "body"]]
  [%role %caption] ~[["data-role" "caption"]]
  [%role %label] ~[["data-role" "label"]]
  [%tone t] (tone-attrs skin t)

++ layout-centered |= tag=@t
  ^- (list [name=@t value=@t])
  ?- tag
  "column" ~
  "stack" ~
  "row" ~[["style:align-items" "center"]]
  "wrap" ~[["style:align-items" "center"] ["style:flex-wrap" "wrap"]]
  * ~

++ layout-base |= [tag=@t direction=@t]
  ^- (list [name=@t value=@t])
  (weld
    ~[
      ["data-layout" tag]
      ["style:display" "flex"]
      ["style:flex-direction" direction]
      ["style:overflow-wrap" "anywhere"]
    (layout-centered tag)

++ heading-tag |= level=@ud
  ^- @t
  ++ clamped ?- (gth 1 level)
    %.y 1
    %.n ?- (gth level 6)
      %.y 6
      %.n level
  "h{(crip (scow %ud clamped))}"

++ render-row |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "row" "row") attrs.payload) kids.payload]

++ render-column |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "column" "column") attrs.payload) kids.payload]

++ render-wrap |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "wrap" "row") attrs.payload) kids.payload]

++ render-stack |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kids=(list A)]]
  ^- (vnode A)
  [%node "div" (weld (layout-base "stack" "column") attrs.payload) kids.payload]

++ render-el |= [skin=theme payload=[attrs=(list [name=@t value=@t]) kid=A]]
  ^- (vnode A)
  ++ own ^- (list [name=@t value=@t]) ~[["data-layout" "el"]]
  ++ all ^- (list [name=@t value=@t]) (weld own attrs.payload)
  [%node "div" all ~[kid.payload]]

++ render-para |= [skin=theme kids=(list A)]
  ^- (vnode A)
  ++ own ^- (list [name=@t value=@t]) ~[["style:overflow-wrap" "anywhere"]]
  [%node "p" own kids]

++ render-text |= [skin=theme words=@t]
  ^- (vnode !!) [%text words]

++ render-heading |= [skin=theme payload=[level=@ud words=@t]]
  ^- (vnode (vnode !!))
  [%node (heading-tag level.payload) ~[["tabindex" "-1"]] ~[[%text words.payload]]]

++ render-link |= [skin=theme payload=[target=qath label=@t]]
  ^- (vnode !!) [%link target.payload label.payload]

++ render-link-unsafe |= [skin=theme payload=[target=@t label=@t]]
  ^- (vnode (vnode !!))
  [%node "a" ~[["href" target.payload]] ~[[%text label.payload]]]